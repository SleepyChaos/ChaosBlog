---
import { getAllPosts, getAllTags } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getAllPosts();
const tags = getAllTags(posts);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="标签" description="所有文章标签索引">
  <section class="bento-card">
    <div>
      <div class="bento-head">
        <span class="bento-head-title">
          <span class="term-ascii-icon">#*</span>
          <span>TAG_MATRIX // 全部标签索引</span>
        </span>
        <span class="bento-head-meta">TOTAL {tags.length} TAGS</span>
      </div>

      <p style="margin: 0 0 1rem; color: var(--text-muted); font-size: 0.92rem;">
        按主题检索已发布的登山笔记与文章：
      </p>

      <div class="tag-matrix">
        {
          tags.map(([tag, count]) => (
            <a
              class="tag-chip"
              style="padding: 0.35rem 0.75rem; font-size: 0.86rem;"
              href={`${base}/tags/${encodeURIComponent(tag)}/`}
            >
              <span>#{tag}</span>
              <span class="tag-count">[{count}]</span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="bento-foot">
      <a href={`${base}/`}>[← cd ~/home]</a>
      <span>POSTS_INDEXED: {posts.length}</span>
    </div>
  </section>
</BaseLayout>
