---
import { getAllPosts, getAllTags, getPostsByTag, formatDateShort, type PostFull } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return getAllTags(posts).map(([tag]) => ({
    params: { tag },
    props: { tag, tagPosts: getPostsByTag(posts, tag) },
  }));
}

const { tag, tagPosts } = Astro.props as { tag: string; tagPosts: PostFull[] };
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`标签:${tag}`} description={`标签「${tag}」下的所有文章`}>
  <h1 class="section-title"># {tag}<span class="count">{tagPosts.length} 篇</span></h1>
  <ul class="post-list">
    {
      tagPosts.map((post) => (
        <li class="post-item">
          <div class="title-line">
            <a class="title" href={`${base}/posts/${post.slug}/`}>
              {post.title}
            </a>
            <time datetime={post.pubDate.toISOString()}>
              {formatDateShort(post.pubDate)}
            </time>
          </div>
          {post.description && <p class="desc">{post.description}</p>}
        </li>
      ))
    }
  </ul>
  <p style="margin-top: 2.5rem"><a href={`${base}/tags/`}>← 查看全部标签</a></p>
</BaseLayout>
