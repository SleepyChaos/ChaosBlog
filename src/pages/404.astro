---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="404 页面不存在">
  <div class="reader-layout is-single">
    <section class="bento-card" style="text-align: center; padding: 2.2rem 1.5rem;">
      <div class="bento-head">
        <span class="bento-head-title">
          <span class="term-ascii-icon">!</span>
          <span>ERR_404 // RUNAWAY_BOULDER.SH</span>
        </span>
        <span class="bento-head-meta">EXIT_CODE: 404</span>
      </div>

      <pre
        id="runaway-404-stage"
        class="ascii-slope-pre"
        style="display: inline-block; text-align: left; margin: 0.8rem auto; padding: 0.65rem 1rem; font-size: 0.7rem;"
      ></pre>

      <h1 style="font-family: var(--font-mono); font-size: 1.85rem; margin: 0.4rem 0;">
        404 :: 巨石滚出了已知航道
      </h1>
      <p
        id="runaway-404-msg"
        style="color: var(--text-muted); margin: 0.4rem 0 1.25rem; font-size: 0.95rem;"
      >
        你访问的路径不存在。点击下方按钮或直接点击画布拦截失控巨石，可为首页西西弗斯赢取 +50m 助推奖励！
      </p>
      <div style="display: flex; justify-content: center; gap: 0.6rem; flex-wrap: wrap;">
        <button type="button" class="term-btn is-primary" id="catch-boulder-btn">
          [&gt;&gt; 拦截失控巨石 (+50m 助推)]
        </button>
        <a class="term-btn" href={`${base}/`}>[← cd ~/home 返回山脚首页]</a>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const stage = document.getElementById('runaway-404-stage');
  const catchBtn = document.getElementById('catch-boulder-btn');
  const msgEl = document.getElementById('runaway-404-msg');

  if (stage) {
    let rockX = 12;
    let vx = 0.42;
    let caught = false;

    const catchBoulder = () => {
      if (caught) return;
      caught = true;
      try {
        const cycleMs = 8 * 3600 * 1000;
        const raw = localStorage.getItem('sisyphus_8h_cycle_v2');
        const parsed = raw
          ? JSON.parse(raw)
          : { anchorEpoch: Math.floor(Date.now() / cycleMs), boostAccum: 0, boostMeters: 0 };
        parsed.boostAccum = Number(parsed.boostAccum || 0) + 0.056;
        parsed.boostMeters = Number(parsed.boostMeters || 0) + 50;
        localStorage.setItem('sisyphus_8h_cycle_v2', JSON.stringify(parsed));
      } catch {}
      window.dispatchEvent(new CustomEvent('sisyphus:boulder-boost', { detail: { amount: 0.056 } }));
      if (msgEl) {
        msgEl.textContent = '[OK] 成功拦截失控巨石！已向 8 小时主轮回注入 +50m 登山动能。';
        msgEl.style.color = 'var(--accent)';
      }
      if (catchBtn) {
        catchBtn.textContent = '[OK 已拦截 (+50m 已入账)]';
      }
    };

    catchBtn?.addEventListener('click', catchBoulder);
    stage.addEventListener('click', catchBoulder);

    const draw = (t: number) => {
      if (!caught) {
        rockX += vx;
        if (rockX > 44 || rockX < 10) vx = -vx;
      }
      const rx = Math.round(rockX);
      const frames = ['@', 'O', '0', '*'];
      const rf = frames[Math.floor(t * 0.015) % frames.length];

      const W = 52;
      const lines = [
        '  *         .                 +              *      ',
        '     \\o/  "石头滚错片场了！"                         ',
        '      |                                             ',
        '     / \\                                            ',
        '════════════════════════════════════════════════════',
      ];
      const row3 = lines[3].split('');
      if (caught) {
        const s = 'o_ [╔▀╗] (LOCKED!)';
        for (let i = 0; i < s.length && rx + i < W; i++) row3[Math.max(8, rx - 4) + i] = s[i];
      } else {
        const s = `..:(${rf}):..`;
        for (let i = 0; i < s.length && rx + i < W; i++) row3[rx + i] = s[i];
      }
      lines[3] = row3.join('');
      stage.textContent = lines.join('\n');
      requestAnimationFrame(draw);
    };
    requestAnimationFrame(draw);
  }
</script>
