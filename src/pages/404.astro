---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="页面不存在">
  <div class="not-found">
    <h1>404</h1>
    <p style="color: var(--text-muted)">你访问的页面不存在,可能已经被移动或删除了。</p>
    <p><a href={`${base}/`}>← 回到首页</a></p>
  </div>
</BaseLayout>
