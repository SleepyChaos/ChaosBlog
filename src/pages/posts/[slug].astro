---
import { getAllPosts, getPostBySlug, renderPost, formatDateLong, readingTime } from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: {
      post,
      older: posts[i + 1] ?? null,
      newer: posts[i - 1] ?? null,
    },
  }));
}

const { post, older, newer } = Astro.props as {
  post: Awaited<ReturnType<typeof getPostBySlug>>;
  older: object | null;
  newer: object | null;
};
const { Content } = await renderPost(post);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={post.title} description={post.description}>
  <article>
    <a class="back-link" href={`${base}/`}>← 返回首页</a>
    <header class="post-header">
      <h1>{post.title}</h1>
      <div class="post-meta">
        <time datetime={post.pubDate.toISOString()}>{formatDateLong(post.pubDate)}</time>
        <span>·</span>
        <span>{readingTime(post.body)}</span>
        {
          post.tags.map((tag) => (
            <a class="tag-chip" href={`${base}/tags/${encodeURIComponent(tag)}/`}>
              # {tag}
            </a>
          ))
        }
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    <nav class="post-nav">
      {
        older && (
          <a class="prev" href={`${base}/posts/${(older as typeof post).slug}/`}>
            <span class="label">← 更早一篇</span>
            {(older as typeof post).title}
          </a>
        )
      }
      {
        newer && (
          <a class="next" href={`${base}/posts/${(newer as typeof post).slug}/`}>
            <span class="label">更新一篇 →</span>
            {(newer as typeof post).title}
          </a>
        )
      }
    </nav>
  </article>
</BaseLayout>
