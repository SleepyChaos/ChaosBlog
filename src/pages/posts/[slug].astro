---
import {
  getAllPosts,
  renderPost,
  formatDateLong,
  readingTime,
  type PostFull,
} from '../../lib/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AscentToc from '../../components/AscentToc.astro';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: {
      post,
      older: posts[i + 1] ?? null,
      newer: posts[i - 1] ?? null,
    },
  }));
}

const { post, older, newer } = Astro.props as {
  post: PostFull;
  older: PostFull | null;
  newer: PostFull | null;
};
const { Content, headings } = await renderPost(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={post.title} description={post.description}>
  <div class="reader-layout">
    <article class="article-card">
      <a class="back-link" href={`${base}/`}>[← cd ~/home]</a>

      <header class="post-header">
        <h1>{post.title}</h1>
        <div class="post-meta">
          <span>DATE: <time datetime={post.pubDate.toISOString()}>{formatDateLong(post.pubDate)}</time></span>
          {
            post.updatedDate && (
              <>
                <span>│</span>
                <span>UPDATED: {formatDateLong(post.updatedDate)}</span>
              </>
            )
          }
          <span>│</span>
          <span>{readingTime(post.body)}</span>
          {
            post.tags.map((tag) => (
              <a class="tag-chip" href={`${base}/tags/${encodeURIComponent(tag)}/`}>
                #{tag}
              </a>
            ))
          }
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>

      <nav class="post-nav" aria-label="文章前后篇导航">
        {
          older ? (
            <a class="prev" href={`${base}/posts/${older.slug}/`}>
              <span class="label">[← OLDER_LOG]</span>
              {older.title}
            </a>
          ) : (
            <div />
          )
        }
        {
          newer ? (
            <a class="next" href={`${base}/posts/${newer.slug}/`}>
              <span class="label">[NEWER_LOG →]</span>
              {newer.title}
            </a>
          ) : (
            <div />
          )
        }
      </nav>
    </article>

    <AscentToc headings={headings} />
  </div>
</BaseLayout>
