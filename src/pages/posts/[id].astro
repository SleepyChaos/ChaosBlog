---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortPosts, formatDateLong, readingTime } from '../../utils';

export async function getStaticPaths() {
  const sorted = sortPosts(await getCollection('blog', ({ data }) => !data.draft));
  return sorted.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      older: sorted[i + 1] ?? null,
      newer: sorted[i - 1] ?? null,
    },
  }));
}

const { post, older, newer } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    <a class="back-link" href={`${base}/`}>← 返回首页</a>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>{formatDateLong(post.data.pubDate)}</time>
        <span>·</span>
        <span>{readingTime(post.body ?? '')}</span>
        {
          post.data.tags.map((tag) => (
            <a class="tag-chip" href={`${base}/tags/${encodeURIComponent(tag)}/`}>
              # {tag}
            </a>
          ))
        }
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    <nav class="post-nav">
      {
        older ? (
          <a class="prev" href={`${base}/posts/${older.id}/`}>
            <span class="label">← 更早一篇</span>
            {older.data.title}
          </a>
        ) : (
          <span />
        )
      }
      {
        newer ? (
          <a class="next" href={`${base}/posts/${newer.id}/`}>
            <span class="label">更新一篇 →</span>
            {newer.data.title}
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</BaseLayout>
