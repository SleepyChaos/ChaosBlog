---
import { getAllPages, renderPage, type PageFull } from '../lib/content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { GITHUB_URL } from '../consts';

export async function getStaticPaths() {
  const pages = await getAllPages();
  return pages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const page = Astro.props.page as PageFull;
const { Content } = await renderPage(page);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isAbout = page.slug === 'about';
---

<BaseLayout title={page.title} description={page.description}>
  <div class="reader-layout is-single">
    <article class="article-card">
      <a class="back-link" href={`${base}/`}>[← cd ~/home]</a>
      <header class="post-header">
        <div
          style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--accent); margin-bottom: 0.25rem;"
        >
          [PAGE // ./{page.slug}.md]
        </div>
        <h1>{page.title}</h1>
      </header>

      <div class="prose">
        <Content />
      </div>

      {
        isAbout && (
          <div
            style="margin-top: 2rem; padding-top: 1.1rem; border-top: 1px dashed var(--border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.65rem; font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-muted);"
          >
            <span id="about-live-telemetry">ALT 210.0m / 884.8m</span>
            <div style="display: flex; gap: 0.45rem; flex-wrap: wrap;">
              <button type="button" class="term-btn is-primary" id="about-boost-btn">
                [+PUSH 推一把石头]
              </button>
              <a class="term-btn" href={GITHUB_URL} target="_blank" rel="noopener">
                [GitHub @SleepyChaos ↗]
              </a>
            </div>
          </div>
        )
      }
    </article>
  </div>
</BaseLayout>

<script>
  const teleEl = document.getElementById('about-live-telemetry');
  const boostBtn = document.getElementById('about-boost-btn');
  const STORAGE_KEY = 'sisyphus_8h_cycle_v2';
  const CYCLE_MS = 8 * 60 * 60 * 1000;
  const PEAK_ALT = 884.8;

  const refreshTelemetry = () => {
    if (!teleEl) return;
    const nowEpoch = Math.floor(Date.now() / CYCLE_MS);
    let anchorEpoch = nowEpoch;
    let boostAccum = 0;
    let boostMeters = 0;
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (typeof parsed.anchorEpoch === 'number') anchorEpoch = parsed.anchorEpoch;
        if (typeof parsed.boostAccum === 'number') boostAccum = parsed.boostAccum;
        boostMeters = Math.round(Number(parsed.boostMeters || 0));
      }
    } catch {}
    const total = Math.max(0, Date.now() / CYCLE_MS - anchorEpoch + boostAccum);
    const frac = total - Math.floor(total);
    const alt = (frac * PEAK_ALT).toFixed(1);
    teleEl.textContent = `当前推石进度: ALT ${alt}m / 884.8m · 累计助推 +${boostMeters}m`;
  };

  refreshTelemetry();
  window.addEventListener('sisyphus:boulder-telemetry', refreshTelemetry);
  window.addEventListener('sisyphus:realmchange', refreshTelemetry);

  boostBtn?.addEventListener('click', () => {
    const dObj: { minM: number; maxM: number; source: string; rolledAmount?: number } = {
      minM: 14,
      maxM: 38,
      source: '关于页助推',
    };
    window.dispatchEvent(new CustomEvent('sisyphus:boulder-boost', { detail: dObj }));
    refreshTelemetry();
    const rolledM = ((dObj.rolledAmount ?? 0.025) * PEAK_ALT).toFixed(1);
    if (boostBtn) {
      boostBtn.textContent = `[OK 已向前推进 +${rolledM}m]`;
      setTimeout(() => {
        boostBtn.textContent = '[+PUSH 推一把石头]';
      }, 1600);
    }
  });
</script>
