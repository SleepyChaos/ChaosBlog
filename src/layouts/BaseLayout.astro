---
import '../styles/global.css';
import 'remark-callouts/styles.css';
import 'katex/dist/katex.min.css';
import Footer from '../components/Footer.astro';
import FloatingAsciiNav from '../components/FloatingAsciiNav.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN" data-hud-dock="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={`${base}/rss.xml`} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      const savedRealm =
        localStorage.getItem('sisyphus_realm') ||
        (window.matchMedia('(prefers-color-scheme: light)').matches ? 'paper' : 'void');
      document.documentElement.dataset.realm = savedRealm;
      try {
        const hudRaw = sessionStorage.getItem('sisyphus_ascii_hud_v8');
        if (hudRaw) {
          const parsed = JSON.parse(hudRaw);
          document.documentElement.dataset.hudDock =
            parsed.mode === 'docked' ? parsed.dockSide || 'top' : 'float';
        }
      } catch {}
    </script>
  </head>
  <body>
    <!-- 立体景深底色光池 + 终端坐标矩阵（供上层毛玻璃卡片与悬浮导航折射出清晰层次） -->
    <div class="ambient-bg" aria-hidden="true">
      <div class="ambient-blob blob-a"></div>
      <div class="ambient-blob blob-b"></div>
      <div class="ambient-blob blob-c"></div>
      <div class="ambient-grid-marks"></div>
    </div>
    <div class="heavy-frost-veil" aria-hidden="true"></div>
    <canvas id="bg-pixel-canvas" aria-hidden="true"></canvas>

    <!-- 全站悬浮导航与双层链式挂件终端（完全接管原静态顶栏） -->
    <FloatingAsciiNav />

    <main class="container-wide page-main">
      <slot />
    </main>
    <Footer />

    <!-- 文章配图灯箱 -->
    <div class="lightbox-modal" id="lightbox-modal" role="dialog" aria-label="图片放大预览">
      <span class="lightbox-close-hint">[ESC // CLICK TO CLOSE]</span>
      <img id="lightbox-img" src="" alt="" />
    </div>

    <script>
      // 1. 四主题背景 ASCII 漂浮字符艺术画布（不再只是单调像素点，而是对应四大世界的字符意象！）
      const bgCanvas = document.getElementById('bg-pixel-canvas') as HTMLCanvasElement | null;
      if (bgCanvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const ctx = bgCanvas.getContext('2d');
        let mutedColor = '#b8c2e6';
        let accentColor = '#a5b4fc';
        let accent2Color = '#38bdf8';
        let curRealm = document.documentElement.dataset.realm || 'void';

        const GLYPH_SETS: Record<string, string[]> = {
          void: ['▮', '*', '⋆', '·', '◉', '⟡', '1:4:9'],
          paper: ['∑', 'Ψ', '∂', '∆', '∞', '∴', '§'],
          crt: ['ﾊ', 'ﾐ', 'ﾋ', 'ｰ', 'ｳ', 'ｼ', '0', '1'],
          amber: ['◈', '∷', '·', '◐', '~', '⟡', '◦'],
        };

        const syncPalette = () => {
          const cs = getComputedStyle(document.documentElement);
          mutedColor = cs.getPropertyValue('--text-muted').trim() || '#b8c2e6';
          accentColor = cs.getPropertyValue('--accent').trim() || '#a5b4fc';
          accent2Color = cs.getPropertyValue('--accent-2').trim() || '#38bdf8';
          curRealm = document.documentElement.dataset.realm || 'void';
        };
        syncPalette();
        window.addEventListener('sisyphus:realmchange', syncPalette);

        const resize = () => {
          const dpr = window.devicePixelRatio || 1;
          bgCanvas.width = window.innerWidth * dpr;
          bgCanvas.height = window.innerHeight * dpr;
          if (ctx) {
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          }
        };
        resize();
        window.addEventListener('resize', resize);

        const motes = Array.from({ length: 28 }, (_, idx) => ({
          x: Math.random() * window.innerWidth,
          y: Math.random() * window.innerHeight,
          seed: idx,
          alpha: 0.14 + Math.random() * 0.22,
          size: idx % 5 === 0 ? 12 : 10,
        }));

        const tickDust = (t: number) => {
          if (ctx) {
            const w = window.innerWidth;
            const h = window.innerHeight;
            ctx.clearRect(0, 0, w, h);
            const glyphs = GLYPH_SETS[curRealm] || GLYPH_SETS.void;

            for (const p of motes) {
              const glyph = glyphs[p.seed % glyphs.length];
              ctx.font = `${p.size}px ui-monospace, SFMono-Regular, Menlo, monospace`;

              if (curRealm === 'crt') {
                // 霓虹矩阵：数字与半角假名垂直矩阵雨下落
                p.y += 0.72 + (p.seed % 4) * 0.3;
                if (p.y > h + 14) {
                  p.y = -12;
                  p.x = Math.round((Math.random() * w) / 24) * 24;
                }
                ctx.fillStyle = p.seed % 4 === 0 ? accent2Color : accentColor;
                ctx.globalAlpha = p.alpha * 1.1;
                ctx.fillText(glyph, p.x, p.y);
              } else if (curRealm === 'paper') {
                // 浮世纸墨：落樱与水墨微尘随春风斜向飘落
                p.x += 0.24 + Math.sin(t * 0.0011 + p.seed) * 0.22;
                p.y += 0.22 + (p.seed % 3) * 0.1;
                if (p.x > w + 12) p.x = -10;
                if (p.y > h + 12) p.y = -10;
                ctx.fillStyle = p.seed % 3 === 0 ? accentColor : mutedColor;
                ctx.globalAlpha = p.alpha * 1.05;
                ctx.fillText(glyph, p.x, p.y);
              } else if (curRealm === 'amber') {
                // 大漠星轨：流沙金砾与星轨符文斜掠升腾
                p.x += 0.32 + Math.sin(t * 0.001 + p.seed) * 0.18;
                p.y -= 0.2 + (p.seed % 3) * 0.1;
                if (p.x > w + 12) p.x = -10;
                if (p.y < -12) p.y = h + 10;
                ctx.fillStyle = p.seed % 3 === 0 ? accentColor : mutedColor;
                ctx.globalAlpha = p.alpha;
                ctx.fillText(glyph, p.x, p.y);
              } else {
                // 星渊神殿：星芒缓升与微闪呼吸
                p.x += Math.sin(t * 0.0007 + p.seed) * 0.16;
                p.y -= 0.12 + (p.seed % 3) * 0.07;
                if (p.x < -12) p.x = w + 10;
                if (p.x > w + 12) p.x = -10;
                if (p.y < -12) p.y = h + 10;
                const twinkle = 0.65 + 0.35 * Math.sin(t * 0.002 + p.seed * 1.7);
                ctx.fillStyle = p.seed % 3 === 0 ? accent2Color : accentColor;
                ctx.globalAlpha = p.alpha * twinkle;
                ctx.fillText(glyph, p.x, p.y);
              }
            }
            ctx.globalAlpha = 1;
          }
          requestAnimationFrame(tickDust);
        };
        requestAnimationFrame(tickDust);
      }

      // 2. 终端代码块顶栏与一键复制增强
      document.querySelectorAll('.prose pre').forEach((pre) => {
        if (pre.parentElement?.classList.contains('code-term-frame')) return;
        const lang =
          (pre as HTMLElement).dataset.language ||
          pre.querySelector('code')?.className.match(/language-(\w+)/)?.[1] ||
          'txt';

        const wrapper = document.createElement('div');
        wrapper.className = 'code-term-frame';

        const head = document.createElement('div');
        head.className = 'code-term-head';

        const label = document.createElement('span');
        label.textContent = `┌─ [${lang.toUpperCase()}]`;

        const copyBtn = document.createElement('button');
        copyBtn.type = 'button';
        copyBtn.className = 'code-copy-btn';
        copyBtn.textContent = '[COPY]';
        copyBtn.addEventListener('click', async () => {
          const raw = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
          try {
            await navigator.clipboard.writeText(raw);
            copyBtn.textContent = '[COPIED OK]';
            setTimeout(() => {
              copyBtn.textContent = '[COPY]';
            }, 1600);
          } catch {
            copyBtn.textContent = '[ERR]';
          }
        });

        head.append(label, copyBtn);
        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.append(head, pre);
      });

      // 3. 图片点击放大预览（Lightbox）
      const modal = document.getElementById('lightbox-modal');
      const modalImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
      if (modal && modalImg) {
        document.querySelectorAll('.prose img').forEach((img) => {
          img.addEventListener('click', () => {
            modalImg.src = (img as HTMLImageElement).src;
            modalImg.alt = (img as HTMLImageElement).alt;
            modal.classList.add('is-open');
          });
        });
        const closeModal = () => modal.classList.remove('is-open');
        modal.addEventListener('click', closeModal);
        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeModal();
        });
      }
    </script>
  </body>
</html>
