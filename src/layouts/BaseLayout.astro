---
import '../styles/global.css';
import 'remark-callouts/styles.css';
import 'katex/dist/katex.min.css';
import Footer from '../components/Footer.astro';
import FloatingAsciiNav from '../components/FloatingAsciiNav.astro';
import RealmBackdrop from '../components/RealmBackdrop.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN" data-hud-dock="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={`${base}/rss.xml`} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      const savedRealm =
        localStorage.getItem('sisyphus_realm') ||
        (window.matchMedia('(prefers-color-scheme: light)').matches ? 'paper' : 'void');
      document.documentElement.dataset.realm = savedRealm;
      try {
        const hudRaw = sessionStorage.getItem('sisyphus_ascii_hud_v8');
        if (hudRaw) {
          const parsed = JSON.parse(hudRaw);
          document.documentElement.dataset.hudDock =
            parsed.mode === 'docked' ? parsed.dockSide || 'top' : 'float';
        }
      } catch {}

      // 在 <head> 最先注册全局唯一推石进度持久化监听器，确保所有组件拿到的海拔与随机助推值 100% 同步
      window.addEventListener('sisyphus:boulder-boost', (ev) => {
        const detail = (ev && ev.detail) || {};
        const PEAK_ALT = 884.8;
        const CYCLE_MS = 8 * 60 * 60 * 1000;
        const KEY = 'sisyphus_8h_cycle_v2';
        let rawAmt = detail.rolledAmount;
        if (typeof rawAmt !== 'number') {
          if (typeof detail.minM === 'number' && typeof detail.maxM === 'number') {
            rawAmt = (detail.minM + Math.random() * (detail.maxM - detail.minM)) / PEAK_ALT;
          } else {
            const baseAmt = Math.max(0.001, Math.min(0.12, detail.amount || 0.015));
            rawAmt = baseAmt * (0.58 + Math.random() * 0.87);
          }
          detail.rolledAmount = rawAmt;
        }
        if (!detail.persisted) {
          detail.persisted = true;
          try {
            const nowEpoch = Math.floor(Date.now() / CYCLE_MS);
            const raw = localStorage.getItem(KEY);
            const save = raw
              ? JSON.parse(raw)
              : { anchorEpoch: nowEpoch, boostAccum: 0, boostMeters: 0 };
            save.boostAccum = Number(save.boostAccum || 0) + rawAmt;
            save.boostMeters = Number(save.boostMeters || 0) + rawAmt * PEAK_ALT;
            localStorage.setItem(KEY, JSON.stringify(save));
          } catch {}
        }
      });
    </script>
  </head>
  <body>
    <!-- 立体景深底色光池 + 终端坐标矩阵（供上层毛玻璃卡片与悬浮导航折射出清晰层次） -->
    <div class="ambient-bg" aria-hidden="true">
      <div class="ambient-blob blob-a"></div>
      <div class="ambient-blob blob-b"></div>
      <div class="ambient-blob blob-c"></div>
      <div class="ambient-grid-marks"></div>
    </div>
    <div class="heavy-frost-veil" aria-hidden="true"></div>
    <RealmBackdrop />

    <!-- 全站悬浮导航与双层链式挂件终端 -->
    <FloatingAsciiNav />

    <main class="container-wide page-main">
      <slot />
    </main>
    <Footer />

    <!-- 全站视口底边地平线微缩推石轨（不阻挡任何点击，在每个界面静默映射 8h 巨石海拔与被动助推脉冲） -->
    <div class="ambient-horizon-ridge" id="ambient-horizon-ridge" aria-hidden="true">
      <div class="horizon-track-line"></div>
      <div class="horizon-fill-line" id="horizon-fill-line"></div>
      <div class="horizon-climber-node" id="horizon-climber-node">
        <span id="horizon-climber-sprite">o_▪</span>
        <span class="h-alt" id="horizon-climber-alt">210.0m</span>
      </div>
      <div class="horizon-impulse-toast" id="horizon-impulse-toast"></div>
    </div>

    <!-- 划选正文句子时浮现的极简终端共鸣与一键检索浮签 -->
    <div class="selection-echo-hud" id="selection-echo-hud" role="toolbar" aria-label="划选词句终端操作">
      <span class="selection-echo-tag" id="selection-echo-tag">[+8.5m 哲思共鸣]</span>
      <button type="button" class="selection-echo-btn" id="selection-grep-btn">
        [&gt;&gt; 终端检索]
      </button>
    </div>

    <!-- 文章配图灯箱 -->
    <div class="lightbox-modal" id="lightbox-modal" role="dialog" aria-label="图片放大预览">
      <span class="lightbox-close-hint">[ESC // CLICK TO CLOSE]</span>
      <img id="lightbox-img" src="" alt="" />
    </div>

    <script>
      // ================= 1. 全局被动推石动能引擎 + 视口底边微缩推石轨 =================
      const CYCLE_MS = 8 * 60 * 60 * 1000;
      const PEAK_ALT = 884.8;
      const BOULDER_KEY = 'sisyphus_8h_cycle_v2';
      const FLOW_KEY = 'sisyphus_flow_v1';

      const horizonFill = document.getElementById('horizon-fill-line');
      const horizonNode = document.getElementById('horizon-climber-node');
      const horizonSprite = document.getElementById('horizon-climber-sprite');
      const horizonAlt = document.getElementById('horizon-climber-alt');
      const horizonToast = document.getElementById('horizon-impulse-toast');

      let flowMult = 1.0;
      let lastImpulseTag = '8H_CHRONO';
      let lastImpulseMeters = 0;
      let toastHideTimer = 0;
      let strideFrame = 0;

      try {
        const savedFlow = Number(sessionStorage.getItem(FLOW_KEY) || '1');
        if (Number.isFinite(savedFlow) && savedFlow >= 1) {
          flowMult = Math.min(2.5, savedFlow);
        }
      } catch {}

      const loadBoulderSave = () => {
        const nowEpoch = Math.floor(Date.now() / CYCLE_MS);
        let save = { anchorEpoch: nowEpoch, boostAccum: 0, boostMeters: 0 };
        try {
          const raw = localStorage.getItem(BOULDER_KEY);
          if (raw) {
            const parsed = JSON.parse(raw);
            if (
              typeof parsed.anchorEpoch === 'number' &&
              typeof parsed.boostAccum === 'number'
            ) {
              save = {
                anchorEpoch: parsed.anchorEpoch,
                boostAccum: parsed.boostAccum,
                boostMeters: Number(parsed.boostMeters || 0),
              };
            }
          } else {
            localStorage.setItem(BOULDER_KEY, JSON.stringify(save));
          }
        } catch {}
        return save;
      };

      const getBoulderState = () => {
        const save = loadBoulderSave();
        const total = Math.max(0, Date.now() / CYCLE_MS - save.anchorEpoch + save.boostAccum);
        const cycle = Math.floor(total);
        const frac = total - cycle;
        const alt = frac * PEAK_ALT;
        return { save, total, cycle, frac, alt };
      };

      const updateHorizonBar = (toastText?: string) => {
        const st = getBoulderState();
        const pct = Math.max(3, Math.min(96, st.frac * 92 + 4));
        if (horizonFill) horizonFill.style.width = `${pct.toFixed(1)}%`;
        if (horizonNode) horizonNode.style.left = `${pct.toFixed(1)}%`;
        if (horizonAlt) {
          const flowStr = flowMult > 1.08 ? ` · ${flowMult.toFixed(1)}x` : '';
          horizonAlt.textContent = `${st.alt.toFixed(1)}m${flowStr}`;
        }
        if (horizonSprite) {
          const sprites = ['o_▪', 'o/▣', 'o_▪', 'o-▣'];
          horizonSprite.textContent = sprites[strideFrame % sprites.length];
        }
        if (toastText && horizonToast) {
          horizonToast.textContent = toastText;
          horizonToast.style.left = `${Math.max(12, Math.min(88, pct + 9)).toFixed(1)}%`;
          horizonToast.classList.add('is-active');
          window.clearTimeout(toastHideTimer);
          toastHideTimer = window.setTimeout(() => {
            horizonToast.classList.remove('is-active');
          }, 1450);
        }

        window.dispatchEvent(
          new CustomEvent('sisyphus:boulder-telemetry', {
            detail: {
              frac: st.frac,
              alt: st.alt,
              cycle: st.cycle,
              boostMeters: st.save.boostMeters,
              flow: flowMult,
              lastSource: lastImpulseTag,
              lastGain: lastImpulseMeters,
            },
          }),
        );
      };

      // 全局监听任何助推事件（支持 [minM, maxM] 随机区间投掷，且保证多监听器共享同一投掷结果！）
      window.addEventListener('sisyphus:boulder-boost', (ev: Event) => {
        const detail =
          (
            ev as CustomEvent<{
              amount?: number;
              minM?: number;
              maxM?: number;
              rolledAmount?: number;
              source?: string;
              persisted?: boolean;
            }>
          ).detail || {};

        let rawAmt = detail.rolledAmount;
        if (typeof rawAmt !== 'number') {
          if (typeof detail.minM === 'number' && typeof detail.maxM === 'number') {
            const randM = detail.minM + Math.random() * (detail.maxM - detail.minM);
            rawAmt = randM / PEAK_ALT;
          } else {
            const baseAmt = Math.max(0.001, Math.min(0.12, detail.amount ?? 0.015));
            rawAmt = baseAmt * (0.58 + Math.random() * 0.87);
          }
          detail.rolledAmount = rawAmt;
        }

        const source = detail.source || '主动助推';
        flowMult = Math.min(2.5, +(flowMult + 0.06).toFixed(2));
        try {
          sessionStorage.setItem(FLOW_KEY, String(flowMult));
        } catch {}

        const gainedM = rawAmt * PEAK_ALT;
        lastImpulseTag = source;
        lastImpulseMeters = gainedM;
        strideFrame++;

        if (!detail.persisted) {
          const save = loadBoulderSave();
          save.boostAccum += rawAmt;
          save.boostMeters += gainedM;
          try {
            localStorage.setItem(BOULDER_KEY, JSON.stringify(save));
          } catch {}
        }

        updateHorizonBar(`+${gainedM.toFixed(1)}m [${source}]`);
      });

      // 被动推石手段 A：沉浸式匀速阅读步频（每次在 +1.8m ~ +6.2m 乘以心流倍率区间内随机推进）
      let lastScrollPos = window.scrollY;
      let lastScrollAt = performance.now();
      let readingScrollAccum = 0;

      window.addEventListener(
        'scroll',
        () => {
          const now = performance.now();
          const dt = Math.max(8, now - lastScrollAt);
          const dy = Math.abs(window.scrollY - lastScrollPos);
          lastScrollPos = window.scrollY;
          lastScrollAt = now;

          const speedPxSec = (dy / dt) * 1000;
          if (speedPxSec >= 35 && speedPxSec <= 580) {
            readingScrollAccum += dy;
            if (readingScrollAccum >= 360) {
              readingScrollAccum = 0;
              const f = Math.min(1.6, flowMult);
              window.dispatchEvent(
                new CustomEvent('sisyphus:boulder-boost', {
                  detail: { minM: 1.8 * f, maxM: 6.2 * f, source: '阅读步频' },
                }),
              );
            }
          }
        },
        { passive: true },
      );

      // 被动推石手段 B：划选正文词句思考（哲思共鸣 +5.5m ~ +15.5m 随机浮动）
      const selHud = document.getElementById('selection-echo-hud');
      const selTag = document.getElementById('selection-echo-tag');
      const selGrepBtn = document.getElementById('selection-grep-btn');
      let currentSelectedSnippet = '';
      let lastSelectionBoostAt = 0;
      let lastRolledSelM = 8.5;

      document.addEventListener('mouseup', () => {
        setTimeout(() => {
          const sel = window.getSelection();
          const text = sel?.toString().trim() || '';
          if (text.length >= 3 && text.length <= 72 && sel && sel.rangeCount > 0) {
            const rect = sel.getRangeAt(0).getBoundingClientRect();
            if (rect.width > 8 && rect.top > 40) {
              currentSelectedSnippet = text;
              const now = performance.now();
              if (now - lastSelectionBoostAt > 3500) {
                lastSelectionBoostAt = now;
                const dObj: { minM: number; maxM: number; source: string; rolledAmount?: number } = {
                  minM: 5.5,
                  maxM: 15.5,
                  source: '哲思共鸣',
                };
                window.dispatchEvent(new CustomEvent('sisyphus:boulder-boost', { detail: dObj }));
                if (typeof dObj.rolledAmount === 'number') {
                  lastRolledSelM = dObj.rolledAmount * PEAK_ALT;
                }
              }
              if (selHud && selTag) {
                const shortQ = text.length > 12 ? `${text.slice(0, 12)}…` : text;
                selTag.textContent = `[+${lastRolledSelM.toFixed(1)}m 哲思共鸣]`;
                if (selGrepBtn) selGrepBtn.textContent = `[>> 检索 "${shortQ}"]`;
                const left = Math.max(12, Math.min(window.innerWidth - 250, rect.left));
                const top = Math.max(12, rect.top - 34);
                selHud.style.left = `${Math.round(left)}px`;
                selHud.style.top = `${Math.round(top)}px`;
                selHud.classList.add('is-open');
              }
              return;
            }
          }
          selHud?.classList.remove('is-open');
        }, 20);
      });

      document.addEventListener('pointerdown', (e) => {
        if (selHud && !selHud.contains(e.target as Node)) {
          selHud.classList.remove('is-open');
        }
      });

      selGrepBtn?.addEventListener('click', () => {
        if (!currentSelectedSnippet) return;
        selHud?.classList.remove('is-open');
        window.dispatchEvent(
          new CustomEvent('sisyphus:cli-query', { detail: { query: currentSelectedSnippet } }),
        );
        window.dispatchEvent(
          new CustomEvent('sisyphus:boulder-boost', {
            detail: { amount: 0.0074, source: '航道求索' },
          }),
        );
      });

      updateHorizonBar();
      setInterval(() => {
        if (flowMult > 1.0) {
          flowMult = Math.max(1.0, +(flowMult - 0.02).toFixed(2));
        }
        updateHorizonBar();
      }, 4000);

      // ================= 3. 终端代码块顶栏增强 + 代码研读/复制被动推石奖励 =================
      document.querySelectorAll('.prose pre').forEach((pre, blockIdx) => {
        if (pre.parentElement?.classList.contains('code-term-frame')) return;
        const lang =
          (pre as HTMLElement).dataset.language ||
          pre.querySelector('code')?.className.match(/language-(\w+)/)?.[1] ||
          'txt';
        const rawCode = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
        const lineCount = Math.max(1, rawCode.trim().split('\n').length);

        const wrapper = document.createElement('div');
        wrapper.className = 'code-term-frame';

        const head = document.createElement('div');
        head.className = 'code-term-head';

        const label = document.createElement('span');
        label.textContent = `┌─ [${lang.toUpperCase()} · ${lineCount}L]`;

        const copyBtn = document.createElement('button');
        copyBtn.type = 'button';
        copyBtn.className = 'code-copy-btn';
        copyBtn.textContent = '[COPY +16m]';
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(rawCode);
            copyBtn.textContent = '[FORGED +16m OK]';
            window.dispatchEvent(
              new CustomEvent('sisyphus:boulder-boost', {
                detail: { amount: 0.018, source: '火种传递' },
              }),
            );
            setTimeout(() => {
              copyBtn.textContent = '[COPY +16m]';
            }, 1800);
          } catch {
            copyBtn.textContent = '[ERR]';
          }
        });

        // 悬停研读代码块超过 1.4 秒自动发放一次“代码研读”推石冲量
        let studyTimer = 0;
        let studied = false;
        wrapper.addEventListener('pointerenter', () => {
          if (studied) return;
          studyTimer = window.setTimeout(() => {
            studied = true;
            label.textContent = `┌─ [${lang.toUpperCase()} · ${lineCount}L · 已研读 +5m]`;
            window.dispatchEvent(
              new CustomEvent('sisyphus:boulder-boost', {
                detail: { amount: 0.0058, source: `研读#${blockIdx + 1}` },
              }),
            );
          }, 1350);
        });
        wrapper.addEventListener('pointerleave', () => {
          window.clearTimeout(studyTimer);
        });

        head.append(label, copyBtn);
        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.append(head, pre);
      });

      // ================= 4. 图片点击放大预览（Lightbox） =================
      const modal = document.getElementById('lightbox-modal');
      const modalImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
      if (modal && modalImg) {
        document.querySelectorAll('.prose img').forEach((img) => {
          img.addEventListener('click', () => {
            modalImg.src = (img as HTMLImageElement).src;
            modalImg.alt = (img as HTMLImageElement).alt;
            modal.classList.add('is-open');
          });
        });
        const closeModal = () => modal.classList.remove('is-open');
        modal.addEventListener('click', closeModal);
        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeModal();
        });
      }
    </script>
  </body>
</html>
