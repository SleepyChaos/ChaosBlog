---
import '../styles/global.css';
import 'remark-callouts/styles.css';
import 'katex/dist/katex.min.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingAsciiNav from '../components/FloatingAsciiNav.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={`${base}/rss.xml`} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      const savedRealm =
        localStorage.getItem('sisyphus_realm') ||
        (window.matchMedia('(prefers-color-scheme: light)').matches ? 'paper' : 'void');
      document.documentElement.dataset.realm = savedRealm;
    </script>
  </head>
  <body>
    <!-- 立体景深底色光池 + 终端坐标矩阵（供上层半透明毛玻璃卡片与悬浮窗产生清晰的模糊折射层次） -->
    <div class="ambient-bg" aria-hidden="true">
      <div class="ambient-blob blob-a"></div>
      <div class="ambient-blob blob-b"></div>
      <div class="ambient-blob blob-c"></div>
      <div class="ambient-grid-marks"></div>
    </div>
    <div class="heavy-frost-veil" aria-hidden="true"></div>
    <canvas id="bg-pixel-canvas" aria-hidden="true"></canvas>

    <!-- 全站纯 ASCII 外框包裹毛玻璃芯的弹射磁吸导航块 -->
    <FloatingAsciiNav />

    <Header />
    <main class="container-wide page-main">
      <slot />
    </main>
    <Footer />

    <!-- 文章配图灯箱 -->
    <div class="lightbox-modal" id="lightbox-modal" role="dialog" aria-label="图片放大预览">
      <span class="lightbox-close-hint">[ESC // CLICK TO CLOSE]</span>
      <img id="lightbox-img" src="" alt="" />
    </div>

    <script>
      // 1. 背景像素微粒画布（随四大风貌切换粒子性格：星尘上浮 / CRT 数据雨下落 / 纸墨微尘 / 琥珀火星）
      const bgCanvas = document.getElementById('bg-pixel-canvas') as HTMLCanvasElement | null;
      if (bgCanvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const ctx = bgCanvas.getContext('2d');
        let mutedColor = '#8d96ad';
        let accentColor = '#818cf8';
        let curRealm = document.documentElement.dataset.realm || 'void';

        const syncPalette = () => {
          const cs = getComputedStyle(document.documentElement);
          mutedColor = cs.getPropertyValue('--text-muted').trim() || '#8d96ad';
          accentColor = cs.getPropertyValue('--accent').trim() || '#818cf8';
          curRealm = document.documentElement.dataset.realm || 'void';
        };
        syncPalette();
        window.addEventListener('sisyphus:realmchange', syncPalette);

        const resize = () => {
          const dpr = window.devicePixelRatio || 1;
          bgCanvas.width = window.innerWidth * dpr;
          bgCanvas.height = window.innerHeight * dpr;
          if (ctx) {
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            ctx.imageSmoothingEnabled = false;
          }
        };
        resize();
        window.addEventListener('resize', resize);

        const dust = Array.from({ length: 32 }, (_, idx) => ({
          x: Math.random() * window.innerWidth,
          y: Math.random() * window.innerHeight,
          seed: idx,
          size: Math.random() < 0.78 ? 2 : 3,
          alpha: 0.14 + Math.random() * 0.2,
        }));

        const tickDust = (t: number) => {
          if (ctx) {
            const w = window.innerWidth;
            const h = window.innerHeight;
            ctx.clearRect(0, 0, w, h);
            for (const p of dust) {
              if (curRealm === 'crt') {
                // CRT 绿磷风貌：垂直数字荧光雨滴下落
                p.y += 0.65 + (p.seed % 4) * 0.28;
                if (p.y > h) {
                  p.y = -4;
                  p.x = Math.round((Math.random() * w) / 16) * 16;
                }
                ctx.fillStyle = p.seed % 3 === 0 ? accentColor : mutedColor;
                ctx.globalAlpha = p.alpha * 1.15;
                ctx.fillRect(Math.round(p.x / 2) * 2, Math.round(p.y / 2) * 2, 2, p.size * 2);
              } else if (curRealm === 'amber') {
                // 琥珀风貌：斜向飘升的暖金余烬
                p.x += 0.22 + Math.sin(t * 0.001 + p.seed) * 0.18;
                p.y -= 0.28 + (p.seed % 3) * 0.12;
                if (p.x > w) p.x = 0;
                if (p.y < 0) p.y = h;
                ctx.fillStyle = p.seed % 2 === 0 ? accentColor : mutedColor;
                ctx.globalAlpha = p.alpha;
                ctx.fillRect(Math.round(p.x / 2) * 2, Math.round(p.y / 2) * 2, p.size, p.size);
              } else {
                // 星图与手稿风貌：静谧缓升微尘
                p.x += Math.sin(t * 0.0007 + p.seed) * 0.16;
                p.y -= 0.12 + (p.seed % 3) * 0.08;
                if (p.x < 0) p.x = w;
                if (p.x > w) p.x = 0;
                if (p.y < 0) p.y = h;
                ctx.fillStyle = mutedColor;
                ctx.globalAlpha = p.alpha;
                ctx.fillRect(Math.round(p.x / 2) * 2, Math.round(p.y / 2) * 2, p.size, p.size);
              }
            }
            ctx.globalAlpha = 1;
          }
          requestAnimationFrame(tickDust);
        };
        requestAnimationFrame(tickDust);
      }

      // 2. 终端代码块顶栏与一键复制增强
      document.querySelectorAll('.prose pre').forEach((pre) => {
        if (pre.parentElement?.classList.contains('code-term-frame')) return;
        const lang =
          (pre as HTMLElement).dataset.language ||
          pre.querySelector('code')?.className.match(/language-(\w+)/)?.[1] ||
          'txt';

        const wrapper = document.createElement('div');
        wrapper.className = 'code-term-frame';

        const head = document.createElement('div');
        head.className = 'code-term-head';

        const label = document.createElement('span');
        label.textContent = `┌─ [${lang.toUpperCase()}]`;

        const copyBtn = document.createElement('button');
        copyBtn.type = 'button';
        copyBtn.className = 'code-copy-btn';
        copyBtn.textContent = '[COPY]';
        copyBtn.addEventListener('click', async () => {
          const raw = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
          try {
            await navigator.clipboard.writeText(raw);
            copyBtn.textContent = '[COPIED ✓]';
            setTimeout(() => {
              copyBtn.textContent = '[COPY]';
            }, 1600);
          } catch {
            copyBtn.textContent = '[ERR]';
          }
        });

        head.append(label, copyBtn);
        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.append(head, pre);
      });

      // 3. 图片点击放大预览（Lightbox）
      const modal = document.getElementById('lightbox-modal');
      const modalImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
      if (modal && modalImg) {
        document.querySelectorAll('.prose img').forEach((img) => {
          img.addEventListener('click', () => {
            modalImg.src = (img as HTMLImageElement).src;
            modalImg.alt = (img as HTMLImageElement).alt;
            modal.classList.add('is-open');
          });
        });
        const closeModal = () => modal.classList.remove('is-open');
        modal.addEventListener('click', closeModal);
        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeModal();
        });
      }
    </script>
  </body>
</html>
