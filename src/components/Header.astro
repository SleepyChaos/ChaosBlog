---
import { TERMINAL_PROMPT, GITHUB_URL, GITHUB_HANDLE } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rawRoute = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length) || '/'
  : Astro.url.pathname;

const displayCmd =
  rawRoute === '/'
    ? 'cd ~/home && ./sisyphus --cycle=8h'
    : `cat .${rawRoute.replace(/\/$/, '')}.md`;
---

<header class="top-term-strip">
  <div class="container-wide">
    <div class="top-term-inner">
      <div class="term-prompt-group">
        <span class="term-ascii-icon">&gt;_</span>
        <a class="term-prompt-host" href={`${base}/`}>{TERMINAL_PROMPT}</a>
        <span class="term-prompt-path" id="top-cmd-readout">{displayCmd}</span>
        <span class="term-cursor" aria-hidden="true">▊</span>
      </div>

      <div class="term-actions">
        <button
          type="button"
          class="term-btn is-primary"
          id="hud-kick-trigger"
          title="高速弹射浮动 ASCII 导航块（同时助推西西弗斯）"
        >
          [⚡弹射HUD]
        </button>
        <button
          type="button"
          class="term-btn"
          id="hud-dock-trigger"
          title="将浮动导航块挂靠侧边栏/释放"
        >
          [::侧挂/释放]
        </button>
        <button
          type="button"
          class="term-btn"
          id="realm-cycle-btn"
          title="切换全站终端主题风貌（星图 / 绿磷CRT / 纸墨蓝图 / 沙丘琥珀）"
        >
          <span id="realm-label">[❖ 星图]</span>
        </button>
        <a class="term-btn" href={GITHUB_URL} target="_blank" rel="noopener">
          [@{GITHUB_HANDLE}]
        </a>
        <a class="term-btn" href={`${base}/rss.xml`} aria-label="RSS 订阅">
          [RSS]
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const REALM_NAMES: Record<string, string> = {
    void: '[❖ 星图]',
    crt: '[❖ 绿磷CRT]',
    paper: '[❖ 纸墨手稿]',
    amber: '[❖ 沙丘琥珀]',
  };

  const realmLabel = document.getElementById('realm-label');
  const refreshRealmLabel = () => {
    const r = document.documentElement.dataset.realm || 'void';
    if (realmLabel) realmLabel.textContent = REALM_NAMES[r] || '[❖ 星图]';
  };
  refreshRealmLabel();
  window.addEventListener('sisyphus:realmchange', refreshRealmLabel);

  document.getElementById('realm-cycle-btn')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('sisyphus:cycle-realm'));
  });

  document.getElementById('hud-kick-trigger')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('sisyphus:hud-kick'));
  });

  document.getElementById('hud-dock-trigger')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('sisyphus:hud-toggle-dock'));
  });
</script>
