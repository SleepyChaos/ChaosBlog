---
import { TERMINAL_PROMPT, GITHUB_URL, GITHUB_HANDLE } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rawRoute = Astro.url.pathname.startsWith(base)
  ? Astro.url.pathname.slice(base.length) || '/'
  : Astro.url.pathname;

const displayCmd =
  rawRoute === '/'
    ? 'cd ~/home && ./status.sh'
    : `cat .${rawRoute.replace(/\/$/, '')}.md`;
---

<header class="top-term-strip">
  <div class="container-wide">
    <div class="top-term-inner">
      <div class="term-prompt-group">
        <span class="term-ascii-icon">&gt;_</span>
        <a class="term-prompt-host" href={`${base}/`}>{TERMINAL_PROMPT}</a>
        <span class="term-prompt-path" id="top-cmd-readout">{displayCmd}</span>
        <span class="term-cursor" aria-hidden="true">▊</span>
      </div>

      <div class="term-actions">
        <button
          type="button"
          class="term-btn is-primary"
          id="hud-kick-trigger"
          title="高速弹射浮动 ASCII 导航块"
        >
          [::弹射HUD]
        </button>
        <button
          type="button"
          class="term-btn"
          id="hud-dock-trigger"
          title="将浮动导航块吸附/释放"
        >
          [::贴顶/释放]
        </button>
        <a class="term-btn" href={GITHUB_URL} target="_blank" rel="noopener">
          [@{GITHUB_HANDLE}]
        </a>
        <a class="term-btn" href={`${base}/rss.xml`} aria-label="RSS 订阅">
          [RSS]
        </a>
        <button
          type="button"
          class="term-btn"
          id="theme-toggle"
          aria-label="切换明暗主题"
        >
          <span id="theme-label">[◐ THEME]</span>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  const themeBtn = document.getElementById('theme-toggle');
  const themeLabel = document.getElementById('theme-label');

  function refreshThemeLabel() {
    const isDark = document.documentElement.dataset.theme === 'dark';
    if (themeLabel) {
      themeLabel.textContent = isDark ? '[☀ LIGHT]' : '[☾ DARK]';
    }
  }
  refreshThemeLabel();

  themeBtn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    localStorage.setItem('theme', next);
    refreshThemeLabel();
    window.dispatchEvent(new CustomEvent('sisyphus:themechange', { detail: { theme: next } }));
  });

  document.getElementById('hud-kick-trigger')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('sisyphus:hud-kick'));
  });

  document.getElementById('hud-dock-trigger')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('sisyphus:hud-toggle-dock'));
  });
</script>
