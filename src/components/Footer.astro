---
import { SITE_AUTHOR, SITE_SUB_AUTHOR, GITHUB_URL } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-wide">
    <div class="site-footer-inner">
      <div style="display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap;">
        <span
          id="footer-mode-pill"
          style="padding: 0.1rem 0.45rem; background: var(--accent); color: var(--accent-fg); font-weight: 700; border-radius: 1px;"
        >
          NORMAL
        </span>
        <span id="footer-world-pill" style="color: var(--accent); font-weight: 700;">
          ◉ 2001·太空漫游
        </span>
        <span>│</span>
        <button
          type="button"
          class="term-btn"
          id="footer-sfx-btn"
          style="padding: 0.08rem 0.45rem; font-size: 0.72rem;"
          title="开启后，鼠标扫过悬浮导航 ASCII 边框可弹奏五声音阶竖琴泛音，切换世界与助推也有合成器音效"
        >
          [SFX 弦音: OFF]
        </button>
      </div>

      <div
        style="color: var(--text-muted); font-size: 0.72rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;"
      >
        <span>[KBD] <strong>/</strong> 终端 · <strong>j/k</strong> 选文 · <strong>t</strong> 跃迁世界 · <strong>p</strong> 助推</span>
      </div>

      <div style="display: flex; align-items: center; gap: 0.45rem; flex-wrap: wrap;">
        <span>© {year} {SITE_AUTHOR} ({SITE_SUB_AUTHOR})</span>
        <span>·</span>
        <a href={`${base}/rss.xml`}>[RSS]</a>
        <span>·</span>
        <a href={GITHUB_URL} target="_blank" rel="noopener">[GitHub]</a>
      </div>
    </div>
  </div>
</footer>

<script>
  const worldPill = document.getElementById('footer-world-pill');
  const sfxBtn = document.getElementById('footer-sfx-btn');

  const WORLD_LABELS: Record<string, string> = {
    void: '◉ 太空漫游 · TMA-1',
    paper: 'Ψ 银河帝国 · 端点星',
    crt: '▓ 黑客帝国 · 锡安',
    amber: '◐ 沙丘 · 厄拉科斯',
  };

  const syncWorldPill = () => {
    const r = document.documentElement.dataset.realm || 'void';
    if (worldPill) {
      worldPill.textContent = WORLD_LABELS[r] || WORLD_LABELS.void;
    }
  };
  syncWorldPill();
  window.addEventListener('sisyphus:realmchange', syncWorldPill);

  const syncSfxLabel = (on: boolean) => {
    if (!sfxBtn) return;
    sfxBtn.textContent = on ? '[SFX 弦音: ON]' : '[SFX 弦音: OFF]';
    sfxBtn.classList.toggle('is-primary', on);
  };

  try {
    syncSfxLabel(localStorage.getItem('sisyphus_sfx') === '1');
  } catch {}

  sfxBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('sisyphus:toggle-sfx'));
  });

  window.addEventListener('sisyphus:sfxchange', (e: Event) => {
    const on = Boolean((e as CustomEvent<{ enabled?: boolean }>).detail?.enabled);
    syncSfxLabel(on);
  });
</script>
