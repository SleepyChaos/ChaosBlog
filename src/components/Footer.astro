---
import { SITE_AUTHOR, SITE_SUB_AUTHOR, GITHUB_URL, CAMUS_QUOTE } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-wide">
    <div class="site-footer-inner">
      <span>
        [EOF] © {year} {SITE_AUTHOR} ({SITE_SUB_AUTHOR}) · "{CAMUS_QUOTE}"
      </span>
      <span>
        <a href={`${base}/rss.xml`}>[RSS]</a>
        ·
        <a href={GITHUB_URL} target="_blank" rel="noopener">[GitHub]</a>
        ·
        <a href="https://astro.build" target="_blank" rel="noopener">[Astro]</a>
      </span>
    </div>
  </div>
</footer>
