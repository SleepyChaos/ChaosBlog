---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname;
const relPath = pathname.startsWith(base) ? pathname.slice(base.length) || '/' : pathname;

const isHome = relPath === '/';
const isPosts = relPath.startsWith('/posts');
const isTags = relPath.startsWith('/tags');
const isAbout = relPath.startsWith('/about');

const navItems = [
  { label: '~/首页', href: `${base}/`, active: isHome },
  { label: './文章', href: `${base}/#summit-logs`, active: isPosts },
  { label: '#标签', href: `${base}/tags/`, active: isTags },
  { label: '?关于', href: `${base}/about/`, active: isAbout },
];
---

<canvas id="fx-pixel-canvas" aria-hidden="true"></canvas>
<div id="pixel-dock-ruler" class="pixel-dock-ruler" aria-hidden="true"></div>

<nav
  id="ascii-float-nav"
  class="ascii-float-nav"
  aria-label="浮动 ASCII 终端导航"
  style="width: 140px; height: 64px;"
>
  <!-- 缩小一圈的雾面毛玻璃芯（严格缩进在最外圈 ASCII 框线之内） -->
  <div
    id="ascii-inner-frost"
    class="ascii-inner-frost"
    style="left: 9px; right: 9px; top: 9px; bottom: 9px;"
  >
  </div>

  <!-- 外圈纯 ASCII 框线边界 -->
  <div id="ascii-frame-top" class="ascii-frame-top">┌─[::0G──v0.8]─┐</div>
  <div id="ascii-frame-bot" class="ascii-frame-bot">└───[000,000]──┘</div>

  <div id="ascii-pipes-left" class="ascii-frame-pipes is-left">
    <span>│</span><span>│</span><span>│</span>
  </div>
  <div id="ascii-pipes-right" class="ascii-frame-pipes is-right">
    <span>│</span><span>│</span><span>│</span>
  </div>

  <!-- 横向贴边态外包端头 -->
  <span id="ascii-cap-left" class="ascii-bar-cap is-left">╠═[::]</span>
  <span id="ascii-cap-right" class="ascii-bar-cap is-right">═╣</span>

  {
    navItems.map((item, idx) => (
      <a
        href={item.href}
        draggable="false"
        data-idx={idx}
        class:list={['ascii-nav-item', { 'is-active': item.active }]}
      >
        {item.label}
      </a>
    ))
  }
</nav>

<script>
  const STORAGE_KEY = 'sisyphus_ascii_hud_v1';

  const nav = document.getElementById('ascii-float-nav') as HTMLElement | null;
  const innerFrost = document.getElementById('ascii-inner-frost') as HTMLElement | null;
  const frameTop = document.getElementById('ascii-frame-top') as HTMLElement | null;
  const frameBot = document.getElementById('ascii-frame-bot') as HTMLElement | null;
  const pipesLeft = document.getElementById('ascii-pipes-left') as HTMLElement | null;
  const pipesRight = document.getElementById('ascii-pipes-right') as HTMLElement | null;
  const capLeft = document.getElementById('ascii-cap-left') as HTMLElement | null;
  const capRight = document.getElementById('ascii-cap-right') as HTMLElement | null;
  const ruler = document.getElementById('pixel-dock-ruler') as HTMLElement | null;
  const fxCanvas = document.getElementById('fx-pixel-canvas') as HTMLCanvasElement | null;
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('#ascii-float-nav .ascii-nav-item'));

  if (nav && innerFrost && frameTop && frameBot && pipesLeft && pipesRight && capLeft && capRight && ruler && fxCanvas) {
    const ctx = fxCanvas.getContext('2d');
    let accentColor = '#818cf8';
    let mutedColor = '#888fa3';

    const syncColors = () => {
      const cs = getComputedStyle(document.documentElement);
      accentColor = cs.getPropertyValue('--accent').trim() || '#818cf8';
      mutedColor = cs.getPropertyValue('--text-muted').trim() || '#888fa3';
    };
    syncColors();
    window.addEventListener('sisyphus:themechange', syncColors);

    const resizeFx = () => {
      const dpr = window.devicePixelRatio || 1;
      fxCanvas.width = window.innerWidth * dpr;
      fxCanvas.height = window.innerHeight * dpr;
      if (ctx) {
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.imageSmoothingEnabled = false;
      }
    };
    resizeFx();
    window.addEventListener('resize', resizeFx);

    // 像素迸发粒子池（2px 网格对齐，阶梯消隐，无发光模糊）
    interface BurstPixel {
      x: number;
      y: number;
      vx: number;
      vy: number;
      size: number;
      life: number;
      decay: number;
      accent: boolean;
    }
    const bursts: BurstPixel[] = [];

    const spawnBurst = (bx: number, by: number, nx: number, ny: number, count: number, scale: number) => {
      for (let i = 0; i < count; i++) {
        const ang = Math.atan2(ny, nx) + (Math.random() - 0.5) * 1.7;
        const sp = (1.3 + Math.random() * 3.2) * scale;
        bursts.push({
          x: bx,
          y: by,
          vx: Math.cos(ang) * sp,
          vy: Math.sin(ang) * sp,
          size: Math.random() < 0.55 ? 3 : 2,
          life: 1,
          decay: 0.035 + Math.random() * 0.025,
          accent: Math.random() < 0.75,
        });
      }
    };

    const spawnDockPixels = (edge: string, cx: number, cy: number, vw: number, vh: number) => {
      for (let i = -5; i <= 5; i++) {
        if (edge === 'top' || edge === 'bottom') {
          bursts.push({
            x: cx + i * 20,
            y: edge === 'top' ? 3 : vh - 5,
            vx: i * 0.3,
            vy: edge === 'top' ? 0.7 : -0.7,
            size: 3,
            life: 0.95,
            decay: 0.045,
            accent: true,
          });
        } else {
          bursts.push({
            x: edge === 'left' ? 3 : vw - 5,
            y: cy + i * 12,
            vx: edge === 'left' ? 0.7 : -0.7,
            vy: i * 0.28,
            size: 3,
            life: 0.95,
            decay: 0.045,
            accent: true,
          });
        }
      }
    };

    // 三套形态几何与内部毛玻璃缩进（确保外圈 ASCII 边界始终包裹内部毛玻璃芯）
    const SHAPES = {
      block: {
        w: 140,
        h: 64,
        inset: { l: 9, r: 9, t: 9, b: 9 },
        coords: [
          [-28, -8],
          [28, -8],
          [-28, 9],
          [28, 9],
        ],
      },
      bar: {
        w: 266,
        h: 30,
        inset: { l: 44, r: 20, t: 4, b: 4 },
        coords: [
          [-64, 0],
          [-15, 0],
          [34, 0],
          [83, 0],
        ],
      },
      rail: {
        w: 78,
        h: 116,
        inset: { l: 9, r: 9, t: 9, b: 9 },
        coords: [
          [0, -32],
          [0, -11],
          [0, 10],
          [0, 31],
        ],
      },
    } as const;

    const CAPTURE_SPEED = 3.8;
    const MAGNET_ZONE = 58;
    const CRUISE_SPEED = 0.82;
    const RESTITUTION = 0.85;
    const AIR_DRAG = 0.986;

    type HudState = 'free' | 'dragging' | 'top' | 'bottom' | 'left' | 'right';
    let state: HudState = window.innerWidth < 640 ? 'top' : 'free';
    let x = window.innerWidth < 640 ? window.innerWidth * 0.5 : window.innerWidth * 0.78;
    let y = window.innerWidth < 640 ? 18 : 132;
    let vx = -0.82;
    let vy = 0.56;
    let impactUntil = 0;
    let magnetImmunityUntil = 0;

    // 恢复跨页面持久化坐标与状态
    try {
      const raw = sessionStorage.getItem(STORAGE_KEY);
      if (raw) {
        const saved = JSON.parse(raw);
        if (saved && typeof saved.xNorm === 'number' && typeof saved.yNorm === 'number') {
          state = saved.state || state;
          x = Math.max(40, Math.min(window.innerWidth - 40, saved.xNorm * window.innerWidth));
          y = Math.max(18, Math.min(window.innerHeight - 18, saved.yNorm * window.innerHeight));
          vx = typeof saved.vx === 'number' ? saved.vx : vx;
          vy = typeof saved.vy === 'number' ? saved.vy : vy;
        }
      }
    } catch {
      // ignore storage errors
    }

    const saveState = () => {
      try {
        sessionStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({
            state: state === 'dragging' ? 'free' : state,
            xNorm: x / Math.max(1, window.innerWidth),
            yNorm: y / Math.max(1, window.innerHeight),
            vx,
            vy,
          }),
        );
      } catch {
        // ignore
      }
    };
    window.addEventListener('pagehide', saveState);

    const initKey =
      state === 'top' || state === 'bottom'
        ? 'bar'
        : state === 'left' || state === 'right'
          ? 'rail'
          : 'block';
    let curW: number = SHAPES[initKey].w;
    let curH: number = SHAPES[initKey].h;
    let velW = 0;
    let velH = 0;
    let curInset = { ...SHAPES[initKey].inset };
    let barAlpha = initKey === 'bar' ? 1 : 0;
    const itemSpring = SHAPES[initKey].coords.map(([ix, iy]) => ({ x: ix, y: iy, vx: 0, vy: 0 }));

    const nearestWall = (cx: number, cy: number, hw: number, hh: number, vw: number, vh: number) => {
      const list: { edge: 'top' | 'bottom' | 'left' | 'right'; dist: number }[] = [
        { edge: 'top', dist: cy - hh },
        { edge: 'bottom', dist: vh - (cy + hh) },
        { edge: 'left', dist: cx - hw },
        { edge: 'right', dist: vw - (cx + hw) },
      ];
      list.sort((a, b) => a.dist - b.dist);
      return list[0];
    };

    const updateRuler = (
      edge: 'top' | 'bottom' | 'left' | 'right' | null,
      strength: number,
      cx: number,
      cy: number,
      vw: number,
      vh: number,
    ) => {
      if (!edge || strength <= 0.02) {
        ruler.style.opacity = '0';
        return;
      }
      ruler.style.opacity = Math.min(0.95, 0.3 + strength * 0.7).toFixed(2);
      if (edge === 'top' || edge === 'bottom') {
        ruler.classList.remove('is-vert');
        const span = Math.round((120 + strength * 100) / 6) * 6;
        const left = Math.max(8, Math.min(vw - span - 8, Math.round((cx - span * 0.5) / 2) * 2));
        ruler.style.width = `${span}px`;
        ruler.style.height = '3px';
        ruler.style.left = `${left}px`;
        ruler.style.top = edge === 'top' ? '1px' : `${vh - 4}px`;
      } else {
        ruler.classList.add('is-vert');
        const vSpan = Math.round((60 + strength * 50) / 6) * 6;
        const top = Math.max(8, Math.min(vh - vSpan - 8, Math.round((cy - vSpan * 0.5) / 2) * 2));
        ruler.style.width = '3px';
        ruler.style.height = `${vSpan}px`;
        ruler.style.top = `${top}px`;
        ruler.style.left = edge === 'left' ? '1px' : `${vw - 4}px`;
      }
    };

    const lockDock = (edge: 'top' | 'bottom' | 'left' | 'right', vw: number, vh: number) => {
      if (state === edge) return;
      state = edge;
      vx = 0;
      vy = 0;
      if (edge === 'top' || edge === 'bottom') {
        velW += 7;
        velH -= 3;
      } else {
        velW -= 3;
        velH += 7;
      }
      spawnDockPixels(edge, x, y, vw, vh);
      saveState();
      window.dispatchEvent(new CustomEvent('sisyphus:hud-state', { detail: { state: edge } }));
    };

    // 外部事件联动（顶栏与首页控制台可触发高速弹射或吸顶/释放）
    window.addEventListener('sisyphus:hud-kick', () => {
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      state = 'free';
      if (x < 80 || x > vw - 80) x = vw * 0.5;
      if (y < 60 || y > vh - 60) y = vh * 0.45;
      const ang = (Math.random() * 0.5 + 0.22) * Math.PI * (Math.random() < 0.5 ? 1 : -1);
      const power = 18 + Math.random() * 6;
      vx = Math.cos(ang) * power;
      vy = Math.sin(ang) * power;
      magnetImmunityUntil = performance.now() + 200;
    });

    window.addEventListener('sisyphus:hud-toggle-dock', () => {
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      if (state === 'free') {
        x = vw * 0.5;
        lockDock('top', vw, vh);
      } else {
        state = 'free';
        const dx = vw * 0.65 - x;
        const dy = Math.min(220, vh * 0.35) - y;
        const d = Math.max(1, Math.hypot(dx, dy));
        vx = (dx / d) * 4.4;
        vy = (dy / d) * 4.4;
        magnetImmunityUntil = performance.now() + 700;
        saveState();
      }
    });

    // 拖拽与甩手动量采样
    let pointerId: number | null = null;
    let startPX = 0;
    let startPY = 0;
    let grabOffsetX = 0;
    let grabOffsetY = 0;
    let moved = false;
    let suppressClickUntil = 0;
    let samples: { x: number; y: number; t: number }[] = [];
    let cursorX = -9999;
    let cursorY = -9999;

    window.addEventListener('pointermove', (e) => {
      cursorX = e.clientX;
      cursorY = e.clientY;

      if (e.pointerId !== pointerId) return;
      const now = performance.now();
      if (!moved && Math.hypot(e.clientX - startPX, e.clientY - startPY) > 4) {
        moved = true;
        state = 'dragging';
        nav.setPointerCapture(e.pointerId);
      }
      if (!moved) return;

      samples.push({ x: e.clientX, y: e.clientY, t: now });
      while (samples.length > 6 && now - samples[0].t > 80) samples.shift();

      const first = samples[0];
      const dt = Math.max(10, now - first.t);
      vx = ((e.clientX - first.x) / dt) * 16.5;
      vy = ((e.clientY - first.y) / dt) * 16.5;
      const dragSpeed = Math.hypot(vx, vy);

      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const hw = curW * 0.5;
      const hh = curH * 0.5;
      x = Math.max(hw + 2, Math.min(vw - hw - 2, e.clientX - grabOffsetX));
      y = Math.max(hh + 2, Math.min(vh - hh - 2, e.clientY - grabOffsetY));

      const nw = nearestWall(x, y, hw, hh, vw, vh);
      const preSnap = nw.dist < MAGNET_ZONE * 0.72 && dragSpeed <= CAPTURE_SPEED;
      updateRuler(preSnap ? nw.edge : null, preSnap ? 1 - nw.dist / MAGNET_ZONE : 0, x, y, vw, vh);
    });

    nav.addEventListener('pointerdown', (e) => {
      pointerId = e.pointerId;
      startPX = e.clientX;
      startPY = e.clientY;
      grabOffsetX = e.clientX - x;
      grabOffsetY = e.clientY - y;
      moved = false;
      samples = [{ x: e.clientX, y: e.clientY, t: performance.now() }];
    });

    const endDrag = (e: PointerEvent) => {
      if (e.pointerId !== pointerId) return;
      const wasMoved = moved;
      pointerId = null;
      moved = false;
      if (!wasMoved) return;

      const now = performance.now();
      suppressClickUntil = now + 180;
      const last = samples[samples.length - 1];
      if (now - last.t > 90) {
        vx = 0;
        vy = 0;
      } else if (samples.length >= 2) {
        const first = samples[0];
        const dt = Math.max(12, last.t - first.t);
        vx = Math.max(-26, Math.min(26, ((last.x - first.x) / dt) * 18.5));
        vy = Math.max(-26, Math.min(26, ((last.y - first.y) / dt) * 18.5));
      }

      const speed = Math.hypot(vx, vy);
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const hw = curW * 0.5;
      const hh = curH * 0.5;
      const nw = nearestWall(x, y, hw, hh, vw, vh);

      if (nw.dist < MAGNET_ZONE * 0.75 && speed <= CAPTURE_SPEED) {
        lockDock(nw.edge, vw, vh);
      } else {
        state = 'free';
        if (speed < 0.35) {
          const ang = Math.random() * Math.PI * 2;
          vx = Math.cos(ang) * CRUISE_SPEED;
          vy = Math.sin(ang) * CRUISE_SPEED;
        }
        saveState();
      }
    };

    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);

    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        if (moved || performance.now() < suppressClickUntil) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }
        saveState();
      });
    });

    const deflect = (horizWall: boolean) => {
      if (horizWall) {
        vy = -vy * RESTITUTION;
        vx = vx * 0.94 + (Math.random() - 0.5) * 1.35;
      } else {
        vx = -vx * RESTITUTION;
        vy = vy * 0.94 + (Math.random() - 0.5) * 1.35;
      }
    };

    const makeBorderLine = (
      prefix: string,
      label: string,
      suffix: string,
      totalChars: number,
      fill: string,
    ) => {
      const inner = Math.max(0, totalChars - prefix.length - suffix.length);
      if (label.length >= inner) return prefix + label.slice(0, inner) + suffix;
      const rem = inner - label.length;
      const l = Math.floor(rem / 2);
      const r = rem - l;
      return prefix + fill.repeat(l) + label + fill.repeat(r) + suffix;
    };

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const tick = (t: number) => {
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const hw = curW * 0.5;
      const hh = curH * 0.5;

      // 渲染碰撞与吸附像素粒子
      if (ctx) {
        ctx.clearRect(0, 0, vw, vh);
        for (let i = bursts.length - 1; i >= 0; i--) {
          const b = bursts[i];
          b.x += b.vx;
          b.y += b.vy;
          b.vx *= 0.94;
          b.vy *= 0.94;
          b.life -= b.decay;
          if (b.life <= 0) {
            bursts.splice(i, 1);
            continue;
          }
          ctx.fillStyle = b.accent ? accentColor : mutedColor;
          ctx.globalAlpha = Math.ceil(b.life * 4) / 4;
          ctx.fillRect(Math.round(b.x / 2) * 2, Math.round(b.y / 2) * 2, b.size, b.size);
        }
        ctx.globalAlpha = 1;
      }

      let pullingEdge: 'top' | 'bottom' | 'left' | 'right' | null = null;
      let pullStrength = 0;

      if (state === 'free' && !reducedMotion) {
        const speed = Math.hypot(vx, vy);
        const nw = nearestWall(x, y, hw, hh, vw, vh);
        const canMagnet = t > magnetImmunityUntil;

        if (speed > CAPTURE_SPEED) {
          vx *= AIR_DRAG;
          vy *= AIR_DRAG;
        } else if (canMagnet && nw.dist < MAGNET_ZONE) {
          pullingEdge = nw.edge;
          pullStrength = 1 - Math.max(0, nw.dist) / MAGNET_ZONE;
          const accel = 0.16 + pullStrength * 0.48;
          if (nw.edge === 'top') {
            vy -= accel;
            vx *= 0.9;
          } else if (nw.edge === 'bottom') {
            vy += accel;
            vx *= 0.9;
          } else if (nw.edge === 'left') {
            vx -= accel;
            vy *= 0.9;
          } else if (nw.edge === 'right') {
            vx += accel;
            vy *= 0.9;
          }
          if (nw.dist <= 5) lockDock(nw.edge, vw, vh);
        } else {
          vx += Math.sin(t * 0.00055) * 0.011;
          vy += Math.cos(t * 0.00072) * 0.011;

          // 光标靠近时静默缓停，轻松点击不追逐
          if (Math.hypot(cursorX - x, cursorY - y) < 82) {
            vx *= 0.82;
            vy *= 0.82;
          } else if (speed > CRUISE_SPEED * 1.25) {
            vx *= AIR_DRAG;
            vy *= AIR_DRAG;
          } else if (speed < CRUISE_SPEED * 0.8) {
            vx = speed < 0.05 ? 0.68 : vx * 1.04;
            vy = speed < 0.05 ? 0.5 : vy * 1.04;
          }
        }

        if (state === 'free') {
          x += vx;
          y += vy;
          const postSpeed = Math.hypot(vx, vy);

          if (x - hw <= 3) {
            if (postSpeed > CAPTURE_SPEED || !canMagnet) {
              x = hw + 3;
              vx = Math.abs(vx);
              deflect(false);
              vx = Math.abs(vx);
              spawnBurst(4, y, 1, 0, 12, Math.min(2.2, postSpeed / 6));
              impactUntil = t + 150;
            } else {
              lockDock('left', vw, vh);
            }
          } else if (x + hw >= vw - 3) {
            if (postSpeed > CAPTURE_SPEED || !canMagnet) {
              x = vw - hw - 3;
              vx = -Math.abs(vx);
              deflect(false);
              vx = -Math.abs(vx);
              spawnBurst(vw - 4, y, -1, 0, 12, Math.min(2.2, postSpeed / 6));
              impactUntil = t + 150;
            } else {
              lockDock('right', vw, vh);
            }
          }

          if (state === 'free') {
            if (y - hh <= 3) {
              if (postSpeed > CAPTURE_SPEED || !canMagnet) {
                y = hh + 3;
                vy = Math.abs(vy);
                deflect(true);
                vy = Math.abs(vy);
                spawnBurst(x, 4, 0, 1, 12, Math.min(2.2, postSpeed / 6));
                impactUntil = t + 150;
              } else {
                lockDock('top', vw, vh);
              }
            } else if (y + hh >= vh - 3) {
              if (postSpeed > CAPTURE_SPEED || !canMagnet) {
                y = vh - hh - 3;
                vy = -Math.abs(vy);
                deflect(true);
                vy = -Math.abs(vy);
                spawnBurst(x, vh - 4, 0, -1, 12, Math.min(2.2, postSpeed / 6));
                impactUntil = t + 150;
              } else {
                lockDock('bottom', vw, vh);
              }
            }
          }
        }

        updateRuler(pullingEdge, pullStrength, x, y, vw, vh);
      } else if (state !== 'dragging') {
        updateRuler(null, 0, x, y, vw, vh);
        if (state === 'top') {
          x += (Math.max(hw + 8, Math.min(vw - hw - 8, x)) - x) * 0.22;
          y += (hh + 2 - y) * 0.25;
        } else if (state === 'bottom') {
          x += (Math.max(hw + 8, Math.min(vw - hw - 8, x)) - x) * 0.22;
          y += (vh - hh - 2 - y) * 0.25;
        } else if (state === 'left') {
          x += (hw + 2 - x) * 0.25;
          y += (Math.max(hh + 8, Math.min(vh - hh - 8, y)) - y) * 0.22;
        } else if (state === 'right') {
          x += (vw - hw - 2 - x) * 0.25;
          y += (Math.max(hh + 8, Math.min(vh - hh - 8, y)) - y) * 0.22;
        }
      }

      // 弹簧阻尼插值形态（宽高 + 缩小版毛玻璃缩进 + 按钮坐标 + ASCII 框线字符）
      let targetKey: 'block' | 'bar' | 'rail' = 'block';
      const activeEdge =
        state === 'top' || state === 'bottom' || state === 'left' || state === 'right'
          ? state
          : pullStrength > 0.35
            ? pullingEdge
            : null;

      if (state === 'dragging') {
        const nw = nearestWall(x, y, hw, hh, vw, vh);
        if (nw.dist < MAGNET_ZONE * 0.65 && Math.hypot(vx, vy) <= CAPTURE_SPEED) {
          targetKey = nw.edge === 'top' || nw.edge === 'bottom' ? 'bar' : 'rail';
        }
      } else if (activeEdge === 'top' || activeEdge === 'bottom') {
        targetKey = 'bar';
      } else if (activeEdge === 'left' || activeEdge === 'right') {
        targetKey = 'rail';
      }

      const target = SHAPES[targetKey];
      velW = (velW + (target.w - curW) * 0.18) * 0.72;
      velH = (velH + (target.h - curH) * 0.18) * 0.72;
      curW += velW;
      curH += velH;
      nav.style.width = `${curW.toFixed(1)}px`;
      nav.style.height = `${curH.toFixed(1)}px`;

      curInset.l += (target.inset.l - curInset.l) * 0.22;
      curInset.r += (target.inset.r - curInset.r) * 0.22;
      curInset.t += (target.inset.t - curInset.t) * 0.22;
      curInset.b += (target.inset.b - curInset.b) * 0.22;
      innerFrost.style.left = `${curInset.l.toFixed(1)}px`;
      innerFrost.style.right = `${curInset.r.toFixed(1)}px`;
      innerFrost.style.top = `${curInset.t.toFixed(1)}px`;
      innerFrost.style.bottom = `${curInset.b.toFixed(1)}px`;

      target.coords.forEach(([tx, ty], i) => {
        const sp = itemSpring[i];
        sp.vx = (sp.vx + (tx - sp.x) * 0.2) * 0.74;
        sp.vy = (sp.vy + (ty - sp.y) * 0.2) * 0.74;
        sp.x += sp.vx;
        sp.y += sp.vy;
        if (links[i]) {
          links[i].style.transform = `translate3d(calc(-50% + ${Math.round(sp.x)}px), calc(-50% + ${Math.round(sp.y)}px), 0)`;
        }
      });

      const wantBar = targetKey === 'bar' ? 1 : 0;
      barAlpha += (wantBar - barAlpha) * 0.22;
      const boxAlpha = 1 - barAlpha;

      frameTop.style.opacity = boxAlpha.toFixed(2);
      frameBot.style.opacity = boxAlpha.toFixed(2);
      pipesLeft.style.opacity = boxAlpha.toFixed(2);
      pipesRight.style.opacity = boxAlpha.toFixed(2);
      capLeft.style.opacity = barAlpha.toFixed(2);
      capRight.style.opacity = barAlpha.toFixed(2);

      const isImpact = t < impactUntil;
      const dispSpeed = Math.hypot(vx, vy);
      const charCount = Math.max(8, Math.round((curW - 6) / 6.65));

      if (boxAlpha > 0.04) {
        if (isImpact) {
          frameTop.textContent = makeBorderLine('╔', '[!BOUNCE!]', '╗', charCount, '═');
          frameBot.textContent = makeBorderLine('╚', '', '╝', charCount, '═');
        } else if (targetKey === 'rail') {
          frameTop.textContent = makeBorderLine('╔', '[::]', '╗', charCount, '═');
          frameBot.textContent = makeBorderLine('╚', '', '╝', charCount, '═');
        } else {
          const vLabel = dispSpeed > CAPTURE_SPEED ? `[v${dispSpeed.toFixed(1)}]` : `[::0G v${dispSpeed.toFixed(1)}]`;
          const cLabel = `[${Math.round(x)},${Math.round(y)}]`;
          frameTop.textContent = makeBorderLine('┌', vLabel, '┐', charCount, '─');
          frameBot.textContent = makeBorderLine('└', cLabel, '┘', charCount, '─');
        }

        const glyph = isImpact || targetKey === 'rail' ? '║' : '│';
        const rows = Math.max(3, Math.round((curH - 22) / 14));
        const key = `${glyph}${rows}`;
        if (pipesLeft.dataset.key !== key) {
          const html = Array(rows).fill(`<span>${glyph}</span>`).join('');
          pipesLeft.innerHTML = html;
          pipesRight.innerHTML = html;
          pipesLeft.dataset.key = key;
        }
      }

      nav.style.transform = `translate3d(${Math.round(x - curW * 0.5)}px, ${Math.round(y - curH * 0.5)}px, 0)`;
      requestAnimationFrame(tick);
    };

    requestAnimationFrame(tick);
  }
</script>
