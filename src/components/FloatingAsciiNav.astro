         已跃迁至 <strong>《银河帝国 · 基地》</strong> 典藏羊皮卷世界。</pre>`,
        );
        return true;
      }

      if (cmd === 'matrix' || cmd === 'neo' || cmd === 'zion') {
        applyRealm('crt');
        showTerminalText(
          'CONSTRUCT :: NEBUCHADNEZZAR',
          `<pre class="hud-term-pre"><span style="color:var(--accent)">  ▛▀▓▀▜</span>  "Wake up, Sisyphus... Do not try to bend the boulder. Realize there is only the climb."
         已跃迁至 <strong>《黑客帝国》</strong> 荧光母体世界。</pre>`,
        );
        return true;
      }

      if (cmd === 'dune' || cmd === 'litany' || cmd === 'spice' || cmd === 'arrakis') {
        applyRealm('amber');
        showTerminalText(
          'ARRAKIS :: LITANY AGAINST FEAR',
          `<pre class="hud-term-pre"><span style="color:#38bdf8">  ◐ ◈ ∷</span>  "我绝不恐惧。恐惧是思维的杀手……当恐惧掠过，唯余我与山坡上的巨石长存。"
         已跃迁至 <strong>《沙丘 · 厄拉科斯》</strong> 香料星轨世界。</pre>`,
        );
        return true;
      }

      if (cmd === 'ls' || cmd === 'll' || cmd === 'posts') {
        if (arg === 'tags') {
          const tagHtml = tagsData
            .map((t) => `<a href="${t.url}" class="tag-chip" style="margin:2px">#${t.name} [${t.count}]</a>`)
            .join('');
          showTerminalText('LS ./TAGS', `<div style="display:flex;flex-wrap:wrap;gap:4px;">${tagHtml}</div>`);
          return true;
        }
        const rows = postsData
          .map(
            (p) =>
              `<a href="${p.url}" class="hud-search-item"><div class="hud-search-item-title"><span>[${String(p.idx).padStart(2, '0')}] ${p.title}</span><span style="color:var(--text-muted);font-weight:400">${p.date}</span></div></a>`,
          )
          .join('');
        showTerminalText(`LS -LH ./POSTS (${postsData.length})`, rows);
        return true;
      }

      if (cmd === 'tags') {
        const tagHtml = tagsData
          .map((t) => `<a href="${t.url}" class="tag-chip" style="margin:2px">#${t.name} [${t.count}]</a>`)
          .join('');
        showTerminalText(`TAGS (${tagsData.length})`, `<div style="display:flex;flex-wrap:wrap;gap:4px;">${tagHtml}</div>`);
        return true;
      }

      if (cmd === 'open' || cmd === 'cat') {
        const num = Number(arg);
        if (Number.isInteger(num) && postsData[num - 1]) {
          window.location.href = postsData[num - 1].url;
          return true;
        }
        if (arg === 'about' || arg === 'about.md') {
          window.location.href = `${baseUrl}/about/`;
          return true;
        }
      }

      if (cmd === 'cd') {
        const target = arg.replace(/^\/+|\/+$/g, '');
        if (!target || target === '~' || target === 'home' || target === '~/home') {
          window.location.href = `${baseUrl}/`;
          return true;
        }
        if (target === 'tags') {
          window.location.href = `${baseUrl}/tags/`;
          return true;
        }
        if (target === 'about') {
          window.location.href = `${baseUrl}/about/`;
          return true;
        }
      }

      if (cmd === 'whoami' || cmd === 'camus' || cmd === 'fortune') {
        const quote =
          cmd === 'whoami'
            ? 'Sisyphus (@SleepyChaos) · 正在努力从 vibecoding 的浪潮中寻找属于我的石头。\nStack: Rust · CodeQL (SemFlow Audit) · Astro'
            : CAMUS_QUOTES[Math.floor(Math.random() * CAMUS_QUOTES.length)];
        showTerminalText(`STDOUT :: ${cmd.toUpperCase()}`, `<pre class="hud-term-pre">${quote}</pre>`);
        return true;
      }

      if (cmd === 'neofetch' || cmd === 'fastfetch' || cmd === 'uptime') {
        const spec = REALM_SPECS[curRealm];
        const cycleMs = 8 * 3600 * 1000;
        const pct = (((Date.now() % cycleMs) / cycleMs) * 100).toFixed(1);
        showTerminalText(
          'NEOFETCH :: SISYPHUS@CHAOS',
          `<pre class="hud-term-pre"><span style="color:var(--accent)">    ${spec.corners[0]}${spec.hMain}${spec.soliton}${spec.hMain}${spec.corners[1]}   </span>  <strong>sisyphus@chaos</strong>
<span style="color:var(--accent)">    o_ ╭◈╮  </span>  ──────────────────────────────
<span style="color:var(--accent)">   /|═ ╰▪╯  </span>  <strong>WORLD</strong> : ${spec.desc}
<span style="color:var(--accent)">   / \\╱▒▒░  </span>  <strong>POSTS</strong> : ${postsData.length} published · ${tagsData.length} tags
<span style="color:var(--accent)"> ╱▒▒▒▒▒▒▒░  </span>  <strong>CYCLE</strong> : 8h Boulder Watch (${pct}% of shift)</pre>`,
        );
        return true;
      }

      if (cmd === 'theme' || cmd === 'realm') {
        const aliases: Record<string, RealmId> = {
          void: 'void',
          odyssey: 'void',
          '2001': 'void',
          paper: 'paper',
          empire: 'paper',
          foundation: 'paper',
          crt: 'crt',
          matrix: 'crt',
          amber: 'amber',
          dune: 'amber',
        };
        const mapped = aliases[arg.toLowerCase()];
        const next = mapped ? (applyRealm(mapped), mapped) : cycleRealm();
        showTerminalText(
          'WORLD JUMP COMPLETE',
          `<pre class="hud-term-pre">→ Active Sci-Fi World: <strong style="color:var(--accent)">${REALM_SPECS[next].desc}</strong></pre>`,
        );
        return true;
      }

      if (cmd === 'push' || cmd === 'boost') {
        window.dispatchEvent(new CustomEvent('sisyphus:boulder-boost', { detail: { amount: 0.06 } }));
        showTerminalText('BOULDER BOOST', `<pre class="hud-term-pre">▲ 已向山坡上的西西弗斯注入 +53m 推石冲量！</pre>`);
        return true;
      }

      if (cmd === 'summit' || cmd === 'roll') {
        window.dispatchEvent(new CustomEvent('sisyphus:trigger-summit'));
        showTerminalText('SUMMIT SEQUENCE', `<pre class="hud-term-pre">▲ 已触发冲顶 → 巨石崩落 → 从容下山完整轮回演出！</pre>`);
        return true;
      }

      if (cmd === 'eject' || cmd === 'launch') {
        cliInput.value = '';
        launchBallistic();
        return true;
      }

      if (cmd === 'clear' || cmd === 'cls' || cmd === 'exit') {
        cliInput.value = '';
        cliInput.blur();
        closeOverlay();
        return true;
      }

      return false;
    };

    const renderLiveSearch = () => {
      const q = cliInput.value.trim();
      if (!q) {
        isCommandOutputMode = false;
        matchedPosts = postsData.slice(0, 5);
        selectedIdx = 0;
        const rows = matchedPosts
          .map(
            (p, idx) =>
              `<a href="${p.url}" class="hud-search-item${idx === 0 ? ' is-selected' : ''}"><div class="hud-search-item-title"><span>${idx === matchedPosts.length - 1 ? '└─' : '├─'} ${p.title}</span><span style="color:var(--text-muted);font-weight:400">${p.date}</span></div></a>`,
          )
          .join('');
        termOverlay.innerHTML = `<div class="hud-search-head"><span>输入关键词检索文章，或运行 help / hal / seldon / matrix / dune / push</span><span>[ESC]</span></div>${rows}`;
        overlayOpen = true;
        termOverlay.classList.add('is-open');
        positionOverlay();
        return;
      }

      const ql = q.toLowerCase();
      const tokens = ql.split(/\s+/).filter(Boolean);
      matchedPosts = postsData
        .map((item) => {
          const titleL = item.title.toLowerCase();
          const tagsL = item.tags.join(' ').toLowerCase();
          const descL = item.desc.toLowerCase();
          const bodyL = item.body.toLowerCase();
          let score = 0;
          for (const tk of tokens) {
            let hit = 0;
            if (titleL.includes(tk)) hit += 10;
            if (tagsL.includes(tk)) hit += 7;
            if (descL.includes(tk)) hit += 4;
            if (bodyL.includes(tk)) hit += 2;
            if (hit === 0) return { item, score: 0 };
            score += hit;
          }
          return { item, score };
        })
        .filter((r) => r.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 7)
        .map((r) => r.item);

      isCommandOutputMode = false;
      if (selectedIdx >= matchedPosts.length) selectedIdx = 0;

      const isKnownCmd = [
        'help',
        '?',
        'ls',
        'll',
        'posts',
        'tags',
        'open',
        'cat',
        'cd',
        'whoami',
        'camus',
        'fortune',
        'neofetch',
        'fastfetch',
        'uptime',
        'theme',
        'realm',
        'push',
        'boost',
        'summit',
        'roll',
        'eject',
        'launch',
        'clear',
        'hal',
        'odyssey',
        '2001',
        'seldon',
        'foundation',
        'empire',
        'matrix',
        'neo',
        'zion',
        'dune',
        'litany',
        'spice',
        'arrakis',
      ].includes(tokens[0]);

      const cmdBanner = isKnownCmd
        ? `<div style="padding:5px 8px;margin-bottom:5px;background:var(--accent-soft);color:var(--accent);border-left:2px solid var(--accent);">⚡ 按 Enter 执行舰载命令: <strong>$ ${q}</strong></div>`
        : '';

      const rows =
        matchedPosts.length === 0
          ? `<div style="padding:6px;color:var(--text-muted);">${isKnownCmd ? '直接回车运行该终端指令。' : '未匹配到文章，试试输入 help 查看科幻彩蛋与命令。'}</div>`
          : matchedPosts
              .map((p, idx) => {
                const tagStr = p.tags.slice(0, 3).map((t) => `#${t}`).join(' ');
                return `<a href="${p.url}" class="hud-search-item${idx === selectedIdx && !isKnownCmd ? ' is-selected' : ''}">
                  <div class="hud-search-item-title">
                    <span>${idx === matchedPosts.length - 1 ? '└─' : '├─'} ${p.title}</span>
                    <span style="color:var(--text-muted);font-weight:400;flex-shrink:0">${p.date}</span>
                  </div>
                  <div class="hud-search-item-sub">${tagStr ? `[${tagStr}] ` : ''}${p.desc}</div>
                </a>`;
              })
              .join('');

      termOverlay.innerHTML = `<div class="hud-search-head"><span>$ grep -i "${q}" (${matchedPosts.length})</span><span>[Enter 执行]</span></div>${cmdBanner}${rows}`;
      overlayOpen = true;
      termOverlay.classList.add('is-open');
      positionOverlay();
    };

    cliInput.addEventListener('focus', () => {
      cliFocused = true;
      renderLiveSearch();
    });
    cliInput.addEventListener('blur', () => {
      cliFocused = false;
    });
    cliInput.addEventListener('input', () => {
      selectedIdx = 0;
      renderLiveSearch();
    });
    cliInput.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' && !isCommandOutputMode && matchedPosts.length > 0) {
        e.preventDefault();
        selectedIdx = (selectedIdx + 1) % matchedPosts.length;
        renderLiveSearch();
      } else if (e.key === 'ArrowUp' && !isCommandOutputMode && matchedPosts.length > 0) {
        e.preventDefault();
        selectedIdx = (selectedIdx - 1 + matchedPosts.length) % matchedPosts.length;
        renderLiveSearch();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const val = cliInput.value.trim();
        if (executeCliCommand(val)) {
          cliInput.select();
          return;
        }
        if (matchedPosts[selectedIdx]) {
          saveState();
          window.location.href = matchedPosts[selectedIdx].url;
        }
      } else if (e.key === 'Escape') {
        cliInput.value = '';
        cliInput.blur();
        closeOverlay();
      }
    });

    window.addEventListener('keydown', (e) => {
      if (
        e.key === '/' &&
        document.activeElement !== cliInput &&
        !(document.activeElement instanceof HTMLInputElement) &&
        !(document.activeElement instanceof HTMLTextAreaElement)
      ) {
        e.preventDefault();
        if (state === 'free' || state === 'dragging') {
          const vw = window.innerWidth;
          x = preferredTopAnchorX(vw);
          lockDock('top', vw, window.innerHeight, performance.now());
        }
        setTimeout(() => cliInput.focus(), 60);
      }
    });

    document.addEventListener('pointerdown', (e) => {
      const target = e.target as Node | null;
      if (
        overlayOpen &&
        target &&
        !pendantCli.contains(target) &&
        !termOverlay.contains(target)
      ) {
        closeOverlay();
      }
    });

    // ========= 28 节点耦合弹簧-质量惯性环 + 鼠标拨弦 + 科幻脉冲波 =========
    const RING_COUNT = 28;
    interface RingMass {
      ux: number;
      uy: number;
      mass: number;
      dx: number;
      dy: number;
      vx: number;
      vy: number;
    }
    const ring: RingMass[] = Array.from({ length: RING_COUNT }, (_, idx) => {
      const side = Math.floor(idx / 7);
      const frac = (idx % 7) / 7;
      let ux = 0;
      let uy = 0;
      if (side === 0) {
        ux = -1 + frac * 2;
        uy = -1;
      } else if (side === 1) {
        ux = 1;
        uy = -1 + frac * 2;
      } else if (side === 2) {
        ux = 1 - frac * 2;
        uy = 1;
      } else {
        ux = -1;
        uy = 1 - frac * 2;
      }
      const midness = Math.sin(frac * Math.PI);
      return { ux, uy, mass: 0.86 + midness * 0.54, dx: 0, dy: 0, vx: 0, vy: 0 };
    });

    let coreDX = 0;
    let coreDY = 0;
    let coreVX = 0;
    let coreVY = 0;

    const sampleRingDisp = (s: number): [number, number] => {
      const wrapped = ((s % RING_COUNT) + RING_COUNT) % RING_COUNT;
      const i0 = Math.floor(wrapped);
      const i1 = (i0 + 1) % RING_COUNT;
      const f = wrapped - i0;
      return [
        ring[i0].dx * (1 - f) + ring[i1].dx * f,
        ring[i0].dy * (1 - f) + ring[i1].dy * f,
      ];
    };

    const impulseRing = (ix: number, iy: number, radialPush = 0) => {
      for (const m of ring) {
        m.vx += ix * m.mass + m.ux * radialPush;
        m.vy += iy * m.mass + m.uy * radialPush;
      }
      coreVX += ix * 0.45;
      coreVY += iy * 0.45;
    };

    let sprintW = 0;
    let dirUX = -0.8;
    let dirUY = 0.6;
    let impactW = 0;
    let impactNX = 0;
    let impactNY = 1;
    let impactStart = 0;
    let smoothPullW = 0;
    let lastPullEdge: EdgeSide | null = null;
    let smoothDockW = 1;
    let rackDeploy = 1;
    let rackEdge: EdgeSide | null = 'top';

    let curW: number = SHAPES.bar.w;
    let curH: number = SHAPES.bar.h;
    let velW = 0;
    let velH = 0;
    let curInset = { ...SHAPES.bar.inset };
    const itemSpring = SHAPES.bar.coords.map(([ix, iy]) => ({ x: ix, y: iy, vx: 0, vy: 0 }));

    // 计算上下贴边时让“主舱 + 右侧三枚异构挂件”整体水平居中的理想锚点 X
    const preferredTopAnchorX = (vw: number) => {
      if (vw < 720) return vw * 0.5;
      return Math.max(SHAPES.bar.w * 0.5 + 20, vw * 0.5 - 172);
    };

    const saveState = () => {
      if (!initialized || window.innerWidth < 160 || window.innerHeight < 140) return;
      const persistedState = state === 'dragging' ? 'free' : state;
      const isDocked =
        persistedState === 'top' ||
        persistedState === 'bottom' ||
        persistedState === 'left' ||
        persistedState === 'right';
      try {
        sessionStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({
            mode: isDocked ? 'docked' : 'float',
            dockSide: isDocked ? persistedState : 'top',
            state: persistedState,
            ambientOrbit,
            xNorm: Math.max(0.04, Math.min(0.96, x / window.innerWidth)),
            yNorm: Math.max(0.03, Math.min(0.97, y / window.innerHeight)),
            vx,
            vy,
          }),
        );
      } catch {
        // ignore
      }
    };
    window.addEventListener('pagehide', saveState);

    let lastScrollY = window.scrollY;
    window.addEventListener(
      'scroll',
      () => {
        const dy = Math.max(-28, Math.min(28, window.scrollY - lastScrollY));
        lastScrollY = window.scrollY;
        if (Math.abs(dy) > 1) {
          impulseRing(0, -dy * 0.13, 0);
          satellites.forEach((sat, idx) => {
            sat.vy -= dy * (idx === 0 ? 0.08 : 0.13 + idx * 0.035);
            if (state === 'left' || state === 'right') {
              sat.vx += (idx % 2 === 0 ? 1 : -1) * Math.abs(dy) * 0.05;
            }
          });
        }
      },
      { passive: true },
    );

    const wallVector = (edge: EdgeSide | null): [number, number] => {
      if (edge === 'top') return [0, -1];
      if (edge === 'bottom') return [0, 1];
      if (edge === 'left') return [-1, 0];
      if (edge === 'right') return [1, 0];
      return [0, 0];
    };

    const launchBallistic = () => {
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      if (vw < 160) return;
      closeOverlay();
      cliInput.blur();
      if (state !== 'free' && state !== 'dragging') {
        const [wx, wy] = wallVector(state);
        spawnBurst(x, y, -wx, -wy, 16, 1.4);
      }
      state = 'free';
      ambientOrbit = false;
      syncDocDockAttr();
      if (x < 90 || x > vw - 90) x = vw * 0.5;
      if (y < 70 || y > vh - 70) y = vh * 0.36;
      const ang = (Math.random() * 0.5 + 0.22) * Math.PI * (Math.random() < 0.5 ? 1 : -1);
      const power = 18 + Math.random() * 6;
      vx = Math.cos(ang) * power;
      vy = Math.sin(ang) * power;
      impulseRing(-vx * 0.65, -vy * 0.65, 3.0);
      magnetImmunityUntil = performance.now() + 260;
      window.dispatchEvent(new CustomEvent('sisyphus:boulder-boost', { detail: { amount: 0.045 } }));
      saveState();
    };

    pendantEject.addEventListener('click', launchBallistic);
    pendantRealm.addEventListener('click', () => {
      cycleRealm();
      satellites[2].vy -= 3.8;
      satellites[2].vx += (Math.random() - 0.5) * 3;
      spawnBurst(satellites[2].x, satellites[2].y, 0, -1, 10, 1.0);
    });

    satellites.forEach((sat, sIdx) => {
      sat.el.addEventListener('pointerenter', () => {
        if (sIdx === 0) return;
        sat.vx += (Math.random() - 0.5) * 2.6;
        sat.vy += state === 'top' || state === 'bottom' ? 2.2 : (Math.random() - 0.5) * 2.0;
      });
    });

    let lastCanvasW = 0;
    let lastCanvasH = 0;
    const syncBorderCanvasSize = (w: number, h: number) => {
      const cw = Math.ceil(w + BORDER_PAD * 2);
      const ch = Math.ceil(h + BORDER_PAD * 2);
      if (cw === lastCanvasW && ch === lastCanvasH) return;
      lastCanvasW = cw;
      lastCanvasH = ch;
      const dpr = window.devicePixelRatio || 1;
      borderCanvas.width = cw * dpr;
      borderCanvas.height = ch * dpr;
      borderCanvas.style.width = `${cw}px`;
      borderCanvas.style.height = `${ch}px`;
      borderCanvas.style.left = `${-BORDER_PAD}px`;
      borderCanvas.style.top = `${-BORDER_PAD}px`;
      if (bCtx) {
        bCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
        bCtx.imageSmoothingEnabled = false;
      }
    };

    const dockedAnchorPos = (
      edge: EdgeSide,
      cx: number,
      cy: number,
      hw: number,
      hh: number,
      vw: number,
      vh: number,
    ): [number, number] => {
      if (edge === 'top') {
        return [Math.max(hw + 14, Math.min(vw - hw - 14, cx)), hh + BAR_RACK_GAP];
      }
      if (edge === 'bottom') {
        return [Math.max(hw + 14, Math.min(vw - hw - 14, cx)), vh - hh - BAR_RACK_GAP];
      }
      if (edge === 'left') {
        return [hw + SIDE_RACK_GAP, Math.max(hh + 16, Math.min(vh - hh - 16, cy))];
      }
      return [vw - hw - SIDE_RACK_GAP, Math.max(hh + 16, Math.min(vh - hh - 16, cy))];
    };

    const nearestWall = (
      cx: number,
      cy: number,
      hw: number,
      hh: number,
      vw: number,
      vh: number,
    ) => {
      const list: { edge: EdgeSide; dist: number }[] = [
        { edge: 'top', dist: cy - hh },
        { edge: 'bottom', dist: vh - (cy + hh) },
        { edge: 'left', dist: cx - hw },
        { edge: 'right', dist: vw - (cx + hw) },
      ];
      list.sort((a, b) => a.dist - b.dist);
      return list[0];
    };

    const updateRuler = (
      edge: EdgeSide | null,
      strength: number,
      cx: number,
      cy: number,
      vw: number,
      vh: number,
    ) => {
      if (!edge || strength <= 0.02) {
        ruler.style.opacity = '0';
        return;
      }
      ruler.style.opacity = Math.min(0.95, 0.3 + strength * 0.7).toFixed(2);
      if (edge === 'top' || edge === 'bottom') {
        ruler.classList.remove('is-vert');
        const span = Math.round((130 + strength * 110) / 6) * 6;
        const left = Math.max(8, Math.min(vw - span - 8, Math.round((cx - span * 0.5) / 2) * 2));
        ruler.style.width = `${span}px`;
        ruler.style.height = '3px';
        ruler.style.left = `${left}px`;
        ruler.style.top = edge === 'top' ? '1px' : `${vh - 4}px`;
      } else {
        ruler.classList.add('is-vert');
        const vSpan = Math.round((70 + strength * 60) / 6) * 6;
        const top = Math.max(8, Math.min(vh - vSpan - 8, Math.round((cy - vSpan * 0.5) / 2) * 2));
        ruler.style.width = '3px';
        ruler.style.height = `${vSpan}px`;
        ruler.style.top = `${top}px`;
        ruler.style.left = edge === 'left' ? '1px' : `${vw - 4}px`;
      }
    };

    const triggerImpact = (nx: number, ny: number, speed: number, now: number) => {
      impactNX = nx;
      impactNY = ny;
      impactW = Math.min(1, Math.max(0.5, speed / 13));
      impactStart = now;
      impulseRing(nx * Math.min(9, speed * 0.55), ny * Math.min(9, speed * 0.55), 3.2);
      window.dispatchEvent(new CustomEvent('sisyphus:boulder-boost', { detail: { amount: 0.015 } }));
    };

    const lockDock = (edge: EdgeSide, vw: number, vh: number, now: number) => {
      if (state === edge) return;
      state = edge;
      ambientOrbit = false;
      vx = 0;
      vy = 0;
      rackEdge = edge;
      lastPullEdge = edge;
      syncDocDockAttr();

      if (edge === 'top' || edge === 'bottom') {
        velW += 7.5;
        velH -= 3.5;
        if (vw >= 720 && x > vw - 390) {
          x = Math.max(SHAPES.bar.w * 0.5 + 24, vw - 405);
        } else {
          x = Math.max(SHAPES.bar.w * 0.5 + 14, Math.min(vw - SHAPES.bar.w * 0.5 - 14, x));
        }
        rackVelY = edge === 'top' ? 2.8 : -2.8;
        impulseRing(0, edge === 'top' ? 3.8 : -3.8, 1.8);
      } else {
        velW -= 4;
        velH += 7.5;
        if (vh > 520 && y > vh - 260) {
          y = Math.max(SHAPES.rail.h * 0.5 + 24, vh - 270);
        } else {
          y = Math.max(SHAPES.rail.h * 0.5 + 16, Math.min(vh - SHAPES.rail.h * 0.5 - 16, y));
        }
        rackVelY = 3.8;
        rackVelX = edge === 'left' ? 2.2 : -2.2;
        impulseRing(edge === 'left' ? 3.2 : -3.2, 4.2, 1.6);
      }

      satellites.forEach((sat, idx) => {
        sat.x = x;
        sat.y = y;
        sat.vx = (edge === 'top' || edge === 'bottom' ? 1 : 0) * (2.4 + idx * 1.1);
        sat.vy = (edge === 'left' || edge === 'right' ? 1 : 0.6) * (2.6 + idx * 1.1);
      });

      void now;
      saveState();
    };

    window.addEventListener('sisyphus:hud-kick', launchBallistic);

    window.addEventListener('sisyphus:hud-toggle-dock', () => {
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      if (vw < 160) return;
      const now = performance.now();
      closeOverlay();
      if (state === 'free') {
        x = preferredTopAnchorX(vw);
        lockDock('top', vw, vh, now);
      } else {
        state = 'free';
        ambientOrbit = true;
        syncDocDockAttr();
        const dx = vw * 0.72 - x;
        const dy = Math.min(240, vh * 0.36) - y;
        const d = Math.max(1, Math.hypot(dx, dy));
        vx = (dx / d) * 4.8;
        vy = (dy / d) * 4.8;
        impulseRing(-vx * 0.8, -vy * 0.8, 3.0);
        magnetImmunityUntil = now + 750;
        saveState();
      }
    });

    let pointerId: number | null = null;
    let startPX = 0;
    let startPY = 0;
    let grabOffsetX = 0;
    let grabOffsetY = 0;
    let grabbedFromDock: EdgeSide | null = null;
    let dockBaseX = 0;
    let dockBaseY = 0;
    let moved = false;
    let suppressClickUntil = 0;
    let samples: { x: number; y: number; t: number }[] = [];
    let cursorX = -9999;
    let cursorY = -9999;
    let prevCursorX = -9999;
    let prevCursorY = -9999;
    let dragAccumDist = 0;

    nav.addEventListener('pointerdown', (e) => {
      pointerId = e.pointerId;
      startPX = e.clientX;
      startPY = e.clientY;
      grabOffsetX = e.clientX - x;
      grabOffsetY = e.clientY - y;
      moved = false;
      dragAccumDist = 0;
      const isDocked =
        state === 'top' || state === 'bottom' || state === 'left' || state === 'right';
      grabbedFromDock = isDocked ? state : null;
      dockBaseX = x;
      dockBaseY = y;
      samples = [{ x: e.clientX, y: e.clientY, t: performance.now() }];
    });

    window.addEventListener('pointermove', (e) => {
      const cvx = prevCursorX < -9000 ? 0 : e.clientX - prevCursorX;
      const cvy = prevCursorY < -9000 ? 0 : e.clientY - prevCursorY;
      prevCursorX = cursorX;
      prevCursorY = cursorY;
      cursorX = e.clientX;
      cursorY = e.clientY;

      const isDockedNow =
        state === 'top' || state === 'bottom' || state === 'left' || state === 'right';
      if (isDockedNow && pointerId === null && Math.hypot(cvx, cvy) > 1.2) {
        const relX = cursorX - x;
        const relY = cursorY - y;
        if (Math.abs(relX) < curW * 0.5 + 32 && Math.abs(relY) < curH * 0.5 + 32) {
          for (const m of ring) {
            const mx = m.ux * (curW * 0.5 - 5);
            const my = m.uy * (curH * 0.5 - 5);
            const d = Math.hypot(relX - mx, relY - my);
            if (d < 34) {
              const pluck = (1 - d / 34) * 0.34;
              m.vx += cvx * pluck + m.ux * 1.15 * pluck;
              m.vy += cvy * pluck + m.uy * 1.15 * pluck;
            }
          }
        }
      }

      if (e.pointerId !== pointerId) return;
      const now = performance.now();
      if (!moved && Math.hypot(e.clientX - startPX, e.clientY - startPY) > 4) {
        moved = true;
        ambientOrbit = false;
        closeOverlay();
        cliInput.blur();
        nav.setPointerCapture(e.pointerId);
        if (!grabbedFromDock) {
          state = 'dragging';
          syncDocDockAttr();
        }
      }
      if (!moved) return;

      dragAccumDist += Math.hypot(cvx, cvy);
      if (dragAccumDist > 110) {
        dragAccumDist = 0;
        window.dispatchEvent(new CustomEvent('sisyphus:boulder-boost', { detail: { amount: 0.012 } }));
      }

      samples.push({ x: e.clientX, y: e.clientY, t: now });
      while (samples.length > 6 && now - samples[0].t > 80) samples.shift();

      const first = samples[0];
      const dt = Math.max(10, now - first.t);
      vx = ((e.clientX - first.x) / dt) * 16.5;
      vy = ((e.clientY - first.y) / dt) * 16.5;

      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const hw = curW * 0.5;
      const hh = curH * 0.5;

      const rawTargetX = e.clientX - grabOffsetX;
      const rawTargetY = e.clientY - grabOffsetY;

      if (grabbedFromDock) {
        const pullDX = rawTargetX - dockBaseX;
        const pullDY = rawTargetY - dockBaseY;
        const outwardPull =
          grabbedFromDock === 'left'
            ? pullDX
            : grabbedFromDock === 'right'
              ? -pullDX
              : grabbedFromDock === 'top'
                ? pullDY
                : -pullDY;

        if (outwardPull < UNHOOK_PULL_DIST) {
          if (grabbedFromDock === 'left' || grabbedFromDock === 'right') {
            x = dockBaseX + pullDX * 0.42;
            y = Math.max(hh + 16, Math.min(vh - hh - 16, rawTargetY));
            dockBaseY = y;
          } else {
            x = Math.max(hw + 14, Math.min(vw - hw - 14, rawTargetX));
            y = dockBaseY + pullDY * 0.42;
            dockBaseX = x;
          }
          return;
        } else {
          const [wx, wy] = wallVector(grabbedFromDock);
          const pinX =
            grabbedFromDock === 'left'
              ? 8
              : grabbedFromDock === 'right'
                ? vw - 8
                : x;
          const pinY =
            grabbedFromDock === 'top'
              ? 8
              : grabbedFromDock === 'bottom'
                ? vh - 8
                : y;
          spawnBurst(pinX, pinY, -wx, -wy, 10, 1.15);
          impulseRing(wx * 8.5, wy * 8.5, 4.0);
          grabbedFromDock = null;
          state = 'dragging';
          syncDocDockAttr();
        }
      }

      x = Math.max(hw + 4, Math.min(vw - hw - 4, rawTargetX));
      y = Math.max(hh + 4, Math.min(vh - hh - 4, rawTargetY));

      const dragSpeed = Math.hypot(vx, vy);
      const nw = nearestWall(x, y, hw, hh, vw, vh);
      const preSnap = nw.dist < MAGNET_ZONE * 0.8 && dragSpeed <= CAPTURE_SPEED;
      updateRuler(preSnap ? nw.edge : null, preSnap ? 1 - nw.dist / MAGNET_ZONE : 0, x, y, vw, vh);
    });

    const endDrag = (e: PointerEvent) => {
      if (e.pointerId !== pointerId) return;
      const wasMoved = moved;
      pointerId = null;
      moved = false;
      if (!wasMoved) {
        grabbedFromDock = null;
        return;
      }

      const now = performance.now();
      suppressClickUntil = now + 180;

      if (grabbedFromDock) {
        rackVelX = (dockBaseX - x) * 0.45;
        rackVelY = 2.4;
        impulseRing((dockBaseX - x) * 0.5, 2.5, 1.2);
        grabbedFromDock = null;
        saveState();
        return;
      }

      const last = samples[samples.length - 1];
      if (now - last.t > 90) {
        vx = 0;
        vy = 0;
      } else if (samples.length >= 2) {
        const first = samples[0];
        const dt = Math.max(12, last.t - first.t);
        vx = Math.max(-26, Math.min(26, ((last.x - first.x) / dt) * 18.5));
        vy = Math.max(-26, Math.min(26, ((last.y - first.y) / dt) * 18.5));
      }

      const speed = Math.hypot(vx, vy);
      if (speed > 4) {
        window.dispatchEvent(new CustomEvent('sisyphus:boulder-boost', { detail: { amount: 0.03 } }));
      }
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const hw = curW * 0.5;
      const hh = curH * 0.5;
      const nw = nearestWall(x, y, hw, hh, vw, vh);

      if (nw.dist < MAGNET_ZONE * 0.8 && speed <= CAPTURE_SPEED) {
        lockDock(nw.edge, vw, vh, now);
      } else {
        state = 'free';
        syncDocDockAttr();
        if (speed < 0.5) {
          ambientOrbit = nw.dist >= MAGNET_ZONE;
          const ang = Math.random() * Math.PI * 2;
          vx = Math.cos(ang) * CRUISE_SPEED;
          vy = Math.sin(ang) * CRUISE_SPEED;
        } else {
          ambientOrbit = false;
        }
        saveState();
      }
    };

    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);

    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        if (moved || performance.now() < suppressClickUntil) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }
        saveState();
      });
    });

    const deflect = (horizWall: boolean) => {
      if (horizWall) {
        vy = -vy * RESTITUTION;
        vx = vx * 0.94 + (Math.random() - 0.5) * 1.35;
      } else {
        vx = -vx * RESTITUTION;
        vy = vy * 0.94 + (Math.random() - 0.5) * 1.35;
      }
    };

    const drawPixelLine = (
      ctx: CanvasRenderingContext2D,
      x0: number,
      y0: number,
      x1: number,
      y1: number,
      step = 2,
    ) => {
      const dist = Math.hypot(x1 - x0, y1 - y0);
      const steps = Math.max(1, Math.round(dist / step));
      for (let i = 0; i <= steps; i++) {
        const u = i / steps;
        const px = Math.round((x0 + (x1 - x0) * u) / 2) * 2;
        const py = Math.round((y0 + (y1 - y0) * u) / 2) * 2;
        ctx.fillRect(px, py, 2, 2);
      }
    };

    // ========= 异构独立挂件编排：上下贴边为“第一排主舱+三枚异构挂牌，第二排悬挂宽幅顶栏式搜索终端”！ =========
    const stepAndDrawSatelliteChain = (t: number, vw: number, vh: number, isDocked: boolean) => {
      const isSide = state === 'left' || state === 'right';
      const cliSat = satellites[0];
      const actionSats = [satellites[1], satellites[2], satellites[3]];

      actionSats.forEach((s) => {
        s.w = s.el.offsetWidth || 84;
        s.h = s.el.offsetHeight || 28;
      });

      if (!isDocked) {
        for (const sat of satellites) {
          sat.x += (x - sat.x) * 0.25;
          sat.y += (y - sat.y) * 0.25;
          sat.alpha *= 0.78;
          if (sat.alpha < 0.03) {
            sat.alpha = 0;
            sat.el.classList.remove('is-deployed');
          }
          sat.el.style.opacity = sat.alpha.toFixed(2);
          sat.el.style.transform = `translate3d(${Math.round(sat.x - sat.w * 0.5)}px, ${Math.round(sat.y - sat.h * 0.5)}px, 0)`;
        }
        return;
      }

      if (isSide) {
        // ====== 左右侧边吸附模式：极简细条终端 + 紧凑三挂件纵向垂挂 ======
        const wantCliW =
          cliFocused || cliHovered || cliInput.value.length > 0 ? 192 : SHAPES.rail.w;
        cliSat.w += (wantCliW - cliSat.w) * 0.24;
        cliSat.h = 28;
        pendantCli.style.width = `${Math.round(cliSat.w)}px`;

        const CHAIN_GAP = 11;
        const totalSpan = satellites.reduce((acc, s) => acc + s.h + CHAIN_GAP, 0);
        const dir = y + curH * 0.5 + totalSpan < vh - 12 ? 1 : -1;
        let prevAnchorY = y + dir * (curH * 0.5);

        satellites.forEach((sat, idx) => {
          const extraW = Math.max(0, sat.w - SHAPES.rail.w);
          let tx = state === 'left' ? x + extraW * 0.5 : x - extraW * 0.5;
          const ty = prevAnchorY + dir * (CHAIN_GAP + sat.h * 0.5);
          tx +=
            Math.sin(t * 0.0026 - idx * 0.85) *
            (0.9 + idx * 0.45) *
            (idx === 0 && cliFocused ? 0 : 1);

          const stiff = 0.2 - idx * 0.018;
          sat.vx = (sat.vx + (tx - sat.x) * stiff) * 0.76;
          sat.vy = (sat.vy + (ty - sat.y) * stiff) * 0.76;
          sat.x += sat.vx;
          sat.y += sat.vy;
          sat.alpha += (1 - sat.alpha) * 0.22;

          sat.el.classList.add('is-deployed');
          sat.el.style.opacity = sat.alpha.toFixed(2);
          sat.el.style.transform = `translate3d(${Math.round(sat.x - sat.w * 0.5)}px, ${Math.round(sat.y - sat.h * 0.5)}px, 0)`;

          if (fxCtx && sat.alpha > 0.15) {
            fxCtx.save();
            fxCtx.globalAlpha = sat.alpha * 0.9;
            const linkTopY = dir > 0 ? prevAnchorY : sat.y + sat.h * 0.5;
            const linkBotY = dir > 0 ? sat.y - sat.h * 0.5 : prevAnchorY;
            fxCtx.fillStyle = borderColor;
            drawPixelLine(fxCtx, x - 11, linkTopY + 1, x - 11, linkBotY - 1, 3);
            drawPixelLine(fxCtx, x + 11, linkTopY + 1, x + 11, linkBotY - 1, 3);
            fxCtx.fillStyle = accentColor;
            const midY = Math.round((linkTopY + linkBotY) * 0.5);
            fxCtx.fillRect(Math.round(x - 12), midY - 1, 3, 3);
            fxCtx.fillRect(Math.round(x + 10), midY - 1, 3, 3);
            fxCtx.restore();
          }

          prevAnchorY = sat.y + dir * (sat.h * 0.5);
        });
        return;
      }

      // ====== 上下贴边模式：双层顶栏结构！ ======
      // 第一层（Row 1）：主导航舱 + 横向串联的 3 枚异构器物挂件（弹射扳机、世界卡带、金属狗牌）
      // 第二层（Row 2）：独立悬挂在双吊索下方的宽幅顶栏式搜索/命令终端（[>_] sisyphus@chaos:~$ ...）！
      const H_GAP = 14;
      const actionTotalW = actionSats.reduce((a, s) => a + s.w + H_GAP, 0);
      const rowDir = state === 'top' ? 1 : -1;

      if (vw >= 720) {
        const hDir = x + curW * 0.5 + actionTotalW < vw - 12 ? 1 : -1;
        let prevAnchorX = x + hDir * (curW * 0.5);
        let prevAnchorY = y;

        actionSats.forEach((sat, idx) => {
          const tx = prevAnchorX + hDir * (H_GAP + sat.w * 0.5);
          const ty = y + Math.sin(t * 0.0028 - idx * 0.95) * (1.1 + idx * 0.45);

          const stiff = 0.21 - idx * 0.02;
          sat.vx = (sat.vx + (tx - sat.x) * stiff) * 0.75;
          sat.vy = (sat.vy + (ty - sat.y) * stiff) * 0.75;
          sat.x += sat.vx;
          sat.y += sat.vy;
          sat.alpha += (1 - sat.alpha) * 0.22;

          sat.el.classList.add('is-deployed');
          sat.el.style.opacity = sat.alpha.toFixed(2);
          sat.el.style.transform = `translate3d(${Math.round(sat.x - sat.w * 0.5)}px, ${Math.round(sat.y - sat.h * 0.5)}px, 0)`;

          if (fxCtx && sat.alpha > 0.15) {
            fxCtx.save();
            fxCtx.globalAlpha = sat.alpha * 0.9;
            const linkLX = hDir > 0 ? prevAnchorX : sat.x + sat.w * 0.5;
            const linkRX = hDir > 0 ? sat.x - sat.w * 0.5 : prevAnchorX;
            const midX = Math.round((linkLX + linkRX) * 0.5);
            const midY = Math.round((prevAnchorY + sat.y) * 0.5);
            fxCtx.fillStyle = borderColor;
            drawPixelLine(fxCtx, linkLX + 1, prevAnchorY, linkRX - 1, sat.y, 2);
            fxCtx.fillStyle = idx === 0 ? accent2Color : accentColor;
            fxCtx.fillRect(midX - 2, midY - 2, 4, 4);
            fxCtx.restore();
          }

          prevAnchorX = sat.x + hDir * (sat.w * 0.5);
          prevAnchorY = sat.y;
        });

        // 计算第一层整体左右包络，使第二层搜索终端优雅对齐悬挂于整组顶栏正下方/正上方！
        const leftMost =
          hDir > 0
            ? x - curW * 0.5
            : actionSats[actionSats.length - 1].x - actionSats[actionSats.length - 1].w * 0.5;
        const rightMost =
          hDir > 0
            ? actionSats[actionSats.length - 1].x + actionSats[actionSats.length - 1].w * 0.5
            : x + curW * 0.5;
        const spanW = Math.max(460, Math.min(vw - 28, rightMost - leftMost));
        cliSat.w += (spanW - cliSat.w) * 0.24;
        cliSat.h = 38;
        pendantCli.style.width = `${Math.round(cliSat.w)}px`;

        const centerRow1 = (leftMost + rightMost) * 0.5;
        const cliTargetX = Math.max(
          cliSat.w * 0.5 + 12,
          Math.min(vw - cliSat.w * 0.5 - 12, centerRow1),
        );
        const cliTargetY =
          y +
          rowDir * (curH * 0.5 + 13 + cliSat.h * 0.5) +
          (cliFocused ? 0 : Math.sin(t * 0.0022) * 1.1);

        cliSat.vx = (cliSat.vx + (cliTargetX - cliSat.x) * 0.2) * 0.75;
        cliSat.vy = (cliSat.vy + (cliTargetY - cliSat.y) * 0.2) * 0.75;
        cliSat.x += cliSat.vx;
        cliSat.y += cliSat.vy;
        cliSat.alpha += (1 - cliSat.alpha) * 0.22;

        cliSat.el.classList.add('is-deployed');
        cliSat.el.style.opacity = cliSat.alpha.toFixed(2);
        cliSat.el.style.transform = `translate3d(${Math.round(cliSat.x - cliSat.w * 0.5)}px, ${Math.round(cliSat.y - cliSat.h * 0.5)}px, 0)`;

        // 绘制连接第一排与第二排宽幅搜索终端的双吊臂钢索挂钩！
        if (fxCtx && cliSat.alpha > 0.15) {
          fxCtx.save();
          fxCtx.globalAlpha = cliSat.alpha * 0.92;
          const strutLeftX = Math.round(x - curW * 0.28);
          const strutRightX = Math.round(
            Math.min(cliSat.x + cliSat.w * 0.36, actionSats[1].x),
          );
          const r1EdgeY = y + rowDir * (curH * 0.5 - 2);
          const r2EdgeY = cliSat.y - rowDir * (cliSat.h * 0.5);

          [strutLeftX, strutRightX].forEach((sx) => {
            fxCtx.fillStyle = borderColor;
            drawPixelLine(fxCtx, sx, r1EdgeY, sx, r2EdgeY, 2);
            fxCtx.fillStyle = accentColor;
            fxCtx.fillRect(sx - 2, Math.round(r1EdgeY) - 1, 5, 3);
            fxCtx.fillRect(sx - 2, Math.round(r2EdgeY) - 1, 5, 3);
          });
          fxCtx.restore();
        }
      } else {
        // 移动端窄屏上下贴边：第二排整宽终端搜索栏，第三排紧凑功能挂牌
        const wantW = Math.min(vw - 20, 440);
        cliSat.w += (wantW - cliSat.w) * 0.25;
        cliSat.h = 36;
        pendantCli.style.width = `${Math.round(cliSat.w)}px`;

        const cliTY = y + rowDir * (curH * 0.5 + 10 + cliSat.h * 0.5);
        cliSat.vx = (cliSat.vx + (vw * 0.5 - cliSat.x) * 0.22) * 0.75;
        cliSat.vy = (cliSat.vy + (cliTY - cliSat.y) * 0.22) * 0.75;
        cliSat.x += cliSat.vx;
        cliSat.y += cliSat.vy;
        cliSat.alpha += (1 - cliSat.alpha) * 0.22;
        cliSat.el.classList.add('is-deployed');
        cliSat.el.style.opacity = cliSat.alpha.toFixed(2);
        cliSat.el.style.transform = `translate3d(${Math.round(cliSat.x - cliSat.w * 0.5)}px, ${Math.round(cliSat.y - cliSat.h * 0.5)}px, 0)`;

        const row3Y = cliTY + rowDir * (cliSat.h * 0.5 + 20);
        const subGap = 8;
        const row3W = actionSats.reduce((a, s) => a + s.w, 0) + subGap * 2;
        let curLeft = Math.max(8, (vw - row3W) * 0.5);
        actionSats.forEach((sat) => {
          const tx = curLeft + sat.w * 0.5;
          curLeft += sat.w + subGap;
          sat.vx = (sat.vx + (tx - sat.x) * 0.22) * 0.75;
          sat.vy = (sat.vy + (row3Y - sat.y) * 0.22) * 0.75;
          sat.x += sat.vx;
          sat.y += sat.vy;
          sat.alpha += (1 - sat.alpha) * 0.22;
          sat.el.classList.add('is-deployed');
          sat.el.style.opacity = sat.alpha.toFixed(2);
          sat.el.style.transform = `translate3d(${Math.round(sat.x - sat.w * 0.5)}px, ${Math.round(sat.y - sat.h * 0.5)}px, 0)`;
        });
      }
    };

    const drawWeaponRackMounts = (
      ox: number,
      oy: number,
      rx: number,
      ry: number,
      vw: number,
      vh: number,
      edge: EdgeSide,
      deploy: number,
    ) => {
      if (!bCtx || deploy <= 0.03) return;
      bCtx.save();
      bCtx.font = monoFont;
      bCtx.textAlign = 'center';
      bCtx.textBaseline = 'middle';

      if (edge === 'left' || edge === 'right') {
        const isLeft = edge === 'left';
        const sign = isLeft ? 1 : -1;
        const wallX = isLeft ? ox - x : ox + (vw - x);
        const [midLDX] = sampleRingDisp(isLeft ? 24.5 : 10.5);
        const targetLugX = ox + (isLeft ? -rx : rx) + midLDX * 0.5;
        const span = Math.abs(targetLugX - wallX);
        const reachX = wallX + sign * span * deploy;
        const isStretched = span > SIDE_RACK_GAP + 7;

        const trackTop = oy - ry - 8;
        const trackBot = oy + ry + 8;
        bCtx.fillStyle = borderColor;
        bCtx.globalAlpha = Math.min(1, deploy * 1.1);
        const spineX = isLeft ? Math.round(wallX) : Math.round(wallX - 3);
        bCtx.fillRect(spineX, Math.round(trackTop), 3, Math.round(trackBot - trackTop));

        bCtx.fillStyle = mutedColor;
        for (let ty = trackTop + 6; ty <= trackBot - 6; ty += 8) {
          const toothX = isLeft ? spineX + 3 : spineX - 3;
          bCtx.fillRect(toothX, Math.round(ty), 3, 2);
        }

        bCtx.fillStyle = accentColor;
        const flangeX = isLeft ? spineX : spineX - 2;
        bCtx.fillRect(flangeX, Math.round(trackTop - 2), 5, 4);
        bCtx.fillRect(flangeX, Math.round(trackBot - 2), 5, 4);

        const armOffsets = [-ry * 0.56, ry * 0.56];
        armOffsets.forEach((offY, armIdx) => {
          const sampleIdx = isLeft ? (armIdx === 0 ? 26 : 23) : armIdx === 0 ? 8.5 : 12;
          const [, lugDY] = sampleRingDisp(sampleIdx);
          const wallArmY = Math.round(oy + offY);
          const lugY = Math.round(oy + offY + lugDY * 0.55);
          const jointX = Math.round(wallX + (reachX - wallX) * 0.62);
          const jointY = Math.round(wallArmY + (lugY - wallArmY) * 0.62);

          bCtx.fillStyle = mutedColor;
          bCtx.globalAlpha = 0.75 * deploy;
          drawPixelLine(bCtx, wallX + sign * 3, wallArmY + 14, jointX, jointY + 2, 2);

          bCtx.fillStyle = accentColor;
          bCtx.globalAlpha = 0.94 * deploy;
          drawPixelLine(bCtx, wallX + sign * 2, wallArmY, reachX - sign * 4, lugY, isStretched ? 5 : 2);

          bCtx.fillStyle = accentColor;
          bCtx.globalAlpha = deploy;
          bCtx.fillText(isLeft ? '╠' : '╣', Math.round(wallX + sign * 5), wallArmY);

          const hookX = Math.round(reachX - sign * 2);
          bCtx.fillText(isLeft ? '╚' : '╝', hookX - sign * 3, lugY + 4);
          bCtx.fillText(isLeft ? '╡' : '╞', hookX, lugY);
          bCtx.fillRect(hookX - 1, lugY - 5, 3, 3);
        });
      } else {
        const isTop = edge === 'top';
        const sign = isTop ? 1 : -1;
        const wallY = isTop ? oy - y : oy + (vh - y);
        const [, midDY] = sampleRingDisp(isTop ? 3.5 : 17.5);
        const targetLugY = oy + (isTop ? -ry : ry) + midDY * 0.5;
        const span = Math.abs(targetLugY - wallY);
        const reachY = wallY + sign * span * deploy;
        const isStretched = span > BAR_RACK_GAP + 6;

        const trackL = ox - rx * 0.78;
        const trackR = ox + rx * 0.78;
        bCtx.fillStyle = borderColor;
        bCtx.globalAlpha = deploy;
        const spineY = isTop ? Math.round(wallY) : Math.round(wallY - 3);
        bCtx.fillRect(Math.round(trackL), spineY, Math.round(trackR - trackL), 3);

        const hangerOffsets = [-rx * 0.58, rx * 0.58];
        hangerOffsets.forEach((offX, hIdx) => {
          const [lugDX] = sampleRingDisp(isTop ? (hIdx === 0 ? 1.5 : 5.5) : hIdx === 0 ? 19.5 : 15.5);
          const wallHX = Math.round(ox + offX);
          const lugX = Math.round(ox + offX + lugDX * 0.5);

          bCtx.fillStyle = mutedColor;
          bCtx.globalAlpha = 0.72 * deploy;
          drawPixelLine(
            bCtx,
            wallHX + (hIdx === 0 ? -12 : 12),
            wallY + sign * 2,
            lugX,
            wallY + (reachY - wallY) * 0.68,
            2,
          );

          bCtx.fillStyle = accentColor;
          bCtx.globalAlpha = 0.94 * deploy;
          drawPixelLine(bCtx, wallHX, wallY + sign * 2, lugX, reachY - sign * 2, isStretched ? 4 : 2);
          bCtx.fillText(isTop ? '╦' : '╩', wallHX, Math.round(wallY + sign * 4));
          bCtx.fillText(isTop ? '╩' : '╦', lugX, Math.round(reachY - sign * 1));
        });
      }

      bCtx.restore();
    };

    interface PerimNode {
      bx: number;
      by: number;
      nx: number;
      ny: number;
      tx: number;
      ty: number;
      ringPos: number;
      glyph: string;
      phase: number;
      isCorner: boolean;
      isLabel: boolean;
    }

    const drawDynamicAsciiBorder = (
      t: number,
      w: number,
      h: number,
      vw: number,
      vh: number,
      speed: number,
      dockEdge: EdgeSide | null,
      pullEdge: EdgeSide | null,
    ) => {
      if (!bCtx) return;
      syncBorderCanvasSize(w, h);
      const cw = lastCanvasW;
      const ch = lastCanvasH;
      const ox = cw * 0.5;
      const oy = ch * 0.5;

      bCtx.clearRect(0, 0, cw, ch);

      const rx = w * 0.5 - 5;
      const ry = h * 0.5 - 5;
      const spec = REALM_SPECS[curRealm] || REALM_SPECS.void;

      if (rackEdge && rackDeploy > 0.03) {
        drawWeaponRackMounts(ox, oy, rx, ry, vw, vh, rackEdge, rackDeploy);
      }

      bCtx.font = monoFont;
      bCtx.textAlign = 'center';
      bCtx.textBaseline = 'middle';

      const cols = Math.max(6, Math.round((rx * 2) / 7.2));
      const rows = Math.max(2, Math.round((ry * 2) / 11.5));

      const topLabel =
        impactW > 0.38
          ? '!RICOCHET!'
          : sprintW > 0.35
            ? `>>v${speed.toFixed(1)}<<`
            : smoothPullW > 0.3
              ? `::DOCKING`
              : dockEdge
                ? dockEdge === 'left' || dockEdge === 'right'
                  ? `::${spec.glyph}`
                  : spec.dockTag
                : spec.floatTag;
      const botLabel = dockEdge ? '' : `${Math.round(x)},${Math.round(y)}`;

      const topStartIdx = Math.floor((cols - 1 - topLabel.length) * 0.5) + 1;
      const botStartIdx = Math.floor((cols - 1 - botLabel.length) * 0.5) + 1;

      const nodes: PerimNode[] = [];

      const corners: [number, number, number, number, number, string][] = [
        [-rx, -ry, -0.707, -0.707, 0, spec.corners[0]],
        [rx, -ry, 0.707, -0.707, 7, spec.corners[1]],
        [rx, ry, 0.707, 0.707, 14, spec.corners[2]],
        [-rx, ry, -0.707, 0.707, 21, spec.corners[3]],
      ];
      corners.forEach(([cx, cy, nx, ny, rPos, cGlyph], cIdx) => {
        nodes.push({
          bx: cx,
          by: cy,
          nx,
          ny,
          tx: -ny,
          ty: nx,
          ringPos: rPos,
          glyph: cGlyph,
          phase: cIdx * 0.9,
          isCorner: true,
          isLabel: false,
        });
      });

      const botBaseChar = curRealm === 'crt' ? '▄' : spec.hMain;

      for (let i = 1; i < cols; i++) {
        const u = i / cols;
        const px = -rx + u * (rx * 2);

        const tCharIdx = i - topStartIdx;
        const hasTopChar = tCharIdx >= 0 && tCharIdx < topLabel.length;
        const waveTopGlyph = Math.sin(t * 0.004 + i * 0.8) > 0.78 ? spec.hWave : spec.hMain;
        nodes.push({
          bx: px,
          by: -ry,
          nx: 0,
          ny: -1,
          tx: 1,
          ty: 0,
          ringPos: u * 7,
          glyph: hasTopChar ? topLabel[tCharIdx] : waveTopGlyph,
          phase: i * 0.55,
          isCorner: false,
          isLabel: hasTopChar,
        });

        const bCharIdx = i - botStartIdx;
        const hasBotChar = botLabel.length > 0 && bCharIdx >= 0 && bCharIdx < botLabel.length;
        const waveBotGlyph = Math.sin(t * 0.004 - i * 0.8) > 0.78 ? spec.hWave : botBaseChar;
        nodes.push({
          bx: px,
          by: ry,
          nx: 0,
          ny: 1,
          tx: 1,
          ty: 0,
          ringPos: 21 - u * 7,
          glyph: hasBotChar ? botLabel[bCharIdx] : waveBotGlyph,
          phase: (cols - i) * 0.55 + 2.1,
          isCorner: false,
          isLabel: hasBotChar,
        });
      }

      for (let j = 1; j < rows; j++) {
        const v = j / rows;
        const py = -ry + v * (ry * 2);
        const isMid = Math.abs(v - 0.5) < 0.25;
        const barMode = smoothDockW > 0.5 && (dockEdge === 'top' || dockEdge === 'bottom');
        const leftG = barMode && isMid ? '╠' : spec.vLeft;
        const rightG = barMode && isMid ? '╣' : spec.vRight;

        nodes.push({
          bx: -rx,
          by: py,
          nx: -1,
          ny: 0,
          tx: 0,
          ty: 1,
          ringPos: 28 - v * 7,
          glyph: leftG,
          phase: j * 0.75 + 4.0,
          isCorner: false,
          isLabel: false,
        });
        nodes.push({
          bx: rx,
          by: py,
          nx: 1,
          ny: 0,
          tx: 0,
          ty: 1,
          ringPos: 7 + v * 7,
          glyph: rightG,
          phase: j * 0.75 + 5.6,
          isCorner: false,
          isLabel: false,
        });
      }

      const [dockWX, dockWY] = wallVector(dockEdge);
      const [pullWX, pullWY] = wallVector(pullEdge);
      const impactAge = t - impactStart;
      const shockFront = 1 - (impactAge / 240) * 2.2;
      const solitonPos = ((t * 0.0095) % 36) - 4;

      const satAlpha = (1 - smoothDockW) * (1 - sprintW * 0.7) * 0.65;
      if (satAlpha > 0.04) {
        bCtx.fillStyle = accent2Color;
        bCtx.globalAlpha = satAlpha;
        for (let s = 0; s < 4; s++) {
          const [sdx, sdy] = sampleRingDisp(s * 7 + 3.5);
          const ang = t * 0.0011 * (s % 2 === 0 ? 1 : -1) + s * 1.57;
          const sx = ox + Math.cos(ang) * (rx + 8 + Math.sin(t * 0.003 + s) * 2.5) + sdx * 1.25;
          const sy = oy + Math.sin(ang) * (ry + 7 + Math.cos(t * 0.0026 + s) * 2.5) + sdy * 1.25;
          bCtx.fillText(s % 2 === 0 ? spec.satA : spec.satB, Math.round(sx), Math.round(sy));
        }
      }

      for (let k = 0; k < nodes.length; k++) {
        const nd = nodes[k];
        const [inerDX, inerDY] = sampleRingDisp(nd.ringPos);
        const labelDamp = nd.isLabel ? 0.62 : 1.0;
        let dx = inerDX * labelDamp;
        let dy = inerDY * labelDamp;
        let glyph = nd.glyph;
        let isSolitonHead = false;

        const worldCharX = x + nd.bx;
        const worldCharY = y + nd.by;
        const distCursor = Math.hypot(cursorX - worldCharX, cursorY - worldCharY);
        if (distCursor < 44 && !nd.isLabel) {
          const magnetSpike = (1 - distCursor / 44) * (smoothDockW > 0.5 ? 5.2 : 3.2);
          dx += nd.nx * magnetSpike;
          dy += nd.ny * magnetSpike;
          if (!nd.isCorner && distCursor < 26) {
            glyph = Math.abs(nd.ny) > 0.5 ? (nd.ny < 0 ? '^' : 'v') : nd.nx < 0 ? '‹' : '›';
          }
        }

        if (smoothDockW > 0.5 && !nd.isLabel) {
          const ringDiff = Math.abs(nd.ringPos - solitonPos);
          if (ringDiff < 2.2) {
            const pulse = Math.cos((ringDiff / 2.2) * (Math.PI * 0.5)) * 3.4 * smoothDockW;
            const kissCheck = dockEdge ? nd.nx * dockWX + nd.ny * dockWY : -1;
            if (kissCheck < 0.4) {
              dx += nd.nx * pulse;
              dy += nd.ny * pulse;
              if (!nd.isCorner && ringDiff < 0.9) {
                glyph = spec.soliton;
                isSolitonHead = true;
              }
            }
          }
        }

        const localStrain = Math.hypot(inerDX, inerDY);
        if (localStrain > 5.2 && !nd.isLabel && !nd.isCorner) {
          if (Math.abs(nd.ny) > 0.5) {
            glyph = localStrain > 10 ? '~' : '═';
          } else {
            glyph = localStrain > 10 ? '¦' : '║';
          }
        }

        const kissAlign = dockEdge ? nd.nx * dockWX + nd.ny * dockWY : -1;
        const freeFactor = kissAlign > 0.4 ? 1 - smoothDockW * 0.82 : 1 - smoothDockW * 0.15;
        const floatAmp = (nd.isLabel ? 0.9 : 2.2) * freeFactor;
        const waveN =
          Math.sin(t * 0.0036 + nd.phase) * floatAmp +
          Math.cos(t * 0.0022 - nd.phase * 0.7) * (floatAmp * 0.45);
        const waveT = Math.cos(t * 0.0026 + nd.phase * 0.9) * (1.0 * freeFactor);
        dx += nd.nx * waveN + nd.tx * waveT;
        dy += nd.ny * waveN + nd.ty * waveT;

        if (smoothPullW > 0.04 && pullEdge) {
          const pullAlign = nd.nx * pullWX + nd.ny * pullWY;
          if (pullAlign > 0.35) {
            const reach =
              pullAlign *
              smoothPullW *
              (5.5 + Math.sin(t * 0.018 + nd.phase * 1.4) * 2.0);
            dx += pullWX * reach;
            dy += pullWY * reach;
          }
        }

        if (sprintW > 0.04) {
          const motionAlign = nd.nx * dirUX + nd.ny * dirUY;
          if (motionAlign > 0.2) {
            const bowCompress = motionAlign * sprintW * 3.0;
            dx -= nd.nx * bowCompress;
            dy -= nd.ny * bowCompress;
            if (!nd.isLabel && !nd.isCorner && motionAlign > 0.65 && k % 2 === 0) {
              glyph =
                Math.abs(dirUX) > Math.abs(dirUY)
                  ? dirUX > 0
                    ? '»'
                    : '«'
                  : dirUY > 0
                    ? '▼'
                    : '▲';
            }
          } else if (motionAlign < -0.2) {
            const tailStretch =
              -motionAlign *
              sprintW *
              (7.5 + Math.sin(t * 0.026 + nd.phase * 1.5) * 3.8);
            dx -= dirUX * tailStretch;
            dy -= dirUY * tailStretch;
            if (!nd.isLabel && !nd.isCorner) {
              glyph = Math.sin(t * 0.03 + nd.phase) > 0 ? '~' : '=';
            }

            if (sprintW > 0.22 && k % 2 === 0) {
              const wakeGlyphs = ['-', ':', '·'];
              for (let wIdx = 0; wIdx < wakeGlyphs.length; wIdx++) {
                const dist = tailStretch * (1.45 + wIdx * 0.72);
                const wx = ox + nd.bx + dx - dirUX * dist;
                const wy = oy + nd.by + dy - dirUY * dist;
                bCtx.fillStyle = wIdx === 0 ? accent2Color : mutedColor;
                bCtx.globalAlpha = Math.max(0.14, sprintW * (0.58 - wIdx * 0.16));
                bCtx.fillText(wakeGlyphs[wIdx], Math.round(wx), Math.round(wy));
              }
            }
          }
        }

        if (impactW > 0.03) {
          const hitAlign = -(nd.nx * impactNX + nd.ny * impactNY);
          if (hitAlign > 0.35) {
            const crush = hitAlign * impactW * 5.2;
            dx -= nd.nx * crush;
            dy -= nd.ny * crush;
            if (!nd.isLabel) {
              glyph = impactW > 0.55 ? '█' : '▓';
            }
          } else {
            const osc = Math.cos(impactAge * 0.044 - (1 - hitAlign) * 1.5);
            const bulge = (1 - Math.max(0, hitAlign)) * impactW * osc * 5.8;
            dx += nd.nx * bulge;
            dy += nd.ny * bulge;
          }

          if (Math.abs(hitAlign - shockFront) < 0.34 && !nd.isLabel && hitAlign <= 0.35) {
            glyph = '+';
          }
        }

        // 孤子脉冲头采用科幻世界特征色（如 2001 的 HAL 9000 红眼、沙丘的伊巴德蓝眼！）
        bCtx.fillStyle = isSolitonHead
          ? curRealm === 'void'
            ? fireColor
            : accent2Color
          : accentColor;
        bCtx.globalAlpha = nd.isLabel || isSolitonHead ? 1 : 0.94;
        bCtx.fillText(glyph, Math.round(ox + nd.bx + dx), Math.round(oy + nd.by + dy));
      }

      bCtx.globalAlpha = 1;
    };

    const stepInertialRing = (stepDX: number, stepDY: number, isDocked: boolean) => {
      const torque =
        pointerId !== null
          ? Math.max(-0.22, Math.min(0.22, (grabOffsetX * stepDY - grabOffsetY * stepDX) * 0.0022))
          : 0;

      for (const m of ring) {
        let mountStiff = 1.0;
        if (isDocked && rackEdge) {
          const [wx, wy] = wallVector(rackEdge);
          if (m.ux * wx + m.uy * wy > 0.5) mountStiff = 0.45;
        }
        m.dx -= stepDX * 0.78 * m.mass * mountStiff;
        m.dy -= stepDY * 0.78 * m.mass * mountStiff;
        m.dx += -m.uy * torque * 24 * m.mass;
        m.dy += m.ux * torque * 24 * m.mass;
      }

      const coupleFX = new Float32Array(RING_COUNT);
      const coupleFY = new Float32Array(RING_COUNT);
      for (let i = 0; i < RING_COUNT; i++) {
        const prev = ring[(i - 1 + RING_COUNT) % RING_COUNT];
        const next = ring[(i + 1) % RING_COUNT];
        const cur = ring[i];
        coupleFX[i] = (prev.dx + next.dx - 2 * cur.dx) * 0.18;
        coupleFY[i] = (prev.dy + next.dy - 2 * cur.dy) * 0.18;
      }

      const kSpring = 0.165;
      const damping = 0.83;
      const maxDisp = 26;
      for (let i = 0; i < RING_COUNT; i++) {
        const m = ring[i];
        const invMass = 1 / m.mass;
        m.vx = (m.vx + (-kSpring * m.dx + coupleFX[i]) * invMass) * damping;
        m.vy = (m.vy + (-kSpring * m.dy + coupleFY[i]) * invMass) * damping;
        m.dx += m.vx;
        m.dy += m.vy;

        const mag = Math.hypot(m.dx, m.dy);
        if (mag > maxDisp) {
          const s = maxDisp / mag;
          m.dx *= s;
          m.dy *= s;
          m.vx *= 0.7;
          m.vy *= 0.7;
        }
      }

      coreDX -= stepDX * 0.34;
      coreDY -= stepDY * 0.34;
      coreVX = (coreVX - coreDX * 0.26) * 0.76;
      coreVY = (coreVY - coreDY * 0.26) * 0.76;
      coreDX = Math.max(-10, Math.min(10, coreDX + coreVX));
      coreDY = Math.max(-10, Math.min(10, coreDY + coreVY));
    };

    const tick = (t: number) => {
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      if (vw < 180 || vh < 140) {
        requestAnimationFrame(tick);
        return;
      }

      if (!initialized) {
        initialized = true;
        // 默认以顶部双层挂架形态接管全站顶栏！
        state = 'top';
        ambientOrbit = false;
        x = preferredTopAnchorX(vw);
        y = SHAPES.bar.h * 0.5 + BAR_RACK_GAP;

        try {
          const raw = sessionStorage.getItem(STORAGE_KEY);
          if (raw) {
            const saved = JSON.parse(raw);
            if (
              saved &&
              Number.isFinite(saved.xNorm) &&
              Number.isFinite(saved.yNorm) &&
              saved.xNorm > 0.03 &&
              saved.yNorm > 0.02
            ) {
              state = saved.state || 'top';
              ambientOrbit = Boolean(saved.ambientOrbit);
              x = Math.max(46, Math.min(vw - 46, saved.xNorm * vw));
              y = Math.max(20, Math.min(vh - 20, saved.yNorm * vh));
              vx = Number.isFinite(saved.vx) ? saved.vx : vx;
              vy = Number.isFinite(saved.vy) ? saved.vy : vy;
            }
          }
        } catch {
          // ignore
        }

        syncDocDockAttr();

        const k =
          state === 'top' || state === 'bottom'
            ? 'bar'
            : state === 'left' || state === 'right'
              ? 'rail'
              : 'block';
        curW = SHAPES[k].w;
        curH = SHAPES[k].h;
        curInset = { ...SHAPES[k].inset };
        SHAPES[k].coords.forEach(([ix, iy], idx) => {
          itemSpring[idx].x = ix;
          itemSpring[idx].y = iy;
        });
        satellites.forEach((sat, idx) => {
          sat.x = idx === 0 && state === 'top' ? vw * 0.5 : x + idx * 70;
          sat.y = idx === 0 && state === 'top' ? y + 50 : y;
          sat.alpha = state === 'free' ? 0 : 1;
        });

        if (state !== 'free') {
          rackEdge = state as EdgeSide;
          rackDeploy = 1;
          smoothDockW = 1;
        } else {
          rackEdge = null;
          rackDeploy = 0;
          smoothDockW = 0;
        }
        prevX = x;
        prevY = y;
        nav.style.visibility = 'visible';
      }

      ensureFxCanvas(vw, vh);
      updateAmbientTyper(t);

      const hw = curW * 0.5;
      const hh = curH * 0.5;

      if (fxCtx) {
        fxCtx.clearRect(0, 0, vw, vh);
        for (let i = bursts.length - 1; i >= 0; i--) {
          const b = bursts[i];
          b.x += b.vx;
          b.y += b.vy;
          b.vx *= 0.94;
          b.vy *= 0.94;
          b.life -= b.decay;
          if (b.life <= 0) {
            bursts.splice(i, 1);
            continue;
          }
          fxCtx.fillStyle = b.accent ? accentColor : mutedColor;
          fxCtx.globalAlpha = Math.ceil(b.life * 4) / 4;
          fxCtx.fillRect(Math.round(b.x / 2) * 2, Math.round(b.y / 2) * 2, b.size, b.size);
        }
        fxCtx.globalAlpha = 1;
      }

      let pullingEdge: EdgeSide | null = null;
      let pullStrength = 0;

      if (state === 'free') {
        const speed = Math.hypot(vx, vy);
        const nw = nearestWall(x, y, hw, hh, vw, vh);
        const canMagnet = !ambientOrbit && t > magnetImmunityUntil;

        if (speed > CAPTURE_SPEED) {
          vx *= AIR_DRAG;
          vy *= AIR_DRAG;
        } else if (canMagnet && nw.dist < MAGNET_ZONE) {
          pullingEdge = nw.edge;
          pullStrength = 1 - Math.max(0, nw.dist) / MAGNET_ZONE;
          const accel = 0.16 + pullStrength * 0.44;
          const standOff = nw.edge === 'left' || nw.edge === 'right' ? SIDE_RACK_GAP : BAR_RACK_GAP;
          const barHalf = SHAPES.bar.w * 0.5 + 14;
          const railHalf = SHAPES.rail.h * 0.5 + 16;

          if (nw.edge === 'top') {
            vy -= accel;
            vx *= 0.9;
            if (x < barHalf) x += (barHalf - x) * 0.2;
            if (x > vw - barHalf) x += (vw - barHalf - x) * 0.2;
          } else if (nw.edge === 'bottom') {
            vy += accel;
            vx *= 0.9;
            if (x < barHalf) x += (barHalf - x) * 0.2;
            if (x > vw - barHalf) x += (vw - barHalf - x) * 0.2;
          } else if (nw.edge === 'left') {
            vx -= accel;
            vy *= 0.9;
            if (y < railHalf) y += (railHalf - y) * 0.2;
            if (y > vh - railHalf) y += (vh - railHalf - y) * 0.2;
          } else if (nw.edge === 'right') {
            vx += accel;
            vy *= 0.9;
            if (y < railHalf) y += (railHalf - y) * 0.2;
            if (y > vh - railHalf) y += (vh - railHalf - y) * 0.2;
          }
          if (nw.dist <= standOff + 2) lockDock(nw.edge, vw, vh, t);
        } else {
          if (ambientOrbit) {
            vx += (vw * 0.72 - x) * 0.00014 + Math.sin(t * 0.00065) * 0.011;
            vy += (Math.min(240, vh * 0.32) - y) * 0.00018 + Math.cos(t * 0.00082) * 0.011;
          } else {
            vx += Math.sin(t * 0.00055) * 0.011;
            vy += Math.cos(t * 0.00072) * 0.011;
          }

          if (Math.hypot(cursorX - x, cursorY - y) < 82) {
            vx *= 0.82;
            vy *= 0.82;
          } else if (speed > CRUISE_SPEED * 1.25) {
            vx *= AIR_DRAG;
            vy *= AIR_DRAG;
          } else if (speed < CRUISE_SPEED * 0.8) {
            vx = speed < 0.05 ? 0.68 : vx * 1.04;
            vy = speed < 0.05 ? 0.5 : vy * 1.04;
          }
        }

        if (state === 'free') {
          x += vx;
          y += vy;
          const postSpeed = Math.hypot(vx, vy);

          if (x - hw <= 4) {
            if (postSpeed > CAPTURE_SPEED || !canMagnet) {
              x = hw + 4;
              vx = Math.abs(vx);
              deflect(false);
              vx = Math.abs(vx);
              if (postSpeed > 2) {
                spawnBurst(4, y, 1, 0, 12, Math.min(2.2, postSpeed / 6));
                triggerImpact(1, 0, postSpeed, t);
              }
            } else {
              lockDock('left', vw, vh, t);
            }
          } else if (x + hw >= vw - 4) {
            if (postSpeed > CAPTURE_SPEED || !canMagnet) {
              x = vw - hw - 4;
              vx = -Math.abs(vx);
              deflect(false);
              vx = -Math.abs(vx);
              if (postSpeed > 2) {
                spawnBurst(vw - 4, y, -1, 0, 12, Math.min(2.2, postSpeed / 6));
                triggerImpact(-1, 0, postSpeed, t);
              }
            } else {
              lockDock('right', vw, vh, t);
            }
          }

          if (state === 'free') {
            if (y - hh <= 4) {
              if (postSpeed > CAPTURE_SPEED || !canMagnet) {
                y = hh + 4;
                vy = Math.abs(vy);
                deflect(true);
                vy = Math.abs(vy);
                if (postSpeed > 2) {
                  spawnBurst(x, 4, 0, 1, 12, Math.min(2.2, postSpeed / 6));
                  triggerImpact(0, 1, postSpeed, t);
                }
              } else {
                lockDock('top', vw, vh, t);
              }
            } else if (y + hh >= vh - 4) {
              if (postSpeed > CAPTURE_SPEED || !canMagnet) {
                y = vh - hh - 4;
                vy = -Math.abs(vy);
                deflect(true);
                vy = -Math.abs(vy);
                if (postSpeed > 2) {
                  spawnBurst(x, vh - 4, 0, -1, 12, Math.min(2.2, postSpeed / 6));
                  triggerImpact(0, -1, postSpeed, t);
                }
              } else {
                lockDock('bottom', vw, vh, t);
              }
            }
          }
        }

        updateRuler(pullingEdge, pullStrength, x, y, vw, vh);
      } else if (state === 'dragging') {
        const nw = nearestWall(x, y, hw, hh, vw, vh);
        const dragSp = Math.hypot(vx, vy);
        if (nw.dist < MAGNET_ZONE * 0.8 && dragSp <= CAPTURE_SPEED) {
          pullingEdge = nw.edge;
          pullStrength = 1 - Math.max(0, nw.dist) / MAGNET_ZONE;
        }
      } else {
        updateRuler(null, 0, x, y, vw, vh);
        if (!grabbedFromDock) {
          const [ax, ay] = dockedAnchorPos(state, x, y, hw, hh, vw, vh);
          rackVelX = (rackVelX + (ax - x) * 0.22) * 0.74;
          rackVelY = (rackVelY + (ay - y) * 0.22) * 0.74;
          x += rackVelX;
          y += rackVelY;
        }
      }

      const isDockedState =
        state === 'top' || state === 'bottom' || state === 'left' || state === 'right';

      const stepDX = x - prevX;
      const stepDY = y - prevY;
      prevX = x;
      prevY = y;
      stepInertialRing(stepDX, stepDY, isDockedState);

      const curSpeed = isDockedState ? 0 : Math.hypot(vx, vy);
      if (curSpeed > 0.25) {
        dirUX += (vx / curSpeed - dirUX) * 0.28;
        dirUY += (vy / curSpeed - dirUY) * 0.28;
        const dNorm = Math.max(0.001, Math.hypot(dirUX, dirUY));
        dirUX /= dNorm;
        dirUY /= dNorm;
      }

      const targetSprint =
        state === 'dragging' ? 0 : Math.max(0, Math.min(1, (curSpeed - 2.2) / 8.5));
      sprintW += (targetSprint - sprintW) * 0.2;
      impactW *= 0.9;
      if (impactW < 0.01) impactW = 0;

      if (pullingEdge) lastPullEdge = pullingEdge;
      smoothPullW += (pullStrength - smoothPullW) * 0.22;
      smoothDockW += ((isDockedState ? 1 : 0) - smoothDockW) * 0.2;

      if (isDockedState) {
        rackEdge = state;
        rackDeploy += (1 - rackDeploy) * 0.24;
      } else if (pullingEdge && pullStrength > 0.2) {
        rackEdge = pullingEdge;
        rackDeploy += (pullStrength * 0.88 - rackDeploy) * 0.22;
      } else {
        rackDeploy *= 0.8;
        if (rackDeploy < 0.01) {
          rackDeploy = 0;
          rackEdge = null;
        }
      }

      let targetKey: 'block' | 'bar' | 'rail' = 'block';
      const activeEdge: EdgeSide | null = isDockedState
        ? state
        : pullStrength > 0.42
          ? pullingEdge
          : null;

      if (activeEdge === 'top' || activeEdge === 'bottom') {
        targetKey = 'bar';
      } else if (activeEdge === 'left' || activeEdge === 'right') {
        targetKey = 'rail';
      }

      const target = SHAPES[targetKey];
      velW = (velW + (target.w - curW) * 0.18) * 0.72;
      velH = (velH + (target.h - curH) * 0.18) * 0.72;
      curW += velW;
      curH += velH;
      nav.style.width = `${curW.toFixed(1)}px`;
      nav.style.height = `${curH.toFixed(1)}px`;

      curInset.l += (target.inset.l - curInset.l) * 0.22;
      curInset.r += (target.inset.r - curInset.r) * 0.22;
      curInset.t += (target.inset.t - curInset.t) * 0.22;
      curInset.b += (target.inset.b - curInset.b) * 0.22;
      innerFrost.style.left = `${curInset.l.toFixed(1)}px`;
      innerFrost.style.right = `${curInset.r.toFixed(1)}px`;
      innerFrost.style.top = `${curInset.t.toFixed(1)}px`;
      innerFrost.style.bottom = `${curInset.b.toFixed(1)}px`;

      const impactOsc = Math.cos((t - impactStart) * 0.04) * impactW * 0.08;
      const impactSquashX = Math.abs(impactNX) > 0.5 ? -impactOsc : impactOsc;
      const impactSquashY = Math.abs(impactNY) > 0.5 ? -impactOsc : impactOsc;
      const sprintStretchX = (Math.abs(dirUX) - Math.abs(dirUY)) * sprintW * 0.045;
      const breath = Math.sin(t * 0.0025) * 0.012 * (1 - smoothDockW);
      const sx = 1 + sprintStretchX + impactSquashX + breath;
      const sy = 1 - sprintStretchX + impactSquashY - breath;
      innerFrost.style.transform = `translate3d(${coreDX.toFixed(1)}px, ${coreDY.toFixed(1)}px, 0) scale(${sx.toFixed(3)}, ${sy.toFixed(3)})`;

      target.coords.forEach(([tx, ty], i) => {
        const sp = itemSpring[i];
        sp.vx = (sp.vx + (tx - sp.x) * 0.2) * 0.74;
        sp.vy = (sp.vy + (ty - sp.y) * 0.2) * 0.74;
        sp.x += sp.vx;
        sp.y += sp.vy;
        if (links[i]) {
          links[i].style.transform = `translate3d(calc(-50% + ${Math.round(sp.x)}px), calc(-50% + ${Math.round(sp.y)}px), 0)`;
        }
      });

      const charFloatAmp = Math.max(0, 1 - smoothDockW * 1.15);
      if (charFloatAmp > 0.02) {
        for (const cs of charSpans) {
          const phase = t * 0.0042 + cs.bIdx * 1.65 + cs.cIdx * 0.92;
          const cx =
            (Math.cos(phase * 0.78) * 0.95 + Math.max(-2.5, Math.min(2.5, coreDX * 0.28))) *
            charFloatAmp;
          const cy =
            (Math.sin(phase) * 2.15 + Math.max(-2.5, Math.min(2.5, coreDY * 0.28))) *
            charFloatAmp;
          cs.el.style.transform = `translate3d(${cx.toFixed(2)}px, ${cy.toFixed(2)}px, 0)`;
        }
      } else {
        for (const cs of charSpans) {
          if (cs.el.style.transform) cs.el.style.transform = '';
        }
      }

      stepAndDrawSatelliteChain(t, vw, vh, isDockedState);
      if (overlayOpen) positionOverlay();

      drawDynamicAsciiBorder(
        t,
        curW,
        curH,
        vw,
        vh,
        curSpeed,
        isDockedState ? state : null,
        smoothPullW > 0.04 ? lastPullEdge : null,
      );

      nav.style.transform = `translate3d(${Math.round(x - curW * 0.5)}px, ${Math.round(y - curH * 0.5)}px, 0)`;
      requestAnimationFrame(tick);
    };

    requestAnimationFrame(tick);
  }
</script>
