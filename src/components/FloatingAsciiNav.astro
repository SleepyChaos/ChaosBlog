---
import { getAllPosts, getAllTags, formatDateShort, readingTime } from '../lib/content';
import { GITHUB_HANDLE, GITHUB_URL } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname;
const relPath = pathname.startsWith(base) ? pathname.slice(base.length) || '/' : pathname;

const isHome = relPath === '/';
const isPosts = relPath.startsWith('/posts');
const isTags = relPath.startsWith('/tags');
const isAbout = relPath.startsWith('/about');

const navItems = [
  { label: '~/首页', href: `${base}/`, active: isHome },
  { label: './文章', href: `${base}/#summit-logs`, active: isPosts },
  { label: '#标签', href: `${base}/tags/`, active: isTags },
  { label: '?关于', href: `${base}/about/`, active: isAbout },
];

const posts = await getAllPosts();
const tags = getAllTags(posts);
const searchIndex = posts.map((p, idx) => ({
  idx: idx + 1,
  title: p.title,
  url: `${base}/posts/${p.slug}/`,
  date: formatDateShort(p.pubDate),
  read: readingTime(p.body),
  tags: p.tags,
  desc: p.description || '',
  body: p.body
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/[#>*`\[\]()_~|-]/g, ' ')
    .replace(/\s+/g, ' ')
    .slice(0, 600),
}));
const tagIndex = tags.map(([name, count]) => ({
  name,
  count,
  url: `${base}/tags/${encodeURIComponent(name)}/`,
}));
---

<canvas id="fx-pixel-canvas" aria-hidden="true"></canvas>
<div id="pixel-dock-ruler" class="pixel-dock-ruler" aria-hidden="true"></div>

<!-- 主模块：始终保持纯粹的 4 个核心路由（上下贴边为顶栏核心舱，左右贴边为 76px 细刃，悬浮态字符失重呼吸） -->
<nav
  id="ascii-float-nav"
  class="ascii-float-nav"
  aria-label="浮动 ASCII 终端导航主舱"
  data-base={base}
  style="width: 248px; height: 38px; visibility: hidden;"
>
  <div
    id="ascii-inner-frost"
    class="ascii-inner-frost"
    style="left: 14px; right: 14px; top: 5px; bottom: 5px;"
  >
  </div>
  <canvas id="ascii-border-canvas" class="ascii-border-canvas" aria-hidden="true"></canvas>

  {
    navItems.map((item, idx) => (
      <a
        href={item.href}
        draggable="false"
        data-idx={idx}
        class:list={['ascii-nav-item', { 'is-active': item.active }]}
      >
        {[...item.label].map((ch, cIdx) => (
          <span class="ascii-char-span" data-bidx={idx} data-cidx={cIdx}>
            {ch}
          </span>
        ))}
      </a>
    ))
  }
</nav>

<!-- 异构挂件 A：双形态终端命令/搜索栏（上下贴边时为独立第二行顶栏同款样式；侧边吸附时自动化为极简细条） -->
<label id="pendant-cli" class="cli-pendant is-bar" aria-label="交互式终端命令行与全文搜索">
  <span class="cli-badge">&gt;_</span>
  <span class="cli-host-full">sisyphus@chaos:~$</span>
  <span class="cli-host-short">$</span>
  <span class="naked-cli-stage">
    <input
      id="naked-cli-input"
      class="naked-cli-input"
      type="text"
      autocomplete="off"
      spellcheck="false"
    />
    <span id="naked-cli-ambient" class="naked-cli-ambient">
      <span id="naked-cli-typer"></span><span class="naked-cli-cursor">█</span>
    </span>
  </span>
  <span class="cli-hint-pill">[/ 唤醒 · help]</span>
</label>

<!-- 异构挂件 B：八角工业切角弹射扳机（Octagonal Eject Trigger） -->
<button
  type="button"
  id="pendant-eject"
  class="hud-pendant pendant-eject"
  title="脱离挂架高速弹射至零重力（同时助推西西弗斯推石）"
>
  <span id="pendant-eject-label">⟪⚡ 弹射⟫</span>
</button>

<!-- 异构挂件 C：双线印章卡带式科幻世界切换器（Sci-Fi World Cartridge） -->
<button
  type="button"
  id="pendant-realm"
  class="hud-pendant pendant-realm"
  title="切换全站科幻 ASCII 世界（太空漫游 / 银河帝国 / 黑客帝国 / 沙丘）"
>
  <span class="realm-glyph" id="pendant-realm-glyph">◉</span>
  <span id="pendant-realm-text">太空漫游</span>
</button>

<!-- 异构挂件 D：穿孔铆钉金属身份狗牌（Punched GitHub Dog-Tag） -->
<a
  href={GITHUB_URL}
  target="_blank"
  rel="noopener"
  draggable="false"
  id="pendant-gh"
  class="hud-pendant pendant-dogtag"
  title="访问 Sisyphus (@SleepyChaos) 的 GitHub 主页"
>
  <span class="dogtag-hole" aria-hidden="true"></span>
  <span id="pendant-gh-label">@{GITHUB_HANDLE} ↗</span>
</a>

<!-- 终端执行输出与搜索匹配浮层 -->
<div id="hud-term-overlay" class="hud-term-overlay" role="region" aria-label="终端输出面板"></div>

<script
  type="application/json"
  id="hud-cli-payload"
  set:html={JSON.stringify({ posts: searchIndex, tags: tagIndex }).replace(/</g, '\\u003c')}
/>

<script>
  const STORAGE_KEY = 'sisyphus_ascii_hud_v8';
  const REALMS = ['void', 'paper', 'crt', 'amber'] as const;
  type RealmId = (typeof REALMS)[number];

  interface RealmSpec {
    glyph: string;
    fullName: string;
    shortName: string;
    desc: string;
    dockTag: string;
    floatTag: string;
    corners: [string, string, string, string];
    hMain: string;
    hWave: string;
    vLeft: string;
    vRight: string;
    soliton: string;
    satA: string;
    satB: string;
  }

  // 四大科幻经典各自的 ASCII 边框艺术词法与图腾配置
  const REALM_SPECS: Record<RealmId, RealmSpec> = {
    void: {
      glyph: '◉',
      fullName: '太空漫游',
      shortName: '漫游',
      desc: '2001: A SPACE ODYSSEY (黑石碑 1:4:9 · HAL-9000 深空舱)',
      dockTag: '::HAL-9000',
      floatTag: '::EVA-0G',
      corners: ['╔', '╗', '╝', '╚'],
      hMain: '═',
      hWave: '▮',
      vLeft: '║',
      vRight: '║',
      soliton: '◉',
      satA: '✦',
      satB: '▮',
    },
    paper: {
      glyph: 'Ψ',
      fullName: '银河帝国',
      shortName: '帝国',
      desc: 'FOUNDATION / GALACTIC EMPIRE (川陀百科典藏 · 谢顿第一辐光)',
      dockTag: '::TRANTOR',
      floatTag: '::SELDON',
      corners: ['┏', '┓', '┛', '┗'],
      hMain: '━',
      hWave: '❖',
      vLeft: '┃',
      vRight: '┃',
      soliton: 'Ψ',
      satA: '∑',
      satB: '∂',
    },
    crt: {
      glyph: '▓',
      fullName: '黑客帝国',
      shortName: '母体',
      desc: 'THE MATRIX (母体构造层 · 半块像素流与片假名代码雨)',
      dockTag: '::MATRIX',
      floatTag: '::ZION',
      corners: ['▛', '▜', '▟', '▙'],
      hMain: '▀',
      hWave: '▓',
      vLeft: '▌',
      vRight: '▐',
      soliton: 'ﾊ',
      satA: '1',
      satB: '0',
    },
    amber: {
      glyph: '◐',
      fullName: '沙丘香料',
      shortName: '沙丘',
      desc: 'DUNE: ARRAKIS (厄拉科斯双月 · 香料金尘与弗雷曼蓝眼)',
      dockTag: '::ARRAKIS',
      floatTag: '::SHAI-HULUD',
      corners: ['╭', '╮', '╯', '╰'],
      hMain: '─',
      hWave: '◈',
      vLeft: '│',
      vRight: '│',
      soliton: '◐',
      satA: '◈',
      satB: '∷',
    },
  };

  const BORDER_PAD = 76;

  interface PostIndexItem {
    idx: number;
    title: string;
    url: string;
    date: string;
    read: string;
    tags: string[];
    desc: string;
    body: string;
  }
  interface TagIndexItem {
    name: string;
    count: number;
    url: string;
  }

  const nav = document.getElementById('ascii-float-nav') as HTMLElement | null;
  const baseUrl = nav?.dataset.base || '';
  const innerFrost = document.getElementById('ascii-inner-frost') as HTMLElement | null;
  const borderCanvas = document.getElementById('ascii-border-canvas') as HTMLCanvasElement | null;
  const ruler = document.getElementById('pixel-dock-ruler') as HTMLElement | null;
  const fxCanvas = document.getElementById('fx-pixel-canvas') as HTMLCanvasElement | null;

  const pendantCli = document.getElementById('pendant-cli') as HTMLElement | null;
  const cliInput = document.getElementById('naked-cli-input') as HTMLInputElement | null;
  const cliAmbient = document.getElementById('naked-cli-ambient') as HTMLElement | null;
  const cliTyper = document.getElementById('naked-cli-typer') as HTMLElement | null;
  const pendantEject = document.getElementById('pendant-eject') as HTMLButtonElement | null;
  const pendantEjectLabel = document.getElementById('pendant-eject-label') as HTMLElement | null;
  const pendantRealm = document.getElementById('pendant-realm') as HTMLButtonElement | null;
  const pendantRealmGlyph = document.getElementById('pendant-realm-glyph') as HTMLElement | null;
  const pendantRealmText = document.getElementById('pendant-realm-text') as HTMLElement | null;
  const pendantGh = document.getElementById('pendant-gh') as HTMLAnchorElement | null;
  const pendantGhLabel = document.getElementById('pendant-gh-label') as HTMLElement | null;
  const termOverlay = document.getElementById('hud-term-overlay') as HTMLElement | null;

  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('#ascii-float-nav .ascii-nav-item'),
  );
  const charSpans = Array.from(
    document.querySelectorAll<HTMLSpanElement>('#ascii-float-nav .ascii-char-span'),
  ).map((el) => ({
    el,
    bIdx: Number(el.dataset.bidx || '0'),
    cIdx: Number(el.dataset.cidx || '0'),
  }));

  let postsData: PostIndexItem[] = [];
  let tagsData: TagIndexItem[] = [];
  try {
    const raw = document.getElementById('hud-cli-payload')?.textContent;
    if (raw) {
      const parsed = JSON.parse(raw);
      postsData = parsed.posts || [];
      tagsData = parsed.tags || [];
    }
  } catch {
    // ignore
  }

  if (
    nav &&
    innerFrost &&
    borderCanvas &&
    ruler &&
    fxCanvas &&
    pendantCli &&
    cliInput &&
    cliAmbient &&
    cliTyper &&
    pendantEject &&
    pendantEjectLabel &&
    pendantRealm &&
    pendantRealmGlyph &&
    pendantRealmText &&
    pendantGh &&
    pendantGhLabel &&
    termOverlay
  ) {
    const fxCtx = fxCanvas.getContext('2d');
    const bCtx = borderCanvas.getContext('2d');

    let curRealm: RealmId = 'void';
    let accentColor = '#a5b4fc';
    let accent2Color = '#38bdf8';
    let fireColor = '#ff3b5c';
    let mutedColor = '#b8c2e6';
    let borderColor = '#7c89b8';
    let monoFont = '600 11px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';

    type EdgeSide = 'top' | 'bottom' | 'left' | 'right';
    type HudState = 'free' | 'dragging' | EdgeSide;
    let state: HudState = 'top';

    const syncPendantLabels = () => {
      const isSide = state === 'left' || state === 'right';
      const spec = REALM_SPECS[curRealm] || REALM_SPECS.void;
      pendantRealmGlyph.textContent = spec.glyph;
      pendantRealmText.textContent = isSide ? spec.shortName : spec.fullName;
      pendantEjectLabel.textContent = isSide ? '⚡弹射' : '⟪⚡ 弹射⟫';
      pendantGhLabel.textContent = isSide ? 'GH↗' : '@Sisyphus ↗';

      pendantEject.classList.toggle('is-rail-compact', isSide);
      pendantRealm.classList.toggle('is-rail-compact', isSide);
      pendantGh.classList.toggle('is-rail-compact', isSide);
      pendantCli.classList.toggle('is-bar', !isSide);
      pendantCli.classList.toggle('is-compact', isSide);
    };

    const syncThemePalette = () => {
      const r = document.documentElement.dataset.realm as RealmId;
      curRealm = REALMS.includes(r) ? r : 'void';
      const cs = getComputedStyle(document.documentElement);
      accentColor = cs.getPropertyValue('--accent').trim() || '#a5b4fc';
      accent2Color = cs.getPropertyValue('--accent-2').trim() || '#38bdf8';
      fireColor = cs.getPropertyValue('--stage-fire').trim() || '#ff3b5c';
      mutedColor = cs.getPropertyValue('--text-muted').trim() || '#b8c2e6';
      borderColor = cs.getPropertyValue('--border-strong').trim() || '#7c89b8';
      const family = cs.getPropertyValue('--font-mono').trim() || 'monospace';
      monoFont = `600 11px ${family}`;
      syncPendantLabels();
    };
    syncThemePalette();
    window.addEventListener('sisyphus:realmchange', syncThemePalette);

    const applyRealm = (next: RealmId) => {
      document.documentElement.dataset.realm = next;
      localStorage.setItem('sisyphus_realm', next);
      syncThemePalette();
      window.dispatchEvent(new CustomEvent('sisyphus:realmchange', { detail: { realm: next } }));
    };

    const cycleRealm = () => {
      const idx = REALMS.indexOf(curRealm);
      const next = REALMS[(idx + 1) % REALMS.length];
      applyRealm(next);
      return next;
    };
    window.addEventListener('sisyphus:cycle-realm', cycleRealm);

    const syncDocDockAttr = () => {
      const isDocked =
        state === 'top' || state === 'bottom' || state === 'left' || state === 'right';
      document.documentElement.dataset.hudDock = isDocked ? state : 'float';
      syncPendantLabels();
    };

    let lastFxW = 0;
    let lastFxH = 0;
    const ensureFxCanvas = (vw: number, vh: number) => {
      if (vw === lastFxW && vh === lastFxH) return;
      lastFxW = vw;
      lastFxH = vh;
      const dpr = window.devicePixelRatio || 1;
      fxCanvas.width = vw * dpr;
      fxCanvas.height = vh * dpr;
      if (fxCtx) {
        fxCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
        fxCtx.imageSmoothingEnabled = false;
      }
    };

    interface BurstPixel {
      x: number;
      y: number;
      vx: number;
      vy: number;
      size: number;
      life: number;
      decay: number;
      accent: boolean;
    }
    const bursts: BurstPixel[] = [];

    const spawnBurst = (
      bx: number,
      by: number,
      nx: number,
      ny: number,
      count: number,
      scale: number,
    ) => {
      for (let i = 0; i < count; i++) {
        const ang = Math.atan2(ny, nx) + (Math.random() - 0.5) * 1.65;
        const sp = (1.3 + Math.random() * 3.2) * scale;
        bursts.push({
          x: bx,
          y: by,
          vx: Math.cos(ang) * sp,
          vy: Math.sin(ang) * sp,
          size: Math.random() < 0.55 ? 3 : 2,
          life: 1,
          decay: 0.034 + Math.random() * 0.024,
          accent: Math.random() < 0.78,
        });
      }
    };

    const SHAPES = {
      block: {
        w: 152,
        h: 70,
        inset: { l: 11, r: 11, t: 11, b: 11 },
        coords: [
          [-31, -10],
          [31, -10],
          [-31, 10],
          [31, 10],
        ],
      },
      bar: {
        w: 252,
        h: 38,
        inset: { l: 14, r: 14, t: 5, b: 5 },
        coords: [
          [-86, 0],
          [-28, 0],
          [30, 0],
          [86, 0],
        ],
      },
      rail: {
        w: 76,
        h: 130,
        inset: { l: 9, r: 9, t: 10, b: 10 },
        coords: [
          [0, -38],
          [0, -13],
          [0, 13],
          [0, 38],
        ],
      },
    } as const;

    const SIDE_RACK_GAP = 24;
    const BAR_RACK_GAP = 14;
    const UNHOOK_PULL_DIST = 30;
    const CAPTURE_SPEED = 3.8;
    const MAGNET_ZONE = 60;
    const CRUISE_SPEED = 0.82;
    const RESTITUTION = 0.85;
    const AIR_DRAG = 0.986;

    let initialized = false;
    let ambientOrbit = false;
    let x = 420;
    let y = SHAPES.bar.h * 0.5 + BAR_RACK_GAP;
    let prevX = 420;
    let prevY = y;
    let vx = -0.82;
    let vy = 0.56;
    let rackVelX = 0;
    let rackVelY = 0;
    let magnetImmunityUntil = 0;

    interface SatPendant {
      el: HTMLElement;
      x: number;
      y: number;
      vx: number;
      vy: number;
      w: number;
      h: number;
      alpha: number;
    }
    const satellites: SatPendant[] = [
      { el: pendantCli, x: 420, y: 74, vx: 0, vy: 0, w: 540, h: 38, alpha: 0 },
      { el: pendantEject, x: 420, y: 33, vx: 0, vy: 0, w: 84, h: 30, alpha: 0 },
      { el: pendantRealm, x: 420, y: 33, vx: 0, vy: 0, w: 102, h: 30, alpha: 0 },
      { el: pendantGh, x: 420, y: 33, vx: 0, vy: 0, w: 112, h: 30, alpha: 0 },
    ];
    let cliFocused = false;
    let cliHovered = false;

    pendantCli.addEventListener('pointerenter', () => {
      cliHovered = true;
    });
    pendantCli.addEventListener('pointerleave', () => {
      cliHovered = false;
    });

    // ========= 顶栏同款/侧栏极简双形态闪烁终端：空闲自动打字 + UNIX/科幻彩蛋命令 + 全文检索 =========
    const BAR_HINTS = [
      'cd ~/home && ./sisyphus --cycle=8h',
      'grep -i "rust" ./documents/posts/*',
      'theme  # 切换: 太空漫游 / 银河帝国 / 黑客帝国 / 沙丘',
      'hal --status   |   seldon   |   matrix   |   dune',
      'push --boulder   &&   neofetch',
    ];
    const COMPACT_HINTS = ['help', 'ls', 'grep...', 'theme', 'push', 'hal'];

    let hintIdx = 0;
    let hintChar = 0;
    let hintDeleting = false;
    let nextTypeTick = 0;

    const updateAmbientTyper = (t: number) => {
      const active = cliFocused || cliInput.value.length > 0;
      cliAmbient.style.opacity = active ? '0' : '1';
      if (active || t < nextTypeTick) return;

      const isSide = state === 'left' || state === 'right';
      const pool = isSide ? COMPACT_HINTS : BAR_HINTS;
      const word = pool[hintIdx % pool.length];

      if (!hintDeleting) {
        hintChar++;
        cliTyper.textContent = word.slice(0, hintChar);
        if (hintChar >= word.length) {
          hintDeleting = true;
          nextTypeTick = t + 2200;
        } else {
          nextTypeTick = t + 58 + Math.random() * 42;
        }
      } else {
        hintChar--;
        cliTyper.textContent = word.slice(0, Math.max(0, hintChar));
        if (hintChar <= 0) {
          hintDeleting = false;
          hintIdx = (hintIdx + 1) % pool.length;
          nextTypeTick = t + 380;
        } else {
          nextTypeTick = t + 24;
        }
      }
    };

    let overlayOpen = false;
    let matchedPosts: PostIndexItem[] = [];
    let selectedIdx = 0;
    let isCommandOutputMode = false;

    const closeOverlay = () => {
      overlayOpen = false;
      termOverlay.classList.remove('is-open');
    };

    const positionOverlay = () => {
      if (!overlayOpen) return;
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const cliSat = satellites[0];
      const isSide = state === 'left' || state === 'right';
      const ow = isSide ? Math.min(vw * 0.9, 420) : Math.min(vw * 0.94, Math.max(420, cliSat.w));
      termOverlay.style.width = `${Math.round(ow)}px`;

      if (state === 'top') {
        const left = Math.max(8, Math.min(vw - ow - 8, cliSat.x - ow * 0.5));
        termOverlay.style.left = `${Math.round(left)}px`;
        termOverlay.style.top = `${Math.round(cliSat.y + cliSat.h * 0.5 + 8)}px`;
        termOverlay.style.bottom = 'auto';
      } else if (state === 'bottom') {
        const left = Math.max(8, Math.min(vw - ow - 8, cliSat.x - ow * 0.5));
        termOverlay.style.left = `${Math.round(left)}px`;
        termOverlay.style.top = 'auto';
        termOverlay.style.bottom = `${Math.round(vh - (cliSat.y - cliSat.h * 0.5 - 8))}px`;
      } else if (state === 'left') {
        termOverlay.style.left = `${Math.round(cliSat.x + cliSat.w * 0.5 + 12)}px`;
        termOverlay.style.top = `${Math.max(12, Math.min(vh - 330, Math.round(cliSat.y - 24)))}px`;
        termOverlay.style.bottom = 'auto';
      } else if (state === 'right') {
        termOverlay.style.left = `${Math.max(8, Math.round(cliSat.x - cliSat.w * 0.5 - ow - 12))}px`;
        termOverlay.style.top = `${Math.max(12, Math.min(vh - 330, Math.round(cliSat.y - 24)))}px`;
        termOverlay.style.bottom = 'auto';
      }
    };

    const showTerminalText = (header: string, bodyHtml: string) => {
      isCommandOutputMode = true;
      matchedPosts = [];
      termOverlay.innerHTML = `<div class="hud-search-head"><span>${header}</span><span>[ESC 关闭]</span></div>${bodyHtml}`;
      overlayOpen = true;
      termOverlay.classList.add('is-open');
      positionOverlay();
    };

    const CAMUS_QUOTES = [
      '“迈向高处的挣扎本身就足以充实人的心灵。应当想象西西弗斯是幸福的。” —— 阿尔贝·加缪',
      '“正在努力从 vibecoding 的浪潮中寻找属于我的石头。” —— Sisyphus',
      '“他走下山时那短暂的停顿，正是意识觉醒、高于他命运的时刻。” ——《西西弗神话》',
      '“希望过一阵回头看，能发现自己又多弄懂了一点。(´･ω･)” —— Sisyphus',
    ];

    const executeCliCommand = (rawInput: string): boolean => {
      const trimmed = rawInput.trim();
      if (!trimmed) return false;
      const [cmdRaw, ...rest] = trimmed.split(/\s+/);
      const cmd = cmdRaw.toLowerCase();
      const arg = rest.join(' ').trim();

      if (cmd === 'help' || cmd === '?' || cmd === 'man') {
        showTerminalText(
          'SISYPHUS-SH :: 舰载终端指令手册',
          `<pre class="hud-term-pre">  <strong style="color:var(--accent)">ls</strong> / <strong style="color:var(--accent)">tags</strong> / <strong style="color:var(--accent)">open &lt;#&gt;</strong>  浏览文章列表、标签矩阵或打开指定序号文章
  <strong style="color:var(--accent)">theme [void|paper|crt|amber]</strong> 切换科幻世界 (漫游/银河帝国/黑客帝国/沙丘)
  <strong style="color:var(--accent)">push</strong> / <strong style="color:var(--accent)">summit</strong>        向西西弗斯注入推石冲量 / 立即演示冲顶崩落下山轮回
  <strong style="color:var(--accent)">hal</strong> | <strong style="color:var(--accent)">seldon</strong> | <strong style="color:var(--accent)">matrix</strong> | <strong style="color:var(--accent)">dune</strong> 触发四大科幻经典终端彩蛋与世界跃迁
  <strong style="color:var(--accent)">neofetch</strong> / <strong style="color:var(--accent)">camus</strong>      打印系统遥测与西西弗斯哲学宣言
  <strong style="color:var(--accent)">eject</strong> / <strong style="color:var(--accent)">cd ~|tags|about</strong>  弹射悬浮舱至零重力 / 路由跳转 (直接输入词即全文检索)</pre>`,
        );
        return true;
      }

      if (cmd === 'hal' || cmd === 'odyssey' || cmd === '2001') {
        applyRealm('void');
        showTerminalText(
          'HAL-9000 :: DISCOVERY ONE',
          `<pre class="hud-term-pre"><span style="color:#ff3b5c">  ( ◉ )</span>  "I'm sorry, Dave. I'm afraid I can't stop pushing that monolith."
         已跃迁至 <strong>《2001：太空漫游》</strong> 世界 · 黑石碑比例 1 : 4 : 9 已校准。</pre>`,
