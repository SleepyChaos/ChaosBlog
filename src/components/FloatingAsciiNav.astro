---
import { getAllPosts, getAllTags, formatDateShort, readingTime } from '../lib/content';
import { GITHUB_URL } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname;
const relPath = pathname.startsWith(base) ? pathname.slice(base.length) || '/' : pathname;

const isHome = relPath === '/';
const isPosts = relPath.startsWith('/posts');
const isTags = relPath.startsWith('/tags');
const isAbout = relPath.startsWith('/about');

const navItems = [
  { label: '~/首页', href: `${base}/`, active: isHome },
  { label: './文章', href: `${base}/#summit-logs`, active: isPosts },
  { label: '#标签', href: `${base}/tags/`, active: isTags },
  { label: '?关于', href: `${base}/about/`, active: isAbout },
];

const posts = await getAllPosts();
const tags = getAllTags(posts);
const searchIndex = posts.map((p, idx) => ({
  idx: idx + 1,
  title: p.title,
  url: `${base}/posts/${p.slug}/`,
  date: formatDateShort(p.pubDate),
  read: readingTime(p.body),
  tags: p.tags,
  desc: p.description || '',
  body: p.body
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/[#>*`\[\]()_~|-]/g, ' ')
    .replace(/\s+/g, ' ')
    .slice(0, 600),
}));
const tagIndex = tags.map(([name, count]) => ({
  name,
  count,
  url: `${base}/tags/${encodeURIComponent(name)}/`,
}));
---

<canvas id="fx-pixel-canvas" aria-hidden="true"></canvas>
<div id="pixel-dock-ruler" class="pixel-dock-ruler" aria-hidden="true"></div>

<!-- 主模块：始终只保留纯粹的 4 个路由按钮（侧挂时化作 74px 极细长条刀锋！） -->
<nav
  id="ascii-float-nav"
  class="ascii-float-nav"
  aria-label="浮动 ASCII 终端导航主舱"
  data-base={base}
  style="width: 146px; height: 68px; visibility: hidden;"
>
  <div
    id="ascii-inner-frost"
    class="ascii-inner-frost"
    style="left: 11px; right: 11px; top: 11px; bottom: 11px;"
  >
  </div>
  <canvas id="ascii-border-canvas" class="ascii-border-canvas" aria-hidden="true"></canvas>

  {
    navItems.map((item, idx) => (
      <a
        href={item.href}
        draggable="false"
        data-idx={idx}
        class:list={['ascii-nav-item', { 'is-active': item.active }]}
      >
        {[...item.label].map((ch, cIdx) => (
          <span class="ascii-char-span" data-bidx={idx} data-cidx={cIdx}>
            {ch}
          </span>
        ))}
      </a>
    ))
  }
</nav>

<!-- 链式独立挂件 1：无框融底闪烁命令终端（直接融入透明毛玻璃，支持 help/ls/neofetch/theme/push 及全文搜索） -->
<label id="pendant-cli" class="naked-cli-pendant" aria-label="交互式终端命令行与搜索">
  <span class="naked-cli-prompt">$</span>
  <span class="naked-cli-stage">
    <input
      id="naked-cli-input"
      class="naked-cli-input"
      type="text"
      autocomplete="off"
      spellcheck="false"
    />
    <span id="naked-cli-ambient" class="naked-cli-ambient">
      <span id="naked-cli-typer"></span><span class="naked-cli-cursor">█</span>
    </span>
  </span>
</label>

<!-- 链式独立挂件 2：弹射脱钩铭牌 -->
<button
  type="button"
  id="pendant-eject"
  class="hud-pendant is-eject"
  title="脱离挂架高速弹射（同时助推西西弗斯）"
>
  <span class="pendant-lug">╠</span><span>⚡弹射</span><span class="pendant-lug">╣</span>
</button>

<!-- 链式独立挂件 3：四重终端风貌切换铭牌（合并换色、明暗、字体与器物细节） -->
<button
  type="button"
  id="pendant-realm"
  class="hud-pendant"
  title="切换全站终端风貌（深空星图 / 绿磷CRT / 纸墨蓝图 / 沙丘琥珀）"
>
  <span class="pendant-lug">╠</span><span id="pendant-realm-text">❖星图</span><span class="pendant-lug">╣</span>
</button>

<!-- 链式独立挂件 4：GitHub 身份铭牌 -->
<a
  href={GITHUB_URL}
  target="_blank"
  rel="noopener"
  draggable="false"
  id="pendant-gh"
  class="hud-pendant"
  title="访问 Sisyphus 的 GitHub 主页"
>
  <span class="pendant-lug">╠</span><span>@GH↗</span><span class="pendant-lug">╣</span>
</a>

<!-- 终端执行输出与搜索匹配透明浮层 -->
<div id="hud-term-overlay" class="hud-term-overlay" role="region" aria-label="终端输出面板"></div>

<script
  type="application/json"
  id="hud-cli-payload"
  set:html={JSON.stringify({ posts: searchIndex, tags: tagIndex }).replace(/</g, '\\u003c')}
/>

<script>
  const STORAGE_KEY = 'sisyphus_ascii_hud_v6';
  const REALMS = ['void', 'crt', 'paper', 'amber'] as const;
  type RealmId = (typeof REALMS)[number];
  const REALM_SHORT: Record<RealmId, string> = {
    void: '❖星图',
    crt: '❖绿磷',
    paper: '❖纸墨',
    amber: '❖琥珀',
  };
  const REALM_DESC: Record<RealmId, string> = {
    void: 'VOID_GLASS (深空星图 · 暗色高透玻璃)',
    crt: 'PHOSPHOR_CRT (1984 绿磷显像管 · 等宽双线框)',
    paper: 'PAPER_BLUEPRINT (手稿蓝图 · 亮色衬线宋体)',
    amber: 'AMBER_DUNE (沙丘琥珀 · 暖金工业终端)',
  };

  const BORDER_PAD = 76;

  interface PostIndexItem {
    idx: number;
    title: string;
    url: string;
    date: string;
    read: string;
    tags: string[];
    desc: string;
    body: string;
  }
  interface TagIndexItem {
    name: string;
    count: number;
    url: string;
  }

  const nav = document.getElementById('ascii-float-nav') as HTMLElement | null;
  const baseUrl = nav?.dataset.base || '';
  const innerFrost = document.getElementById('ascii-inner-frost') as HTMLElement | null;
  const borderCanvas = document.getElementById('ascii-border-canvas') as HTMLCanvasElement | null;
  const ruler = document.getElementById('pixel-dock-ruler') as HTMLElement | null;
  const fxCanvas = document.getElementById('fx-pixel-canvas') as HTMLCanvasElement | null;

  const pendantCli = document.getElementById('pendant-cli') as HTMLElement | null;
  const cliInput = document.getElementById('naked-cli-input') as HTMLInputElement | null;
  const cliAmbient = document.getElementById('naked-cli-ambient') as HTMLElement | null;
  const cliTyper = document.getElementById('naked-cli-typer') as HTMLElement | null;
  const pendantEject = document.getElementById('pendant-eject') as HTMLButtonElement | null;
  const pendantRealm = document.getElementById('pendant-realm') as HTMLButtonElement | null;
  const pendantRealmText = document.getElementById('pendant-realm-text') as HTMLElement | null;
  const pendantGh = document.getElementById('pendant-gh') as HTMLAnchorElement | null;
  const termOverlay = document.getElementById('hud-term-overlay') as HTMLElement | null;

  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('#ascii-float-nav .ascii-nav-item'),
  );
  const charSpans = Array.from(
    document.querySelectorAll<HTMLSpanElement>('#ascii-float-nav .ascii-char-span'),
  ).map((el) => ({
    el,
    bIdx: Number(el.dataset.bidx || '0'),
    cIdx: Number(el.dataset.cidx || '0'),
  }));

  let postsData: PostIndexItem[] = [];
  let tagsData: TagIndexItem[] = [];
  try {
    const raw = document.getElementById('hud-cli-payload')?.textContent;
    if (raw) {
      const parsed = JSON.parse(raw);
      postsData = parsed.posts || [];
      tagsData = parsed.tags || [];
    }
  } catch {
    // ignore
  }

  if (
    nav &&
    innerFrost &&
    borderCanvas &&
    ruler &&
    fxCanvas &&
    pendantCli &&
    cliInput &&
    cliAmbient &&
    cliTyper &&
    pendantEject &&
    pendantRealm &&
    pendantRealmText &&
    pendantGh &&
    termOverlay
  ) {
    const fxCtx = fxCanvas.getContext('2d');
    const bCtx = borderCanvas.getContext('2d');

    let accentColor = '#818cf8';
    let mutedColor = '#8d96ad';
    let borderColor = '#4a5578';
    let monoFont = '600 11px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';

    const syncThemePalette = () => {
      const cs = getComputedStyle(document.documentElement);
      accentColor = cs.getPropertyValue('--accent').trim() || '#818cf8';
      mutedColor = cs.getPropertyValue('--text-muted').trim() || '#8d96ad';
      borderColor = cs.getPropertyValue('--border-strong').trim() || '#4a5578';
      const family = cs.getPropertyValue('--font-mono').trim() || 'monospace';
      monoFont = `600 11px ${family}`;

      const curRealm = (document.documentElement.dataset.realm || 'void') as RealmId;
      pendantRealmText.textContent = REALM_SHORT[curRealm] || '❖星图';
    };
    syncThemePalette();
    window.addEventListener('sisyphus:realmchange', syncThemePalette);

    const applyRealm = (next: RealmId) => {
      document.documentElement.dataset.realm = next;
      localStorage.setItem('sisyphus_realm', next);
      syncThemePalette();
      window.dispatchEvent(new CustomEvent('sisyphus:realmchange', { detail: { realm: next } }));
    };

    const cycleRealm = () => {
      const cur = (document.documentElement.dataset.realm || 'void') as RealmId;
      const next = REALMS[(REALMS.indexOf(cur) + 1) % REALMS.length];
      applyRealm(next);
      return next;
    };
    window.addEventListener('sisyphus:cycle-realm', cycleRealm);

    let lastFxW = 0;
    let lastFxH = 0;
    const ensureFxCanvas = (vw: number, vh: number) => {
      if (vw === lastFxW && vh === lastFxH) return;
      lastFxW = vw;
      lastFxH = vh;
      const dpr = window.devicePixelRatio || 1;
      fxCanvas.width = vw * dpr;
      fxCanvas.height = vh * dpr;
      if (fxCtx) {
        fxCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
        fxCtx.imageSmoothingEnabled = false;
      }
    };

    interface BurstPixel {
      x: number;
      y: number;
      vx: number;
      vy: number;
      size: number;
      life: number;
      decay: number;
      accent: boolean;
    }
    const bursts: BurstPixel[] = [];

    const spawnBurst = (
      bx: number,
      by: number,
      nx: number,
      ny: number,
      count: number,
      scale: number,
    ) => {
      for (let i = 0; i < count; i++) {
        const ang = Math.atan2(ny, nx) + (Math.random() - 0.5) * 1.65;
        const sp = (1.3 + Math.random() * 3.2) * scale;
        bursts.push({
          x: bx,
          y: by,
          vx: Math.cos(ang) * sp,
          vy: Math.sin(ang) * sp,
          size: Math.random() < 0.55 ? 3 : 2,
          life: 1,
          decay: 0.034 + Math.random() * 0.024,
          accent: Math.random() < 0.78,
        });
      }
    };

    // 主模块始终保持纤细精干！侧挂时仅 74px 宽单列刀锋，扩展功能全部作为独立挂件串在后面！
    const SHAPES = {
      block: {
        w: 146,
        h: 68,
        inset: { l: 11, r: 11, t: 11, b: 11 },
        coords: [
          [-29, -9],
          [29, -9],
          [-29, 10],
          [29, 10],
        ],
      },
      bar: {
        w: 234,
        h: 34,
        inset: { l: 14, r: 14, t: 5, b: 5 },
        coords: [
          [-80, 0],
          [-26, 0],
          [28, 0],
          [80, 0],
        ],
      },
      rail: {
        // 细长竖条（仅 74px 宽！比之前窄一半多！）
        w: 74,
        h: 126,
        inset: { l: 9, r: 9, t: 10, b: 10 },
        coords: [
          [0, -37],
          [0, -12],
          [0, 12],
          [0, 37],
        ],
      },
    } as const;

    const SIDE_RACK_GAP = 26;
    const BAR_RACK_GAP = 14;
    const UNHOOK_PULL_DIST = 30;
    const CAPTURE_SPEED = 3.8;
    const MAGNET_ZONE = 60;
    const CRUISE_SPEED = 0.82;
    const RESTITUTION = 0.85;
    const AIR_DRAG = 0.986;

    type EdgeSide = 'top' | 'bottom' | 'left' | 'right';
    type HudState = 'free' | 'dragging' | EdgeSide;

    let initialized = false;
    let ambientOrbit = true;
    let state: HudState = 'free';
    let x = 400;
    let y = 160;
    let prevX = 400;
    let prevY = 160;
    let vx = -0.82;
    let vy = 0.56;
    let rackVelX = 0;
    let rackVelY = 0;
    let magnetImmunityUntil = 0;

    // ========= 4 个链式独立外挂件的弹簧摆锤状态 =========
    interface SatPendant {
      el: HTMLElement;
      x: number;
      y: number;
      vx: number;
      vy: number;
      w: number;
      h: number;
      alpha: number;
    }
    const satellites: SatPendant[] = [
      { el: pendantCli, x: 400, y: 160, vx: 0, vy: 0, w: 170, h: 30, alpha: 0 },
      { el: pendantEject, x: 400, y: 160, vx: 0, vy: 0, w: 66, h: 26, alpha: 0 },
      { el: pendantRealm, x: 400, y: 160, vx: 0, vy: 0, w: 68, h: 26, alpha: 0 },
      { el: pendantGh, x: 400, y: 160, vx: 0, vy: 0, w: 64, h: 26, alpha: 0 },
    ];
    let cliFocused = false;
    let cliHovered = false;

    pendantCli.addEventListener('pointerenter', () => {
      cliHovered = true;
    });
    pendantCli.addEventListener('pointerleave', () => {
      cliHovered = false;
    });

    // ========= 无框闪烁终端：空闲自动打字呼吸 + 真实 UNIX 命令引擎 + 全文检索 =========
    const AMBIENT_HINTS = [
      'help',
      'grep rust...',
      'neofetch',
      'ls -l posts',
      'theme',
      'push --boulder',
      'camus',
    ];
    let hintIdx = 0;
    let hintChar = 0;
    let hintDeleting = false;
    let nextTypeTick = 0;

    const updateAmbientTyper = (t: number) => {
      const active = cliFocused || cliInput.value.length > 0;
      cliAmbient.style.opacity = active ? '0' : '1';
      if (active || t < nextTypeTick) return;

      const word = AMBIENT_HINTS[hintIdx];
      if (!hintDeleting) {
        hintChar++;
        cliTyper.textContent = word.slice(0, hintChar);
        if (hintChar >= word.length) {
          hintDeleting = true;
          nextTypeTick = t + 1850;
        } else {
          nextTypeTick = t + 75 + Math.random() * 55;
        }
      } else {
        hintChar--;
        cliTyper.textContent = word.slice(0, Math.max(0, hintChar));
        if (hintChar <= 0) {
          hintDeleting = false;
          hintIdx = (hintIdx + 1) % AMBIENT_HINTS.length;
          nextTypeTick = t + 420;
        } else {
          nextTypeTick = t + 36;
        }
      }
    };

    let overlayOpen = false;
    let matchedPosts: PostIndexItem[] = [];
    let selectedIdx = 0;
    let isCommandOutputMode = false;

    const closeOverlay = () => {
      overlayOpen = false;
      termOverlay.classList.remove('is-open');
    };

    const positionOverlay = () => {
      if (!overlayOpen) return;
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const cliSat = satellites[0];
      const ow = Math.min(vw * 0.92, 410);
      termOverlay.style.width = `${ow}px`;

      if (state === 'top') {
        const left = Math.max(8, Math.min(vw - ow - 8, cliSat.x - ow * 0.4));
        termOverlay.style.left = `${Math.round(left)}px`;
        termOverlay.style.top = `${Math.round(cliSat.y + 22)}px`;
        termOverlay.style.bottom = 'auto';
      } else if (state === 'bottom') {
        const left = Math.max(8, Math.min(vw - ow - 8, cliSat.x - ow * 0.4));
        termOverlay.style.left = `${Math.round(left)}px`;
        termOverlay.style.top = 'auto';
        termOverlay.style.bottom = `${Math.round(vh - (cliSat.y - 22))}px`;
      } else if (state === 'left') {
        termOverlay.style.left = `${Math.round(cliSat.x + cliSat.w * 0.5 + 12)}px`;
        termOverlay.style.top = `${Math.max(12, Math.min(vh - 320, Math.round(cliSat.y - 24)))}px`;
        termOverlay.style.bottom = 'auto';
      } else if (state === 'right') {
        termOverlay.style.left = `${Math.max(8, Math.round(cliSat.x - cliSat.w * 0.5 - ow - 12))}px`;
        termOverlay.style.top = `${Math.max(12, Math.min(vh - 320, Math.round(cliSat.y - 24)))}px`;
        termOverlay.style.bottom = 'auto';
      }
    };

    const showTerminalText = (header: string, bodyHtml: string) => {
      isCommandOutputMode = true;
      matchedPosts = [];
      termOverlay.innerHTML = `<div class="hud-search-head"><span>${header}</span><span>[ESC 关闭]</span></div>${bodyHtml}`;
      overlayOpen = true;
      termOverlay.classList.add('is-open');
      positionOverlay();
    };

    const CAMUS_QUOTES = [
      '“迈向高处的挣扎本身就足以充实人的心灵。应当想象西西弗斯是幸福的。” —— 阿尔贝·加缪',
      '“正在努力从 vibecoding 的浪潮中寻找属于我的石头。” —— Sisyphus',
      '“他走下山时那短暂的停顿，正是意识觉醒、高于他命运的时刻。” ——《西西弗神话》',
      '“希望过一阵回头看，能发现自己又多弄懂了一点。(´･ω･)” —— Sisyphus',
    ];

    const executeCliCommand = (rawInput: string): boolean => {
      const trimmed = rawInput.trim();
      if (!trimmed) return false;
      const [cmdRaw, ...rest] = trimmed.split(/\s+/);
      const cmd = cmdRaw.toLowerCase();
      const arg = rest.join(' ').trim();

      if (cmd === 'help' || cmd === '?' || cmd === 'man') {
        showTerminalText(
          'SISYPHUS-SH :: BUILTIN COMMANDS',
          `<pre class="hud-term-pre" style="color: var(--text);">  <strong style="color:var(--accent)">ls</strong> / <strong style="color:var(--accent)">posts</strong>      列出全部已发布文章
  <strong style="color:var(--accent)">tags</strong>            列出全部标签索引
  <strong style="color:var(--accent)">open &lt;#&gt;</strong>        按序号打开文章 (如 open 1)
  <strong style="color:var(--accent)">neofetch</strong>        查看系统与 8h 推石轮回遥测
  <strong style="color:var(--accent)">theme [name]</strong>    切换风貌 (void/crt/paper/amber)
  <strong style="color:var(--accent)">push</strong> / <strong style="color:var(--accent)">summit</strong>   助推巨石 / 直接冲顶演示滚落与下山
  <strong style="color:var(--accent)">eject</strong>           脱离武器挂架高速弹射
  <strong style="color:var(--accent)">whoami</strong> / <strong style="color:var(--accent)">camus</strong>  打印西西弗斯语录与身份宣言
  <strong style="color:var(--accent)">cd ~|tags|about</strong> 终端路由跳转  |  直接输入任意词全文搜索</pre>`,
        );
        return true;
      }

      if (cmd === 'ls' || cmd === 'll' || cmd === 'posts') {
        if (arg === 'tags') {
          const tagHtml = tagsData
            .map((t) => `<a href="${t.url}" class="tag-chip" style="margin:2px">#${t.name} [${t.count}]</a>`)
            .join('');
          showTerminalText('LS ./TAGS', `<div style="display:flex;flex-wrap:wrap;gap:4px;">${tagHtml}</div>`);
          return true;
        }
        const rows = postsData
          .map(
            (p) =>
              `<a href="${p.url}" class="hud-search-item"><div class="hud-search-item-title"><span>[${String(p.idx).padStart(2, '0')}] ${p.title}</span><span style="color:var(--text-muted);font-weight:400">${p.date}</span></div></a>`,
          )
          .join('');
        showTerminalText(`LS -LH ./POSTS (${postsData.length})`, rows);
        return true;
      }

      if (cmd === 'tags') {
        const tagHtml = tagsData
          .map((t) => `<a href="${t.url}" class="tag-chip" style="margin:2px">#${t.name} [${t.count}]</a>`)
          .join('');
        showTerminalText(`TAGS (${tagsData.length})`, `<div style="display:flex;flex-wrap:wrap;gap:4px;">${tagHtml}</div>`);
        return true;
      }

      if (cmd === 'open' || cmd === 'cat') {
        const num = Number(arg);
        if (Number.isInteger(num) && postsData[num - 1]) {
          window.location.href = postsData[num - 1].url;
          return true;
        }
        if (arg === 'about' || arg === 'about.md') {
          window.location.href = `${baseUrl}/about/`;
          return true;
        }
      }

      if (cmd === 'cd') {
        const target = arg.replace(/^\/+|\/+$/g, '');
        if (!target || target === '~' || target === 'home') {
          window.location.href = `${baseUrl}/`;
          return true;
        }
        if (target === 'tags') {
          window.location.href = `${baseUrl}/tags/`;
          return true;
        }
        if (target === 'about') {
          window.location.href = `${baseUrl}/about/`;
          return true;
        }
      }

      if (cmd === 'whoami' || cmd === 'camus' || cmd === 'fortune') {
        const quote =
          cmd === 'whoami'
            ? 'Sisyphus (@SleepyChaos) · 杭师大在读 · 正在努力从 vibecoding 的浪潮中寻找属于我的石头。\nStack: Rust · CodeQL (SemFlow Audit) · Astro'
            : CAMUS_QUOTES[Math.floor(Math.random() * CAMUS_QUOTES.length)];
        showTerminalText(`STDOUT :: ${cmd.toUpperCase()}`, `<pre class="hud-term-pre">${quote}</pre>`);
        return true;
      }

      if (cmd === 'neofetch' || cmd === 'fastfetch' || cmd === 'uptime') {
        const r = (document.documentElement.dataset.realm || 'void') as RealmId;
        const cycleMs = 8 * 3600 * 1000;
        const pct = (((Date.now() % cycleMs) / cycleMs) * 100).toFixed(1);
        showTerminalText(
          'NEOFETCH :: SISYPHUS@CHAOS',
          `<pre class="hud-term-pre"><span style="color:var(--accent)">      ╱▒░     </span>  <strong>sisyphus@chaos</strong>
<span style="color:var(--accent)">    o_ (@)    </span>  ──────────────────────
<span style="color:var(--accent)">   /| ╱▒▒░    </span>  <strong>REALM</strong>: ${REALM_DESC[r]}
<span style="color:var(--accent)">   / \\▒▒▒░    </span>  <strong>POSTS</strong>: ${postsData.length} published · ${tagsData.length} tags
<span style="color:var(--accent)"> ╱▒▒▒▒▒▒▒░    </span>  <strong>EPOCH</strong>: 8h Boulder Cycle (${pct}% elapsed)
                <strong>SHELL</strong>: sisyphus-sh (glass-melted)</pre>`,
        );
        return true;
      }

      if (cmd === 'theme' || cmd === 'realm') {
        const argL = arg.toLowerCase() as RealmId;
        const next = REALMS.includes(argL) ? argL : cycleRealm();
        if (REALMS.includes(argL)) applyRealm(argL);
        showTerminalText('REALM SWITCHED', `<pre class="hud-term-pre">→ Active Realm: <strong style="color:var(--accent)">${REALM_DESC[next]}</strong></pre>`);
        return true;
      }

      if (cmd === 'push' || cmd === 'boost') {
        window.dispatchEvent(new CustomEvent('sisyphus:boulder-boost', { detail: { amount: 0.06 } }));
        showTerminalText('BOULDER BOOST', `<pre class="hud-term-pre">▲ 已向山坡上的西西弗斯注入 +53m 推石动能！</pre>`);
        return true;
      }

      if (cmd === 'summit' || cmd === 'roll') {
        window.dispatchEvent(new CustomEvent('sisyphus:trigger-summit'));
        showTerminalText('SUMMIT SEQUENCE', `<pre class="hud-term-pre">▲ 已触发登顶 → 巨石崩落 → 转身下山完整轮回演示（请看首页 01 画布）！</pre>`);
        return true;
      }

      if (cmd === 'eject' || cmd === 'launch') {
        cliInput.value = '';
        launchBallistic();
        return true;
      }

      if (cmd === 'clear' || cmd === 'cls' || cmd === 'exit') {
        cliInput.value = '';
        cliInput.blur();
        closeOverlay();
        return true;
      }

      return false;
    };

    const renderLiveSearch = () => {
      const q = cliInput.value.trim();
      if (!q) {
        // 空输入聚焦时展示快捷终端提示 + 最新文章
        isCommandOutputMode = false;
        matchedPosts = postsData.slice(0, 5);
        selectedIdx = 0;
        const rows = matchedPosts
          .map(
            (p, idx) =>
              `<a href="${p.url}" class="hud-search-item${idx === 0 ? ' is-selected' : ''}"><div class="hud-search-item-title"><span>${idx === matchedPosts.length - 1 ? '└─' : '├─'} ${p.title}</span><span style="color:var(--text-muted);font-weight:400">${p.date}</span></div></a>`,
          )
          .join('');
        termOverlay.innerHTML = `<div class="hud-search-head"><span>输入关键词搜索，或敲 help / ls / neofetch / theme / push</span><span>[ESC]</span></div>${rows}`;
        overlayOpen = true;
        termOverlay.classList.add('is-open');
        positionOverlay();
        return;
      }

      // 若正在输入明显的内置无参指令前缀，不抢占回车，实时过滤文章同时提示可回车执行命令
      const ql = q.toLowerCase();
      const tokens = ql.split(/\s+/).filter(Boolean);
      matchedPosts = postsData
        .map((item) => {
          const titleL = item.title.toLowerCase();
          const tagsL = item.tags.join(' ').toLowerCase();
          const descL = item.desc.toLowerCase();
          const bodyL = item.body.toLowerCase();
          let score = 0;
          for (const tk of tokens) {
            let hit = 0;
            if (titleL.includes(tk)) hit += 10;
            if (tagsL.includes(tk)) hit += 7;
            if (descL.includes(tk)) hit += 4;
            if (bodyL.includes(tk)) hit += 2;
            if (hit === 0) return { item, score: 0 };
            score += hit;
          }
          return { item, score };
        })
        .filter((r) => r.score > 0)
        .sort((a, b) => b.score - a.score)
        .slice(0, 7)
        .map((r) => r.item);

      isCommandOutputMode = false;
      if (selectedIdx >= matchedPosts.length) selectedIdx = 0;

      const isKnownCmd = [
        'help',
        '?',
        'ls',
        'll',
        'posts',
        'tags',
        'open',
        'cat',
        'cd',
        'whoami',
        'camus',
        'fortune',
        'neofetch',
        'fastfetch',
        'uptime',
        'theme',
        'realm',
        'push',
        'boost',
        'summit',
        'roll',
        'eject',
        'launch',
        'clear',
      ].includes(tokens[0]);

      const cmdBanner = isKnownCmd
        ? `<div style="padding:4px 6px;margin-bottom:4px;background:var(--accent-soft);color:var(--accent);border-left:2px solid var(--accent);">⚡ 按 Enter 执行终端命令: <strong>$ ${q}</strong></div>`
        : '';

      const rows =
        matchedPosts.length === 0
          ? `<div style="padding:6px;color:var(--text-muted);">${isKnownCmd ? '直接回车运行该命令。' : '未匹配到文章，试试敲 help 查看终端指令。'}</div>`
          : matchedPosts
              .map((p, idx) => {
                const tagStr = p.tags.slice(0, 3).map((t) => `#${t}`).join(' ');
                return `<a href="${p.url}" class="hud-search-item${idx === selectedIdx && !isKnownCmd ? ' is-selected' : ''}">
                  <div class="hud-search-item-title">
                    <span>${idx === matchedPosts.length - 1 ? '└─' : '├─'} ${p.title}</span>
                    <span style="color:var(--text-muted);font-weight:400;flex-shrink:0">${p.date}</span>
                  </div>
                  <div class="hud-search-item-sub">${tagStr ? `[${tagStr}] ` : ''}${p.desc}</div>
                </a>`;
              })
              .join('');

      termOverlay.innerHTML = `<div class="hud-search-head"><span>$ grep -i "${q}" (${matchedPosts.length})</span><span>[Enter 执行]</span></div>${cmdBanner}${rows}`;
      overlayOpen = true;
      termOverlay.classList.add('is-open');
      positionOverlay();
    };

    cliInput.addEventListener('focus', () => {
      cliFocused = true;
      renderLiveSearch();
    });
    cliInput.addEventListener('blur', () => {
      cliFocused = false;
    });
    cliInput.addEventListener('input', () => {
      selectedIdx = 0;
      renderLiveSearch();
    });
    cliInput.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' && !isCommandOutputMode && matchedPosts.length > 0) {
        e.preventDefault();
        selectedIdx = (selectedIdx + 1) % matchedPosts.length;
        renderLiveSearch();
      } else if (e.key === 'ArrowUp' && !isCommandOutputMode && matchedPosts.length > 0) {
        e.preventDefault();
        selectedIdx = (selectedIdx - 1 + matchedPosts.length) % matchedPosts.length;
        renderLiveSearch();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const val = cliInput.value.trim();
        if (executeCliCommand(val)) {
          cliInput.select();
          return;
        }
        if (matchedPosts[selectedIdx]) {
          saveState();
          window.location.href = matchedPosts[selectedIdx].url;
        }
      } else if (e.key === 'Escape') {
        cliInput.value = '';
        cliInput.blur();
        closeOverlay();
      }
    });

    // 全局按 `/` 键快速唤醒无框终端！
    window.addEventListener('keydown', (e) => {
      if (
        e.key === '/' &&
        document.activeElement !== cliInput &&
        !(document.activeElement instanceof HTMLInputElement) &&
        !(document.activeElement instanceof HTMLTextAreaElement)
      ) {
        e.preventDefault();
        if (state === 'free' || state === 'dragging') {
          lockDock('top', window.innerWidth, window.innerHeight, performance.now());
        }
        setTimeout(() => cliInput.focus(), 60);
      }
    });

    document.addEventListener('pointerdown', (e) => {
      const target = e.target as Node | null;
      if (
        overlayOpen &&
        target &&
        !pendantCli.contains(target) &&
        !termOverlay.contains(target)
      ) {
        closeOverlay();
      }
    });

    // ========= 28 节点耦合弹簧-质量惯性环 + 鼠标“拨弦”效应 + 脉冲孤子波 =========
    const RING_COUNT = 28;
    interface RingMass {
      ux: number;
      uy: number;
      mass: number;
      dx: number;
      dy: number;
      vx: number;
      vy: number;
    }
    const ring: RingMass[] = Array.from({ length: RING_COUNT }, (_, idx) => {
      const side = Math.floor(idx / 7);
      const frac = (idx % 7) / 7;
      let ux = 0;
      let uy = 0;
      if (side === 0) {
        ux = -1 + frac * 2;
        uy = -1;
      } else if (side === 1) {
        ux = 1;
        uy = -1 + frac * 2;
      } else if (side === 2) {
        ux = 1 - frac * 2;
        uy = 1;
      } else {
        ux = -1;
        uy = 1 - frac * 2;
      }
      const midness = Math.sin(frac * Math.PI);
      return { ux, uy, mass: 0.86 + midness * 0.54, dx: 0, dy: 0, vx: 0, vy: 0 };
    });

    let coreDX = 0;
    let coreDY = 0;
    let coreVX = 0;
    let coreVY = 0;

    const sampleRingDisp = (s: number): [number, number] => {
      const wrapped = ((s % RING_COUNT) + RING_COUNT) % RING_COUNT;
      const i0 = Math.floor(wrapped);
      const i1 = (i0 + 1) % RING_COUNT;
      const f = wrapped - i0;
      return [
        ring[i0].dx * (1 - f) + ring[i1].dx * f,
        ring[i0].dy * (1 - f) + ring[i1].dy * f,
      ];
    };

    const impulseRing = (ix: number, iy: number, radialPush = 0) => {
      for (const m of ring) {
        m.vx += ix * m.mass + m.ux * radialPush;
        m.vy += iy * m.mass + m.uy * radialPush;
      }
      coreVX += ix * 0.45;
      coreVY += iy * 0.45;
    };

    let sprintW = 0;
    let dirUX = -0.8;
    let dirUY = 0.6;
    let impactW = 0;
    let impactNX = 0;
    let impactNY = 1;
    let impactStart = 0;
    let smoothPullW = 0;
    let lastPullEdge: EdgeSide | null = null;
    let smoothDockW = 0;
    let rackDeploy = 0;
    let rackEdge: EdgeSide | null = null;

    let curW: number = SHAPES.block.w;
    let curH: number = SHAPES.block.h;
    let velW = 0;
    let velH = 0;
    let curInset = { ...SHAPES.block.inset };
    const itemSpring = SHAPES.block.coords.map(([ix, iy]) => ({ x: ix, y: iy, vx: 0, vy: 0 }));

    const saveState = () => {
      if (!initialized || window.innerWidth < 160 || window.innerHeight < 140) return;
      try {
        sessionStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({
            state: state === 'dragging' ? 'free' : state,
            ambientOrbit,
            xNorm: Math.max(0.04, Math.min(0.96, x / window.innerWidth)),
            yNorm: Math.max(0.03, Math.min(0.97, y / window.innerHeight)),
            vx,
            vy,
          }),
        );
      } catch {
        // ignore
      }
    };
    window.addEventListener('pagehide', saveState);

    // 页面滚动微风耦合：滚动页面时挂架上的主舱与独立挂件串产生随风摆荡！
    let lastScrollY = window.scrollY;
    window.addEventListener(
      'scroll',
      () => {
        const dy = Math.max(-28, Math.min(28, window.scrollY - lastScrollY));
        lastScrollY = window.scrollY;
        if (Math.abs(dy) > 1) {
          impulseRing(0, -dy * 0.14, 0);
          satellites.forEach((sat, idx) => {
            sat.vy -= dy * (0.12 + idx * 0.04);
            if (state === 'left' || state === 'right') {
              sat.vx += (idx % 2 === 0 ? 1 : -1) * Math.abs(dy) * 0.05;
            }
          });
        }
      },
      { passive: true },
    );

    const wallVector = (edge: EdgeSide | null): [number, number] => {
      if (edge === 'top') return [0, -1];
      if (edge === 'bottom') return [0, 1];
      if (edge === 'left') return [-1, 0];
      if (edge === 'right') return [1, 0];
      return [0, 0];
    };

    const launchBallistic = () => {
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      if (vw < 160) return;
      closeOverlay();
      cliInput.blur();
      if (state !== 'free' && state !== 'dragging') {
        const [wx, wy] = wallVector(state);
        spawnBurst(x, y, -wx, -wy, 14, 1.35);
      }
      state = 'free';
      ambientOrbit = false;
      if (x < 90 || x > vw - 90) x = vw * 0.5;
      if (y < 70 || y > vh - 70) y = vh * 0.45;
      const ang = (Math.random() * 0.5 + 0.22) * Math.PI * (Math.random() < 0.5 ? 1 : -1);
      const power = 18 + Math.random() * 6;
      vx = Math.cos(ang) * power;
      vy = Math.sin(ang) * power;
      impulseRing(-vx * 0.65, -vy * 0.65, 3.0);
      magnetImmunityUntil = performance.now() + 260;
      // 发射联动助推西西弗斯！
      window.dispatchEvent(new CustomEvent('sisyphus:boulder-boost', { detail: { amount: 0.045 } }));
      saveState();
    };

    pendantEject.addEventListener('click', launchBallistic);
    pendantRealm.addEventListener('click', () => {
      cycleRealm();
      // 点挂件时挂件本身弹跳晃动一下
      satellites[2].vy -= 3.5;
      satellites[2].vx += (Math.random() - 0.5) * 3;
      spawnBurst(satellites[2].x, satellites[2].y, 0, -1, 8, 0.9);
    });

    // 鼠标划过挂件时产生清脆的碰撞微摆（像手指拨动挂牌串！）
    satellites.forEach((sat, sIdx) => {
      sat.el.addEventListener('pointerenter', () => {
        if (sIdx === 0) return; // CLI 不乱晃方便输入
        sat.vx += (Math.random() - 0.5) * 2.8;
        sat.vy += state === 'top' || state === 'bottom' ? 2.4 : (Math.random() - 0.5) * 2.2;
      });
    });

    let lastCanvasW = 0;
    let lastCanvasH = 0;
    const syncBorderCanvasSize = (w: number, h: number) => {
      const cw = Math.ceil(w + BORDER_PAD * 2);
      const ch = Math.ceil(h + BORDER_PAD * 2);
      if (cw === lastCanvasW && ch === lastCanvasH) return;
      lastCanvasW = cw;
      lastCanvasH = ch;
      const dpr = window.devicePixelRatio || 1;
      borderCanvas.width = cw * dpr;
      borderCanvas.height = ch * dpr;
      borderCanvas.style.width = `${cw}px`;
      borderCanvas.style.height = `${ch}px`;
      borderCanvas.style.left = `${-BORDER_PAD}px`;
      borderCanvas.style.top = `${-BORDER_PAD}px`;
      if (bCtx) {
        bCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
        bCtx.imageSmoothingEnabled = false;
      }
    };

    const dockedAnchorPos = (
      edge: EdgeSide,
      cx: number,
      cy: number,
      hw: number,
      hh: number,
      vw: number,
      vh: number,
    ): [number, number] => {
      if (edge === 'top') {
        // 默认偏左停靠一点，给右侧串联的独立挂件留足舒展空间
        return [Math.max(hw + 14, Math.min(vw - hw - 14, cx)), hh + BAR_RACK_GAP];
      }
      if (edge === 'bottom') {
        return [Math.max(hw + 14, Math.min(vw - hw - 14, cx)), vh - hh - BAR_RACK_GAP];
      }
      if (edge === 'left') {
        return [hw + SIDE_RACK_GAP, Math.max(hh + 16, Math.min(vh - hh - 16, cy))];
      }
      return [vw - hw - SIDE_RACK_GAP, Math.max(hh + 16, Math.min(vh - hh - 16, cy))];
    };

    const nearestWall = (
      cx: number,
      cy: number,
      hw: number,
      hh: number,
      vw: number,
      vh: number,
    ) => {
      const list: { edge: EdgeSide; dist: number }[] = [
        { edge: 'top', dist: cy - hh },
        { edge: 'bottom', dist: vh - (cy + hh) },
        { edge: 'left', dist: cx - hw },
        { edge: 'right', dist: vw - (cx + hw) },
      ];
      list.sort((a, b) => a.dist - b.dist);
      return list[0];
    };

    const updateRuler = (
      edge: EdgeSide | null,
      strength: number,
      cx: number,
      cy: number,
      vw: number,
      vh: number,
    ) => {
      if (!edge || strength <= 0.02) {
        ruler.style.opacity = '0';
        return;
      }
      ruler.style.opacity = Math.min(0.95, 0.3 + strength * 0.7).toFixed(2);
      if (edge === 'top' || edge === 'bottom') {
        ruler.classList.remove('is-vert');
        const span = Math.round((130 + strength * 110) / 6) * 6;
        const left = Math.max(8, Math.min(vw - span - 8, Math.round((cx - span * 0.5) / 2) * 2));
        ruler.style.width = `${span}px`;
        ruler.style.height = '3px';
        ruler.style.left = `${left}px`;
        ruler.style.top = edge === 'top' ? '1px' : `${vh - 4}px`;
      } else {
        ruler.classList.add('is-vert');
        const vSpan = Math.round((70 + strength * 60) / 6) * 6;
        const top = Math.max(8, Math.min(vh - vSpan - 8, Math.round((cy - vSpan * 0.5) / 2) * 2));
        ruler.style.width = '3px';
        ruler.style.height = `${vSpan}px`;
        ruler.style.top = `${top}px`;
        ruler.style.left = edge === 'left' ? '1px' : `${vw - 4}px`;
      }
    };

    const triggerImpact = (nx: number, ny: number, speed: number, now: number) => {
      impactNX = nx;
      impactNY = ny;
      impactW = Math.min(1, Math.max(0.5, speed / 13));
      impactStart = now;
      impulseRing(nx * Math.min(9, speed * 0.55), ny * Math.min(9, speed * 0.55), 3.2);
      // 撞墙动能同样传导给山坡上的西西弗斯助推一把！
      window.dispatchEvent(new CustomEvent('sisyphus:boulder-boost', { detail: { amount: 0.015 } }));
    };

    const lockDock = (edge: EdgeSide, vw: number, vh: number, now: number) => {
      if (state === edge) return;
      state = edge;
      ambientOrbit = false;
      vx = 0;
      vy = 0;
      rackEdge = edge;
      lastPullEdge = edge;

      if (edge === 'top' || edge === 'bottom') {
        velW += 7.5;
        velH -= 3.5;
        // 如果靠右太近则往左让出一点位置以便右侧挂件串展开
        if (vw > 720 && x > vw - 420) {
          x = Math.max(SHAPES.bar.w * 0.5 + 24, vw - 440);
        } else {
          x = Math.max(SHAPES.bar.w * 0.5 + 14, Math.min(vw - SHAPES.bar.w * 0.5 - 14, x));
        }
        rackVelY = edge === 'top' ? 2.8 : -2.8;
        impulseRing(0, edge === 'top' ? 3.8 : -3.8, 1.8);
      } else {
        velW -= 4;
        velH += 7.5;
        // 侧挂时如果太靠下，往上收一点给下方串联的 4 个细长挂件留空间
        if (vh > 520 && y > vh - 260) {
          y = Math.max(SHAPES.rail.h * 0.5 + 24, vh - 270);
        } else {
          y = Math.max(SHAPES.rail.h * 0.5 + 16, Math.min(vh - SHAPES.rail.h * 0.5 - 16, y));
        }
        rackVelY = 3.8;
        rackVelX = edge === 'left' ? 2.2 : -2.2;
        impulseRing(edge === 'left' ? 3.2 : -3.2, 4.2, 1.6);
      }

      // 挂件从主舱位置依次弹射展开（火车挂钩级联弹开效果！）
      satellites.forEach((sat, idx) => {
        sat.x = x;
        sat.y = y;
        sat.vx = (edge === 'top' || edge === 'bottom' ? 1 : 0) * (3 + idx * 1.4);
        sat.vy = (edge === 'left' || edge === 'right' ? 1 : 0) * (3 + idx * 1.4);
      });

      void now;
      saveState();
      window.dispatchEvent(new CustomEvent('sisyphus:hud-state', { detail: { state: edge } }));
    };

    window.addEventListener('sisyphus:hud-kick', launchBallistic);

    window.addEventListener('sisyphus:hud-toggle-dock', () => {
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      if (vw < 160) return;
      const now = performance.now();
      closeOverlay();
      if (state === 'free') {
        y = Math.max(120, Math.min(vh - 280, vh * 0.24));
        lockDock('left', vw, vh, now);
      } else {
        state = 'free';
        ambientOrbit = true;
        const dx = vw * 0.72 - x;
        const dy = Math.min(240, vh * 0.36) - y;
        const d = Math.max(1, Math.hypot(dx, dy));
        vx = (dx / d) * 4.8;
        vy = (dy / d) * 4.8;
        impulseRing(-vx * 0.8, -vy * 0.8, 3.0);
        magnetImmunityUntil = now + 750;
        saveState();
      }
    });

    // 指针拖拽、鼠标拨弦感应与拖拽助推蓄力
    let pointerId: number | null = null;
    let startPX = 0;
    let startPY = 0;
    let grabOffsetX = 0;
    let grabOffsetY = 0;
    let grabbedFromDock: EdgeSide | null = null;
    let dockBaseX = 0;
    let dockBaseY = 0;
    let moved = false;
    let suppressClickUntil = 0;
    let samples: { x: number; y: number; t: number }[] = [];
    let cursorX = -9999;
    let cursorY = -9999;
    let prevCursorX = -9999;
    let prevCursorY = -9999;
    let dragAccumDist = 0;

    nav.addEventListener('pointerdown', (e) => {
      pointerId = e.pointerId;
      startPX = e.clientX;
      startPY = e.clientY;
      grabOffsetX = e.clientX - x;
      grabOffsetY = e.clientY - y;
      moved = false;
      dragAccumDist = 0;
      const isDocked =
        state === 'top' || state === 'bottom' || state === 'left' || state === 'right';
      grabbedFromDock = isDocked ? state : null;
      dockBaseX = x;
      dockBaseY = y;
      samples = [{ x: e.clientX, y: e.clientY, t: performance.now() }];
    });

    window.addEventListener('pointermove', (e) => {
      const cvx = prevCursorX < -9000 ? 0 : e.clientX - prevCursorX;
      const cvy = prevCursorY < -9000 ? 0 : e.clientY - prevCursorY;
      prevCursorX = cursorX;
      prevCursorY = cursorY;
      cursorX = e.clientX;
      cursorY = e.clientY;

      // 【吸附态趣味边缘互动】：鼠标掠过吸附边缘时像“拨动琴弦”一样拨动对应方位的 ASCII 边框质点！
      const isDockedNow =
        state === 'top' || state === 'bottom' || state === 'left' || state === 'right';
      if (isDockedNow && pointerId === null && Math.hypot(cvx, cvy) > 1.2) {
        const relX = cursorX - x;
        const relY = cursorY - y;
        if (Math.abs(relX) < curW * 0.5 + 32 && Math.abs(relY) < curH * 0.5 + 32) {
          for (const m of ring) {
            const mx = m.ux * (curW * 0.5 - 5);
            const my = m.uy * (curH * 0.5 - 5);
            const d = Math.hypot(relX - mx, relY - my);
            if (d < 34) {
              const pluck = (1 - d / 34) * 0.32;
              m.vx += cvx * pluck + m.ux * 1.1 * pluck;
              m.vy += cvy * pluck + m.uy * 1.1 * pluck;
            }
          }
        }
      }

      if (e.pointerId !== pointerId) return;
      const now = performance.now();
      if (!moved && Math.hypot(e.clientX - startPX, e.clientY - startPY) > 4) {
        moved = true;
        ambientOrbit = false;
        closeOverlay();
        cliInput.blur();
        nav.setPointerCapture(e.pointerId);
        if (!grabbedFromDock) {
          state = 'dragging';
        }
      }
      if (!moved) return;

      // 拖动晃动悬浮窗时持续给西西弗斯输送推石动力！
      dragAccumDist += Math.hypot(cvx, cvy);
      if (dragAccumDist > 110) {
        dragAccumDist = 0;
        window.dispatchEvent(new CustomEvent('sisyphus:boulder-boost', { detail: { amount: 0.012 } }));
      }

      samples.push({ x: e.clientX, y: e.clientY, t: now });
      while (samples.length > 6 && now - samples[0].t > 80) samples.shift();

      const first = samples[0];
      const dt = Math.max(10, now - first.t);
      vx = ((e.clientX - first.x) / dt) * 16.5;
      vy = ((e.clientY - first.y) / dt) * 16.5;

      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const hw = curW * 0.5;
      const hh = curH * 0.5;

      const rawTargetX = e.clientX - grabOffsetX;
      const rawTargetY = e.clientY - grabOffsetY;

      if (grabbedFromDock) {
        const pullDX = rawTargetX - dockBaseX;
        const pullDY = rawTargetY - dockBaseY;
        const outwardPull =
          grabbedFromDock === 'left'
            ? pullDX
            : grabbedFromDock === 'right'
              ? -pullDX
              : grabbedFromDock === 'top'
                ? pullDY
                : -pullDY;

        if (outwardPull < UNHOOK_PULL_DIST) {
          if (grabbedFromDock === 'left' || grabbedFromDock === 'right') {
            x = dockBaseX + pullDX * 0.42;
            y = Math.max(hh + 16, Math.min(vh - hh - 16, rawTargetY));
            dockBaseY = y;
          } else {
            x = Math.max(hw + 14, Math.min(vw - hw - 14, rawTargetX));
            y = dockBaseY + pullDY * 0.42;
            dockBaseX = x;
          }
          return;
        } else {
          const [wx, wy] = wallVector(grabbedFromDock);
          const pinX =
            grabbedFromDock === 'left'
              ? 8
              : grabbedFromDock === 'right'
                ? vw - 8
                : x;
          const pinY =
            grabbedFromDock === 'top'
              ? 8
              : grabbedFromDock === 'bottom'
                ? vh - 8
                : y;
          spawnBurst(pinX, pinY, -wx, -wy, 9, 1.15);
          impulseRing(wx * 8.5, wy * 8.5, 4.0);
          grabbedFromDock = null;
          state = 'dragging';
        }
      }

      x = Math.max(hw + 4, Math.min(vw - hw - 4, rawTargetX));
      y = Math.max(hh + 4, Math.min(vh - hh - 4, rawTargetY));

      const dragSpeed = Math.hypot(vx, vy);
      const nw = nearestWall(x, y, hw, hh, vw, vh);
      const preSnap = nw.dist < MAGNET_ZONE * 0.8 && dragSpeed <= CAPTURE_SPEED;
      updateRuler(preSnap ? nw.edge : null, preSnap ? 1 - nw.dist / MAGNET_ZONE : 0, x, y, vw, vh);
    });

    const endDrag = (e: PointerEvent) => {
      if (e.pointerId !== pointerId) return;
      const wasMoved = moved;
      pointerId = null;
      moved = false;
      if (!wasMoved) {
        grabbedFromDock = null;
        return;
      }

      const now = performance.now();
      suppressClickUntil = now + 180;

      if (grabbedFromDock) {
        rackVelX = (dockBaseX - x) * 0.45;
        rackVelY = 2.4;
        impulseRing((dockBaseX - x) * 0.5, 2.5, 1.2);
        grabbedFromDock = null;
        saveState();
        return;
      }

      const last = samples[samples.length - 1];
      if (now - last.t > 90) {
        vx = 0;
        vy = 0;
      } else if (samples.length >= 2) {
        const first = samples[0];
        const dt = Math.max(12, last.t - first.t);
        vx = Math.max(-26, Math.min(26, ((last.x - first.x) / dt) * 18.5));
        vy = Math.max(-26, Math.min(26, ((last.y - first.y) / dt) * 18.5));
      }

      const speed = Math.hypot(vx, vy);
      if (speed > 4) {
        window.dispatchEvent(new CustomEvent('sisyphus:boulder-boost', { detail: { amount: 0.03 } }));
      }
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      const hw = curW * 0.5;
      const hh = curH * 0.5;
      const nw = nearestWall(x, y, hw, hh, vw, vh);

      if (nw.dist < MAGNET_ZONE * 0.8 && speed <= CAPTURE_SPEED) {
        lockDock(nw.edge, vw, vh, now);
      } else {
        state = 'free';
        if (speed < 0.5) {
          ambientOrbit = nw.dist >= MAGNET_ZONE;
          const ang = Math.random() * Math.PI * 2;
          vx = Math.cos(ang) * CRUISE_SPEED;
          vy = Math.sin(ang) * CRUISE_SPEED;
        } else {
          ambientOrbit = false;
        }
        saveState();
      }
    };

    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);

    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        if (moved || performance.now() < suppressClickUntil) {
          e.preventDefault();
          e.stopPropagation();
          return;
        }
        saveState();
      });
    });

    const deflect = (horizWall: boolean) => {
      if (horizWall) {
        vy = -vy * RESTITUTION;
        vx = vx * 0.94 + (Math.random() - 0.5) * 1.35;
      } else {
        vx = -vx * RESTITUTION;
        vy = vy * 0.94 + (Math.random() - 0.5) * 1.35;
      }
    };

    const drawPixelLine = (
      ctx: CanvasRenderingContext2D,
      x0: number,
      y0: number,
      x1: number,
      y1: number,
      step = 2,
    ) => {
      const dist = Math.hypot(x1 - x0, y1 - y0);
      const steps = Math.max(1, Math.round(dist / step));
      for (let i = 0; i <= steps; i++) {
        const u = i / steps;
        const px = Math.round((x0 + (x1 - x0) * u) / 2) * 2;
        const py = Math.round((y0 + (y1 - y0) * u) / 2) * 2;
        ctx.fillRect(px, py, 2, 2);
      }
    };

    // ========= 更新并绘制串联独立外挂件与铰接挂链（Mechanical Chain Couplings） =========
    const stepAndDrawSatelliteChain = (t: number, vw: number, vh: number, isDocked: boolean) => {
      // 侧边栏模式下，CLI 平时窄至 76px 保持整串细长；悬停或聚焦输入时丝滑横向舒展至 186px！
      const isSide = state === 'left' || state === 'right';
      const wantCliW = isSide
        ? cliFocused || cliHovered || cliInput.value.length > 0
          ? 186
          : 76
        : vw < 720
          ? Math.min(150, vw - 180)
          : 196;
      satellites[0].w += (wantCliW - satellites[0].w) * 0.22;
      pendantCli.style.width = `${Math.round(satellites[0].w)}px`;

      satellites[1].w = pendantEject.offsetWidth || 66;
      satellites[2].w = pendantRealm.offsetWidth || 68;
      satellites[3].w = pendantGh.offsetWidth || 64;

      if (!isDocked) {
        // 太空浮动态：挂件收拢回主舱并隐去，只留纯粹 4 按钮主舱漫游！
        for (const sat of satellites) {
          sat.x += (x - sat.x) * 0.25;
          sat.y += (y - sat.y) * 0.25;
          sat.alpha *= 0.78;
          if (sat.alpha < 0.03) {
            sat.alpha = 0;
            sat.el.classList.remove('is-deployed');
          }
          sat.el.style.opacity = sat.alpha.toFixed(2);
          sat.el.style.transform = `translate3d(${Math.round(sat.x - sat.w * 0.5)}px, ${Math.round(sat.y - sat.h * 0.5)}px, 0)`;
        }
        return;
      }

      // 计算挂件串联方向：默认顶/底向右串（若右边空间不够则向左串），左/右侧向下串（若底部不够则向上串）
      const CHAIN_GAP = isSide ? 11 : 13;
      const totalChainSpan = isSide
        ? satellites.reduce((acc, s) => acc + s.h + CHAIN_GAP, 0)
        : satellites.reduce((acc, s) => acc + s.w + CHAIN_GAP, 0);

      if (!isSide && vw < 680) {
        // 手机窄屏吸顶/吸底时：挂件串优雅折到第二排居中悬挂在主舱正下方/正上方！
        const rowDir = state === 'top' ? 1 : -1;
        const rowY = y + rowDir * (curH * 0.5 + 22);
        const subGap = 6;
        const rowTotalW = satellites.reduce((a, s) => a + s.w, 0) + subGap * 3;
        let cursorLeft = Math.max(8, Math.min(vw - rowTotalW - 8, x - rowTotalW * 0.5));

        satellites.forEach((sat, idx) => {
          const tx = cursorLeft + sat.w * 0.5;
          const ty = rowY + Math.sin(t * 0.003 + idx * 1.1) * 1.2;
          cursorLeft += sat.w + subGap;
          sat.vx = (sat.vx + (tx - sat.x) * 0.22) * 0.75;
          sat.vy = (sat.vy + (ty - sat.y) * 0.22) * 0.75;
          sat.x += sat.vx;
          sat.y += sat.vy;
          sat.alpha += (1 - sat.alpha) * 0.2;
          sat.el.classList.add('is-deployed');
          sat.el.style.opacity = sat.alpha.toFixed(2);
          sat.el.style.transform = `translate3d(${Math.round(sat.x - sat.w * 0.5)}px, ${Math.round(sat.y - sat.h * 0.5)}px, 0)`;
        });
        return;
      }

      const dir = isSide
        ? y + curH * 0.5 + totalChainSpan < vh - 12
          ? 1
          : -1
        : x + curW * 0.5 + totalChainSpan < vw - 12
          ? 1
          : -1;

      let prevAnchorX = isSide ? x : x + dir * (curW * 0.5);
      let prevAnchorY = isSide ? y + dir * (curH * 0.5) : y;

      satellites.forEach((sat, idx) => {
        // 侧边挂靠且 CLI 展开变宽时，CLI 挂件贴合导轨内侧向屏幕内伸展，绝不撞墙！
        let tx = x;
        let ty = y;
        if (isSide) {
          const baseRailHalf = SHAPES.rail.w * 0.5;
          const extraW = Math.max(0, sat.w - SHAPES.rail.w);
          tx = state === 'left' ? x + extraW * 0.5 : x - extraW * 0.5;
          ty = prevAnchorY + dir * (CHAIN_GAP + sat.h * 0.5);
          // 轻微钟摆呼吸摆动（越末端的挂件摆幅越灵动！）
          tx += Math.sin(t * 0.0026 - idx * 0.85) * (0.9 + idx * 0.45) * (idx === 0 && cliFocused ? 0 : 1);
          void baseRailHalf;
        } else {
          tx = prevAnchorX + dir * (CHAIN_GAP + sat.w * 0.5);
          ty = y + Math.sin(t * 0.0028 - idx * 0.9) * (1.1 + idx * 0.4) * (idx === 0 && cliFocused ? 0 : 1);
        }

        // 链式弹簧摆锤耦合：前一个模块的运动带动后一个挂件甩摆！
        const stiff = 0.2 - idx * 0.018;
        sat.vx = (sat.vx + (tx - sat.x) * stiff) * 0.76;
        sat.vy = (sat.vy + (ty - sat.y) * stiff) * 0.76;
        sat.x += sat.vx;
        sat.y += sat.vy;
        sat.alpha += (1 - sat.alpha) * 0.22;

        sat.el.classList.add('is-deployed');
        sat.el.style.opacity = sat.alpha.toFixed(2);
        sat.el.style.transform = `translate3d(${Math.round(sat.x - sat.w * 0.5)}px, ${Math.round(sat.y - sat.h * 0.5)}px, 0)`;

        // 在全屏画布 fxCtx 上绘制连接两个模块之间的机械挂钩链扣（══◈══ 或双股竖向吊链 ┆ ◈ ┆）
        if (fxCtx && sat.alpha > 0.15) {
          fxCtx.save();
          fxCtx.globalAlpha = sat.alpha * 0.88;
          if (isSide) {
            const linkTopY = dir > 0 ? prevAnchorY : sat.y + sat.h * 0.5;
            const linkBotY = dir > 0 ? sat.y - sat.h * 0.5 : prevAnchorY;
            const chainX = x; // 沿主轴中心对齐挂链
            fxCtx.fillStyle = borderColor;
            drawPixelLine(fxCtx, chainX - 10, linkTopY + 1, chainX - 10, linkBotY - 1, 3);
            drawPixelLine(fxCtx, chainX + 10, linkTopY + 1, chainX + 10, linkBotY - 1, 3);
            // 中央锁扣销钉
            fxCtx.fillStyle = accentColor;
            const midY = Math.round((linkTopY + linkBotY) * 0.5);
            fxCtx.fillRect(Math.round(chainX - 11), midY - 1, 3, 3);
            fxCtx.fillRect(Math.round(chainX + 9), midY - 1, 3, 3);
          } else {
            const linkLX = dir > 0 ? prevAnchorX : sat.x + sat.w * 0.5;
            const linkRX = dir > 0 ? sat.x - sat.w * 0.5 : prevAnchorX;
            const midX = Math.round((linkLX + linkRX) * 0.5);
            const midY = Math.round((prevAnchorY + sat.y) * 0.5);
            fxCtx.fillStyle = borderColor;
            drawPixelLine(fxCtx, linkLX + 1, prevAnchorY, linkRX - 1, sat.y, 2);
            fxCtx.fillStyle = accentColor;
            fxCtx.fillRect(midX - 2, midY - 2, 4, 4);
          }
          fxCtx.restore();
        }

        prevAnchorX = isSide ? x : sat.x + dir * (sat.w * 0.5);
        prevAnchorY = isSide ? sat.y + dir * (sat.h * 0.5) : sat.y;
      });
    };

    const drawWeaponRackMounts = (
      ox: number,
      oy: number,
      rx: number,
      ry: number,
      vw: number,
      vh: number,
      edge: EdgeSide,
      deploy: number,
    ) => {
      if (!bCtx || deploy <= 0.03) return;
      bCtx.save();
      bCtx.font = monoFont;
      bCtx.textAlign = 'center';
      bCtx.textBaseline = 'middle';

      if (edge === 'left' || edge === 'right') {
        const isLeft = edge === 'left';
        const sign = isLeft ? 1 : -1;
        const wallX = isLeft ? ox - x : ox + (vw - x);
        const [midLDX] = sampleRingDisp(isLeft ? 24.5 : 10.5);
        const targetLugX = ox + (isLeft ? -rx : rx) + midLDX * 0.5;
        const span = Math.abs(targetLugX - wallX);
        const reachX = wallX + sign * span * deploy;
        const isStretched = span > SIDE_RACK_GAP + 7;

        const trackTop = oy - ry - 8;
        const trackBot = oy + ry + 8;
        bCtx.fillStyle = borderColor;
        bCtx.globalAlpha = Math.min(1, deploy * 1.1);
        const spineX = isLeft ? Math.round(wallX) : Math.round(wallX - 3);
        bCtx.fillRect(spineX, Math.round(trackTop), 3, Math.round(trackBot - trackTop));

        bCtx.fillStyle = mutedColor;
        for (let ty = trackTop + 6; ty <= trackBot - 6; ty += 8) {
          const toothX = isLeft ? spineX + 3 : spineX - 3;
          bCtx.fillRect(toothX, Math.round(ty), 3, 2);
        }

        bCtx.fillStyle = accentColor;
        const flangeX = isLeft ? spineX : spineX - 2;
        bCtx.fillRect(flangeX, Math.round(trackTop - 2), 5, 4);
        bCtx.fillRect(flangeX, Math.round(trackBot - 2), 5, 4);

        const armOffsets = [-ry * 0.56, ry * 0.56];
        armOffsets.forEach((offY, armIdx) => {
          const sampleIdx = isLeft ? (armIdx === 0 ? 26 : 23) : armIdx === 0 ? 8.5 : 12;
          const [, lugDY] = sampleRingDisp(sampleIdx);
          const wallArmY = Math.round(oy + offY);
          const lugY = Math.round(oy + offY + lugDY * 0.55);
          const jointX = Math.round(wallX + (reachX - wallX) * 0.62);
          const jointY = Math.round(wallArmY + (lugY - wallArmY) * 0.62);

          bCtx.fillStyle = mutedColor;
          bCtx.globalAlpha = 0.75 * deploy;
          drawPixelLine(bCtx, wallX + sign * 3, wallArmY + 14, jointX, jointY + 2, 2);

          bCtx.fillStyle = accentColor;
          bCtx.globalAlpha = 0.94 * deploy;
          drawPixelLine(bCtx, wallX + sign * 2, wallArmY, reachX - sign * 4, lugY, isStretched ? 5 : 2);

          bCtx.fillStyle = accentColor;
          bCtx.globalAlpha = deploy;
          bCtx.fillText(isLeft ? '╠' : '╣', Math.round(wallX + sign * 5), wallArmY);

          const hookX = Math.round(reachX - sign * 2);
          bCtx.fillText(isLeft ? '╚' : '╝', hookX - sign * 3, lugY + 4);
          bCtx.fillText(isLeft ? '╡' : '╞', hookX, lugY);
          bCtx.fillRect(hookX - 1, lugY - 5, 3, 3);
        });
      } else {
        const isTop = edge === 'top';
        const sign = isTop ? 1 : -1;
        const wallY = isTop ? oy - y : oy + (vh - y);
        const [, midDY] = sampleRingDisp(isTop ? 3.5 : 17.5);
        const targetLugY = oy + (isTop ? -ry : ry) + midDY * 0.5;
        const span = Math.abs(targetLugY - wallY);
        const reachY = wallY + sign * span * deploy;
        const isStretched = span > BAR_RACK_GAP + 6;

        const trackL = ox - rx * 0.78;
        const trackR = ox + rx * 0.78;
        bCtx.fillStyle = borderColor;
        bCtx.globalAlpha = deploy;
        const spineY = isTop ? Math.round(wallY) : Math.round(wallY - 3);
        bCtx.fillRect(Math.round(trackL), spineY, Math.round(trackR - trackL), 3);

        const hangerOffsets = [-rx * 0.58, rx * 0.58];
        hangerOffsets.forEach((offX, hIdx) => {
          const [lugDX] = sampleRingDisp(isTop ? (hIdx === 0 ? 1.5 : 5.5) : hIdx === 0 ? 19.5 : 15.5);
          const wallHX = Math.round(ox + offX);
          const lugX = Math.round(ox + offX + lugDX * 0.5);

          bCtx.fillStyle = mutedColor;
          bCtx.globalAlpha = 0.72 * deploy;
          drawPixelLine(
            bCtx,
            wallHX + (hIdx === 0 ? -12 : 12),
            wallY + sign * 2,
            lugX,
            wallY + (reachY - wallY) * 0.68,
            2,
          );

          bCtx.fillStyle = accentColor;
          bCtx.globalAlpha = 0.94 * deploy;
          drawPixelLine(bCtx, wallHX, wallY + sign * 2, lugX, reachY - sign * 2, isStretched ? 4 : 2);
          bCtx.fillText(isTop ? '╦' : '╩', wallHX, Math.round(wallY + sign * 4));
          bCtx.fillText(isTop ? '╩' : '╦', lugX, Math.round(reachY - sign * 1));
        });
      }

      bCtx.restore();
    };

    interface PerimNode {
      bx: number;
      by: number;
      nx: number;
      ny: number;
      tx: number;
      ty: number;
      ringPos: number;
      glyph: string;
      phase: number;
      isCorner: boolean;
      isLabel: boolean;
    }

    const drawDynamicAsciiBorder = (
      t: number,
      w: number,
      h: number,
      vw: number,
      vh: number,
      speed: number,
      dockEdge: EdgeSide | null,
      pullEdge: EdgeSide | null,
    ) => {
      if (!bCtx) return;
      syncBorderCanvasSize(w, h);
      const cw = lastCanvasW;
      const ch = lastCanvasH;
      const ox = cw * 0.5;
      const oy = ch * 0.5;

      bCtx.clearRect(0, 0, cw, ch);

      const rx = w * 0.5 - 5;
      const ry = h * 0.5 - 5;

      if (rackEdge && rackDeploy > 0.03) {
        drawWeaponRackMounts(ox, oy, rx, ry, vw, vh, rackEdge, rackDeploy);
      }

      bCtx.font = monoFont;
      bCtx.textAlign = 'center';
      bCtx.textBaseline = 'middle';

      const cols = Math.max(6, Math.round((rx * 2) / 7.2));
      const rows = Math.max(2, Math.round((ry * 2) / 11.5));

      const topLabel =
        impactW > 0.38
          ? '!RICOCHET!'
          : sprintW > 0.35
            ? `>>v${speed.toFixed(1)}<<`
            : smoothPullW > 0.3
              ? `::HOOK`
              : dockEdge
                ? `::NAV`
                : `::0G`;
      const botLabel = dockEdge ? '' : `${Math.round(x)},${Math.round(y)}`;

      const topStartIdx = Math.floor((cols - 1 - topLabel.length) * 0.5) + 1;
      const botStartIdx = Math.floor((cols - 1 - botLabel.length) * 0.5) + 1;

      const nodes: PerimNode[] = [];

      const corners: [number, number, number, number, number, string, string][] = [
        [-rx, -ry, -0.707, -0.707, 0, '┌', '╔'],
        [rx, -ry, 0.707, -0.707, 7, '┐', '╗'],
        [rx, ry, 0.707, 0.707, 14, '┘', '╝'],
        [-rx, ry, -0.707, 0.707, 21, '└', '╚'],
      ];
      corners.forEach(([cx, cy, nx, ny, rPos, singleG, doubleG], cIdx) => {
        const useDouble = impactW > 0.28 || sprintW > 0.45 || smoothDockW > 0.5;
        nodes.push({
          bx: cx,
          by: cy,
          nx,
          ny,
          tx: -ny,
          ty: nx,
          ringPos: rPos,
          glyph: useDouble ? doubleG : singleG,
          phase: cIdx * 0.9,
          isCorner: true,
          isLabel: false,
        });
      });

      for (let i = 1; i < cols; i++) {
        const u = i / cols;
        const px = -rx + u * (rx * 2);

        const tCharIdx = i - topStartIdx;
        const hasTopChar = tCharIdx >= 0 && tCharIdx < topLabel.length;
        const waveTopGlyph = Math.sin(t * 0.004 + i * 0.7) > 0.72 ? '═' : '─';
        nodes.push({
          bx: px,
          by: -ry,
          nx: 0,
          ny: -1,
          tx: 1,
          ty: 0,
          ringPos: u * 7,
          glyph: hasTopChar ? topLabel[tCharIdx] : waveTopGlyph,
          phase: i * 0.55,
          isCorner: false,
          isLabel: hasTopChar,
        });

        const bCharIdx = i - botStartIdx;
        const hasBotChar = botLabel.length > 0 && bCharIdx >= 0 && bCharIdx < botLabel.length;
        const waveBotGlyph = Math.sin(t * 0.004 - i * 0.7) > 0.72 ? '═' : '─';
        nodes.push({
          bx: px,
          by: ry,
          nx: 0,
          ny: 1,
          tx: 1,
          ty: 0,
          ringPos: 21 - u * 7,
          glyph: hasBotChar ? botLabel[bCharIdx] : waveBotGlyph,
          phase: (cols - i) * 0.55 + 2.1,
          isCorner: false,
          isLabel: hasBotChar,
        });
      }

      for (let j = 1; j < rows; j++) {
        const v = j / rows;
        const py = -ry + v * (ry * 2);
        const isMid = Math.abs(v - 0.5) < 0.25;
        const barMode = smoothDockW > 0.5 && (dockEdge === 'top' || dockEdge === 'bottom');
        const leftG = barMode && isMid ? '╠' : sprintW > 0.5 || impactW > 0.3 ? '║' : '│';
        const rightG = barMode && isMid ? '╣' : sprintW > 0.5 || impactW > 0.3 ? '║' : '│';

        nodes.push({
          bx: -rx,
          by: py,
          nx: -1,
          ny: 0,
          tx: 0,
          ty: 1,
          ringPos: 28 - v * 7,
          glyph: leftG,
          phase: j * 0.75 + 4.0,
          isCorner: false,
          isLabel: false,
        });
        nodes.push({
          bx: rx,
          by: py,
          nx: 1,
          ny: 0,
          tx: 0,
          ty: 1,
          ringPos: 7 + v * 7,
          glyph: rightG,
          phase: j * 0.75 + 5.6,
          isCorner: false,
          isLabel: false,
        });
      }

      const [dockWX, dockWY] = wallVector(dockEdge);
      const [pullWX, pullWY] = wallVector(pullEdge);
      const impactAge = t - impactStart;
      const shockFront = 1 - (impactAge / 240) * 2.2;

      // 【吸附态孤子脉冲巡检波】：每 3.4 秒一道电流孤子波沿整圈框线轻快环绕一圈，并轻轻弹起沿途字符！
      const solitonPos = ((t * 0.0095) % 36) - 4; // 沿 0..28 环绕

      const satAlpha = (1 - smoothDockW) * (1 - sprintW * 0.7) * 0.5;
      if (satAlpha > 0.04) {
        bCtx.fillStyle = accentColor;
        bCtx.globalAlpha = satAlpha;
        for (let s = 0; s < 4; s++) {
          const [sdx, sdy] = sampleRingDisp(s * 7 + 3.5);
          const ang = t * 0.0011 * (s % 2 === 0 ? 1 : -1) + s * 1.57;
          const sx = ox + Math.cos(ang) * (rx + 7 + Math.sin(t * 0.003 + s) * 2.5) + sdx * 1.25;
          const sy = oy + Math.sin(ang) * (ry + 6 + Math.cos(t * 0.0026 + s) * 2.5) + sdy * 1.25;
          bCtx.fillText(s % 2 === 0 ? '·' : ':', Math.round(sx), Math.round(sy));
        }
      }

      for (let k = 0; k < nodes.length; k++) {
        const nd = nodes[k];
        const [inerDX, inerDY] = sampleRingDisp(nd.ringPos);
        const labelDamp = nd.isLabel ? 0.62 : 1.0;
        let dx = inerDX * labelDamp;
        let dy = inerDY * labelDamp;
        let glyph = nd.glyph;

        // 1. 鼠标靠近时的磁流体“琴弦起峰”形变（吸附态下尤其明显好玩！）
        const worldCharX = x + nd.bx;
        const worldCharY = y + nd.by;
        const distCursor = Math.hypot(cursorX - worldCharX, cursorY - worldCharY);
        if (distCursor < 44 && !nd.isLabel) {
          const magnetSpike = (1 - distCursor / 44) * (smoothDockW > 0.5 ? 5.2 : 3.2);
          dx += nd.nx * magnetSpike;
          dy += nd.ny * magnetSpike;
          if (!nd.isCorner && distCursor < 26) {
            glyph = Math.abs(nd.ny) > 0.5 ? (nd.ny < 0 ? '^' : 'v') : nd.nx < 0 ? '‹' : '›';
          }
        }

        // 2. 吸附态孤子脉冲巡检波拱起效应
        if (smoothDockW > 0.5 && !nd.isLabel) {
          const ringDiff = Math.abs(nd.ringPos - solitonPos);
          if (ringDiff < 2.2) {
            const pulse = Math.cos((ringDiff / 2.2) * (Math.PI * 0.5)) * 3.4 * smoothDockW;
            const kissCheck = dockEdge ? nd.nx * dockWX + nd.ny * dockWY : -1;
            if (kissCheck < 0.4) {
              dx += nd.nx * pulse;
              dy += nd.ny * pulse;
              if (!nd.isCorner && ringDiff < 0.9) glyph = '╬';
            }
          }
        }

        // 3. 大幅惯性拉扯波纹符号
        const localStrain = Math.hypot(inerDX, inerDY);
        if (localStrain > 5.2 && !nd.isLabel && !nd.isCorner) {
          if (Math.abs(nd.ny) > 0.5) {
            glyph = localStrain > 10 ? '~' : '═';
          } else {
            glyph = localStrain > 10 ? '¦' : '║';
          }
        }

        // 4. 呼吸驻波（吸附态暴露侧保留灵动的 2 阶弦驻波起伏！）
        const kissAlign = dockEdge ? nd.nx * dockWX + nd.ny * dockWY : -1;
        const freeFactor = kissAlign > 0.4 ? 1 - smoothDockW * 0.82 : 1 - smoothDockW * 0.15;
        const floatAmp = (nd.isLabel ? 0.9 : 2.3) * freeFactor;
        const waveN =
          Math.sin(t * 0.0036 + nd.phase) * floatAmp +
          Math.cos(t * 0.0022 - nd.phase * 0.7) * (floatAmp * 0.45);
        const waveT = Math.cos(t * 0.0026 + nd.phase * 0.9) * (1.0 * freeFactor);
        dx += nd.nx * waveN + nd.tx * waveT;
        dy += nd.ny * waveN + nd.ty * waveT;

        if (smoothPullW > 0.04 && pullEdge) {
          const pullAlign = nd.nx * pullWX + nd.ny * pullWY;
          if (pullAlign > 0.35) {
            const reach =
              pullAlign *
              smoothPullW *
              (5.5 + Math.sin(t * 0.018 + nd.phase * 1.4) * 2.0);
            dx += pullWX * reach;
            dy += pullWY * reach;
          }
        }

        if (sprintW > 0.04) {
          const motionAlign = nd.nx * dirUX + nd.ny * dirUY;
          if (motionAlign > 0.2) {
            const bowCompress = motionAlign * sprintW * 3.0;
            dx -= nd.nx * bowCompress;
            dy -= nd.ny * bowCompress;
            if (!nd.isLabel && !nd.isCorner && motionAlign > 0.65 && k % 2 === 0) {
              glyph =
                Math.abs(dirUX) > Math.abs(dirUY)
                  ? dirUX > 0
                    ? '»'
                    : '«'
                  : dirUY > 0
                    ? '▼'
                    : '▲';
            }
          } else if (motionAlign < -0.2) {
            const tailStretch =
              -motionAlign *
              sprintW *
              (7.5 + Math.sin(t * 0.026 + nd.phase * 1.5) * 3.8);
            dx -= dirUX * tailStretch;
            dy -= dirUY * tailStretch;
            if (!nd.isLabel && !nd.isCorner) {
              glyph = Math.sin(t * 0.03 + nd.phase) > 0 ? '~' : '=';
            }

            if (sprintW > 0.22 && k % 2 === 0) {
              const wakeGlyphs = ['-', ':', '·'];
              for (let wIdx = 0; wIdx < wakeGlyphs.length; wIdx++) {
                const dist = tailStretch * (1.45 + wIdx * 0.72);
                const wx = ox + nd.bx + dx - dirUX * dist;
                const wy = oy + nd.by + dy - dirUY * dist;
                bCtx.fillStyle = wIdx === 0 ? accentColor : mutedColor;
                bCtx.globalAlpha = Math.max(0.12, sprintW * (0.55 - wIdx * 0.16));
                bCtx.fillText(wakeGlyphs[wIdx], Math.round(wx), Math.round(wy));
              }
            }
          }
        }

        if (impactW > 0.03) {
          const hitAlign = -(nd.nx * impactNX + nd.ny * impactNY);
          if (hitAlign > 0.35) {
            const crush = hitAlign * impactW * 5.2;
            dx -= nd.nx * crush;
            dy -= nd.ny * crush;
            if (!nd.isLabel) {
              glyph = impactW > 0.55 ? '█' : '▓';
            }
          } else {
            const osc = Math.cos(impactAge * 0.044 - (1 - hitAlign) * 1.5);
            const bulge = (1 - Math.max(0, hitAlign)) * impactW * osc * 5.8;
            dx += nd.nx * bulge;
            dy += nd.ny * bulge;
          }

          if (Math.abs(hitAlign - shockFront) < 0.34 && !nd.isLabel && hitAlign <= 0.35) {
            glyph = '+';
          }
        }

        bCtx.fillStyle = accentColor;
        bCtx.globalAlpha = nd.isLabel ? 0.96 : 0.92;
        bCtx.fillText(glyph, Math.round(ox + nd.bx + dx), Math.round(oy + nd.by + dy));
      }

      bCtx.globalAlpha = 1;
    };

    const stepInertialRing = (stepDX: number, stepDY: number, isDocked: boolean) => {
      const torque =
        pointerId !== null
          ? Math.max(-0.22, Math.min(0.22, (grabOffsetX * stepDY - grabOffsetY * stepDX) * 0.0022))
          : 0;

      for (const m of ring) {
        let mountStiff = 1.0;
        if (isDocked && rackEdge) {
          const [wx, wy] = wallVector(rackEdge);
          if (m.ux * wx + m.uy * wy > 0.5) mountStiff = 0.45;
        }
        m.dx -= stepDX * 0.78 * m.mass * mountStiff;
        m.dy -= stepDY * 0.78 * m.mass * mountStiff;
        m.dx += -m.uy * torque * 24 * m.mass;
        m.dy += m.ux * torque * 24 * m.mass;
      }

      const coupleFX = new Float32Array(RING_COUNT);
      const coupleFY = new Float32Array(RING_COUNT);
      for (let i = 0; i < RING_COUNT; i++) {
        const prev = ring[(i - 1 + RING_COUNT) % RING_COUNT];
        const next = ring[(i + 1) % RING_COUNT];
        const cur = ring[i];
        coupleFX[i] = (prev.dx + next.dx - 2 * cur.dx) * 0.18;
        coupleFY[i] = (prev.dy + next.dy - 2 * cur.dy) * 0.18;
      }

      const kSpring = 0.165;
      const damping = 0.83;
      const maxDisp = 26;
      for (let i = 0; i < RING_COUNT; i++) {
        const m = ring[i];
        const invMass = 1 / m.mass;
        m.vx = (m.vx + (-kSpring * m.dx + coupleFX[i]) * invMass) * damping;
        m.vy = (m.vy + (-kSpring * m.dy + coupleFY[i]) * invMass) * damping;
        m.dx += m.vx;
        m.dy += m.vy;

        const mag = Math.hypot(m.dx, m.dy);
        if (mag > maxDisp) {
          const s = maxDisp / mag;
          m.dx *= s;
          m.dy *= s;
          m.vx *= 0.7;
          m.vy *= 0.7;
        }
      }

      coreDX -= stepDX * 0.34;
      coreDY -= stepDY * 0.34;
      coreVX = (coreVX - coreDX * 0.26) * 0.76;
      coreVY = (coreVY - coreDY * 0.26) * 0.76;
      coreDX = Math.max(-10, Math.min(10, coreDX + coreVX));
      coreDY = Math.max(-10, Math.min(10, coreDY + coreVY));
    };

    const tick = (t: number) => {
      const vw = window.innerWidth;
      const vh = window.innerHeight;
      if (vw < 180 || vh < 140) {
        requestAnimationFrame(tick);
        return;
      }

      if (!initialized) {
        initialized = true;
        state = vw < 640 ? 'top' : 'free';
        ambientOrbit = state === 'free';
        x = vw < 640 ? vw * 0.5 : vw * 0.72;
        y = vw < 640 ? SHAPES.bar.h * 0.5 + BAR_RACK_GAP : Math.max(150, Math.min(260, vh * 0.3));

        try {
          const raw = sessionStorage.getItem(STORAGE_KEY);
          if (raw) {
            const saved = JSON.parse(raw);
            if (
              saved &&
              Number.isFinite(saved.xNorm) &&
              Number.isFinite(saved.yNorm) &&
              saved.xNorm > 0.03 &&
              saved.yNorm > 0.02
            ) {
              state = saved.state || state;
              ambientOrbit = Boolean(saved.ambientOrbit);
              x = Math.max(46, Math.min(vw - 46, saved.xNorm * vw));
              y = Math.max(22, Math.min(vh - 22, saved.yNorm * vh));
              vx = Number.isFinite(saved.vx) ? saved.vx : vx;
              vy = Number.isFinite(saved.vy) ? saved.vy : vy;
            }
          }
        } catch {
          // ignore
        }

        const k =
          state === 'top' || state === 'bottom'
            ? 'bar'
            : state === 'left' || state === 'right'
              ? 'rail'
              : 'block';
        curW = SHAPES[k].w;
        curH = SHAPES[k].h;
        curInset = { ...SHAPES[k].inset };
        SHAPES[k].coords.forEach(([ix, iy], idx) => {
          itemSpring[idx].x = ix;
          itemSpring[idx].y = iy;
        });
        satellites.forEach((sat) => {
          sat.x = x;
          sat.y = y;
        });

        if (state !== 'free') {
          rackEdge = state as EdgeSide;
          rackDeploy = 1;
          smoothDockW = 1;
        }
        prevX = x;
        prevY = y;
        nav.style.visibility = 'visible';
      }

      ensureFxCanvas(vw, vh);
      updateAmbientTyper(t);

      const hw = curW * 0.5;
      const hh = curH * 0.5;

      if (fxCtx) {
        fxCtx.clearRect(0, 0, vw, vh);
        for (let i = bursts.length - 1; i >= 0; i--) {
          const b = bursts[i];
          b.x += b.vx;
          b.y += b.vy;
          b.vx *= 0.94;
          b.vy *= 0.94;
          b.life -= b.decay;
          if (b.life <= 0) {
            bursts.splice(i, 1);
            continue;
          }
          fxCtx.fillStyle = b.accent ? accentColor : mutedColor;
          fxCtx.globalAlpha = Math.ceil(b.life * 4) / 4;
          fxCtx.fillRect(Math.round(b.x / 2) * 2, Math.round(b.y / 2) * 2, b.size, b.size);
        }
        fxCtx.globalAlpha = 1;
      }

      let pullingEdge: EdgeSide | null = null;
      let pullStrength = 0;

      if (state === 'free') {
        const speed = Math.hypot(vx, vy);
        const nw = nearestWall(x, y, hw, hh, vw, vh);
        const canMagnet = !ambientOrbit && t > magnetImmunityUntil;

        if (speed > CAPTURE_SPEED) {
          vx *= AIR_DRAG;
          vy *= AIR_DRAG;
        } else if (canMagnet && nw.dist < MAGNET_ZONE) {
          pullingEdge = nw.edge;
          pullStrength = 1 - Math.max(0, nw.dist) / MAGNET_ZONE;
          const accel = 0.16 + pullStrength * 0.44;
          const standOff = nw.edge === 'left' || nw.edge === 'right' ? SIDE_RACK_GAP : BAR_RACK_GAP;
          const barHalf = SHAPES.bar.w * 0.5 + 14;
          const railHalf = SHAPES.rail.h * 0.5 + 16;

          if (nw.edge === 'top') {
            vy -= accel;
            vx *= 0.9;
            if (x < barHalf) x += (barHalf - x) * 0.2;
            if (x > vw - barHalf) x += (vw - barHalf - x) * 0.2;
          } else if (nw.edge === 'bottom') {
            vy += accel;
            vx *= 0.9;
            if (x < barHalf) x += (barHalf - x) * 0.2;
            if (x > vw - barHalf) x += (vw - barHalf - x) * 0.2;
          } else if (nw.edge === 'left') {
            vx -= accel;
            vy *= 0.9;
            if (y < railHalf) y += (railHalf - y) * 0.2;
            if (y > vh - railHalf) y += (vh - railHalf - y) * 0.2;
          } else if (nw.edge === 'right') {
            vx += accel;
            vy *= 0.9;
            if (y < railHalf) y += (railHalf - y) * 0.2;
            if (y > vh - railHalf) y += (vh - railHalf - y) * 0.2;
          }
          if (nw.dist <= standOff + 2) lockDock(nw.edge, vw, vh, t);
        } else {
          if (ambientOrbit) {
            vx += (vw * 0.72 - x) * 0.00014 + Math.sin(t * 0.00065) * 0.011;
            vy += (Math.min(240, vh * 0.32) - y) * 0.00018 + Math.cos(t * 0.00082) * 0.011;
          } else {
            vx += Math.sin(t * 0.00055) * 0.011;
            vy += Math.cos(t * 0.00072) * 0.011;
          }

          if (Math.hypot(cursorX - x, cursorY - y) < 82) {
            vx *= 0.82;
            vy *= 0.82;
          } else if (speed > CRUISE_SPEED * 1.25) {
            vx *= AIR_DRAG;
            vy *= AIR_DRAG;
          } else if (speed < CRUISE_SPEED * 0.8) {
            vx = speed < 0.05 ? 0.68 : vx * 1.04;
            vy = speed < 0.05 ? 0.5 : vy * 1.04;
          }
        }

        if (state === 'free') {
          x += vx;
          y += vy;
          const postSpeed = Math.hypot(vx, vy);

          if (x - hw <= 4) {
            if (postSpeed > CAPTURE_SPEED || !canMagnet) {
              x = hw + 4;
              vx = Math.abs(vx);
              deflect(false);
              vx = Math.abs(vx);
              if (postSpeed > 2) {
                spawnBurst(4, y, 1, 0, 12, Math.min(2.2, postSpeed / 6));
                triggerImpact(1, 0, postSpeed, t);
              }
            } else {
              lockDock('left', vw, vh, t);
            }
          } else if (x + hw >= vw - 4) {
            if (postSpeed > CAPTURE_SPEED || !canMagnet) {
              x = vw - hw - 4;
              vx = -Math.abs(vx);
              deflect(false);
              vx = -Math.abs(vx);
              if (postSpeed > 2) {
                spawnBurst(vw - 4, y, -1, 0, 12, Math.min(2.2, postSpeed / 6));
                triggerImpact(-1, 0, postSpeed, t);
              }
            } else {
              lockDock('right', vw, vh, t);
            }
          }

          if (state === 'free') {
            if (y - hh <= 4) {
              if (postSpeed > CAPTURE_SPEED || !canMagnet) {
                y = hh + 4;
                vy = Math.abs(vy);
                deflect(true);
                vy = Math.abs(vy);
                if (postSpeed > 2) {
                  spawnBurst(x, 4, 0, 1, 12, Math.min(2.2, postSpeed / 6));
                  triggerImpact(0, 1, postSpeed, t);
                }
              } else {
                lockDock('top', vw, vh, t);
              }
            } else if (y + hh >= vh - 4) {
              if (postSpeed > CAPTURE_SPEED || !canMagnet) {
                y = vh - hh - 4;
                vy = -Math.abs(vy);
                deflect(true);
                vy = -Math.abs(vy);
                if (postSpeed > 2) {
                  spawnBurst(x, vh - 4, 0, -1, 12, Math.min(2.2, postSpeed / 6));
                  triggerImpact(0, -1, postSpeed, t);
                }
              } else {
                lockDock('bottom', vw, vh, t);
              }
            }
          }
        }

        updateRuler(pullingEdge, pullStrength, x, y, vw, vh);
      } else if (state === 'dragging') {
        const nw = nearestWall(x, y, hw, hh, vw, vh);
        const dragSp = Math.hypot(vx, vy);
        if (nw.dist < MAGNET_ZONE * 0.8 && dragSp <= CAPTURE_SPEED) {
          pullingEdge = nw.edge;
          pullStrength = 1 - Math.max(0, nw.dist) / MAGNET_ZONE;
        }
      } else {
        updateRuler(null, 0, x, y, vw, vh);
        if (!grabbedFromDock) {
          const [ax, ay] = dockedAnchorPos(state, x, y, hw, hh, vw, vh);
          rackVelX = (rackVelX + (ax - x) * 0.22) * 0.74;
          rackVelY = (rackVelY + (ay - y) * 0.22) * 0.74;
          x += rackVelX;
          y += rackVelY;
        }
      }

      const isDockedState =
        state === 'top' || state === 'bottom' || state === 'left' || state === 'right';

      const stepDX = x - prevX;
      const stepDY = y - prevY;
      prevX = x;
      prevY = y;
      stepInertialRing(stepDX, stepDY, isDockedState);

      const curSpeed = isDockedState ? 0 : Math.hypot(vx, vy);
      if (curSpeed > 0.25) {
        dirUX += (vx / curSpeed - dirUX) * 0.28;
        dirUY += (vy / curSpeed - dirUY) * 0.28;
        const dNorm = Math.max(0.001, Math.hypot(dirUX, dirUY));
        dirUX /= dNorm;
        dirUY /= dNorm;
      }

      const targetSprint =
        state === 'dragging' ? 0 : Math.max(0, Math.min(1, (curSpeed - 2.2) / 8.5));
      sprintW += (targetSprint - sprintW) * 0.2;
      impactW *= 0.9;
      if (impactW < 0.01) impactW = 0;

      if (pullingEdge) lastPullEdge = pullingEdge;
      smoothPullW += (pullStrength - smoothPullW) * 0.22;
      smoothDockW += ((isDockedState ? 1 : 0) - smoothDockW) * 0.2;

      if (isDockedState) {
        rackEdge = state;
        rackDeploy += (1 - rackDeploy) * 0.24;
      } else if (pullingEdge && pullStrength > 0.2) {
        rackEdge = pullingEdge;
        rackDeploy += (pullStrength * 0.88 - rackDeploy) * 0.22;
      } else {
        rackDeploy *= 0.8;
        if (rackDeploy < 0.01) {
          rackDeploy = 0;
          rackEdge = null;
        }
      }

      let targetKey: 'block' | 'bar' | 'rail' = 'block';
      const activeEdge: EdgeSide | null = isDockedState
        ? state
        : pullStrength > 0.42
          ? pullingEdge
          : null;

      if (activeEdge === 'top' || activeEdge === 'bottom') {
        targetKey = 'bar';
      } else if (activeEdge === 'left' || activeEdge === 'right') {
        targetKey = 'rail';
      }

      const target = SHAPES[targetKey];
      velW = (velW + (target.w - curW) * 0.18) * 0.72;
      velH = (velH + (target.h - curH) * 0.18) * 0.72;
      curW += velW;
      curH += velH;
      nav.style.width = `${curW.toFixed(1)}px`;
      nav.style.height = `${curH.toFixed(1)}px`;

      curInset.l += (target.inset.l - curInset.l) * 0.22;
      curInset.r += (target.inset.r - curInset.r) * 0.22;
      curInset.t += (target.inset.t - curInset.t) * 0.22;
      curInset.b += (target.inset.b - curInset.b) * 0.22;
      innerFrost.style.left = `${curInset.l.toFixed(1)}px`;
      innerFrost.style.right = `${curInset.r.toFixed(1)}px`;
      innerFrost.style.top = `${curInset.t.toFixed(1)}px`;
      innerFrost.style.bottom = `${curInset.b.toFixed(1)}px`;

      const impactOsc = Math.cos((t - impactStart) * 0.04) * impactW * 0.08;
      const impactSquashX = Math.abs(impactNX) > 0.5 ? -impactOsc : impactOsc;
      const impactSquashY = Math.abs(impactNY) > 0.5 ? -impactOsc : impactOsc;
      const sprintStretchX = (Math.abs(dirUX) - Math.abs(dirUY)) * sprintW * 0.045;
      const breath = Math.sin(t * 0.0025) * 0.012 * (1 - smoothDockW);
      const sx = 1 + sprintStretchX + impactSquashX + breath;
      const sy = 1 - sprintStretchX + impactSquashY - breath;
      innerFrost.style.transform = `translate3d(${coreDX.toFixed(1)}px, ${coreDY.toFixed(1)}px, 0) scale(${sx.toFixed(3)}, ${sy.toFixed(3)})`;

      target.coords.forEach(([tx, ty], i) => {
        const sp = itemSpring[i];
        sp.vx = (sp.vx + (tx - sp.x) * 0.2) * 0.74;
        sp.vy = (sp.vy + (ty - sp.y) * 0.2) * 0.74;
        sp.x += sp.vx;
        sp.y += sp.vy;
        if (links[i]) {
          links[i].style.transform = `translate3d(calc(-50% + ${Math.round(sp.x)}px), calc(-50% + ${Math.round(sp.y)}px), 0)`;
        }
      });

      // 按钮内单字失重微浮动（吸附后平滑定格）
      const charFloatAmp = Math.max(0, 1 - smoothDockW * 1.15);
      if (charFloatAmp > 0.02) {
        for (const cs of charSpans) {
          const phase = t * 0.0042 + cs.bIdx * 1.65 + cs.cIdx * 0.92;
          const cx =
            (Math.cos(phase * 0.78) * 0.95 + Math.max(-2.5, Math.min(2.5, coreDX * 0.28))) *
            charFloatAmp;
          const cy =
            (Math.sin(phase) * 2.15 + Math.max(-2.5, Math.min(2.5, coreDY * 0.28))) *
            charFloatAmp;
          cs.el.style.transform = `translate3d(${cx.toFixed(2)}px, ${cy.toFixed(2)}px, 0)`;
        }
      } else {
        for (const cs of charSpans) {
          if (cs.el.style.transform) cs.el.style.transform = '';
        }
      }

      // 推进并绘制链式独立外挂件与连接挂扣！
      stepAndDrawSatelliteChain(t, vw, vh, isDockedState);
      if (overlayOpen) positionOverlay();

      drawDynamicAsciiBorder(
        t,
        curW,
        curH,
        vw,
        vh,
        curSpeed,
        isDockedState ? state : null,
        smoothPullW > 0.04 ? lastPullEdge : null,
      );

      nav.style.transform = `translate3d(${Math.round(x - curW * 0.5)}px, ${Math.round(y - curH * 0.5)}px, 0)`;
      requestAnimationFrame(tick);
    };

    requestAnimationFrame(tick);
  }
</script>
