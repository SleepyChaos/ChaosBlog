---
import { CAMUS_QUOTE } from '../consts';

interface Props {
  initialSummits?: number;
}

const { initialSummits = 1 } = Astro.props;
---

<div class="bento-card col-7 sisyphus-stage-card">
  <div class="bento-head">
    <span class="bento-head-title">
      <span class="term-ascii-icon">/▲</span>
      <span id="sisyphus-stage-title">01 // TYCHO · 月面第谷环形山</span>
    </span>
    <div class="sisyphus-head-actions">
      <button
        type="button"
        class="term-btn is-primary"
        id="sisyphus-push-btn"
        title="助推巨石：分段触发【稳步/突进/暴击神迹】专属动画，更有 1% 概率直接触发【骑沙虫/星门舱/帝国舰/救世主】直达峰顶彩蛋！"
      >
        [+PUSH 助推]
      </button>
      <button
        type="button"
        class="term-btn"
        id="sisyphus-summit-btn"
        title="体验完整史诗冲顶演出（骑乘沙虫/星门推进舱/川陀反重力舰/尼奥觉醒御空）→ 巨石崩落 → 走下山坡"
      >
        [&gt;&gt; 冲顶轮回]
      </button>
    </div>
  </div>

  <!-- 320x180 原生像素画舞台：自研像素光栅器 + 4 套科幻主题场景 + 分段助推与 1% 彩蛋演出 -->
  <div
    class="ascii-slope-viewport"
    id="sisyphus-stage-viewport"
    tabindex="0"
    role="img"
    aria-label="西西弗斯推石上山的像素动画，点击画面可助推并触发分段特效或1%登顶彩蛋"
  >
    <canvas id="sisyphus-canvas" class="ascii-slope-canvas" width="320" height="180"></canvas>
    <pre class="ascii-slope-pre is-sr-mirror" id="sisyphus-sr-status" aria-hidden="true"></pre>
  </div>

  <div class="bento-foot">
    <span id="sisyphus-telemetry" data-summits={initialSummits}>
      ALT 210.0m / 884.8m · ETA 06h 05m · #1
    </span>
    <span id="sisyphus-phase-quote">"{CAMUS_QUOTE}"</span>
  </div>
</div>

<script>
  type Realm = 'void' | 'paper' | 'crt' | 'amber';
  type Mode = 'push' | 'stand' | 'cheer' | 'walk' | 'watch' | 'ride';
  type Phase = 'CLIMB' | 'SUMMIT' | 'ROLL' | 'DESCENT';

  const boot = () => {
    const canvas = document.getElementById('sisyphus-canvas') as HTMLCanvasElement | null;
    const viewportEl = document.getElementById('sisyphus-stage-viewport');
    const titleEl = document.getElementById('sisyphus-stage-title');
    const telemetryEl = document.getElementById('sisyphus-telemetry');
    const quoteEl = document.getElementById('sisyphus-phase-quote');
    const srEl = document.getElementById('sisyphus-sr-status');
    const pushBtn = document.getElementById('sisyphus-push-btn');
    const summitBtn = document.getElementById('sisyphus-summit-btn');
    if (!canvas || !telemetryEl) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // ======================================================================
    // 0. 常量与工具
    // ======================================================================
    const W = 320;
    const H = 180;
    const N = W * H;
    canvas.width = W;
    canvas.height = H;

    const CYCLE_MS = 8 * 60 * 60 * 1000;
    const PEAK_ALT = 884.8;
    const STORAGE_KEY = 'sisyphus_8h_cycle_v2';
    const baseSummits = Number(telemetryEl.dataset.summits || '1');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const clamp = (v: number, a: number, b: number) => (v < a ? a : v > b ? b : v);
    const pack = (r: number, g: number, b: number) =>
      ((255 << 24) | (b << 16) | (g << 8) | r) >>> 0;
    const hex = (h: string) => {
      const n = parseInt(h.slice(1), 16);
      return pack((n >> 16) & 255, (n >> 8) & 255, n & 255);
    };
    const hash = (x: number, y: number) => {
      const h = Math.sin(x * 127.1 + y * 311.7) * 43758.5453;
      return h - Math.floor(h);
    };
    const noise = (x: number, y: number) => {
      const ix = Math.floor(x);
      const iy = Math.floor(y);
      const fx = x - ix;
      const fy = y - iy;
      const ux = fx * fx * (3 - 2 * fx);
      const uy = fy * fy * (3 - 2 * fy);
      const a = hash(ix, iy);
      const b = hash(ix + 1, iy);
      const c = hash(ix, iy + 1);
      const d = hash(ix + 1, iy + 1);
      return a + (b - a) * ux + (c - a) * uy + (a - b - c + d) * ux * uy;
    };

    const B4 = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map((v) => (v + 0.5) / 16);
    const bayer = (x: number, y: number) => B4[((y & 3) << 2) | (x & 3)];

    // ======================================================================
    // 1. 像素光栅器（直接写 ImageData，自带图层/遮罩/描边）
    // ======================================================================
    const image = ctx.createImageData(W, H);
    const buf = new Uint32Array(image.data.buffer);
    const staticBuf = new Uint32Array(N);
    const layer = new Uint32Array(N);
    const mask = new Uint8Array(N);
    const tmpRow = new Uint32Array(W);

    let toLayer = false;
    let layerId = 1;
    let clipFn: ((x: number, y: number) => boolean) | null = null;
    let bx0 = W;
    let by0 = H;
    let bx1 = 0;
    let by1 = 0;

    const plot = (x: number, y: number, c: number) => {
      if (x < 0 || y < 0 || x >= W || y >= H) return;
      if (clipFn && !clipFn(x, y)) return;
      const i = y * W + x;
      if (toLayer) {
        layer[i] = c;
        mask[i] = layerId;
        if (x < bx0) bx0 = x;
        if (x > bx1) bx1 = x;
        if (y < by0) by0 = y;
        if (y > by1) by1 = y;
      } else {
        buf[i] = c;
      }
    };
    const pset = (x: number, y: number, c: number) => plot(Math.floor(x), Math.floor(y), c);
    const pdither = (x: number, y: number, c: number, a: number) => {
      const xi = Math.floor(x);
      const yi = Math.floor(y);
      if (a >= 1 || (a > 0 && a > bayer(xi, yi))) plot(xi, yi, c);
    };
    const rect = (x: number, y: number, w: number, h: number, c: number) => {
      const x0 = Math.round(x);
      const y0 = Math.round(y);
      for (let j = 0; j < h; j++) for (let i = 0; i < w; i++) plot(x0 + i, y0 + j, c);
    };
    const disc = (cx: number, cy: number, r: number, c: number) => {
      const R = Math.ceil(r);
      const r2 = r * r;
      const x0 = Math.round(cx);
      const y0 = Math.round(cy);
      for (let dy = -R; dy <= R; dy++)
        for (let dx = -R; dx <= R; dx++) if (dx * dx + dy * dy <= r2) plot(x0 + dx, y0 + dy, c);
    };
    const fillEllipse = (cx: number, cy: number, rx: number, ry: number, c: number) => {
      const x0 = Math.round(cx);
      const y0 = Math.round(cy);
      for (let dy = -Math.ceil(ry); dy <= Math.ceil(ry); dy++)
        for (let dx = -Math.ceil(rx); dx <= Math.ceil(rx); dx++)
          if ((dx * dx) / (rx * rx) + (dy * dy) / (ry * ry) <= 1) plot(x0 + dx, y0 + dy, c);
    };
    const stroke = (x0: number, y0: number, x1: number, y1: number, w: number, c: number) => {
      const steps = Math.max(1, Math.ceil(Math.max(Math.abs(x1 - x0), Math.abs(y1 - y0))));
      for (let s = 0; s <= steps; s++) {
        const t = s / steps;
        const x = x0 + (x1 - x0) * t;
        const y = y0 + (y1 - y0) * t;
        if (w <= 1) plot(Math.round(x), Math.round(y), c);
        else rect(x - w / 2, y - w / 2, w, w, c);
      }
    };
    const ring = (cx: number, cy: number, rx: number, ry: number, c: number, a = 1) => {
      const steps = Math.ceil((rx + ry) * 3.4);
      for (let s = 0; s < steps; s++) {
        const t = (s / steps) * Math.PI * 2;
        pdither(cx + Math.cos(t) * rx, cy + Math.sin(t) * ry, c, a);
      }
    };
    const poly = (pts: number[], c: number) => {
      let minY = Infinity;
      let maxY = -Infinity;
      for (let i = 1; i < pts.length; i += 2) {
        minY = Math.min(minY, pts[i]);
        maxY = Math.max(maxY, pts[i]);
      }
      const n = pts.length / 2;
      const xs: number[] = [];
      for (let y = Math.max(0, Math.floor(minY)); y <= Math.min(H - 1, Math.ceil(maxY)); y++) {
        const sy = y + 0.5;
        xs.length = 0;
        for (let i = 0; i < n; i++) {
          const ax = pts[i * 2];
          const ay = pts[i * 2 + 1];
          const j = (i + 1) % n;
          const bxp = pts[j * 2];
          const byp = pts[j * 2 + 1];
          if ((ay <= sy && byp > sy) || (byp <= sy && ay > sy)) {
            xs.push(ax + ((sy - ay) / (byp - ay)) * (bxp - ax));
          }
        }
        xs.sort((a, b) => a - b);
        for (let k = 0; k + 1 < xs.length; k += 2) {
          for (let x = Math.ceil(xs[k] - 0.5); x <= Math.floor(xs[k + 1] - 0.5); x++) plot(x, y, c);
        }
      }
    };
    const gradient = (stops: [number, string][]) => {
      const cs = stops.map(([y, c]) => [y, hex(c)] as [number, number]);
      for (let y = 0; y < H; y++) {
        let k = 0;
        while (k < cs.length - 2 && y >= cs[k + 1][0]) k++;
        const [ya, ca] = cs[k];
        const [yb, cb] = cs[k + 1];
        const t = clamp((y - ya) / Math.max(1, yb - ya), 0, 1);
        for (let x = 0; x < W; x++) plot(x, y, t > bayer(x, y) ? cb : ca);
      }
    };
    const depthTone = (stops: [number, number][], d: number, x: number, y: number) => {
      let k = 0;
      while (k < stops.length - 2 && d >= stops[k + 1][0]) k++;
      const [da, ca] = stops[k];
      const [db, cb] = stops[k + 1];
      const t = clamp((d - da) / Math.max(1, db - da), 0, 1);
      return t > bayer(x, y) ? cb : ca;
    };

    // 3x5 像素字体（支持浮动数字、暴击与彩蛋标识）
    const FONT: Record<string, string> = {
      '0': '111101101101111',
      '1': '010110010010111',
      '2': '111001111100111',
      '3': '111001111001111',
      '4': '101101111001001',
      '5': '111100111001111',
      '6': '111100111101111',
      '7': '111001010010010',
      '8': '111101111101111',
      '9': '111101111001111',
      '+': '000010111010000',
      m: '000110111101101',
      '!': '010010010000010',
      '*': '101010111010101',
      '%': '101001010100101',
      C: '111100100100111',
      R: '110101110101101',
      I: '111010010010111',
      T: '111010010010010',
      M: '101111101101101',
      A: '010101111101101',
      X: '101101010101101',
      '.': '000000000000010',
    };
    const drawText = (s: string, x: number, y: number, c: number, oc: number) => {
      let cx = Math.round(x);
      const cy = Math.round(y);
      for (const ch of s) {
        const g = FONT[ch];
        if (g) {
          for (let pass = 0; pass < 2; pass++) {
            for (let b = 0; b < 15; b++) {
              if (g[b] !== '1') continue;
              const gx = cx + (b % 3);
              const gyy = cy + Math.floor(b / 3);
              if (pass === 0) {
                for (let oy = -1; oy <= 1; oy++) for (let ox = -1; ox <= 1; ox++) plot(gx + ox, gyy + oy, oc);
              } else plot(gx, gyy, c);
            }
          }
        }
        cx += 4;
      }
    };

    // ======================================================================
    // 2. 地形与路径
    // ======================================================================
    const BASE_Y = 160;
    const SUMMIT_Y = 62;
    const X0 = 30;
    const X1 = 262;
    const terrainAt = (x: number) => {
      if (x <= X0) return BASE_Y;
      if (x >= X1) return SUMMIT_Y;
      const t = (x - X0) / (X1 - X0);
      const e = t * 0.7 + t * t * (3 - 2 * t) * 0.3;
      const und = Math.sin(t * Math.PI * 3) * Math.sin(t * Math.PI) * 3.2;
      return BASE_Y - (BASE_Y - SUMMIT_Y) * e + und;
    };
    const GY = new Float32Array(W + 2);
    for (let x = 0; x < W + 2; x++) GY[x] = terrainAt(x);
    const gyi = new Int16Array(W);
    for (let x = 0; x < W; x++) gyi[x] = Math.round(GY[x]);
    const gy = (x: number) => {
      if (x <= 0) return GY[0];
      if (x >= W) return GY[W];
      const i = Math.floor(x);
      const f = x - i;
      return GY[i] * (1 - f) + GY[i + 1] * f;
    };
    const skyClip = (x: number, y: number) => y < gyi[x];

    const R = 8;
    const PATH_X0 = 46;
    const PATH_X1 = 270;
    const contactX = (p: number) => PATH_X0 + clamp(p, 0, 1) * (PATH_X1 - PATH_X0);
    const boulderCenter = (cx: number, lift = 0) => {
      const g = (gy(cx + 1) - gy(cx - 1)) / 2;
      const l = Math.hypot(g, 1);
      return { x: cx + (g / l) * R, y: gy(cx) - R / l - 0.5 - lift };
    };
    const pushHeroX = (p: number) => boulderCenter(contactX(p)).x - R + 0.5 - 10.8;
    const SUMMIT_STAND_X = 284;

    // 沙丘中景
    const midDune = (x: number) => 136 + Math.sin(x * 0.027 + 2) * 7 + Math.sin(x * 0.07) * 2.5;
    const midDuneI = new Int16Array(W);
    for (let x = 0; x < W; x++) midDuneI[x] = Math.round(midDune(x));

    // ======================================================================
    // 3. 主题配色
    // ======================================================================
    const HERO: Record<Realm, { main: number; back: number; acc: number; acc2: number; outline: number }> = {
      void: { main: hex('#e9edf5'), back: hex('#a7afc2'), acc: hex('#f2b44f'), acc2: hex('#c6ccda'), outline: hex('#080a14') },
      paper: { main: hex('#2a2833'), back: hex('#565264'), acc: hex('#c83c2b'), acc2: hex('#e0b354'), outline: hex('#18161f') },
      crt: { main: hex('#010402'), back: hex('#04160a'), acc: hex('#b6ffcf'), acc2: hex('#010402'), outline: hex('#3dff7a') },
      amber: { main: hex('#3b2519'), back: hex('#26170f'), acc: hex('#5ec8ff'), acc2: hex('#8f5a36'), outline: hex('#1d0d07') },
    };
    const ROCK: Record<Realm, number[]> = {
      void: ['#f1f3f8', '#c5cad6', '#8f96a8', '#5c6276', '#353a4c'].map(hex),
      paper: ['#f7e3a8', '#d6b66f', '#9c8354', '#665842', '#3d352a'].map(hex),
      crt: ['#c8ffd9', '#3dff7a', '#138a3a', '#03200d', '#010a04'].map(hex),
      amber: ['#f2bb78', '#d9944f', '#b8723c', '#8a4f2a', '#5e321c'].map(hex),
    };
    const LIGHT: Record<Realm, [number, number, number]> = {
      void: [-0.72, -0.45, 0.52],
      paper: [-0.55, -0.58, 0.6],
      crt: [-0.2, -0.5, 0.84],
      amber: [0.7, -0.25, 0.66],
    };
    for (const k of Object.keys(LIGHT) as Realm[]) {
      const [a, b, c] = LIGHT[k];
      const l = Math.hypot(a, b, c);
      LIGHT[k] = [a / l, b / l, c / l];
    }
    const SHADOW: Record<Realm, { c: number; dir: number } | null> = {
      void: { c: hex('#2a2f42'), dir: 1 },
      paper: { c: hex('#595042'), dir: 1 },
      crt: null,
      amber: { c: hex('#7a3d22'), dir: -1 },
    };
    const TITLES: Record<Realm, string> = {
      void: '01 // TYCHO · 月面第谷环形山',
      paper: '01 // TRANTOR · 川陀首都与端点星',
      crt: '01 // CONSTRUCT · 母体构造层',
      amber: '01 // ARRAKIS · 厄拉科斯沙海',
    };
    const CLIMB_QUOTES: Record<Realm, string> = {
      void: '"My God, it\'s full of stars." —— 2001: A Space Odyssey',
      paper: '"The fall of Empire, gentlemen, is a massive thing..." —— Hari Seldon',
      crt: '"There is no spoon." —— The Matrix',
      amber: '"Fear is the mind-killer." —— Dune',
    };

    const getRealm = (): Realm => {
      const r = document.documentElement.dataset.realm;
      return r === 'paper' || r === 'crt' || r === 'amber' ? r : 'void';
    };
    let realm: Realm = getRealm();

    // ======================================================================
    // 4. 静态背景构建（四大主题：月面第谷 / 川陀摩天首都与端点星 / 母体都市 / 沙丘大漠）
    // ======================================================================
    interface Star { x: number; y: number; b: number; ph: number }
    let stars: Star[] = [];

    const buildVoid = () => {
      gradient([
        [0, '#020309'],
        [55, '#050a1c'],
        [105, '#0c1430'],
        [150, '#18234a'],
      ]);
      // 木星 + 卫星连珠
      const jx = 62;
      const jy = 46;
      const jr = 25;
      const bands = ['#efdcb4', '#c89a63', '#f4e7cb', '#b07a4c', '#e6c896', '#a86f45', '#f0dfba'].map(hex);
      const night = hex('#14111d');
      const dusk = hex('#3a2c33');
      const spot = hex('#c4563c');
      for (let dy = -jr; dy <= jr; dy++) {
        for (let dx = -jr; dx <= jr; dx++) {
          const nx = dx / jr;
          const ny = dy / jr;
          const r2 = nx * nx + ny * ny;
          if (r2 > 1) continue;
          const nz = Math.sqrt(1 - r2);
          const lum = clamp(-nx * 0.75 - ny * 0.35 + nz * 0.55, 0, 1);
          const bi = Math.floor((ny + 1) * 5.2 + Math.sin(nx * 5 + ny * 3) * 0.35);
          let c = bands[((bi % bands.length) + bands.length) % bands.length];
          if (((dx + 7) / 4.4) ** 2 + ((dy - 8) / 2.4) ** 2 <= 1) c = spot;
          const x = jx + dx;
          const y = jy + dy;
          if (lum < 0.16 + bayer(x, y) * 0.16) c = night;
          else if (lum < 0.3 + bayer(x, y) * 0.12) c = dusk;
          plot(x, y, c);
        }
      }
      disc(98, 22, 2.2, hex('#d9dde6'));
      disc(109, 16, 1.5, hex('#c3c8d4'));
      plot(118, 11, hex('#aeb4c2'));

      for (let x = 0; x < W; x++) {
        const a = Math.round(112 + Math.sin(x * 0.021 + 1) * 10 + Math.sin(x * 0.067) * 4);
        const b = Math.round(128 + Math.sin(x * 0.03 + 2.4) * 8 + Math.sin(x * 0.09) * 3);
        for (let y = a; y < H; y++) plot(x, y, y === a ? hex('#39425f') : hex('#1b2136'));
        for (let y = b; y < H; y++) plot(x, y, y === b ? hex('#4a5479') : depthTone([[0, hex('#2a3150')], [20, hex('#20263f')]], y - b, x, y));
      }
      const tones: [number, number][] = [
        [0, hex('#a3aabb')],
        [8, hex('#7c8396')],
        [22, hex('#5a6074')],
        [46, hex('#3c4155')],
        [90, hex('#262a3b')],
      ];
      for (let x = 0; x < W; x++) {
        const top = gyi[x];
        for (let y = top; y < H; y++) {
          let c = depthTone(tones, y - top, x, y);
          const h = hash(x, y);
          if (h > 0.985) c = hex('#c2c8d4');
          else if (h > 0.94) c = hex('#4b5064');
          plot(x, y, c);
        }
        plot(x, top, hex('#e2e7f0'));
      }
      for (let i = 0; i < 14; i++) {
        const x = 40 + hash(i, 7) * 215;
        const rx = 2.5 + hash(i, 9) * 5;
        const ry = rx * 0.38;
        const cy = gy(x) + 3 + hash(i, 8) * 14;
        for (let dy = -Math.ceil(ry) - 1; dy <= Math.ceil(ry) + 1; dy++) {
          for (let dx = -Math.ceil(rx) - 1; dx <= Math.ceil(rx) + 1; dx++) {
            const e = (dx * dx) / (rx * rx) + (dy * dy) / (ry * ry);
            const px = Math.round(x) + dx;
            const py = Math.round(cy) + dy;
            if (py <= gyi[clamp(px, 0, W - 1)]) continue;
            if (e <= 0.72) plot(px, py, dx < rx * 0.1 ? hex('#3f4558') : hex('#8f96a8'));
            else if (e <= 1.25) plot(px, py, dy < 0 ? hex('#c3c9d6') : hex('#50566a'));
          }
        }
      }
      for (let i = 0; i < 12; i++) {
        const x = 34 + hash(i, 21) * 240;
        const r = 1 + hash(i, 22) * 1.4;
        disc(x, gy(x) - r * 0.6, r, hex('#6a7184'));
        plot(Math.round(x - r * 0.4), Math.round(gy(x) - r), hex('#d0d5df'));
      }
      // 峰顶 TMA-1 黑石碑
      const mb = gyi[294];
      for (let i = 0; i < 24; i++) pdither(297 + i, mb, hex('#1d2233'), 0.8 - i / 30);
      rect(290, mb - 17, 7, 17, hex('#020204'));
      rect(290, mb - 17, 1, 17, hex('#3e4663'));
      rect(290, mb - 17, 7, 1, hex('#5a6489'));

      stars = [];
      for (let i = 0; i < 150; i++) {
        const x = Math.floor(hash(i, 1) * W);
        const y = Math.floor(hash(i, 2) * 118);
        if (y >= gy(x) - 4 || y > 108) continue;
        if (Math.hypot(x - jx, y - jy) < jr + 2) continue;
        stars.push({ x, y, b: hash(i, 3), ph: hash(i, 4) * 6.28 });
      }
    };

    // 《银河帝国：基地》—— 川陀帝国摩天大楼首都 (Trantor Ecumenopolis) + 天空中的端点星 (Planet Terminus)
    const buildPaper = () => {
      // 1. 川陀穹顶大气渐变：高空星轨蓝灰 -> 中空帝国金辉 -> 城市地平线暖象牙色
      gradient([
        [0, '#2a3c56'],
        [28, '#466080'],
        [60, '#7c93ad'],
        [96, '#c8bfae'],
        [135, '#ebe1cc'],
      ]);

      // 高空微星与星轨经纬网格
      for (let i = 0; i < 45; i++) {
        const sx = Math.floor(hash(i, 61) * W);
        const sy = Math.floor(hash(i, 62) * 52);
        plot(sx, sy, i % 3 === 0 ? hex('#fff6dc') : hex('#a9c0d9'));
      }

      // 2. 天空中的【端点星 Planet Terminus】(海洋深蓝 + 百科全书金陆地 + 双层星环与轨道信标)
      const tx = 64;
      const ty = 36;
      const tr = 19;
      // 端点星背侧星环
      for (let s = 0; s < 140; s++) {
        const ang = (s / 140) * Math.PI; // 背部半环
        const rx = Math.cos(ang + Math.PI) * 34;
        const ry = Math.sin(ang + Math.PI) * 8.5;
        const px = tx + rx * 0.94 - ry * 0.34;
        const py = ty + rx * 0.34 + ry * 0.94;
        pdither(px, py, hex('#d4a756'), 0.85);
      }
      // 端点星球体（带极冠、海洋、大陆与晨昏线）
      const oceanLit = hex('#3a6691');
      const oceanMid = hex('#274769');
      const oceanDark = hex('#1b2e47');
      const landLit = hex('#e3c98d');
      const landMid = hex('#b89758');
      const iceCap = hex('#f7f2e4');
      for (let dy = -tr; dy <= tr; dy++) {
        for (let dx = -tr; dx <= tr; dx++) {
          const nx = dx / tr;
          const ny = dy / tr;
          const r2 = nx * nx + ny * ny;
          if (r2 > 1) continue;
          const nz = Math.sqrt(1 - r2);
          const lum = clamp(-nx * 0.6 - ny * 0.4 + nz * 0.68, 0, 1);
          const nCont = noise(nx * 3.4 + 7.2, ny * 3.4 + 2.1);
          const isLand = nCont > 0.53;
          const isPolar = Math.abs(ny) > 0.82;
          let c = isPolar ? iceCap : isLand ? (lum > 0.45 ? landLit : landMid) : (lum > 0.5 ? oceanLit : oceanMid);
          if (lum < 0.2 + bayer(tx + dx, ty + dy) * 0.16) c = oceanDark;
          plot(tx + dx, ty + dy, c);
        }
      }
      // 端点星前侧双星环与轨道百科空间站
      for (let s = 0; s < 160; s++) {
        const ang = (s / 160) * Math.PI;
        for (const [radX, radY, col] of [
          [34, 8.5, hex('#f0c875')],
          [28, 6.8, hex('#c8402a')],
        ] as [number, number, number][]) {
          const rx = Math.cos(ang) * radX;
          const ry = Math.sin(ang) * radY;
          const px = tx + rx * 0.94 - ry * 0.34;
          const py = ty + rx * 0.34 + ry * 0.94;
          pdither(px, py, col, 0.92);
        }
      }
      disc(tx + 31, ty + 11, 1.5, hex('#fff5d6')); // 端点星轨道空间站

      // 3. 川陀星环太空电梯主索 (Imperial Space Elevator Tether, x = 148)
      const elevX = 148;
      for (let y = 0; y < 140; y++) {
        plot(elevX, y, y % 4 === 0 ? hex('#f5d484') : hex('#5d6e82'));
        if (y % 14 === 0) {
          plot(elevX - 1, y, hex('#c8402a'));
          plot(elevX + 1, y, hex('#c8402a'));
        }
      }

      // 4. 川陀远景巨型帝国参议院穹顶与高耸尖塔天际线 (Far Megacity Layer)
      const farDark = hex('#526173');
      const farEdge = hex('#7f90a3');
      const farGold = hex('#d9b264');
      // 帝国中央大穹顶 (cx = 148, cy = 126, rx = 38, ry = 26)
      for (let dy = -26; dy <= 10; dy++) {
        for (let dx = -38; dx <= 38; dx++) {
          if ((dx * dx) / (38 * 38) + (dy * dy) / (26 * 26) <= 1) {
            const x = 148 + dx;
            const y = 126 + dy;
            const rib = Math.abs((dx % 9) + 4.5) < 1.1 || Math.abs(dy + 12) < 1;
            plot(x, y, rib ? farEdge : farDark);
          }
        }
      }
      // 远景摩天楼森林 (x = 0..290)
      let fx = 2;
      while (fx < 285) {
        const fw = 5 + Math.floor(hash(fx, 11) * 9);
        const fh = 24 + Math.floor(hash(fx, 12) * 54);
        const ftop = 138 - fh;
        for (let y = ftop; y < 142; y++) {
          for (let x = fx; x < Math.min(W, fx + fw); x++) {
            const isRim = x === fx || x === fx + fw - 1 || y === ftop;
            plot(x, y, isRim ? farEdge : farDark);
          }
        }
        // 塔尖信号塔
        if (hash(fx, 13) > 0.35) {
          const mid = fx + (fw >> 1);
          stroke(mid, ftop - 8, mid, ftop, 1, farEdge);
          plot(mid, ftop - 9, farGold);
        }
        fx += fw + 1 + Math.floor(hash(fx, 14) * 3);
      }

      // 5. 川陀中景高楼大厦群 (Mid-ground High-Rise Skyscrapers + Skybridges + Lit Windows)
      const bFace = hex('#2e3846');
      const bShade = hex('#1f2630');
      const bTrim = hex('#8c9bab');
      const bGold = hex('#e5ba63');
      const bRed = hex('#c8402a');
      const bWinLit = hex('#f7e09e');
      const bWinCyan = hex('#88c9e8');

      const towers: [number, number, number, number][] = [
        [8, 12, 72, 1],
        [24, 15, 58, 2],
        [43, 14, 78, 0],
        [61, 16, 52, 2],
        [81, 13, 66, 1],
        [98, 17, 46, 2],
        [119, 15, 62, 1],
        [139, 18, 38, 2], // 太空电梯基座摩天巨塔
        [161, 14, 56, 1],
        [179, 16, 48, 2],
        [199, 13, 64, 0],
        [216, 15, 54, 1],
        [235, 14, 68, 2],
      ];

      // 摩天楼之间的双层高空连廊 (Skybridges)
      for (let i = 0; i < towers.length - 1; i++) {
        const [xA, wA, topA] = towers[i];
        const [xB, , topB] = towers[i + 1];
        const by = Math.max(topA, topB) + 14;
        if (by < 138) {
          rect(xA + wA, by, xB - (xA + wA), 2, bTrim);
          rect(xA + wA, by + 1, xB - (xA + wA), 1, bGold);
        }
      }

      for (const [bx, bw, btop, style] of towers) {
        const bot = Math.min(155, gyi[clamp(bx + (bw >> 1), 0, W - 1)] + 4);
        for (let y = btop; y < bot; y++) {
          for (let x = bx; x < bx + bw; x++) {
            const isLeftLit = x < bx + (bw >> 1);
            const isBorder = x === bx || x === bx + bw - 1 || y === btop;
            let c = isBorder ? bTrim : isLeftLit ? bFace : bShade;
            // 密集的摩天楼窗户矩阵
            const wx = x - bx;
            const wy = y - btop;
            if (wx >= 2 && wx <= bw - 3 && wy >= 4 && wy % 3 !== 0 && wx % 2 === 1) {
              const wh = hash(x * 3, y * 5);
              if (wh > 0.35) c = wh > 0.86 ? bWinCyan : bWinLit;
            }
            if (wy === 2 || wy === 10) c = bGold;
            plot(x, y, c);
          }
        }
        // 阶梯式退台塔冠 (Art-Deco / Imperial Stepped Crown)
        if (style === 1) {
          rect(bx + 2, btop - 5, bw - 4, 5, bFace);
          rect(bx + 2, btop - 5, bw - 4, 1, bGold);
          stroke(bx + (bw >> 1), btop - 12, bx + (bw >> 1), btop - 5, 1, bTrim);
          plot(bx + (bw >> 1), btop - 13, bRed);
        } else if (style === 2) {
          // 帝国金字塔/穹顶塔冠
          poly([bx + 1, btop, bx + bw - 1, btop, bx + (bw >> 1), btop - 9], bGold);
          stroke(bx + (bw >> 1), btop - 15, bx + (bw >> 1), btop - 9, 1, bTrim);
          plot(bx + (bw >> 1), btop - 16, bRed);
        }
      }

      // 6. 主山坡：川陀帝国钛金大理石大道 (Imperial Titanium-Marble Causeway)
      const tones: [number, number][] = [
        [0, hex('#d8ccb4')],
        [8, hex('#b8aa90')],
        [22, hex('#8f826b')],
        [46, hex('#665c4b')],
        [85, hex('#453e33')],
      ];
      const ink = hex('#24201c');
      for (let x = 0; x < W; x++) {
        const top = gyi[x];
        for (let y = top; y < H; y++) {
          const d = y - top;
          let c = depthTone(tones, d, x, y);
          // 帝国装甲金属接缝与金色心理史学导轨线
          if (d === 3) c = hex('#d4a756');
          else if (d === 4) c = hex('#6e5832');
          else if (d > 5 && ((x + (d >> 3) * 11) % 22 === 0 || d % 10 === 0)) c = hex('#594f40');
          plot(x, y, c);
        }
        plot(x, top, hex('#fff6e0'));
        if (top + 1 < H) plot(x, top + 1, ink);
      }

      // 大道沿途的帝国路灯柱与全息信标桩
      for (let lx = 44; lx <= 252; lx += 34) {
        const ly = gyi[lx];
        rect(lx, ly - 8, 1, 8, hex('#3b4654'));
        rect(lx - 1, ly - 9, 3, 2, hex('#f0c875'));
        plot(lx, ly - 10, hex('#c8402a'));
      }

      // 7. 峰顶：谢顿时间穹顶与第一辐光浑天圣殿 (Seldon Time Vault & Prime Radiant Rotunda)
      const tb = gyi[298];
      // 穹顶阶梯基座
      rect(286, tb - 3, 26, 3, hex('#4a5568'));
      rect(288, tb - 11, 22, 8, hex('#dcd0b8'));
      for (let cx = 290; cx <= 308; cx += 3) {
        rect(cx, tb - 11, 1, 8, hex('#736857'));
      }
      // 帝国穹顶金顶与悬浮第一辐光环
      for (let dy = -9; dy <= 0; dy++) {
        const hw = Math.round(Math.sqrt(Math.max(0, 11 * 11 - dy * dy * 1.4)));
        rect(299 - hw, tb - 11 + dy, hw * 2, 1, dy < -5 ? hex('#e5ba63') : hex('#3a506b'));
      }
      ring(299, tb - 22, 6, 2.5, hex('#e5ba63'), 1);
      disc(299, tb - 22, 1.8, hex('#c8402a'));
    };

    const buildCrt = () => {
      const bg = hex('#010502');
      for (let i = 0; i < N; i++) buf[i] = bg;
      let x = 0;
      while (x < W) {
        const w = 6 + Math.floor(hash(x, 1) * 14);
        const h = 18 + Math.floor(hash(x, 2) * 52);
        const top = 148 - h;
        for (let yy = top; yy < 148; yy++) {
          for (let xx = x; xx < Math.min(W, x + w); xx++) {
            const edge = xx === x || xx === x + w - 1 || yy === top;
            let c = hex('#020a04');
            if (edge) c = hex('#0b3a1a');
            else if ((xx - x) % 3 === 1 && (yy - top) % 4 === 2 && hash(xx, yy) > 0.45) c = hex('#0f5a28');
            plot(xx, yy, c);
          }
        }
        x += w + 1 + Math.floor(hash(x, 3) * 3);
      }
      for (let xx = 0; xx < W; xx++) plot(xx, 148, hex('#0b3a1a'));
      for (let xx = 0; xx < W; xx++) {
        const top = gyi[xx];
        for (let y = top; y < H; y++) plot(xx, y, hex('#010703'));
        for (let k = 1; top + k * 5 < H; k++) {
          const c = k < 3 ? hex('#0f6a2c') : k < 6 ? hex('#0b4a20') : hex('#072e14');
          pdither(xx, top + k * 5, c, 1 - k * 0.07);
        }
        if (xx % 10 === 0) for (let y = top + 1; y < H; y++) pdither(xx, y, hex('#083818'), 0.7);
        plot(xx, top, hex('#3dff7a'));
        if (top + 1 < H) plot(xx, top + 1, hex('#127a35'));
      }
      const db = gyi[298];
      rect(293, db - 16, 10, 16, hex('#3dff7a'));
      rect(294, db - 15, 8, 15, hex('#0a2e14'));
      rect(297, db - 14, 2, 14, hex('#c8ffd9'));
      for (let i = 0; i < 16; i++) pdither(303 + i, db, hex('#0f6a2c'), 0.8 - i / 20);
    };

    const buildAmber = () => {
      gradient([
        [0, '#170b1c'],
        [38, '#33142c'],
        [72, '#6b2632'],
        [100, '#b34a33'],
        [124, '#e58a46'],
        [142, '#f2b866'],
      ]);
      for (let r = 34; r > 22; r--) ring(230, 128, r, r, hex('#f6c27a'), 0.5 - (r - 22) / 30);
      disc(230, 128, 22, hex('#fbdc98'));
      disc(70, 30, 10, hex('#f0dcc0'));
      for (let dy = -10; dy <= 10; dy++) {
        for (let dx = -10; dx <= 10; dx++) {
          if (dx * dx + dy * dy > 100) continue;
          const lit = (dx + 3) / 10;
          if (lit < bayer(70 + dx, 30 + dy) * 0.9 - 0.4) plot(70 + dx, 30 + dy, hex('#b9a487'));
        }
      }
      const mouse = hex('#c9af8e');
      fillEllipse(70, 32, 2.4, 1.3, mouse);
      plot(73, 31, mouse);
      plot(73, 30, mouse);
      plot(74, 31, mouse);
      plot(67, 33, mouse);
      plot(66, 32, mouse);
      plot(65, 31, mouse);
      plot(65, 30, mouse);
      disc(101, 18, 4.5, hex('#dcc6a4'));
      for (let i = 0; i < 40; i++) {
        const sx = Math.floor(hash(i, 51) * W);
        const sy = Math.floor(hash(i, 52) * 40);
        if (Math.hypot(sx - 70, sy - 30) > 13) plot(sx, sy, hex('#f5d9c0'));
      }
      for (let x = 0; x < W; x++) {
        const t = Math.round(122 + Math.sin(x * 0.018 + 0.5) * 6 + Math.sin(x * 0.051 + 1.2) * 3);
        for (let y = t; y < H; y++) plot(x, y, y === t ? hex('#c06440') : hex('#8a3e2c'));
      }
      for (let x = 0; x < W; x++) {
        const t = midDuneI[x];
        const lit = midDune(x + 1) - midDune(x) > 0;
        for (let y = t; y < H; y++) plot(x, y, y === t ? hex('#e3894c') : lit ? hex('#bb6234') : hex('#8f4426'));
      }
      const tones: [number, number][] = [
        [0, hex('#d7843f')],
        [12, hex('#c06f36')],
        [35, hex('#a35a2d')],
        [80, hex('#7e4325')],
      ];
      for (let x = 0; x < W; x++) {
        const top = gyi[x];
        for (let y = top; y < H; y++) {
          const d = y - top;
          let c = depthTone(tones, d, x, y);
          const r = Math.sin(x * 0.42 + d * 1.25 + noise(x * 0.05, y * 0.08) * 3);
          if (d < 45 && r > 0.85) c = hex('#eaa25c');
          else if (r < -0.9) c = hex('#9b512b');
          plot(x, y, c);
        }
        plot(x, top, hex('#f7c27c'));
      }
      const rock = hex('#4a2418');
      const rockLit = hex('#8a4a2c');
      poly([282, 63, 288, 42, 292, 46, 297, 30, 302, 40, 308, 33, 314, 48, 320, 44, 320, 63], rock);
      stroke(288, 43, 285, 60, 1, rockLit);
      stroke(297, 31, 293, 58, 1, rockLit);
      stroke(308, 34, 305, 58, 1, rockLit);
      for (let x = 282; x < W; x++) plot(x, gyi[x], hex('#f7c27c'));
    };

    const buildStatic = () => {
      toLayer = false;
      clipFn = null;
      if (realm === 'void') buildVoid();
      else if (realm === 'paper') buildPaper();
