---
import { CAMUS_QUOTE } from '../consts';

interface Props {
  initialSummits?: number;
}

const { initialSummits = 1 } = Astro.props;
---

<div class="bento-card col-7 sisyphus-stage-card">
  <div class="bento-head">
    <span class="bento-head-title">
      <span class="term-ascii-icon">/▲</span>
      <span id="sisyphus-stage-title">01 // TMA-1 · 第谷环形山</span>
      <span class="sisyphus-res-pill" title="xterm.js 离屏字形纹理图集 (224×72 格) + Chafa 双色象限/盲文混合光栅 (448×288 亚像素) + 3D 法线球体光照">
        448×288 HD
      </span>
    </span>
    <div class="sisyphus-head-actions">
      <button
        type="button"
        class="term-btn is-primary"
        id="sisyphus-push-btn"
        title="卡准下方节拍槽亮起时点击（或按空格键），触发 2.2x 完美发力暴击！"
      >
        [+PUSH 助推]
      </button>
      <button
        type="button"
        class="term-btn is-theme-skill"
        id="sisyphus-skill-btn"
        title="触发当前文艺作品主题专属天象神迹与互动机制 (快捷键 E)"
      >
        [◈ 1:4:9 星门]
      </button>
      <button
        type="button"
        class="term-btn"
        id="sisyphus-summit-btn"
        title="快进体验完整：冲顶驻足 → 巨石抛物崩落 → 走下山坡无缝轮回"
      >
        [&gt;&gt; 冲顶轮回]
      </button>
    </div>
  </div>

  <!-- 224x72 (448x288 亚像素 = 129,024 点阵) xterm.js CustomGlyph 图集 + Chafa 双色象限光栅混合渲染容器 -->
  <div
    class="ascii-slope-viewport"
    id="sisyphus-stage-viewport"
    tabindex="0"
    aria-label="西西弗斯四大科幻文学主题高分像素终端互动剧场（支持鼠标点击热点、空格键节拍助推与 E 键主题神迹）"
  >
    <canvas
      id="sisyphus-ascii-canvas"
      class="ascii-slope-canvas"
      aria-label="448x288 亚像素点阵、Chafa 双色象限像素骨骼、3D 法线光照巨石与 xterm.js 字形图集混合渲染的西西弗斯剧场"></canvas>
    <pre
      class="ascii-slope-pre is-sr-mirror"
      id="sisyphus-ascii-stage"
      aria-hidden="true"></pre>
  </div>

  <!-- 终端互动小游戏状态栏：推石节拍共鸣槽 + 沿途五大文学地标 + 热点交互提示 -->
  <div class="sisyphus-minigame-bar" id="sisyphus-minigame-bar">
    <div
      class="minigame-cadence-box"
      id="sisyphus-cadence-box"
      title="当游标进入中央 [█] 共振区时点击助推或按 Space 键，触发 2.2x 完美发力与连击！"
    >
      <span class="cadence-label">CADENCE</span>
      <span class="cadence-track" id="sisyphus-cadence-meter">░░▒▓█▓▒░░</span>
      <span class="cadence-combo" id="sisyphus-combo-badge">SYNC</span>
    </div>
    <div class="minigame-milestones" id="sisyphus-milestone-strip" aria-label="攀登沿途五大文学主题营地">
      <span class="ms-node is-reached" data-ms-idx="0" title="营地 I (180m)">I</span>
      <span class="ms-sep">─</span>
      <span class="ms-node" data-ms-idx="1" title="营地 II (380m)">II</span>
      <span class="ms-sep">─</span>
      <span class="ms-node" data-ms-idx="2" title="营地 III (580m)">III</span>
      <span class="ms-sep">─</span>
      <span class="ms-node" data-ms-idx="3" title="营地 IV (740m)">IV</span>
      <span class="ms-sep">─</span>
      <span class="ms-node" data-ms-idx="4" title="峰顶圣殿 (884.8m)">▲</span>
    </div>
    <div class="minigame-hotspot-hint" id="sisyphus-hotspot-hint">
      ◈ 悬停画布锁定天象/地下奇观 · 卡准节拍点击触发完美共鸣
    </div>
  </div>

  <div class="bento-foot">
    <span id="sisyphus-telemetry" data-summits={initialSummits}>
      ALT 210.0m / 884.8m · ETA 06h 05m · #1
    </span>
    <span id="sisyphus-phase-quote">"{CAMUS_QUOTE}"</span>
  </div>
</div>

<script>
  const stageEl = document.getElementById('sisyphus-ascii-stage');
  const canvasEl = document.getElementById('sisyphus-ascii-canvas') as HTMLCanvasElement | null;
  const viewportEl = document.getElementById('sisyphus-stage-viewport');
  const stageTitleEl = document.getElementById('sisyphus-stage-title');
  const telemetryEl = document.getElementById('sisyphus-telemetry');
  const quoteEl = document.getElementById('sisyphus-phase-quote');
  const pushBtn = document.getElementById('sisyphus-push-btn');
  const skillBtn = document.getElementById('sisyphus-skill-btn') as HTMLButtonElement | null;
  const summitBtn = document.getElementById('sisyphus-summit-btn');
  const cadenceMeterEl = document.getElementById('sisyphus-cadence-meter');
  const comboBadgeEl = document.getElementById('sisyphus-combo-badge');
  const cadenceBoxEl = document.getElementById('sisyphus-cadence-box');
  const hotspotHintEl = document.getElementById('sisyphus-hotspot-hint');
  const milestoneNodes = Array.from(
    document.querySelectorAll<HTMLElement>('#sisyphus-milestone-strip .ms-node'),
  );

  if (stageEl && telemetryEl) {
    // ================= 1. 4倍超采样分辨率矩阵参数 (xterm.js Atlas + Chafa Hybrid) =================
    // 224x72 字符格 = 16,128 格；Drawille 2x4 盲文层 = 448x288 (129,024 亚像素)；Chafa 2x2 双色象限层 = 448x144
    const COLS = 224;
    const ROWS = 72;
    const SUB_W = COLS * 2; // 448 水平亚像素
    const SUB_H = ROWS * 4; // 288 垂直盲文亚像素
    const QUAD_W = COLS * 2; // 448 水平象限像素
    const QUAD_H = ROWS * 2; // 144 垂直象限像素
    const CELL_W = 4; // 逻辑列宽 4px (224 * 4 = 896)
    const CELL_H = 7; // 逻辑行高 7px (72 * 7 = 504)
    const CYCLE_MS = 8 * 60 * 60 * 1000;
    const PEAK_ALT = 884.8;
    const STORAGE_KEY = 'sisyphus_8h_cycle_v2';
    const baseSummits = Number(telemetryEl.dataset.summits || '1');

    // 物理像素倍率锁定 >=2，保证每个 4x7 单元格在纹理图集中拥有至少 8x14 乃至 12x21 的物理像素锐度
    const atlasDpr = Math.max(2, Math.min(3, Math.ceil(window.devicePixelRatio || 2)));
    const TILE_W = CELL_W * atlasDpr; // 8px or 12px
    const TILE_H = CELL_H * atlasDpr; // 14px or 21px

    let ctx: CanvasRenderingContext2D | null = null;
    if (canvasEl && typeof canvasEl.getContext === 'function') {
      canvasEl.width = COLS * TILE_W;
      canvasEl.height = ROWS * TILE_H;
      ctx = canvasEl.getContext('2d', { alpha: false });
      if (ctx) {
        ctx.imageSmoothingEnabled = false;
      }
    }

    // ================= 2. 四部科幻巨著的文本与地标配置 =================
    const STAGE_TITLES: Record<string, string> = {
      void: '01 // TMA-1 · 第谷环形山',
      paper: '01 // TERMINUS · 端点星穹顶',
      crt: '01 // ZION · 尼布甲尼撒号',
      amber: '01 // ARRAKIS · 塔布尔穴地',
    };

    const SKILL_SPECS: Record<
      string,
      { label: string; activeName: string; desc: string; quote: string }
    > = {
      void: {
        label: '[◈ 1:4:9 星门]',
        activeName: 'STAR-GATE HARMONIC // 1:4:9 星门引力走廊',
        desc: '点击大红斑木星、旋转离心舱发现号或红眼 HAL-9000，开启 1:4:9 星门零重力跃迁',
        quote: '"My God, it\'s full of stars! 1:4:9 星门引力场已接管三维巨石质量。"',
      },
      paper: {
        label: '[Ψ 辐光推演]',
        activeName: 'PRIME RADIANT // 谢顿危机微分奇点配平',
        desc: '点击三维第一辐光流形上的谢顿危机奇点或地下全息穹顶，钤盖【基地纪元】朱砂大印',
        quote: '"心理史学方程收敛：∆S/∆t = 0，第三次谢顿危机已化为历史必然性推力！"',
      },
      crt: {
        label: '[⚡ 矩阵EMP]',
        activeName: 'NEBUCHADNEZZAR EMP // 锡安电磁脉冲与子弹时间',
        desc: '点击 6 触手 IK 机械乌贼哨兵或气垫船，释放 EMP 令巨石进入 0x00 线框减重与子弹时间',
        quote: '"There is no boulder. 尼布甲尼撒号 EMP 已震碎乌贼哨兵，母体重力代码重写！"',
      },
      amber: {
        label: '[◈ 沙槌驭虫]',
        activeName: 'SHAI-HULUD BREACH // 弗雷曼沙钩驭虫冲锋',
        desc: '点击山脚沙槌、香料喷发带或扑翼机，召唤环形晶齿巨型沙虫夏胡鲁破沙驮石狂飙',
        quote: '"Bless the Maker and His water! 弗雷曼沙钩已挂住夏胡鲁背鳞，驭虫冲顶！"',
      },
    };

    const REALM_MILESTONES: Record<string, { col: number; alt: number; code: string; name: string }[]> = {
      void: [
        { col: 60, alt: 180, code: 'CLV', name: '克拉维斯基地 (180m)' },
        { col: 100, alt: 380, code: 'TMA', name: 'TMA-1 发掘坑 (380m)' },
        { col: 138, alt: 580, code: 'JUP', name: '木星引力锚点 (580m)' },
        { col: 172, alt: 740, code: 'HAL', name: '发现号离心舱 (740m)' },
        { col: 206, alt: 884.8, code: '1:4:9', name: '星门方尖碑巅 (884.8m)' },
      ],
      paper: [
        { col: 60, alt: 180, code: 'TRM', name: '端点星百科馆 (180m)' },
        { col: 100, alt: 380, code: 'VLT', name: '谢顿全息穹顶 (380m)' },
        { col: 138, alt: 580, code: 'TRN', name: '川陀帝国书库 (580m)' },
        { col: 172, alt: 740, code: '2ND', name: '第二基地星院 (740m)' },
        { col: 206, alt: 884.8, code: 'GAL', name: '银河新纪元巅 (884.8m)' },
      ],
      crt: [
        { col: 60, alt: 180, code: 'CST', name: '纯白构造层 (180m)' },
        { col: 100, alt: 380, code: 'ORC', name: '先知公寓节点 (380m)' },
        { col: 138, alt: 580, code: 'ZIN', name: '锡安船坞防线 (580m)' },
        { col: 172, alt: 740, code: 'MCH', name: '零一机械城门 (740m)' },
        { col: 206, alt: 884.8, code: 'SRC', name: '万物之源核心 (884.8m)' },
      ],
      amber: [
        { col: 60, alt: 180, code: 'TBR', name: '塔布尔穴地 (180m)' },
        { col: 100, alt: 380, code: 'SHD', name: '障壁山脉裂口 (380m)' },
        { col: 138, alt: 580, code: 'SPC', name: '大香料盐盘 (580m)' },
        { col: 172, alt: 740, code: 'WND', name: '弗雷曼集风塔 (740m)' },
        { col: 206, alt: 884.8, code: 'ARK', name: '厄拉奇恩皇座巅 (884.8m)' },
      ],
    };

    const WORLD_QUOTES: Record<string, string> = {
      void: '"My God, it\'s full of stars..." —— 大卫·鲍曼 · 发现号 (TMA-1 / 1:4:9)',
      paper: '"跨越三万年银河暗夜的，是端点星日复一日的编纂与推石。" —— 哈里·谢顿',
      crt: '"Do not try to bend the boulder. Only realize the truth: there is only the climb."',
      amber: '"恐惧是思维的杀手。当沙暴掠过障壁山脉，唯余我与巨石长存。" —— 贝尼·杰瑟里特祷文',
    };

    const BUBBLE_LINES: Record<string, string[]> = {
      void: ['(TMA-1 1:4:9)', '(HAL watching)', '(Clavius ridge)', '(full of stars)', '(EVA nominal)'],
      paper: ['(dS/dt > 0)', '(for Terminus)', '(Seldon Vault)', '(Prime Radiant)', '(Encyclopedia)'],
      crt: ['(no spoon...)', '(Zion uplink)', '(Nebuchadnezzar)', '(Construct ok)', '(still happy)'],
      amber: ['(Sietch Tabr)', '(Shield Wall)', '(walk without)', '(Shai-Hulud!)', '(Kull Wahad!)'],
    };

    // ================= 3. 16 通道扩展色板与 xterm.js 离屏 CustomGlyph 字形纹理图集 =================
    interface StagePalette {
      bg: string;
      colors: string[]; // 0..15
    }
    let cachedRealm = '';
    let palette: StagePalette = {
      bg: '#060813',
      colors: Array(16).fill('#64748b'),
    };

    const parseRgb = (colorStr: string): [number, number, number] => {
      const s = colorStr.trim();
      if (s.startsWith('#')) {
        const hex = s.slice(1);
        const full =
          hex.length === 3
            ? hex
                .split('')
                .map((c) => c + c)
                .join('')
            : hex.slice(0, 6);
        const num = parseInt(full, 16);
        if (!Number.isNaN(num)) {
          return [(num >> 16) & 255, (num >> 8) & 255, num & 255];
        }
      }
      if (s.startsWith('rgb')) {
        const nums = s.match(/\d+(\.\d+)?/g);
        if (nums && nums.length >= 3) {
          return [Number(nums[0]), Number(nums[1]), Number(nums[2])];
        }
      }
      return [100, 116, 139];
    };

    const mixColor = (cA: string, cB: string, t: number): string => {
      const [r1, g1, b1] = parseRgb(cA);
      const [r2, g2, b2] = parseRgb(cB);
      const r = Math.round(r1 + (r2 - r1) * t);
      const g = Math.round(g1 + (g2 - g1) * t);
      const b = Math.round(b1 + (b2 - b1) * t);
      return `rgb(${r},${g},${b})`;
    };

    // xterm.js 风格离屏字形纹理图集缓存 (按 (char, fgColorId) 懒加载烘焙至 64x128 瓦片网格)
    const ATLAS_COLS = 64;
    const ATLAS_ROWS = 128;
    const atlasCanvas = document.createElement('canvas');
    atlasCanvas.width = ATLAS_COLS * TILE_W;
    atlasCanvas.height = ATLAS_ROWS * TILE_H;
    const atlasCtx = atlasCanvas.getContext('2d');
    const atlasMap = new Map<string, number>();
    let atlasNextSlot = 0;

    const clearGlyphAtlas = () => {
      atlasMap.clear();
      atlasNextSlot = 0;
      if (atlasCtx) {
        atlasCtx.clearRect(0, 0, atlasCanvas.width, atlasCanvas.height);
      }
    };

    // Unicode 象限块字符集 (Chafa 2x2 掩码 0..15)
    const QUAD_CHARS = [
      ' ',
      '▘',
      '▝',
      '▀',
      '▖',
      '▌',
      '▞',
      '▛',
      '▗',
      '▚',
      '▐',
      '▜',
      '▄',
      '▙',
      '▟',
      '█',
    ] as const;
    const QUAD_CHAR_MAP = new Map<string, number>(QUAD_CHARS.map((ch, idx) => [ch, idx]));

    const BRAILLE_BITS = [
      [0x01, 0x02, 0x04, 0x40],
      [0x08, 0x10, 0x20, 0x80],
    ];

    // Bayer 8x8 有序抖动矩阵 (0..1)
    const BAYER_8X8 = [
      [0, 32, 8, 40, 2, 34, 10, 42],
      [48, 16, 56, 24, 50, 18, 58, 26],
      [12, 44, 4, 36, 14, 46, 6, 38],
      [60, 28, 52, 20, 62, 30, 54, 22],
      [3, 35, 11, 43, 1, 33, 9, 41],
      [51, 19, 59, 27, 49, 17, 57, 25],
      [15, 47, 7, 39, 13, 45, 5, 37],
      [63, 31, 55, 23, 61, 29, 53, 21],
    ].map((row) => row.map((v) => (v + 0.5) / 64));

    // xterm.js CustomGlyphs 整数像素精确自绘（彻底消除字体拼缝！）
    const getOrBakeGlyphSlot = (ch: string, colorId: number): number => {
      const key = `${ch}_${colorId}`;
      const existing = atlasMap.get(key);
      if (existing !== undefined) return existing;

      if (atlasNextSlot >= ATLAS_COLS * ATLAS_ROWS) {
        clearGlyphAtlas();
      }
      const slot = atlasNextSlot++;
      atlasMap.set(key, slot);
      if (!atlasCtx) return slot;

      const ox = (slot % ATLAS_COLS) * TILE_W;
      const oy = Math.floor(slot / ATLAS_COLS) * TILE_H;
      const color = palette.colors[colorId] || palette.colors[0];
      atlasCtx.fillStyle = color;

      const hw = TILE_W >> 1;
      const hh = TILE_H >> 1;

      // 1. Chafa 2x2 象限像素块：整数矩形零裂缝自绘
      const quadMask = QUAD_CHAR_MAP.get(ch);
      if (quadMask !== undefined) {
        if (quadMask & 1) atlasCtx.fillRect(ox, oy, hw, hh);
        if (quadMask & 2) atlasCtx.fillRect(ox + hw, oy, TILE_W - hw, hh);
        if (quadMask & 4) atlasCtx.fillRect(ox, oy + hh, hw, TILE_H - hh);
        if (quadMask & 8) atlasCtx.fillRect(ox + hw, oy + hh, TILE_W - hw, TILE_H - hh);
        return slot;
      }

      // 2. Unicode 2x4 盲文点阵 (U+2800..U+28FF)：自绘精密亚像素晶点
      const code = ch.charCodeAt(0);
      if (code >= 0x2800 && code <= 0x28ff) {
        const mask = code - 0x2800;
        const dotW = Math.max(2, Math.floor(TILE_W * 0.3));
        const dotH = Math.max(2, Math.floor(TILE_H * 0.16));
        const x0 = Math.floor(TILE_W * 0.14);
        const x1 = Math.floor(TILE_W * 0.58);
        for (let dx = 0; dx < 2; dx++) {
          for (let dy = 0; dy < 4; dy++) {
            if (mask & BRAILLE_BITS[dx][dy]) {
              const px = ox + (dx === 0 ? x0 : x1);
              const py = oy + Math.floor((dy + 0.25) * (TILE_H / 4));
              atlasCtx.fillRect(px, py, dotW, dotH);
            }
          }
        }
        return slot;
      }

      // 3. 阶梯阴影密度块 (░ ▒ ▓)：自绘 Bayer 像素网点
      if (ch === '░' || ch === '▒' || ch === '▓') {
        const thresh = ch === '░' ? 0.25 : ch === '▒' ? 0.5 : 0.75;
        const step = Math.max(1, Math.floor(atlasDpr));
        for (let py = 0; py < TILE_H; py += step) {
          for (let px = 0; px < TILE_W; px += step) {
            const bx = Math.floor(px / step) & 7;
            const by = Math.floor(py / step) & 7;
            if (BAYER_8X8[by][bx] < thresh) {
              atlasCtx.fillRect(ox + px, oy + py, step, step);
            }
          }
        }
        return slot;
      }

      // 4. 其它 ASCII / 数学符号 / 假名 / 制表符：高锐度等宽字体烘焙
      atlasCtx.save();
      atlasCtx.beginPath();
      atlasCtx.rect(ox, oy, TILE_W, TILE_H);
      atlasCtx.clip();
      atlasCtx.font = `700 ${Math.round(TILE_H * 0.82)}px Menlo, Monaco, Consolas, "JetBrains Mono", "SF Mono", monospace`;
      atlasCtx.textAlign = 'center';
      atlasCtx.textBaseline = 'middle';
      atlasCtx.fillText(ch, ox + TILE_W * 0.5, oy + TILE_H * 0.52);
      atlasCtx.restore();
      return slot;
    };

    const refreshPalette = (realm: string) => {
      if (realm === cachedRealm) return;
      cachedRealm = realm;
      try {
        const cs = getComputedStyle(document.documentElement);
        const getVar = (name: string, fallback: string) =>
          cs.getPropertyValue(name).trim() || fallback;
        const bg = getVar('--stage-bg', '#060813');
        const sky = getVar('--stage-sky', '#fde68a');
        const aurora = getVar('--stage-aurora', '#38bdf8');
        const aurora2 = getVar('--stage-aurora-2', '#818cf8');
        const far = getVar('--stage-far', '#475569');
        const ridge = getVar('--stage-ridge', '#e2e8f0');
        const earth = getVar('--stage-earth', '#64748b');
        const hero = getVar('--stage-hero', '#38bdf8');
        const rock = getVar('--stage-rock', '#cbd5e1');
        const fire = getVar('--stage-fire', '#f43f5e');
        const hud = getVar('--text', '#f8fafc');

        palette = {
          bg,
          colors: [
            bg, // 0: background / transparent
            sky, // 1: primary celestial highlight
            aurora, // 2: secondary cyan/emerald/fremen-blue
            aurora2, // 3: tertiary violet/magenta/amber
            far, // 4: distant mountain / structure
            ridge, // 5: ridge crest highlight
            earth, // 6: sunlit terrain strata
            hero, // 7: Sisyphus primary suit/cloak
            rock, // 8: 3D boulder sunlit facet
            fire, // 9: HAL red / vermilion seal / sentinel laser / spice fire
            hud, // 10: crisp HUD text
            mixColor(earth, bg, 0.72), // 11: deep raycast umbra shadow
            mixColor(earth, bg, 0.42), // 12: mid geological strata shadow
            mixColor(rock, bg, 0.52), // 13: 3D boulder dark hemisphere
            mixColor(hero, bg, 0.48), // 14: Sisyphus back limbs & shadow
            mixColor(aurora, bg, 0.76), // 15: subtle atmospheric / chamber glow
          ],
        };
        clearGlyphAtlas();
      } catch {}
    };

    // ================= 4. 8 小时持久化轮回与小游戏状态 =================
    interface CycleSave {
      anchorEpoch: number;
      boostAccum: number;
      boostMeters: number;
    }

    const nowInit = Date.now();
    const initEpoch = Math.floor(nowInit / CYCLE_MS);
    let save: CycleSave = {
      anchorEpoch: initEpoch,
      boostAccum: 0,
      boostMeters: 0,
    };

    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (
          typeof parsed.anchorEpoch === 'number' &&
          typeof parsed.boostAccum === 'number'
        ) {
          save = {
            anchorEpoch: parsed.anchorEpoch,
            boostAccum: parsed.boostAccum,
            boostMeters: Number(parsed.boostMeters || 0),
          };
        }
      } else {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(save));
      }
    } catch {}

    const persistSave = () => {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(save));
      } catch {}
    };

    const getTotalRawCycles = (nowMs: number) => {
      const elapsedEpochs = nowMs / CYCLE_MS - save.anchorEpoch;
      return Math.max(0, elapsedEpochs + save.boostAccum);
    };

    type Phase = 'CLIMB' | 'SUMMIT_BREATH' | 'AVALANCHE' | 'DESCENT_WALK';
    let phase: Phase = 'CLIMB';
    let phaseElapsed = 0;

    const initTotal = getTotalRawCycles(nowInit);
    let activeCycleIndex = Math.floor(initTotal);
    let displayFrac = initTotal - activeCycleIndex;
    let boostVelocity = 0;
    let sprintToSummit = false;
    let boostBannerTimer = 0;
    let lastBoostGainMeters = 0;
    let lastBoostSource = '主动助推';

    let boulderProg = displayFrac;
    let sisyphusProg = Math.max(0, displayFrac - 0.056);
    let avalancheVel = 0;
    let continuousRoll = 0;
    let continuousStep = 0;

    // 小游戏与四大文艺作品专属互动状态
    let cadenceClock = 0;
    let comboCount = 0;
    let comboDecayTimer = 0;
    let critFlashTimer = 0;
    let themeSkillTimer = 0;
    let undergroundPulseTimer = 0;

    let halAlertPhase = 0;
    let crisisCol = 132;
    let sentinelX = 160;
    let sentinelY = 18;
    let sentinelStunTimer = 0;

    interface InteractiveHotspot {
      id: 'boulder' | 'sky_anomaly' | 'celestial' | 'sub_core' | 'milestone';
      col: number;
      row: number;
      w: number;
      h: number;
      label: string;
      hint: string;
    }
    let pointerCol = -1;
    let pointerRow = -1;
    let hoveredHotspot: InteractiveHotspot | null = null;
    let activeHotspots: InteractiveHotspot[] = [];

    interface SubParticle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      gravity: number;
      life: number;
      maxLife: number;
      cls: number;
    }
    const subParticles: SubParticle[] = [];

    interface FloatingTag {
      col: number;
      row: number;
      text: string;
      cls: number;
      life: number;
      maxLife: number;
    }
    const floatingTags: FloatingTag[] = [];

    const spawnFloatingTag = (col: number, row: number, text: string, cls = 9, maxLife = 1.35) => {
      if (floatingTags.length > 6) floatingTags.shift();
      floatingTags.push({
        col: Math.max(2, Math.min(COLS - text.length - 2, Math.round(col))),
        row: Math.max(2, Math.min(ROWS - 4, row)),
        text,
        cls,
        life: 0,
        maxLife,
      });
    };

    // 三层透视黑客帝国代码雨 (近景、中景、远景)
    const matrixDrops = Array.from({ length: 48 }, (_, i) => ({
      col: 6 + i * 4.4 + (i % 3),
      y: (i * 5.3) % 64,
      speed: (i % 3 === 0 ? 11.5 : i % 3 === 1 ? 7.8 : 4.8) + (i % 4) * 1.2,
      len: 5 + (i % 7),
      layer: i % 3, // 0: near bright, 1: mid emerald, 2: far dim
    }));

    let skyStrikeTimer = 0;
    let skyStrikeCol = 108;

    // ================= 5. 224x72 高精度山脊地形函数与法线坡度 =================
    const terrainY = (c: number): number => {
      if (c <= 18) return 68.4;
      if (c >= 198) return 24.4;
      const u = (c - 18) / 180;
      const base = 68.4 - u * 44.0; // 68.4 -> 24.4
      const undulation =
        -Math.sin(u * Math.PI * 4.0) * 3.3 * Math.sin(u * Math.PI) +
        Math.sin(u * Math.PI * 8.0) * 0.9 * Math.sin(u * Math.PI);
      return Math.max(23.6, Math.min(68.8, base + undulation));
    };

    const getTerrainGrade = (c: number): number => {
      const c0 = Math.max(0, Math.min(COLS - 3, c - 1));
      const c1 = Math.min(COLS - 1, c0 + 2);
      return (terrainY(c0) - terrainY(c1)) / (c1 - c0);
    };

    const progToCol = (p: number): number => {
      const clamped = Math.max(0, Math.min(1, p));
      return 28.0 + clamped * 173.0; // 28.0 -> 201.0
    };

    // 2D 快速连续噪声函数 (用于木星云带、沙丘风纹、北斋等高线与地质断层)
    const hash2D = (x: number, y: number): number => {
      const h = Math.sin(x * 127.1 + y * 311.7) * 43758.5453;
      return h - Math.floor(h);
    };

    const valueNoise2D = (x: number, y: number): number => {
      const ix = Math.floor(x);
      const iy = Math.floor(y);
      const fx = x - ix;
      const fy = y - iy;
      const ux = fx * fx * (3 - 2 * fx);
      const uy = fy * fy * (3 - 2 * fy);
      const a = hash2D(ix, iy);
      const b = hash2D(ix + 1, iy);
      const c = hash2D(ix, iy + 1);
      const d = hash2D(ix + 1, iy + 1);
      return a + (b - a) * ux + (c - a) * uy + (a - b - c + d) * ux * uy;
    };

    const spawnSubParticles = (
      colX: number,
      rowY: number,
      count: number,
      dirX: number,
      cls: number,
      gravity = 56.0,
    ) => {
      for (let i = 0; i < count; i++) {
        if (subParticles.length > 180) subParticles.shift();
        subParticles.push({
          x: colX * 2 + (Math.random() - 0.5) * 5,
          y: rowY * 4 + (Math.random() - 0.5) * 5,
          vx: dirX * (12 + Math.random() * 34) + (Math.random() - 0.5) * 14,
          vy: -(14 + Math.random() * 32),
          gravity,
          life: 0,
          maxLife: 0.55 + Math.random() * 0.75,
          cls,
        });
      }
    };

    const applyBoost = (
      amount: number,
      strikeCol?: number,
      source = '主动助推',
      alreadyPersisted = false,
    ) => {
      if (phase !== 'CLIMB') return;
      const clamped = Math.max(0.001, Math.min(0.14, amount));
      const gainedM = clamped * PEAK_ALT;
      if (alreadyPersisted) {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (raw) {
            const parsed = JSON.parse(raw);
            save.boostAccum = Number(parsed.boostAccum || save.boostAccum);
            save.boostMeters = Number(parsed.boostMeters || save.boostMeters);
          }
        } catch {}
      } else {
        save.boostAccum += clamped;
        save.boostMeters += gainedM;
        persistSave();
      }
      lastBoostGainMeters = gainedM;
      lastBoostSource = source;
      boostBannerTimer = 2.2;
      boostVelocity = Math.min(0.52, boostVelocity + clamped * 3.1);

      const bx = progToCol(boulderProg);
      const by = terrainY(bx);
      skyStrikeCol = strikeCol ?? Math.round(bx);
      skyStrikeTimer = strikeCol !== undefined ? 0.62 : 0.38;
      spawnSubParticles(bx - 3, by - 1, 22, -1, 9);
    };

    const triggerRhythmicPush = (baseLabel = '节拍助推', strikeCol?: number) => {
      if (phase !== 'CLIMB') return;
      const distFromCenter = Math.abs(cadenceClock - 0.5);
      const isPerfect = distFromCenter <= 0.16;
      const bx = progToCol(boulderProg);
      const by = terrainY(bx);

      if (isPerfect) {
        comboCount = Math.min(12, comboCount + 1);
        comboDecayTimer = 6.5;
        critFlashTimer = 0.75;
        const mult = 1 + Math.min(1.2, comboCount * 0.18);
        const minM = Math.round(34 * mult);
        const maxM = Math.round(56 * mult);
        spawnSubParticles(bx, by - 2.5, 32, -1.2, 1, 40);
        spawnFloatingTag(
          bx - 8,
          by - 10,
          `★PERFECT x${comboCount > 1 ? comboCount : '2'}!`,
          9,
          1.4,
        );
        window.dispatchEvent(
          new CustomEvent('sisyphus:boulder-boost', {
            detail: {
              minM,
              maxM,
              source: comboCount > 1 ? `完美共振 x${comboCount}` : '完美节拍暴击',
              strikeCol,
            },
          }),
        );
      } else {
        comboCount = Math.max(0, comboCount - 1);
        spawnFloatingTag(bx - 5, by - 9, `+PUSH`, 7, 0.9);
        window.dispatchEvent(
          new CustomEvent('sisyphus:boulder-boost', {
            detail: { minM: 14, maxM: 32, source: baseLabel, strikeCol },
          }),
        );
      }
    };

    const triggerThemeSkill = (customSource?: string) => {
      if (phase !== 'CLIMB') return;
      const realm = document.documentElement.dataset.realm || 'void';
      const spec = SKILL_SPECS[realm] || SKILL_SPECS.void;
      themeSkillTimer = 4.0;
      critFlashTimer = 0.9;
      comboCount = Math.min(12, comboCount + 1);
      comboDecayTimer = 7.0;

      const bx = progToCol(boulderProg);
      const by = terrainY(bx);
      spawnSubParticles(bx, by - 3, 36, -0.8, 2, 28);
      spawnSubParticles(bx + 2, by - 2, 24, 1.1, 9, 32);

      const tagMap: Record<string, string> = {
        void: '◈ [1:4:9 STAR-GATE WARP!]',
        paper: 'Ψ [SELDON CRISIS SOLVED!]',
        crt: '⚡ [EMP // 0x00 NO BOULDER!]',
        amber: '◈ [MAKER HOOK // SHAI-HULUD!]',
      };
      spawnFloatingTag(bx - 12, by - 12, tagMap[realm] || tagMap.void, 1, 1.9);

      if (realm === 'crt') {
        sentinelStunTimer = 4.8;
      } else if (realm === 'paper') {
        crisisCol = 70 + Math.floor(Math.random() * 110);
      }

      if (quoteEl) {
        quoteEl.textContent = spec.quote;
      }

      window.dispatchEvent(
        new CustomEvent('sisyphus:boulder-boost', {
          detail: {
            minM: 48,
            maxM: 82,
            source: customSource || spec.label.replace(/[\[\]]/g, ''),
            strikeCol: Math.round(bx),
          },
        }),
      );
    };

    pushBtn?.addEventListener('click', () => triggerRhythmicPush('主动助推'));
    skillBtn?.addEventListener('click', () => triggerThemeSkill());
    summitBtn?.addEventListener('click', () => {
      if (phase === 'CLIMB') sprintToSummit = true;
    });

    const updatePointerCell = (e: MouseEvent) => {
      const target = (canvasEl || viewportEl || stageEl) as HTMLElement;
      const rect = target.getBoundingClientRect();
      if (rect.width <= 0 || rect.height <= 0) return;
      const rx = (e.clientX - rect.left) / rect.width;
      const ry = (e.clientY - rect.top) / rect.height;
      if (rx < 0 || rx > 1 || ry < 0 || ry > 1) {
        pointerCol = -1;
        pointerRow = -1;
        hoveredHotspot = null;
        return;
      }
      pointerCol = Math.max(0, Math.min(COLS - 1, Math.floor(rx * COLS)));
      pointerRow = Math.max(0, Math.min(ROWS - 1, Math.floor(ry * ROWS)));

      hoveredHotspot = null;
      for (const hs of activeHotspots) {
        if (
          pointerCol >= hs.col - 2 &&
          pointerCol <= hs.col + hs.w + 1 &&
          pointerRow >= hs.row - 1 &&
          pointerRow <= hs.row + hs.h + 1
        ) {
          hoveredHotspot = hs;
          break;
        }
      }
      if (hotspotHintEl) {
        if (hoveredHotspot) {
          hotspotHintEl.textContent = `⌖ [${hoveredHotspot.label}] ${hoveredHotspot.hint}`;
          hotspotHintEl.classList.add('is-locked');
        } else {
          const realm = document.documentElement.dataset.realm || 'void';
          hotspotHintEl.textContent = (SKILL_SPECS[realm] || SKILL_SPECS.void).desc;
          hotspotHintEl.classList.remove('is-locked');
        }
      }
    };

    viewportEl?.addEventListener('pointermove', updatePointerCell);
    viewportEl?.addEventListener('pointerleave', () => {
      pointerCol = -1;
      pointerRow = -1;
      hoveredHotspot = null;
      if (hotspotHintEl) {
        const realm = document.documentElement.dataset.realm || 'void';
        hotspotHintEl.textContent = (SKILL_SPECS[realm] || SKILL_SPECS.void).desc;
        hotspotHintEl.classList.remove('is-locked');
      }
    });

    const handleStageClick = (e: MouseEvent) => {
      updatePointerCell(e);
      const clickedCol = pointerCol >= 0 ? pointerCol : Math.round(progToCol(boulderProg));

      if (hoveredHotspot) {
        if (hoveredHotspot.id === 'sky_anomaly' || hoveredHotspot.id === 'celestial') {
          triggerThemeSkill(hoveredHotspot.label);
          return;
        }
        if (hoveredHotspot.id === 'sub_core') {
          undergroundPulseTimer = 1.7;
          const bx = progToCol(boulderProg);
          const by = terrainY(bx);
          spawnSubParticles(bx, by, 26, -0.5, 2, 30);
          spawnFloatingTag(
            hoveredHotspot.col + 4,
            hoveredHotspot.row - 2,
            `▲ [${hoveredHotspot.label} 共鸣!]`,
            2,
            1.4,
          );
          window.dispatchEvent(
            new CustomEvent('sisyphus:boulder-boost', {
              detail: {
                minM: 30,
                maxM: 54,
                source: hoveredHotspot.label,
                strikeCol: Math.round(bx),
              },
            }),
          );
          return;
        }
        if (hoveredHotspot.id === 'milestone') {
          spawnFloatingTag(
            hoveredHotspot.col - 3,
            hoveredHotspot.row - 3,
            `⚑ ${hoveredHotspot.label}`,
            1,
            1.3,
          );
          triggerRhythmicPush(hoveredHotspot.label, hoveredHotspot.col);
          return;
        }
      }

      triggerRhythmicPush('天象共鸣', clickedCol);
    };

    viewportEl?.addEventListener('click', handleStageClick);
    stageEl.addEventListener('click', handleStageClick);
    cadenceBoxEl?.addEventListener('click', () => triggerRhythmicPush('节拍共鸣'));
    milestoneNodes.forEach((node, idx) => {
      node.addEventListener('click', () => {
        const realm = document.documentElement.dataset.realm || 'void';
        const ms = (REALM_MILESTONES[realm] || REALM_MILESTONES.void)[idx];
        if (ms) {
          spawnFloatingTag(ms.col - 4, terrainY(ms.col) - 6, `⚑ ${ms.code} BEACON`, 1, 1.3);
          triggerRhythmicPush(ms.name, ms.col);
        }
      });
    });

    viewportEl?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.code === 'Space' || e.key === ' ') {
        e.preventDefault();
        triggerRhythmicPush('SPACE节拍');
      } else if (e.key === 'e' || e.key === 'E') {
        e.preventDefault();
        triggerThemeSkill();
      }
    });

    window.addEventListener('sisyphus:boulder-boost', (ev: Event) => {
      const detail = (
        ev as CustomEvent<{
          amount?: number;
          minM?: number;
          maxM?: number;
          rolledAmount?: number;
          source?: string;
          strikeCol?: number;
        }>
      ).detail;
      let rawAmt = detail?.rolledAmount;
      if (typeof rawAmt !== 'number') {
        if (typeof detail?.minM === 'number' && typeof detail?.maxM === 'number') {
          rawAmt = (detail.minM + Math.random() * (detail.maxM - detail.minM)) / PEAK_ALT;
        } else {
          const baseAmt = Math.max(0.001, Math.min(0.12, detail?.amount ?? 0.018));
          rawAmt = baseAmt * (0.58 + Math.random() * 0.87);
        }
        if (detail) detail.rolledAmount = rawAmt;
      }
      applyBoost(rawAmt, detail?.strikeCol, detail?.source || '动能共鸣', true);
    });

    window.addEventListener('sisyphus:trigger-summit', () => {
      if (phase === 'CLIMB') sprintToSummit = true;
    });

    const syncStageTitle = () => {
      const r = document.documentElement.dataset.realm || 'void';
      cachedRealm = '';
      refreshPalette(r);
      if (stageTitleEl) {
        stageTitleEl.textContent = STAGE_TITLES[r] || STAGE_TITLES.void;
      }
      const spec = SKILL_SPECS[r] || SKILL_SPECS.void;
      if (skillBtn) {
        skillBtn.textContent = spec.label;
        skillBtn.title = spec.desc;
      }
      if (hotspotHintEl && !hoveredHotspot) {
        hotspotHintEl.textContent = spec.desc;
      }
      const msList = REALM_MILESTONES[r] || REALM_MILESTONES.void;
      milestoneNodes.forEach((node, idx) => {
        const ms = msList[idx];
        if (ms) {
          node.textContent = idx === 4 ? `▲${ms.code}` : `${idx + 1}:${ms.code}`;
          node.title = ms.name;
        }
      });
    };
    syncStageTitle();
    window.addEventListener('sisyphus:realmchange', syncStageTitle);

    const formatEta = (ms: number) => {
      const totalSec = Math.max(0, Math.floor(ms / 1000));
      const h = Math.floor(totalSec / 3600);
      const m = Math.floor((totalSec % 3600) / 60);
      const s = totalSec % 60;
      return `${String(h).padStart(2, '0')}h ${String(m).padStart(2, '0')}m ${String(s).padStart(2, '0')}s`;
    };

    // ================= 6. 预分配双层高分缓冲区 (零 GC 抖动) =================
    const cellChar: string[][] = Array.from({ length: ROWS }, () => Array(COLS).fill(' '));
    const cellFg = new Uint8Array(ROWS * COLS);
    const cellBg = new Uint8Array(ROWS * COLS);
    const brailleMask = new Uint8Array(ROWS * COLS);
    const brailleCls = new Uint8Array(ROWS * COLS);
    const quadBuf = new Uint8Array(QUAD_H * QUAD_W); // 448x144 Chafa 2x2 像素缓冲
    const rayShadowCol = new Float32Array(COLS); // rot.js 天体光线投射阴影高度表

    let lastTime = performance.now();
    let lastRenderTime = 0;
    let lastSrSyncTime = 0;
    let nextPebbleTick = 0;
    let nextMeteorTick = 1200;

    const tick = (nowPerf: number) => {
      const dt = Math.min(0.08, Math.max(0.001, (nowPerf - lastTime) / 1000));
      lastTime = nowPerf;

      const nowWall = Date.now();
      const totalRaw = getTotalRawCycles(nowWall);
      const realm = document.documentElement.dataset.realm || 'void';

      for (let i = subParticles.length - 1; i >= 0; i--) {
        const p = subParticles[i];
        p.life += dt;
        if (p.life >= p.maxLife) {
          subParticles.splice(i, 1);
          continue;
        }
        p.x += p.vx * dt;
        p.y += p.vy * dt;
        p.vy += p.gravity * dt;
      }

      for (let i = floatingTags.length - 1; i >= 0; i--) {
        const ft = floatingTags[i];
        ft.life += dt;
        ft.row -= dt * 4.2;
        if (ft.life >= ft.maxLife) {
          floatingTags.splice(i, 1);
        }
      }

      for (const drop of matrixDrops) {
        drop.y += drop.speed * dt * (themeSkillTimer > 0 && realm === 'crt' ? 0.32 : 1);
        if (drop.y > ROWS + drop.len) {
          drop.y = -2;
        }
      }

      cadenceClock = (cadenceClock + dt * 0.72) % 1.0;
      if (comboDecayTimer > 0) {
        comboDecayTimer = Math.max(0, comboDecayTimer - dt);
        if (comboDecayTimer <= 0) comboCount = 0;
      }
      if (critFlashTimer > 0) critFlashTimer = Math.max(0, critFlashTimer - dt);
      if (themeSkillTimer > 0) themeSkillTimer = Math.max(0, themeSkillTimer - dt);
      if (undergroundPulseTimer > 0) undergroundPulseTimer = Math.max(0, undergroundPulseTimer - dt);
      if (sentinelStunTimer > 0) sentinelStunTimer = Math.max(0, sentinelStunTimer - dt);

      halAlertPhase = (halAlertPhase + dt * 1.05) % (Math.PI * 2);
      if (sentinelStunTimer <= 0) {
        sentinelX = 136 + Math.sin(nowPerf * 0.0011) * 44;
        sentinelY = 17 + Math.cos(nowPerf * 0.0019) * 6.5;
      }

      if (nowPerf > nextMeteorTick) {
        nextMeteorTick = nowPerf + 1400 + Math.random() * 1700;
        if (realm === 'void') {
          subParticles.push({
            x: 260 + Math.random() * 110,
            y: 10 + Math.random() * 28,
            vx: -88 - Math.random() * 36,
            vy: 22,
            gravity: 0,
            life: 0,
            maxLife: 1.1,
            cls: 1,
          });
        } else if (realm === 'amber') {
          for (let k = 0; k < 9; k++) {
            subParticles.push({
              x: 340 + Math.random() * 75,
              y: 22 + Math.random() * 78,
              vx: -64 - Math.random() * 32,
              vy: 4.5,
              gravity: 0,
              life: 0,
              maxLife: 1.6,
              cls: k === 0 ? 9 : k % 2 === 0 ? 2 : 1,
            });
          }
        }
      }

      if (boostBannerTimer > 0) boostBannerTimer = Math.max(0, boostBannerTimer - dt);
      if (skyStrikeTimer > 0) skyStrikeTimer = Math.max(0, skyStrikeTimer - dt);

      if (phase === 'CLIMB') {
        const curCol = progToCol(boulderProg);
        const curGrade = getTerrainGrade(curCol);
        const slopeTempo = curGrade > 0.36 ? 0.78 : curGrade < 0.12 ? 1.28 : 1.0;
        const skillMult = themeSkillTimer > 0 ? 2.5 : 1.0;
        const speedMult = (sprintToSummit ? 6.5 : (1 + boostVelocity * 11) * skillMult) * slopeTempo;
        continuousStep += dt * 3.0 * speedMult;
        continuousRoll += dt * 2.4 * speedMult;

        if (nowPerf > nextPebbleTick) {
          const baseInterval = curGrade > 0.36 ? 320 : 520;
          nextPebbleTick =
            nowPerf + (boostVelocity > 0.02 || sprintToSummit || themeSkillTimer > 0 ? 100 : baseInterval);
          const sx = progToCol(sisyphusProg);
          spawnSubParticles(
            sx - 2.4,
            terrainY(sx) - 0.5,
            curGrade > 0.36 || themeSkillTimer > 0 ? 5 : 3,
            -0.9,
            boostVelocity > 0.02 || curGrade > 0.38 || themeSkillTimer > 0 ? 9 : 5,
          );
        }

        if (sprintToSummit) {
          const step = Math.min(1.001 - displayFrac, dt * 0.42);
          save.boostAccum += Math.max(0, step);
          displayFrac += step;
          if (displayFrac >= 1.0) {
            sprintToSummit = false;
            persistSave();
            phase = 'SUMMIT_BREATH';
            phaseElapsed = 0;
            boulderProg = 1.0;
            sisyphusProg = 0.944;
          }
        } else {
          const targetCycle = Math.floor(totalRaw);
          if (targetCycle > activeCycleIndex) {
            displayFrac += Math.min(1.002 - displayFrac, dt * 0.55);
            if (displayFrac >= 1.0) {
              phase = 'SUMMIT_BREATH';
              phaseElapsed = 0;
              boulderProg = 1.0;
              sisyphusProg = 0.944;
            }
          } else {
            const targetFrac = totalRaw - activeCycleIndex;
            const diff = targetFrac - displayFrac;
            if (Math.abs(diff) > 0.00001) {
              displayFrac += diff * Math.min(1, dt * 7.5);
            }
            if (boostVelocity > 0.001) {
              boostVelocity *= Math.pow(0.18, dt);
            }
          }
        }

        const rhythmPulse = Math.sin(cadenceClock * Math.PI * 2);
        const heaveBob = rhythmPulse * 0.0032 + Math.sin(continuousStep * Math.PI) * 0.0018;
        boulderProg = Math.min(1, Math.max(0.02, displayFrac + heaveBob));
        sisyphusProg = Math.max(0, boulderProg - 0.056);
      } else if (phase === 'SUMMIT_BREATH') {
        phaseElapsed += dt;
        boulderProg = 1.0;
        sisyphusProg = 0.944;
        if (phaseElapsed > 2.2 && Math.random() < 0.48) {
          const bx = progToCol(boulderProg);
          spawnSubParticles(bx - 3, terrainY(bx) - 0.4, 3, -0.7, 9);
        }
        if (phaseElapsed >= 3.3) {
          phase = 'AVALANCHE';
          phaseElapsed = 0;
          avalancheVel = 0.06;
        }
      } else if (phase === 'AVALANCHE') {
        phaseElapsed += dt;
        avalancheVel = Math.min(0.48, avalancheVel + dt * 0.25);
        boulderProg = Math.max(0.02, boulderProg - avalancheVel * dt);
        continuousRoll -= avalancheVel * dt * 38;

        const bx = progToCol(boulderProg);
        if (boulderProg > 0.025 && Math.random() < 0.8) {
          spawnSubParticles(bx + 3.2, terrainY(bx) - 1.0, 4, 0.9, 9);
        }

        if (phaseElapsed > 1.3) {
          sisyphusProg = Math.max(0.75, sisyphusProg - dt * 0.085);
          continuousStep += dt * 4.8;
        }

        if (boulderProg <= 0.022) {
          boulderProg = 0.02;
          spawnSubParticles(progToCol(0.02) + 2.5, terrainY(24) - 1.0, 24, 0.4, 9);
          phase = 'DESCENT_WALK';
          phaseElapsed = 0;
        }
      } else if (phase === 'DESCENT_WALK') {
        phaseElapsed += dt;
        boulderProg = 0.02;
        const targetS = 0.0;
        if (sisyphusProg > targetS + 0.004) {
          const walkSpeed = 0.18;
          sisyphusProg = Math.max(targetS, sisyphusProg - walkSpeed * dt);
          continuousStep += walkSpeed * dt * 44;
        } else {
          sisyphusProg = targetS;
          if (phaseElapsed > 4.5) {
            const latestTotal = getTotalRawCycles(Date.now());
            activeCycleIndex = Math.floor(latestTotal);
            displayFrac = Math.min(0.05, latestTotal - activeCycleIndex);
            boulderProg = displayFrac;
            sisyphusProg = Math.max(0, displayFrac - 0.056);
            phase = 'CLIMB';
            phaseElapsed = 0;
          }
        }
      }

      if (nowPerf - lastRenderTime >= 32) {
        lastRenderTime = nowPerf;
        renderFrame(nowPerf, realm);
      }

      requestAnimationFrame(tick);
    };

    // ================= 7. 五合一高分混合渲染管线 (renderFrame) =================
    const renderFrame = (nowPerf: number, realm: string) => {
      refreshPalette(realm);

      // 清空缓冲
      for (let r = 0; r < ROWS; r++) {
        cellChar[r].fill(' ');
      }
      cellFg.fill(0);
      cellBg.fill(0);
      brailleMask.fill(0);
      brailleCls.fill(0);
      quadBuf.fill(0);
      activeHotspots = [];

      const sec = nowPerf * 0.001;
      const bCol = progToCol(boulderProg);
      let bGroundY = terrainY(bCol);
      if (phase === 'AVALANCHE') {
        bGroundY -= Math.abs(Math.sin(boulderProg * Math.PI * 7.0)) * 3.0;
      } else if (themeSkillTimer > 0 && realm === 'amber') {
        bGroundY -= 1.5;
      }
      const sCol = progToCol(sisyphusProg);

      // --- 工具函数 A: 448x288 Drawille 盲文亚像素画笔 ---
      const setSubPixel = (px: number, py: number, colorCls: number, allowUnderground = false) => {
        const xi = Math.round(px);
        const yi = Math.round(py);
        if (xi < 0 || xi >= SUB_W || yi < 0 || yi >= SUB_H) return;
        const col = xi >> 1;
        const row = yi >> 2;
        if (!allowUnderground && yi >= terrainY(col) * 4 - 2) return;
        const idx = row * COLS + col;
        brailleMask[idx] |= BRAILLE_BITS[xi & 1][yi & 3];
        if (colorCls > brailleCls[idx]) {
          brailleCls[idx] = colorCls;
        }
      };

      const drawSubLine = (
        x0: number,
        y0: number,
        x1: number,
        y1: number,
        colorCls: number,
        allowUnderground = false,
      ) => {
        const steps = Math.max(1, Math.ceil(Math.hypot(x1 - x0, y1 - y0)));
        for (let i = 0; i <= steps; i++) {
          const u = i / steps;
          setSubPixel(x0 + (x1 - x0) * u, y0 + (y1 - y0) * u, colorCls, allowUnderground);
        }
      };

      const drawSubCircle = (
        cx: number,
        cy: number,
        r: number,
        colorCls: number,
        fill = false,
        crescentCutX = 0,
      ) => {
        const r2 = r * r;
        for (let dy = -Math.ceil(r); dy <= Math.ceil(r); dy++) {
          for (let dx = -Math.ceil(r); dx <= Math.ceil(r); dx++) {
            const d2 = dx * dx + dy * dy;
            if (fill ? d2 <= r2 : Math.abs(Math.sqrt(d2) - r) < 0.78) {
              if (crescentCutX !== 0) {
                const cd2 = (dx - crescentCutX) * (dx - crescentCutX) + dy * dy;
                if (cd2 < r2 * 0.78) continue;
              }
              setSubPixel(cx + dx, cy + dy, colorCls);
            }
          }
        }
      };

      const drawSubEllipseRing = (
        cx: number,
        cy: number,
        rx: number,
        ry: number,
        tiltRad: number,
        colorCls: number,
      ) => {
        const steps = Math.ceil(rx * 5.8);
        const cosT = Math.cos(tiltRad);
        const sinT = Math.sin(tiltRad);
        for (let i = 0; i < steps; i++) {
          const a = (i / steps) * Math.PI * 2;
          const ex = Math.cos(a) * rx;
          const ey = Math.sin(a) * ry;
          setSubPixel(cx + ex * cosT - ey * sinT, cy + ex * sinT + ey * cosT, colorCls);
        }
      };

      // --- 工具函数 B: 448x144 Chafa 2x2 双色象限像素画笔 ---
      const setQuadPixel = (qx: number, qy: number, colorCls: number) => {
        const xi = Math.round(qx);
        const yi = Math.round(qy);
        if (xi >= 0 && xi < QUAD_W && yi >= 0 && yi < QUAD_H) {
          quadBuf[yi * QUAD_W + xi] = colorCls;
        }
      };

      const drawQuadLine = (x0: number, y0: number, x1: number, y1: number, colorCls: number, thick = 1) => {
        const steps = Math.max(1, Math.ceil(Math.hypot(x1 - x0, y1 - y0)));
        for (let i = 0; i <= steps; i++) {
          const u = i / steps;
          const px = x0 + (x1 - x0) * u;
          const py = y0 + (y1 - y0) * u;
          setQuadPixel(px, py, colorCls);
          if (thick > 1) {
            setQuadPixel(px + 1, py, colorCls);
            setQuadPixel(px, py + 1, colorCls);
          }
        }
      };

      const drawQuadRect = (qx: number, qy: number, w: number, h: number, colorCls: number) => {
        const x0 = Math.round(qx);
        const y0 = Math.round(qy);
        for (let dy = 0; dy < h; dy++) {
          for (let dx = 0; dx < w; dx++) {
            setQuadPixel(x0 + dx, y0 + dy, colorCls);
          }
        }
      };

      // --- 工具函数 C: 224x72 字符直接写入 ---
      const put = (r: number, c: number, ch: string, fg = 10, bg?: number) => {
        const ri = Math.round(r);
        const ci = Math.round(c);
        if (ri >= 0 && ri < ROWS && ci >= 0 && ci < COLS && ch.length === 1) {
          const idx = ri * COLS + ci;
          cellChar[ri][ci] = ch;
          cellFg[idx] = fg;
          if (bg !== undefined) cellBg[idx] = bg;
        }
      };

      const putStr = (r: number, c: number, text: string, fg = 10, keepSpace = false, bg?: number) => {
        const ri = Math.round(r);
        const ciStart = Math.round(c);
        for (let i = 0; i < text.length; i++) {
          const ci = ciStart + i;
          if (ri >= 0 && ri < ROWS && ci >= 0 && ci < COLS) {
            if (text[i] !== ' ' || keepSpace) {
              const idx = ri * COLS + ci;
              cellChar[ri][ci] = text[i];
              cellFg[idx] = fg;
              if (bg !== undefined) cellBg[idx] = bg;
            }
          }
        }
      };

      // ================= LAYER 1: 448x288 远景三层视差山脉与 Bayer 抖动阴影 =================
      for (let px = 20; px < 356; px++) {
        const p1 = 84 + Math.abs(px - 92) * 0.43 + Math.sin(px * 0.13) * 2.8;
        const p2 = 70 + Math.abs(px - 196) * 0.37 + Math.cos(px * 0.11) * 3.2;
        const p3 = 88 + Math.abs(px - 292) * 0.41 + Math.sin(px * 0.15) * 2.6;
        const py = Math.min(p1, p2, p3);
        const groundLim = terrainY(px * 0.5) * 4 - 10;
        if (py < groundLim) {
          setSubPixel(px, py, 4);
          setSubPixel(px, py + 1, 4);
          // 远山向阳面与背阴面 Bayer 抖动立体体积排线
          const isSunlitSide = (px < 92) || (px >= 145 && px < 196) || (px >= 248 && px < 292);
          for (let dy = 2; dy < 32 && py + dy < groundLim; dy += 2) {
            const fade = 1 - dy / 34;
            const bVal = BAYER_8X8[(Math.floor(py + dy)) & 7][px & 7];
            if (bVal < (isSunlitSide ? 0.48 : 0.22) * fade) {
              setSubPixel(px, py + dy, isSunlitSide ? 4 : 12);
            }
          }
        }
      }

      for (let px = 10; px < 308; px++) {
        const m1 = 128 + Math.abs(px - 64) * 0.42 + Math.cos(px * 0.16) * 2.4;
        const m2 = 112 + Math.abs(px - 148) * 0.35 + Math.sin(px * 0.12) * 2.8;
        const m3 = 104 + Math.abs(px - 236) * 0.33 + Math.cos(px * 0.09) * 2.4;
        const my = Math.min(m1, m2, m3);
        const groundLim = terrainY(px * 0.5) * 4 - 5;
        if (my < groundLim) {
          setSubPixel(px, my, 5);
          setSubPixel(px, my + 1, 4);
          if (px % 7 === 0 && my + 18 < groundLim) {
            drawSubLine(px, my + 2, px + 8, my + 18, 4);
          }
        }
      }

      // 高空深空星图与 65 颗动态闪烁星辰
      const constellations = [
        [164, 20, 192, 28],
        [192, 28, 224, 18],
        [224, 18, 248, 34],
        [296, 24, 328, 16],
        [328, 16, 356, 30],
      ] as const;
      for (const [x0, y0, x1, y1] of constellations) {
        drawSubLine(x0, y0, x1, y1, 4);
        drawSubCircle(x0, y0, 1.8, 2, true);
        drawSubCircle(x1, y1, 1.8, 2, true);
      }
      for (let sIdx = 0; sIdx < 65; sIdx++) {
        const sx = ((sIdx * 73 + 29) % (SUB_W - 24)) + 12;
        const sy = ((sIdx * 53 + 11) % 92) + 8;
        if (Math.sin(sec * 1.8 + sIdx * 1.7) > -0.25) {
          setSubPixel(sx, sy, sIdx % 5 === 0 ? 1 : sIdx % 2 === 0 ? 2 : 4);
        }
      }

      // ================= LAYER 2: 四大科幻名著高分辨率微缩名场面 (448x288 + Chafa 2x2) =================
      // 定义主天体光源坐标 (用于 rot.js 实时光线投射阴影与 3D 巨石球面法线光照)
      let lightCol = 40;
      let lightRow = 11;

      if (realm === 'void') {
        // 《2001：太空漫游》：3D 湍流云带木星 + 大红斑气旋 + 旋转离心环发现号 XD-1 + 1:4:9 透视黑石碑 + HAL-9000 扫描扇区
        lightCol = 40;
        lightRow = 10;
        const jx = 80;
        const jy = 42;
        const jR = 27.5;
        // 3D 球面投影木星云带与大红斑
        for (let dy = -Math.ceil(jR); dy <= Math.ceil(jR); dy++) {
          for (let dx = -Math.ceil(jR); dx <= Math.ceil(jR); dx++) {
            const d2 = dx * dx + dy * dy;
            if (d2 > jR * jR) continue;
            const nz = Math.sqrt(1 - d2 / (jR * jR));
            const lon = Math.atan2(dx, nz * jR) + sec * 0.35;
            const lat = dy / jR;
            const band = Math.sin(lat * 16 + Math.sin(lon * 3) * 0.45);
            // 大红斑气旋涡流
            const grsDist = Math.hypot((dx - 7) / 6.5, (dy - 6) / 4.2);
            if (grsDist < 1.0) {
              setSubPixel(jx + dx, jy + dy, grsDist < 0.55 ? 9 : 1);
            } else if (Math.abs( Math.sqrt(d2) - jR ) < 1.1) {
              setSubPixel(jx + dx, jy + dy, 1);
            } else if (band > 0.15 && (dx + dy) % 2 === 0) {
              setSubPixel(jx + dx, jy + dy, lat > 0.25 ? 3 : 1);
            }
          }
        }
        drawSubEllipseRing(jx, jy, 56, 12.5, -0.18, 2);
        drawSubEllipseRing(jx, jy, 70, 16.0, -0.18, 4);

        // 发现号深空飞船 (XD-1 Discovery One) —— Chafa 2x2 像素级球形乘员舱 + 旋转离心机重力环 + 长桁架脊柱 + 核热尾焰
        const shipQx = Math.round(152 + ((sec * 18) % 188));
        const shipQy = Math.round(24 + Math.sin(sec * 1.4) * 3.5);
        // 尾部核热推进器与双色离子尾焰
        drawQuadLine(shipQx - 12, shipQy, shipQx - 2, shipQy, 9);
        drawQuadLine(shipQx - 9, shipQy - 1, shipQx - 2, shipQy - 1, 2);
        drawQuadLine(shipQx - 9, shipQy + 1, shipQx - 2, shipQy + 1, 2);
        drawQuadRect(shipQx - 2, shipQy - 1, 4, 3, 4);
        // 主桁架脊柱与核燃料荚舱
        drawQuadLine(shipQx + 2, shipQy, shipQx + 24, shipQy, 5);
        for (let pod = 4; pod <= 20; pod += 4) {
          setQuadPixel(shipQx + pod, shipQy - 1, 4);
          setQuadPixel(shipQx + pod, shipQy + 1, 12);
        }
        // 中段高增益通信天线与旋转离心机重力环 (Rotating Centrifuge)
        const centH = Math.round(Math.abs(Math.sin(sec * 3.5)) * 4) + 1;
        drawQuadLine(shipQx + 18, shipQy - centH, shipQx + 18, shipQy + centH, 2);
        // 前部球形一号乘员舱与舷窗
        for (let dy = -3; dy <= 3; dy++) {
          for (let dx = -3; dx <= 3; dx++) {
            if (dx * dx + dy * dy <= 11) {
              setQuadPixel(shipQx + 28 + dx, shipQy + dy, dx > 0 && dy < 0 ? 5 : 8);
            }
          }
        }
        setQuadPixel(shipQx + 30, shipQy - 1, 9); // HAL 主控舱红光舷窗

        // 第谷环形山 1:4:9 黑色方尖碑 (3D 透视屹立于山麓 + 球面谐波)
        drawQuadRect(10, 110, 8, 24, 11);
        drawQuadLine(10, 110, 10, 133, 5);
        drawQuadLine(10, 110, 17, 110, 2);
        for (let wIdx = 0; wIdx < 5; wIdx++) {
          const rad = ((sec * 20 + wIdx * 14) % 62) + 8;
          for (let a = -1.45; a <= 0.15; a += 0.05) {
            setSubPixel(28 + Math.cos(a) * rad, 236 + Math.sin(a) * rad, 2);
          }
        }

        // 右上角高分 HAL-9000 巨型红眼镜头与周期性红色扫描扇区
        const halCx = 398;
        const halCy = 26;
        const isHalScanning = Math.sin(halAlertPhase) > 0.35 && themeSkillTimer <= 0;
        drawSubCircle(halCx, halCy, 11, 4, false);
        drawSubCircle(halCx, halCy, 7, 9, false);
        drawSubCircle(halCx, halCy, 3.2, themeSkillTimer > 0 ? 2 : 9, true);
        if (isHalScanning) {
          drawSubLine(halCx, halCy, bCol * 2, (bGroundY - 3) * 4, 9);
          drawSubLine(halCx, halCy, bCol * 2 - 12, (bGroundY - 1) * 4, 9);
        }

        // 1:4:9 星门引力走廊特技
        if (themeSkillTimer > 0) {
          const bxPx = bCol * 2;
          const byPy = (bGroundY - 3) * 4;
          for (let k = -3; k <= 3; k++) {
            drawSubLine(jx + k * 9, jy, bxPx + k * 4, byPy, k === 0 ? 1 : 2);
          }
          for (let ring = 0; ring < 6; ring++) {
            const u = (sec * 1.9 + ring * 0.16) % 1;
            drawSubEllipseRing(
              jx + (bxPx - jx) * u,
              jy + (byPy - jy) * u,
              8 + u * 16,
              3 + u * 6,
              -0.4,
              ring % 2 === 0 ? 9 : 2,
            );
          }
        }

        activeHotspots.push(
          {
            id: 'celestial',
            col: 26,
            row: 3,
            w: 28,
            h: 15,
            label: 'JUPITER // 3D木星与大红斑',
            hint: '点击引爆 1:4:9 星门引力弹弓 (+65m)',
          },
          {
            id: 'sky_anomaly',
            col: 190,
            row: 2,
            w: 22,
            h: 9,
            label: 'HAL-9000 // 逻辑主脑红眼',
            hint: '点击红眼镜头拔除 HAL 逻辑模块，消除重力扫描锁！',
          },
        );
      } else if (realm === 'paper') {
        // 《银河帝国：基地》：北斋版画朱砂红日/川陀星环 + 3D 洛伦兹/黎曼“第一辐光”流形 + 端点星全息谢顿穹顶
        lightCol = 38;
        lightRow = 10;
        const tx = 76;
        const ty = 40;
        drawSubCircle(tx, ty, 19.5, 1, true);
        drawSubEllipseRing(tx, ty, 48, 11.0, -0.26, 3);
        drawSubEllipseRing(tx, ty, 60, 14.5, -0.26, 4);

        // 第一辐光 (Prime Radiant) 3D 旋转心理史学相位流形
        for (let px = 132; px < 396; px++) {
          const u = (px - 132) * 0.042;
          const amp = themeSkillTimer > 0 ? 24 : 17;
          const yA = 42 + Math.sin(u + sec * 2.2) * amp + Math.cos(u * 2.3 - sec) * 4;
          const yB = 42 + Math.cos(u * 0.85 - sec * 1.7) * (amp * 0.88);
          setSubPixel(px, yA, 3);
          setSubPixel(px, yA + 1, 3);
          setSubPixel(px, yB, 1);
          setSubPixel(px, yB - 1, 1);
          if (px % 10 === 0) {
            drawSubLine(px, yA, px, yB, themeSkillTimer > 0 ? 9 : 4);
          }
        }

        // 谢顿危机微分奇点靶标
        const cPx = crisisCol * 2;
        const cPy = 42 + Math.sin((cPx - 132) * 0.042 + sec * 2.2) * 17;
        drawSubCircle(cPx, cPy, 9 + Math.sin(sec * 6) * 2.5, 9, false);
        drawSubCircle(cPx, cPy, 4, 1, true);

        if (themeSkillTimer > 0) {
          drawSubLine(cPx, cPy, bCol * 2, (bGroundY - 3) * 4, 1);
          drawSubCircle(bCol * 2, (bGroundY - 3) * 4, 22, 9, false);
        }

        // 端点星谢顿全息穹顶 (Seldon Vault) Chafa 2x2 像素建筑
        for (let dy = 0; dy < 14; dy++) {
          const halfW = Math.round(Math.sqrt(Math.max(0, 14 * 14 - (14 - dy) * (14 - dy))));
          drawQuadLine(22 - halfW, 114 + dy, 22 + halfW, 114 + dy, dy < 3 ? 1 : 4);
        }
        drawQuadRect(10, 128, 25, 6, 5);

        activeHotspots.push(
          {
            id: 'sky_anomaly',
            col: crisisCol - 7,
            row: Math.max(2, Math.round(cPy / 4) - 3),
            w: 15,
            h: 7,
            label: 'SELDON CRISIS // 谢顿危机奇点',
            hint: '点击用第一辐光配平心理史学方程，钤盖【基地纪元】朱砂官印！',
          },
          {
            id: 'celestial',
            col: 24,
            row: 4,
            w: 26,
            h: 14,
            label: 'TRANTOR // 川陀帝国星环',
            hint: '点击调阅银河百科全书星图助推巨石',
          },
        );
      } else if (realm === 'crt') {
        // 《黑客帝国》：锡安电磁风暴云 + 分叉闪电 + 6 触手 IK 机械乌贼哨兵 + 尼布甲尼撒号气垫船
        lightCol = 112;
        lightRow = 6;
        for (let px = 64; px < 404; px += 2) {
          const py = 32 + Math.sin(px * 0.06 - sec * 5) * 8.5;
          const py2 = 44 + Math.cos(px * 0.045 + sec * 3.8) * 6.5;
          setSubPixel(px, py, 2);
          if (px % 4 === 0) setSubPixel(px, py2, 4);
        }
        if (sec % 2.1 < 0.55 || themeSkillTimer > 0) {
          let lx = 224 + Math.sin(sec * 17) * 52;
          let ly = 4;
          for (let seg = 0; seg < 14; seg++) {
            const nx = lx + Math.sin(seg * 3.7 + sec * 31) * 16;
            const ny = ly + 10;
            drawSubLine(lx, ly, nx, ny, 9);
            if (seg === 4 || seg === 8) {
              drawSubLine(lx, ly, lx - 28, ly + 22, 3);
            }
            lx = nx;
            ly = ny;
          }
        }

        // 尼布甲尼撒号气垫船 (Nebuchadnezzar Hovercraft) Chafa 2x2 像素船体与反重力喷口
        const hovQx = Math.round(196 + Math.sin(sec * 1.3) * 48);
        const hovQy = Math.round(32 + Math.cos(sec * 2.2) * 5);
        drawQuadRect(hovQx - 10, hovQy - 2, 20, 4, 4);
        drawQuadRect(hovQx - 6, hovQy - 4, 12, 2, 5);
        // 四组蓝光电磁反重力悬浮垫
        for (const padOff of [-9, -3, 3, 8]) {
          drawQuadRect(hovQx + padOff, hovQy + 2, 2, 2, 3);
          drawSubLine((hovQx + padOff) * 1, (hovQy + 4) * 2, (hovQx + padOff - 2) * 1, (hovQy + 9) * 2, 2);
        }

        // 6 触手逆向动力学 (IK Sinusoidal) 机械乌贼哨兵 (Sentinel Squid)
        const sentPx = sentinelX * 2;
        const sentPy = sentinelY * 4;
        const sentQx = Math.round(sentinelX);
        const sentQy = Math.round(sentinelY * 0.5);
        // 乌贼装甲头部与复眼阵列
        drawQuadRect(sentQx - 3, sentQy - 2, 7, 5, sentinelStunTimer > 0 ? 4 : 12);
        setQuadPixel(sentQx + 2, sentQy - 1, sentinelStunTimer > 0 ? 3 : 9);
        setQuadPixel(sentQx + 3, sentQy, sentinelStunTimer > 0 ? 3 : 9);
        setQuadPixel(sentQx + 2, sentQy + 1, sentinelStunTimer > 0 ? 3 : 9);

        if (sentinelStunTimer <= 0) {
          // 6 条多关节正弦摆动触手
          for (let t = 0; t < 6; t++) {
            let tx0 = sentPx - 6;
            let ty0 = sentPy - 10 + t * 4;
            for (let j = 1; j <= 4; j++) {
              const wave = Math.sin(sec * 11 - j * 0.9 + t * 0.8) * (4 + j * 1.5);
              const tx1 = tx0 - 8;
              const ty1 = ty0 + (t - 2.5) * 1.4 + wave;
              drawSubLine(tx0, ty0, tx1, ty1, t % 2 === 0 ? 9 : 4);
              tx0 = tx1;
              ty0 = ty1;
            }
          }
          // 哨兵红色锁定激光束
          if (Math.sin(sec * 2.5) > 0.25) {
            drawSubLine(sentPx + 6, sentPy, bCol * 2, (bGroundY - 3) * 4, 9);
          }
        }

        // EMP 特技双环电磁冲击波
        if (themeSkillTimer > 0) {
          const empR = (4.0 - themeSkillTimer) * 105;
          drawSubCircle(bCol * 2, (bGroundY - 3) * 4, empR, 3, false);
          drawSubCircle(bCol * 2, (bGroundY - 3) * 4, empR * 0.65, 2, false);
        }

        activeHotspots.push(
          {
            id: 'sky_anomaly',
            col: Math.round(sentinelX) - 10,
            row: Math.round(sentinelY) - 4,
            w: 18,
            h: 9,
            label: 'SENTINEL // 6触手IK机械乌贼',
            hint: '点击引爆尼布甲尼撒号 EMP 瘫痪乌贼，令巨石进入 0x00 线框减重态！',
          },
          {
            id: 'celestial',
            col: Math.round(hovQx / 2) - 8,
            row: Math.round(hovQy / 2) - 3,
            w: 16,
            h: 7,
            label: 'NEBUCHADNEZZAR // 锡安气垫船',
            hint: '点击请求 Operator 载入母体重力覆写程序',
          },
        );
      } else {
        // 《沙丘》：穆阿迪布双弯月 + 阿崔迪四翼扑翼机 + 环形晶齿巨型沙虫夏胡鲁破沙
        lightCol = 32;
        lightRow = 8;
        drawSubCircle(64, 32, 21.0, 1, true, 8.8);
        drawSubCircle(124, 44, 11.0, 2, true, 5.2);

        for (let wLine = 0; wLine < 7; wLine++) {
          const wy0 = 24 + wLine * 16;
          const wx0 = ((sec * 52 + wLine * 83) % 330) + 32;
          drawSubLine(wx0, wy0, wx0 + 38, wy0 + 4, 4);
        }

        // 高分阿崔迪蜻蜓扑翼机 (Atreides Ornithopter) Chafa 机身 + 4 翼高频残影
        const thopPx = 136 + ((sec * 27) % 224);
        const thopPy = 48 + Math.sin(sec * 2.8) * 6.5;
        const thopQx = Math.round(thopPx * 0.5);
        const thopQy = Math.round(thopPy * 0.5);
        drawQuadRect(thopQx - 4, thopQy, 9, 2, 1);
        setQuadPixel(thopQx + 4, thopQy, 9); // 驾驶舱高光
        drawQuadLine(thopQx - 4, thopQy, thopQx - 9, thopQy - 2, 5); // 修长尾梁
        const wingA = Math.sin(sec * 26) * 13;
        const wingB = Math.cos(sec * 26) * 11;
        drawSubLine(thopPx + 4, thopPy, thopPx - 12, thopPy - 4 + wingA, 1);
        drawSubLine(thopPx + 4, thopPy, thopPx + 22, thopPy - 4 - wingA, 1);
        drawSubLine(thopPx - 2, thopPy, thopPx - 16, thopPy + 2 + wingB, 2);
        drawSubLine(thopPx - 2, thopPy, thopPx + 18, thopPy + 2 - wingB, 2);

        // 巨型沙虫夏胡鲁 (Shai-Hulud)：Chafa 双色体节鳞片 + 环形晶齿巨口破沙！
        const wormPhase = sec * (themeSkillTimer > 0 ? 7.5 : 3.8);
        const wormStartQx = themeSkillTimer > 0 ? Math.max(36, Math.round(bCol) - 44) : 54;
        const wormEndQx = themeSkillTimer > 0 ? Math.min(206, Math.round(bCol) + 28) : 148;
        const wormAmp = themeSkillTimer > 0 ? 15.0 : 10.5;

        for (let qx = wormStartQx; qx < wormEndQx; qx++) {
          const arch = Math.sin((qx - wormStartQx) * 0.11 - wormPhase) * wormAmp;
          const groundQy = terrainY(qx) * 2;
          const wy = Math.round(groundQy - 3 - arch);
          if (wy < groundQy - 1) {
            const thick = themeSkillTimer > 0 ? 9 : 6;
            for (let dy = 0; dy < thick && wy + dy < groundQy; dy++) {
              const isRing = qx % 3 === 0;
              const colId = dy === 0 ? 1 : isRing ? 9 : dy > thick - 3 ? 11 : 4;
              setQuadPixel(qx, wy + dy, colId);
            }
          }
        }
        // 沙虫前端环形晶齿巨口 (Crystalline Maw)
        const mawPx = wormEndQx * 2;
        const mawPy = (terrainY(wormEndQx) - 5) * 4;
        drawSubCircle(mawPx, mawPy, themeSkillTimer > 0 ? 12 : 8, 9, false);
        drawSubCircle(mawPx, mawPy, themeSkillTimer > 0 ? 6 : 4, 1, false);

        // 塔布尔穴地沙槌同心地震波
        const thumpR = ((sec * 28) % 54) + 4;
        drawSubEllipseRing(24, 256, thumpR * 1.6, thumpR * 0.5, 0, 2);

        activeHotspots.push(
          {
            id: 'sky_anomaly',
            col: 6,
            row: 57,
            w: 14,
            h: 10,
            label: 'THUMPER // 弗雷曼沙槌',
            hint: '点击敲击沙槌并抛出沙钩，驾驭巨型沙虫夏胡鲁破沙冲顶！',
          },
          {
            id: 'celestial',
            col: Math.round(thopPx / 2) - 8,
            row: Math.round(thopPy / 4) - 4,
            w: 18,
            h: 8,
            label: 'ORNITHOPTER // 阿崔迪四翼扑翼机',
            hint: '点击投下香料矿脉高能助推信标',
          },
        );
      }

      // 光栅化亚像素火花与天象集束流
      for (const sp of subParticles) {
        setSubPixel(sp.x, sp.y, sp.cls);
        setSubPixel(sp.x - sp.vx * 0.018, sp.y - sp.vy * 0.018, sp.cls);
      }

      if (skyStrikeTimer > 0) {
        const bTargetPx = bCol * 2;
        const bTargetPy = (bGroundY - 3) * 4;
        drawSubLine(skyStrikeCol * 2, 4, bTargetPx, bTargetPy, 9);
        drawSubLine(skyStrikeCol * 2 + 3, 4, bTargetPx - 2, bTargetPy, 2);
        drawSubCircle(bTargetPx, bTargetPy, (0.65 - skyStrikeTimer) * 46, 9, false);
      }

      if (undergroundPulseTimer > 0) {
        const bTargetPx = bCol * 2;
        const bTargetPy = bGroundY * 4;
        for (let k = -2; k <= 2; k++) {
          drawSubLine(310 + k * 12, 240, bTargetPx + k * 3, bTargetPy, k === 0 ? 2 : 9, true);
        }
      }

      // ================= LAYER 3: rot.js 实时天体光线投射阴影 + 山体多层地质噪声光栅化 =================
      // 计算从主天体 (lightCol, lightRow) 投向山脊的实时阴影包络线
      for (let c = 0; c < COLS; c++) {
        rayShadowCol[c] = -1;
      }
      for (let c = 0; c < COLS; c++) {
        const ridgeR = terrainY(c);
        const dx = c - lightCol;
        const dy = ridgeR - lightRow;
        const dist = Math.abs(dx);
        if (dist < 1) continue;
        const stepDir = dx >= 0 ? 1 : -1;
        const slopeRay = dy / dist;
        for (let step = 1; step <= 38; step++) {
          const tc = c + step * stepDir;
          if (tc < 0 || tc >= COLS) break;
          const rayY = ridgeR + step * Math.max(0.18, slopeRay * 0.45);
          if (rayY > terrainY(tc)) {
            rayShadowCol[tc] = Math.max(rayShadowCol[tc], rayY);
          }
        }
      }

      // 绘制山体地质断面与受光/背光抖动层
      const treadShift = Math.floor(continuousRoll * 3.5);
      for (let c = 0; c < COLS; c++) {
        const yExact = terrainY(c);
        const sr = Math.round(yExact);
        const nextY = terrainY(Math.min(COLS - 1, c + 1));
        const diff = nextY - yExact;
        const inBoulderShadow = c < bCol && c >= bCol - 18;

        let ridgeChar = '═';
        if (c >= 198) ridgeChar = '═';
        else if (diff < -0.22) ridgeChar = '/';
        else if (diff < -0.04) ridgeChar = '~';
        else if (diff > 0.08) ridgeChar = '\\';
        else ridgeChar = '─';

        if (sr >= 0 && sr < ROWS) {
          put(sr, c, ridgeChar, inBoulderShadow ? 4 : 5, inBoulderShadow ? 11 : 12);
        }

        for (let r = sr + 1; r < ROWS; r++) {
          const depth = r - sr;
          const isRayShadowed = r <= rayShadowCol[c] || inBoulderShadow;
          const nVal = valueNoise2D(c * 0.08, r * 0.14 + (realm === 'amber' ? sec * 0.4 : 0));
          const bayer = BAYER_8X8[r & 7][c & 7];

          let fill = ':';
          let fgId = isRayShadowed ? 4 : 6;
          let bgId = depth <= 2 ? 12 : depth <= 7 ? 11 : 0;

          if (realm === 'crt') {
            const pulseWave = Math.abs(((c - Math.floor(sec * 28)) % 44 + 44) % 44) < 3;
            fill =
              depth === 1
                ? (c + r + treadShift) % 2 === 0
                  ? '1'
                  : '0'
                : depth <= 4
                  ? (c + depth) % 5 === 0
                    ? '╬'
                    : '▒'
                  : nVal + bayer * 0.35 > 0.62
                    ? '▓'
                    : '·';
            if (pulseWave && depth <= 4) {
              fgId = 3;
              bgId = 15;
            }
          } else if (realm === 'paper') {
            // 北斋《赤富士》木版画刀刻等高线与皴法
            const contourBand = Math.abs(Math.sin(depth * 0.55 + nVal * 3.2)) < 0.22;
            fill =
              depth === 1
                ? '/'
                : contourBand
                  ? diff < 0
                    ? '╱'
                    : '─'
                  : depth <= 5
                    ? '▒'
                    : '░';
            if (contourBand && !isRayShadowed) fgId = 1;
          } else if (realm === 'amber') {
            // Simplex 实时流动沙丘风成波纹
            const ripple = Math.sin(c * 0.22 + r * 0.45 - sec * 3.2 + nVal * 4.0);
            fill =
              depth === 1
                ? '~'
                : ripple > 0.45
                  ? '≈'
                  : depth <= 5
                    ? '▒'
                    : (c + r) % 9 === 0
                      ? '◈'
                      : '░';
            if (ripple > 0.55 && depth <= 5 && !isRayShadowed) fgId = 1;
          } else {
            const harmonic = (c * 2 + r + Math.floor(sec * 6)) % 23 === 0;
            fill =
              depth === 1
                ? '▀'
                : nVal + (1 - depth / 48) * 0.4 > bayer
                  ? depth <= 5
                    ? '▓'
                    : '▒'
                  : '·';
            if (harmonic) fgId = 2;
          }
          put(r, c, fill, fgId, bgId);
        }
      }

      // ================= LAYER 4: 真·3D 法线球面/多面体光照巨石 (Chafa 2x2 + Sobel 轮廓) =================
      // 巨石半径: 在 448x144 Chafa 象限坐标系中为 rx=11, ry=8 (对应 11列 x 8行 字符格的高分立体球体)
      const bCenterQx = bCol * 2;
      const bCenterQy = (bGroundY - 3.9) * 2;
      const bRx = 10.5;
      const bRy = 7.8;

      // 归一化三维光源方向向量 (指向当前主题的主天体)
      const lDx = lightCol - bCol;
      const lDy = (lightRow - (bGroundY - 4)) * 1.6;
      const lDz = 65;
      const lLen = Math.hypot(lDx, lDy, lDz) || 1;
      const Lx = lDx / lLen;
      const Ly = lDy / lLen;
      const Lz = lDz / lLen;

      const rollRad = continuousRoll * 0.85;
      const cosR = Math.cos(rollRad);
      const sinR = Math.sin(rollRad);
      const isWireframeMatrix = realm === 'crt' && themeSkillTimer > 0;

      for (let dy = -Math.ceil(bRy); dy <= Math.ceil(bRy); dy++) {
        for (let dx = -Math.ceil(bRx); dx <= Math.ceil(bRx); dx++) {
          const nx = dx / bRx;
          const ny = dy / bRy;
          const r2 = nx * nx + ny * ny;
          if (r2 > 1.0) continue;

          const nz = Math.sqrt(Math.max(0, 1.0 - r2));
          // 绕 Z 轴与 X 轴三维滚动旋转后的球面局部纹理坐标 (u, v, w)
          const u = nx * cosR - ny * sinR;
          const v = nx * sinR + ny * cosR;
          const w = nz;

          // Lambertian 漫反射 + Blinn-Phong 高光
          const ndotl = Math.max(0, nx * Lx + ny * Ly + nz * Lz);
          const spec = Math.pow(Math.max(0, nx * Lx * 0.5 + ny * Ly * 0.5 + nz * 0.86), 8);
          let lum = ndotl * 0.82 + spec * 0.45;

          // 四大文艺作品各自的 3D 巨石表面几何雕刻
          let facetColor = 0;
          if (realm === 'void') {
            // 1:4:9 黑石碑晶体测地线凹槽
            const isMonolithSlab = Math.abs(u) < 0.22 && Math.abs(v) < 0.68;
            const isMeridian = Math.abs(Math.abs(u) - 0.55) < 0.1 || Math.abs(v) < 0.09;
            if (isMonolithSlab) {
              facetColor = themeSkillTimer > 0 ? 2 : 11;
            } else if (isMeridian) {
              facetColor = 2;
            }
          } else if (realm === 'paper') {
            // 第一辐光三维正交浑天仪黄铜星环
            const onRing =
              Math.abs(u) < 0.15 || Math.abs(v) < 0.15 || Math.abs(u * u + v * v - 0.48) < 0.11;
            if (onRing) facetColor = themeSkillTimer > 0 ? 9 : 1;
          } else if (realm === 'crt') {
            // 锡安十六进制矩阵魔方网格
            const gridLine =
              Math.abs((u * 4) - Math.round(u * 4)) < 0.16 ||
              Math.abs((v * 4) - Math.round(v * 4)) < 0.16;
            if (isWireframeMatrix) {
              if (!gridLine && r2 < 0.82) continue; // 0x00 NO BOULDER 透明线框态！
              facetColor = 2;
            } else if (gridLine) {
              facetColor = 2;
            }
          } else {
            // 沙丘风蚀陨石坑与发光香料晶脉
            const spiceVein = Math.abs(Math.sin(u * 7 + v * 5)) < 0.16;
            if (spiceVein) facetColor = 9;
          }

          const qx = Math.round(bCenterQx + dx);
          const qy = Math.round(bCenterQy + dy);
          const bayer = BAYER_8X8[qy & 7][qx & 7];

          let finalColor = 8;
          if (facetColor !== 0) {
            finalColor = facetColor;
          } else if (lum > 0.78) {
            finalColor = 1; // 镜面高光
          } else if (lum > 0.42 + (bayer - 0.5) * 0.22) {
            finalColor = 8; // 受光半球
          } else if (lum > 0.18 + (bayer - 0.5) * 0.18) {
            finalColor = 13; // 明暗交界线 (Terminator)
          } else {
            finalColor = 11; // 背光本影半球
          }

          setQuadPixel(qx, qy, finalColor);
        }
      }

      // ================= LAYER 5: 16x22 亚像素骨骼动画西西弗斯 (Chafa 2x2 双色像素角色) =================
      const localGrade = getTerrainGrade(bCol);
      const sCenterCol =
        phase === 'CLIMB' ? Math.max(4, bCol - 8.2) : sCol;
      const sFootGroundY = terrainY(sCenterCol);
      const sGroundY =
        phase === 'CLIMB'
          ? Math.max(bGroundY + 0.5, Math.min(bGroundY + 2.5, sFootGroundY))
          : sFootGroundY;

      const footQx = Math.round(sCenterCol * 2);
      const footQy = Math.round(sGroundY * 2);
      const isSweetSpot = Math.abs(cadenceClock - 0.5) <= 0.16;
      const isBoosted = boostVelocity > 0.02 || sprintToSummit || themeSkillTimer > 0;

      // 渲染像素骨骼小人的函数 (支持黑客帝国子弹时间残影重绘)
      const drawArticulatedSisyphus = (
        baseQx: number,
        baseQy: number,
        cPrimary: number,
        cSecondary: number,
        cAccent: number,
      ) => {
        const stride = continuousStep * Math.PI;
        const leanX =
          phase === 'CLIMB'
            ? localGrade > 0.34
              ? 4
              : 2
            : phase === 'DESCENT_WALK'
              ? -1
              : 0;
        const heavePush =
          phase === 'CLIMB' ? Math.round(Math.sin(cadenceClock * Math.PI * 2) * 1.5) : 0;

        // 骨盆与肩部关节坐标
        const hipX = baseQx + leanX * 0.4;
        const hipY = baseQy - 7;
        const shX = baseQx + leanX + heavePush;
        const shY = baseQy - 13 + (localGrade > 0.34 && phase === 'CLIMB' ? 1 : 0);

        // 1. 后腿与前腿 (大腿 -> 膝盖 -> 小腿 -> 战靴)
        const legA = Math.sin(stride) * 3.2;
        const legB = Math.sin(stride + Math.PI) * 3.2;
        // 后腿 (暗色)
        const kneeBackX = hipX - 1 + legB * 0.5;
        const kneeBackY = hipY + 3.5;
        const footBackX = baseQx - 2 + legB;
        drawQuadLine(hipX, hipY, kneeBackX, kneeBackY, cSecondary, 2);
        drawQuadLine(kneeBackX, kneeBackY, footBackX, baseQy, cSecondary, 1);
        // 前腿 (亮色)
        const kneeFrontX = hipX + 2 + legA * 0.6;
        const kneeFrontY = hipY + 3.5;
        const footFrontX = baseQx + 1 + legA;
        drawQuadLine(hipX, hipY, kneeFrontX, kneeFrontY, cPrimary, 2);
        drawQuadLine(kneeFrontX, kneeFrontY, footFrontX, baseQy, cPrimary, 2);
        setQuadPixel(footFrontX + 1, baseQy, cAccent);

        // 2. 主题专属披风 / 宇航服背包 (随山风与推进速度飘动)
        if (realm === 'void') {
          // 宇航员 PLSS 生命维持背包与姿态推进器喷焰
          drawQuadRect(shX - 4, shY, 3, 5, 5);
          setQuadPixel(shX - 4, shY + 1, 9);
          if (isBoosted || isSweetSpot) {
            drawQuadLine(shX - 5, shY + 3, shX - 9, shY + 5, 2);
            drawQuadLine(shX - 5, shY + 4, shX - 8, shY + 6, 9);
          }
        } else {
          // 学者长袍 / 尼奥黑风衣 / 弗雷曼沙漠披风 (6 节流体波动)
          const cloakLen = realm === 'crt' ? 8 : 9;
          for (let seg = 1; seg <= cloakLen; seg++) {
            const wave = Math.sin(sec * 9 - seg * 0.7) * (1.2 + seg * 0.25);
            const cx = shX - 2 - seg * 1.1;
            const cy = shY + 1 + seg * 0.65 + wave;
            setQuadPixel(cx, cy, seg % 2 === 0 ? cSecondary : cAccent);
            setQuadPixel(cx, cy + 1, cSecondary);
          }
        }

        // 3. 躯干脊柱与胸甲
        drawQuadLine(hipX, hipY, shX, shY, cPrimary, 2);
        drawQuadLine(hipX - 1, hipY, shX - 1, shY + 1, cSecondary, 1);

        // 4. 双臂 (上臂 -> 肘关节 -> 前臂 -> 抵住 3D 巨石的手掌)
        if (phase === 'CLIMB') {
          const handX = Math.round(bCenterQx - bRx + 1);
          const handY = Math.round(bCenterQy + 1);
          const elbowY = shY + (isSweetSpot ? 1 : 3);
          const elbowX = (shX + handX) * 0.5 - 1;
          // 后臂
          drawQuadLine(shX, shY + 1, elbowX, elbowY + 1, cSecondary, 1);
          drawQuadLine(elbowX, elbowY + 1, handX, handY + 1, cSecondary, 1);
          // 前臂
          drawQuadLine(shX + 1, shY, elbowX + 1, elbowY, cPrimary, 2);
          drawQuadLine(elbowX + 1, elbowY, handX, handY, cPrimary, 2);
          setQuadPixel(handX, handY, isSweetSpot ? 9 : cAccent);
        } else if (phase === 'SUMMIT_BREATH' && phaseElapsed < 1.3) {
          // 登顶振臂高呼
          drawQuadLine(shX, shY, shX - 3, shY - 5, cPrimary, 1);
          drawQuadLine(shX + 1, shY, shX + 4, shY - 5, cPrimary, 1);
