---
import { CAMUS_QUOTE } from '../consts';

interface Props {
  initialSummits?: number;
}

const { initialSummits = 1 } = Astro.props;
---

<div class="bento-card col-7 sisyphus-stage-card">
  <div class="bento-head">
    <span class="bento-head-title">
      <span class="term-ascii-icon">/▲</span>
      <span id="sisyphus-stage-title">01 // TYCHO · 月面第谷环形山</span>
    </span>
    <div class="sisyphus-head-actions">
      <button
        type="button"
        class="term-btn is-primary"
        id="sisyphus-push-btn"
        title="助推巨石（也可直接点击画面，或聚焦画面后按空格）"
      >
        [+PUSH 助推]
      </button>
      <button
        type="button"
        class="term-btn"
        id="sisyphus-summit-btn"
        title="快进：冲顶 → 巨石滚落 → 走下山坡"
      >
        [&gt;&gt; 冲顶轮回]
      </button>
    </div>
  </div>

  <!-- 320x180 原生像素画舞台：自研像素光栅器 + 4 套主题场景 -->
  <div
    class="ascii-slope-viewport"
    id="sisyphus-stage-viewport"
    tabindex="0"
    role="img"
    aria-label="西西弗斯推石上山的像素动画，点击画面可助推"
  >
    <canvas id="sisyphus-canvas" class="ascii-slope-canvas" width="320" height="180"></canvas>
    <pre class="ascii-slope-pre is-sr-mirror" id="sisyphus-sr-status" aria-hidden="true"></pre>
  </div>

  <div class="bento-foot">
    <span id="sisyphus-telemetry" data-summits={initialSummits}>
      ALT 210.0m / 884.8m · ETA 06h 05m · #1
    </span>
    <span id="sisyphus-phase-quote">"{CAMUS_QUOTE}"</span>
  </div>
</div>

<script>
  type Realm = 'void' | 'paper' | 'crt' | 'amber';
  type Mode = 'push' | 'stand' | 'cheer' | 'walk' | 'watch';
  type Phase = 'CLIMB' | 'SUMMIT' | 'ROLL' | 'DESCENT';

  const boot = () => {
    const canvas = document.getElementById('sisyphus-canvas') as HTMLCanvasElement | null;
    const viewportEl = document.getElementById('sisyphus-stage-viewport');
    const titleEl = document.getElementById('sisyphus-stage-title');
    const telemetryEl = document.getElementById('sisyphus-telemetry');
    const quoteEl = document.getElementById('sisyphus-phase-quote');
    const srEl = document.getElementById('sisyphus-sr-status');
    const pushBtn = document.getElementById('sisyphus-push-btn');
    const summitBtn = document.getElementById('sisyphus-summit-btn');
    if (!canvas || !telemetryEl) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // ======================================================================
    // 0. 常量与工具
    // ======================================================================
    const W = 320;
    const H = 180;
    const N = W * H;
    canvas.width = W;
    canvas.height = H;

    const CYCLE_MS = 8 * 60 * 60 * 1000;
    const PEAK_ALT = 884.8;
    const STORAGE_KEY = 'sisyphus_8h_cycle_v2';
    const baseSummits = Number(telemetryEl.dataset.summits || '1');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const clamp = (v: number, a: number, b: number) => (v < a ? a : v > b ? b : v);
    const pack = (r: number, g: number, b: number) =>
      ((255 << 24) | (b << 16) | (g << 8) | r) >>> 0;
    const hex = (h: string) => {
      const n = parseInt(h.slice(1), 16);
      return pack((n >> 16) & 255, (n >> 8) & 255, n & 255);
    };
    const hash = (x: number, y: number) => {
      const h = Math.sin(x * 127.1 + y * 311.7) * 43758.5453;
      return h - Math.floor(h);
    };
    const noise = (x: number, y: number) => {
      const ix = Math.floor(x);
      const iy = Math.floor(y);
      const fx = x - ix;
      const fy = y - iy;
      const ux = fx * fx * (3 - 2 * fx);
      const uy = fy * fy * (3 - 2 * fy);
      const a = hash(ix, iy);
      const b = hash(ix + 1, iy);
      const c = hash(ix, iy + 1);
      const d = hash(ix + 1, iy + 1);
      return a + (b - a) * ux + (c - a) * uy + (a - b - c + d) * ux * uy;
    };

    const B4 = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map((v) => (v + 0.5) / 16);
    const bayer = (x: number, y: number) => B4[((y & 3) << 2) | (x & 3)];

    // ======================================================================
    // 1. 像素光栅器（直接写 ImageData，自带图层/遮罩/描边）
    // ======================================================================
    const image = ctx.createImageData(W, H);
    const buf = new Uint32Array(image.data.buffer);
    const staticBuf = new Uint32Array(N);
    const layer = new Uint32Array(N);
    const mask = new Uint8Array(N);
    const tmpRow = new Uint32Array(W);

    let toLayer = false;
    let layerId = 1;
    let clipFn: ((x: number, y: number) => boolean) | null = null;
    let bx0 = W;
    let by0 = H;
    let bx1 = 0;
    let by1 = 0;

    const plot = (x: number, y: number, c: number) => {
      if (x < 0 || y < 0 || x >= W || y >= H) return;
      if (clipFn && !clipFn(x, y)) return;
      const i = y * W + x;
      if (toLayer) {
        layer[i] = c;
        mask[i] = layerId;
        if (x < bx0) bx0 = x;
        if (x > bx1) bx1 = x;
        if (y < by0) by0 = y;
        if (y > by1) by1 = y;
      } else {
        buf[i] = c;
      }
    };
    const pset = (x: number, y: number, c: number) => plot(Math.floor(x), Math.floor(y), c);
    const pdither = (x: number, y: number, c: number, a: number) => {
      const xi = Math.floor(x);
      const yi = Math.floor(y);
      if (a >= 1 || (a > 0 && a > bayer(xi, yi))) plot(xi, yi, c);
    };
    const rect = (x: number, y: number, w: number, h: number, c: number) => {
      const x0 = Math.round(x);
      const y0 = Math.round(y);
      for (let j = 0; j < h; j++) for (let i = 0; i < w; i++) plot(x0 + i, y0 + j, c);
    };
    const disc = (cx: number, cy: number, r: number, c: number) => {
      const R = Math.ceil(r);
      const r2 = r * r;
      const x0 = Math.round(cx);
      const y0 = Math.round(cy);
      for (let dy = -R; dy <= R; dy++)
        for (let dx = -R; dx <= R; dx++) if (dx * dx + dy * dy <= r2) plot(x0 + dx, y0 + dy, c);
    };
    const fillEllipse = (cx: number, cy: number, rx: number, ry: number, c: number) => {
      const x0 = Math.round(cx);
      const y0 = Math.round(cy);
      for (let dy = -Math.ceil(ry); dy <= Math.ceil(ry); dy++)
        for (let dx = -Math.ceil(rx); dx <= Math.ceil(rx); dx++)
          if ((dx * dx) / (rx * rx) + (dy * dy) / (ry * ry) <= 1) plot(x0 + dx, y0 + dy, c);
    };
    const stroke = (x0: number, y0: number, x1: number, y1: number, w: number, c: number) => {
      const steps = Math.max(1, Math.ceil(Math.max(Math.abs(x1 - x0), Math.abs(y1 - y0))));
      for (let s = 0; s <= steps; s++) {
        const t = s / steps;
        const x = x0 + (x1 - x0) * t;
        const y = y0 + (y1 - y0) * t;
        if (w <= 1) plot(Math.round(x), Math.round(y), c);
        else rect(x - w / 2, y - w / 2, w, w, c);
      }
    };
    const ring = (cx: number, cy: number, rx: number, ry: number, c: number, a = 1) => {
      const steps = Math.ceil((rx + ry) * 3.4);
      for (let s = 0; s < steps; s++) {
        const t = (s / steps) * Math.PI * 2;
        pdither(cx + Math.cos(t) * rx, cy + Math.sin(t) * ry, c, a);
      }
    };
    const poly = (pts: number[], c: number) => {
      let minY = Infinity;
      let maxY = -Infinity;
      for (let i = 1; i < pts.length; i += 2) {
        minY = Math.min(minY, pts[i]);
        maxY = Math.max(maxY, pts[i]);
      }
      const n = pts.length / 2;
      const xs: number[] = [];
      for (let y = Math.max(0, Math.floor(minY)); y <= Math.min(H - 1, Math.ceil(maxY)); y++) {
        const sy = y + 0.5;
        xs.length = 0;
        for (let i = 0; i < n; i++) {
          const ax = pts[i * 2];
          const ay = pts[i * 2 + 1];
          const j = (i + 1) % n;
          const bxp = pts[j * 2];
          const byp = pts[j * 2 + 1];
          if ((ay <= sy && byp > sy) || (byp <= sy && ay > sy)) {
            xs.push(ax + ((sy - ay) / (byp - ay)) * (bxp - ax));
          }
        }
        xs.sort((a, b) => a - b);
        for (let k = 0; k + 1 < xs.length; k += 2) {
          for (let x = Math.ceil(xs[k] - 0.5); x <= Math.floor(xs[k + 1] - 0.5); x++) plot(x, y, c);
        }
      }
    };
    const gradient = (stops: [number, string][]) => {
      const cs = stops.map(([y, c]) => [y, hex(c)] as [number, number]);
      for (let y = 0; y < H; y++) {
        let k = 0;
        while (k < cs.length - 2 && y >= cs[k + 1][0]) k++;
        const [ya, ca] = cs[k];
        const [yb, cb] = cs[k + 1];
        const t = clamp((y - ya) / Math.max(1, yb - ya), 0, 1);
        for (let x = 0; x < W; x++) plot(x, y, t > bayer(x, y) ? cb : ca);
      }
    };
    const depthTone = (stops: [number, number][], d: number, x: number, y: number) => {
      let k = 0;
      while (k < stops.length - 2 && d >= stops[k + 1][0]) k++;
      const [da, ca] = stops[k];
      const [db, cb] = stops[k + 1];
      const t = clamp((d - da) / Math.max(1, db - da), 0, 1);
      return t > bayer(x, y) ? cb : ca;
    };

    // 3x5 像素字体（浮动数字）
    const FONT: Record<string, string> = {
      '0': '111101101101111',
      '1': '010110010010111',
      '2': '111001111100111',
      '3': '111001111001111',
      '4': '101101111001001',
      '5': '111100111001111',
      '6': '111100111101111',
      '7': '111001010010010',
      '8': '111101111101111',
      '9': '111101111001111',
      '+': '000010111010000',
      m: '000110111101101',
      '.': '000000000000010',
    };
    const drawText = (s: string, x: number, y: number, c: number, oc: number) => {
      let cx = Math.round(x);
      const cy = Math.round(y);
      for (const ch of s) {
        const g = FONT[ch];
        if (g) {
          for (let pass = 0; pass < 2; pass++) {
            for (let b = 0; b < 15; b++) {
              if (g[b] !== '1') continue;
              const gx = cx + (b % 3);
              const gyy = cy + Math.floor(b / 3);
              if (pass === 0) {
                for (let oy = -1; oy <= 1; oy++) for (let ox = -1; ox <= 1; ox++) plot(gx + ox, gyy + oy, oc);
              } else plot(gx, gyy, c);
            }
          }
        }
        cx += 4;
      }
    };

    // ======================================================================
    // 2. 地形与路径
    // ======================================================================
    const BASE_Y = 160;
    const SUMMIT_Y = 62;
    const X0 = 30;
    const X1 = 262;
    const terrainAt = (x: number) => {
      if (x <= X0) return BASE_Y;
      if (x >= X1) return SUMMIT_Y;
      const t = (x - X0) / (X1 - X0);
      const e = t * 0.7 + t * t * (3 - 2 * t) * 0.3;
      const und = Math.sin(t * Math.PI * 3) * Math.sin(t * Math.PI) * 3.2;
      return BASE_Y - (BASE_Y - SUMMIT_Y) * e + und;
    };
    const GY = new Float32Array(W + 2);
    for (let x = 0; x < W + 2; x++) GY[x] = terrainAt(x);
    const gyi = new Int16Array(W);
    for (let x = 0; x < W; x++) gyi[x] = Math.round(GY[x]);
    const gy = (x: number) => {
      if (x <= 0) return GY[0];
      if (x >= W) return GY[W];
      const i = Math.floor(x);
      const f = x - i;
      return GY[i] * (1 - f) + GY[i + 1] * f;
    };
    const skyClip = (x: number, y: number) => y < gyi[x];

    const R = 8;
    const PATH_X0 = 46;
    const PATH_X1 = 270;
    const contactX = (p: number) => PATH_X0 + clamp(p, 0, 1) * (PATH_X1 - PATH_X0);
    const boulderCenter = (cx: number, lift = 0) => {
      const g = (gy(cx + 1) - gy(cx - 1)) / 2;
      const l = Math.hypot(g, 1);
      return { x: cx + (g / l) * R, y: gy(cx) - R / l - 0.5 - lift };
    };
    const pushHeroX = (p: number) => boulderCenter(contactX(p)).x - R + 0.5 - 10.8;
    const SUMMIT_STAND_X = 284;

    // 沙丘中景（amber 静态 + 沙虫裁剪共用）
    const midDune = (x: number) => 136 + Math.sin(x * 0.027 + 2) * 7 + Math.sin(x * 0.07) * 2.5;
    const midDuneI = new Int16Array(W);
    for (let x = 0; x < W; x++) midDuneI[x] = Math.round(midDune(x));

    // ======================================================================
    // 3. 主题配色
    // ======================================================================
    const HERO: Record<Realm, { main: number; back: number; acc: number; acc2: number; outline: number }> = {
      void: { main: hex('#e9edf5'), back: hex('#a7afc2'), acc: hex('#f2b44f'), acc2: hex('#c6ccda'), outline: hex('#080a14') },
      paper: { main: hex('#2b2622'), back: hex('#544a41'), acc: hex('#3e5878'), acc2: hex('#c9a45c'), outline: hex('#1e1a17') },
      crt: { main: hex('#010402'), back: hex('#04160a'), acc: hex('#b6ffcf'), acc2: hex('#010402'), outline: hex('#3dff7a') },
      amber: { main: hex('#3b2519'), back: hex('#26170f'), acc: hex('#5ec8ff'), acc2: hex('#8f5a36'), outline: hex('#1d0d07') },
    };
    const ROCK: Record<Realm, number[]> = {
      void: ['#f1f3f8', '#c5cad6', '#8f96a8', '#5c6276', '#353a4c'].map(hex),
      paper: ['#cfc7b8', '#a39b8d', '#7d7569', '#575049', '#3a3430'].map(hex),
      crt: ['#c8ffd9', '#3dff7a', '#138a3a', '#03200d', '#010a04'].map(hex),
      amber: ['#f2bb78', '#d9944f', '#b8723c', '#8a4f2a', '#5e321c'].map(hex),
    };
    const LIGHT: Record<Realm, [number, number, number]> = {
      void: [-0.72, -0.45, 0.52],
      paper: [0.55, -0.6, 0.58],
      crt: [-0.2, -0.5, 0.84],
      amber: [0.7, -0.25, 0.66],
    };
    for (const k of Object.keys(LIGHT) as Realm[]) {
      const [a, b, c] = LIGHT[k];
      const l = Math.hypot(a, b, c);
      LIGHT[k] = [a / l, b / l, c / l];
    }
    const SHADOW: Record<Realm, { c: number; dir: number } | null> = {
      void: { c: hex('#2a2f42'), dir: 1 },
      paper: { c: hex('#4a4436'), dir: -1 },
      crt: null,
      amber: { c: hex('#7a3d22'), dir: -1 },
    };
    const TITLES: Record<Realm, string> = {
      void: '01 // TYCHO · 月面第谷环形山',
      paper: '01 // TERMINUS · 浮世绘端点星',
      crt: '01 // CONSTRUCT · 母体构造层',
      amber: '01 // ARRAKIS · 厄拉科斯沙海',
    };
    const CLIMB_QUOTES: Record<Realm, string> = {
      void: '"My God, it\'s full of stars." —— 2001: A Space Odyssey',
      paper: '"Violence is the last refuge of the incompetent." —— Salvor Hardin',
      crt: '"There is no spoon." —— The Matrix',
      amber: '"Fear is the mind-killer." —— Dune',
    };

    const getRealm = (): Realm => {
      const r = document.documentElement.dataset.realm;
      return r === 'paper' || r === 'crt' || r === 'amber' ? r : 'void';
    };
    let realm: Realm = getRealm();

    // ======================================================================
    // 4. 静态背景构建（每次切换主题时烘焙一次）
    // ======================================================================
    interface Star { x: number; y: number; b: number; ph: number }
    let stars: Star[] = [];

    const drawSeal = (cx: number, cy: number, s: number, red: number, paperC: number) => {
      const x0 = Math.round(cx - s / 2);
      const y0 = Math.round(cy - s / 2);
      rect(x0, y0, s, s, red);
      const u = s / 15;
      const t = Math.max(1, Math.round(u * 1.4));
      rect(x0 + 7 * u, y0 + 3 * u, t, 9 * u + t, paperC);
      rect(x0 + 3 * u, y0 + 6 * u, t, 6 * u + t, paperC);
      rect(x0 + 11 * u, y0 + 6 * u, t, 6 * u + t, paperC);
      rect(x0 + 3 * u, y0 + 12 * u, 8 * u + t, t, paperC);
      for (let i = 0; i < s; i++) {
        if (hash(i, s) > 0.72) plot(x0 + i, y0, paperC);
        if (hash(s, i) > 0.72) plot(x0 + i, y0 + s - 1, paperC);
        if (hash(i + 3, s * 2) > 0.75) plot(x0, y0 + i, paperC);
        if (hash(s * 3, i + 7) > 0.75) plot(x0 + s - 1, y0 + i, paperC);
      }
    };

    const buildVoid = () => {
      gradient([
        [0, '#020309'],
        [55, '#050a1c'],
        [105, '#0c1430'],
        [150, '#18234a'],
      ]);
      // 木星 + 卫星连珠（2001 开场构图）
      const jx = 62;
      const jy = 46;
      const jr = 25;
      const bands = ['#efdcb4', '#c89a63', '#f4e7cb', '#b07a4c', '#e6c896', '#a86f45', '#f0dfba'].map(hex);
      const night = hex('#14111d');
      const dusk = hex('#3a2c33');
      const spot = hex('#c4563c');
      for (let dy = -jr; dy <= jr; dy++) {
        for (let dx = -jr; dx <= jr; dx++) {
          const nx = dx / jr;
          const ny = dy / jr;
          const r2 = nx * nx + ny * ny;
          if (r2 > 1) continue;
          const nz = Math.sqrt(1 - r2);
          const lum = clamp(-nx * 0.75 - ny * 0.35 + nz * 0.55, 0, 1);
          const bi = Math.floor((ny + 1) * 5.2 + Math.sin(nx * 5 + ny * 3) * 0.35);
          let c = bands[((bi % bands.length) + bands.length) % bands.length];
          if (((dx + 7) / 4.4) ** 2 + ((dy - 8) / 2.4) ** 2 <= 1) c = spot;
          const x = jx + dx;
          const y = jy + dy;
          if (lum < 0.16 + bayer(x, y) * 0.16) c = night;
          else if (lum < 0.3 + bayer(x, y) * 0.12) c = dusk;
          plot(x, y, c);
        }
      }
      disc(98, 22, 2.2, hex('#d9dde6'));
      disc(109, 16, 1.5, hex('#c3c8d4'));
      plot(118, 11, hex('#aeb4c2'));

      // 远景高地两层
      for (let x = 0; x < W; x++) {
        const a = Math.round(112 + Math.sin(x * 0.021 + 1) * 10 + Math.sin(x * 0.067) * 4);
        const b = Math.round(128 + Math.sin(x * 0.03 + 2.4) * 8 + Math.sin(x * 0.09) * 3);
        for (let y = a; y < H; y++) plot(x, y, y === a ? hex('#39425f') : hex('#1b2136'));
        for (let y = b; y < H; y++) plot(x, y, y === b ? hex('#4a5479') : depthTone([[0, hex('#2a3150')], [20, hex('#20263f')]], y - b, x, y));
      }
      // 主山体：月壤
      const tones: [number, number][] = [
        [0, hex('#a3aabb')],
        [8, hex('#7c8396')],
        [22, hex('#5a6074')],
        [46, hex('#3c4155')],
        [90, hex('#262a3b')],
      ];
      for (let x = 0; x < W; x++) {
        const top = gyi[x];
        for (let y = top; y < H; y++) {
          let c = depthTone(tones, y - top, x, y);
          const h = hash(x, y);
          if (h > 0.985) c = hex('#c2c8d4');
          else if (h > 0.94) c = hex('#4b5064');
          plot(x, y, c);
        }
        plot(x, top, hex('#e2e7f0'));
      }
      // 环形山
      for (let i = 0; i < 14; i++) {
        const x = 40 + hash(i, 7) * 215;
        const rx = 2.5 + hash(i, 9) * 5;
        const ry = rx * 0.38;
        const cy = gy(x) + 3 + hash(i, 8) * 14;
        for (let dy = -Math.ceil(ry) - 1; dy <= Math.ceil(ry) + 1; dy++) {
          for (let dx = -Math.ceil(rx) - 1; dx <= Math.ceil(rx) + 1; dx++) {
            const e = (dx * dx) / (rx * rx) + (dy * dy) / (ry * ry);
            const px = Math.round(x) + dx;
            const py = Math.round(cy) + dy;
            if (py <= gyi[clamp(px, 0, W - 1)]) continue;
            if (e <= 0.72) plot(px, py, dx < rx * 0.1 ? hex('#3f4558') : hex('#8f96a8'));
            else if (e <= 1.25) plot(px, py, dy < 0 ? hex('#c3c9d6') : hex('#50566a'));
          }
        }
      }
      // 碎石
      for (let i = 0; i < 12; i++) {
        const x = 34 + hash(i, 21) * 240;
        const r = 1 + hash(i, 22) * 1.4;
        disc(x, gy(x) - r * 0.6, r, hex('#6a7184'));
        plot(Math.round(x - r * 0.4), Math.round(gy(x) - r), hex('#d0d5df'));
      }
      // 峰顶 TMA-1 黑石碑 (≈1:4:9) + 长影
      const mb = gyi[294];
      for (let i = 0; i < 24; i++) pdither(297 + i, mb, hex('#1d2233'), 0.8 - i / 30);
      rect(290, mb - 17, 7, 17, hex('#020204'));
      rect(290, mb - 17, 1, 17, hex('#3e4663'));
      rect(290, mb - 17, 7, 1, hex('#5a6489'));

      stars = [];
      for (let i = 0; i < 150; i++) {
        const x = Math.floor(hash(i, 1) * W);
        const y = Math.floor(hash(i, 2) * 118);
        if (y >= gy(x) - 4 || y > 108) continue;
        if (Math.hypot(x - jx, y - jy) < jr + 2) continue;
        stars.push({ x, y, b: hash(i, 3), ph: hash(i, 4) * 6.28 });
      }
    };

    const buildPaper = () => {
      // 宣纸底 + 纤维 + 暗角
      const p0 = hex('#efe5cf');
      const p1 = hex('#e7dbc1');
      const p2 = hex('#dccdb0');
      const pv = hex('#e0d1b2');
      for (let y = 0; y < H; y++) {
        for (let x = 0; x < W; x++) {
          const h = hash(x, y);
          let c = h > 0.97 ? p2 : h > 0.8 ? p1 : p0;
          const vx = (x - W / 2) / (W / 2);
          const vy = (y - H / 2) / (H / 2);
          if ((vx * vx + vy * vy) * 0.42 - 0.18 > bayer(x, y)) c = pv;
          plot(x, y, c);
        }
      }
      // 朱砂红日（在峰顶之后）
      disc(250, 44, 22, hex('#c8402a'));
      // 远山富士：靛蓝 + 雪冠 + 墨线
      const ink = hex('#2b2622');
      for (let x = 30; x < 280; x++) {
        const top = 52 + Math.pow(Math.abs(x - 150) / 110, 1.35) * 70 + Math.sin(x * 0.4) * 0.6;
        const ti = Math.round(top);
        for (let y = ti; y < 150; y++) {
          const d = y - ti;
          const snow = 61 + Math.abs(Math.sin(x * 0.55)) * 7 + Math.abs(x - 150) * 0.05;
          let c: number;
          if (y < snow) c = hex('#f7f1e3');
          else c = depthTone([[0, hex('#3e5878')], [30, hex('#55708f')], [60, hex('#8aa0b4')]], d, x, y);
          plot(x, y, c);
        }
        plot(x, ti, ink);
      }
      // 雾带
      for (let y = 116; y < 136; y++) {
        const a = 1 - Math.abs(y - 126) / 10;
        for (let x = 0; x < W; x++) pdither(x, y, hex('#f4ecda'), a);
      }
      // 近处低丘
      for (let x = 0; x < 200; x++) {
        const t = Math.round(140 + Math.sin(x * 0.05 + 0.4) * 6 + Math.sin(x * 0.13) * 2);
        for (let y = t; y < H; y++) plot(x, y, y === t ? ink : hex('#a7b38c'));
      }
      // 主山体
      const tones: [number, number][] = [
        [0, hex('#7f915f')],
        [10, hex('#6f8152')],
        [30, hex('#5d6d45')],
        [70, hex('#4c5a39')],
      ];
      for (let x = 0; x < W; x++) {
        const top = gyi[x];
        for (let y = top; y < H; y++) plot(x, y, depthTone(tones, y - top, x, y));
        plot(x, top, ink);
        if (top + 1 < H) plot(x, top + 1, hex('#3d4a2d'));
      }
      // 皴法短笔触 + 草簇
      for (let i = 0; i < 160; i++) {
        const x = Math.floor(hash(i, 31) * W);
        const y = gyi[x] + 4 + Math.floor(hash(i, 32) * 50);
        if (y >= H - 1) continue;
        stroke(x, y, x + 2, y - 2, 1, hex('#3a4430'));
      }
      for (let x = 6; x < W; x += 7 + Math.floor(hash(x, 5) * 6)) {
        const t = gyi[x];
        plot(x, t - 1, ink);
        plot(x - 1, t - 2, ink);
        plot(x + 1, t - 2, ink);
      }
      // 前景松树
      stroke(16, 161, 21, 112, 2, ink);
      stroke(19, 130, 10, 122, 1, ink);
      stroke(20, 120, 30, 116, 1, ink);
      const canopy: [number, number, number, number][] = [
        [14, 121, 9, 3],
        [29, 116, 9, 3],
        [21, 108, 11, 3.5],
        [18, 99, 8, 3],
      ];
      for (const [cx, cy, rx, ry] of canopy) fillEllipse(cx, cy, rx + 1, ry + 1, ink);
      for (const [cx, cy, rx, ry] of canopy) {
        fillEllipse(cx, cy, rx, ry, hex('#3f5a3a'));
        stroke(cx - rx + 2, cy - 1, cx + rx - 3, cy - 1, 1, hex('#5f7d55'));
      }
      // 峰顶谢顿穹顶（神社式）
      const tb = gyi[300];
      rect(294, tb - 10, 1, 10, hex('#b5452c'));
      rect(306, tb - 10, 1, 10, hex('#b5452c'));
      rect(296, tb - 7, 9, 7, hex('#e9dcc0'));
      poly([288, tb - 10, 313, tb - 10, 308, tb - 14, 293, tb - 14], ink);
      rect(299, tb - 16, 3, 2, ink);
      stroke(296, tb - 4, 304, tb - 4, 1, ink);
      // 角落印章「山」
      drawSeal(15, 15, 15, hex('#b8382a'), hex('#efe5cf'));
    };

    const buildCrt = () => {
      const bg = hex('#010502');
      for (let i = 0; i < N; i++) buf[i] = bg;
      // 母体城市天际线
      let x = 0;
      while (x < W) {
        const w = 6 + Math.floor(hash(x, 1) * 14);
        const h = 18 + Math.floor(hash(x, 2) * 52);
        const top = 148 - h;
        for (let yy = top; yy < 148; yy++) {
          for (let xx = x; xx < Math.min(W, x + w); xx++) {
            const edge = xx === x || xx === x + w - 1 || yy === top;
            let c = hex('#020a04');
            if (edge) c = hex('#0b3a1a');
            else if ((xx - x) % 3 === 1 && (yy - top) % 4 === 2 && hash(xx, yy) > 0.45) c = hex('#0f5a28');
            plot(xx, yy, c);
          }
        }
        x += w + 1 + Math.floor(hash(x, 3) * 3);
      }
      for (let xx = 0; xx < W; xx++) plot(xx, 148, hex('#0b3a1a'));
      // 线框山体
      for (let xx = 0; xx < W; xx++) {
        const top = gyi[xx];
        for (let y = top; y < H; y++) plot(xx, y, hex('#010703'));
        for (let k = 1; top + k * 5 < H; k++) {
          const c = k < 3 ? hex('#0f6a2c') : k < 6 ? hex('#0b4a20') : hex('#072e14');
          pdither(xx, top + k * 5, c, 1 - k * 0.07);
        }
        if (xx % 10 === 0) for (let y = top + 1; y < H; y++) pdither(xx, y, hex('#083818'), 0.7);
        plot(xx, top, hex('#3dff7a'));
        if (top + 1 < H) plot(xx, top + 1, hex('#127a35'));
      }
      // 峰顶：源头之门
      const db = gyi[298];
      rect(293, db - 16, 10, 16, hex('#3dff7a'));
      rect(294, db - 15, 8, 15, hex('#0a2e14'));
      rect(297, db - 14, 2, 14, hex('#c8ffd9'));
      for (let i = 0; i < 16; i++) pdither(303 + i, db, hex('#0f6a2c'), 0.8 - i / 20);
    };

    const buildAmber = () => {
      gradient([
        [0, '#170b1c'],
        [38, '#33142c'],
        [72, '#6b2632'],
        [100, '#b34a33'],
        [124, '#e58a46'],
        [142, '#f2b866'],
      ]);
      // 落日余晖
      for (let r = 34; r > 22; r--) ring(230, 128, r, r, hex('#f6c27a'), 0.5 - (r - 22) / 30);
      disc(230, 128, 22, hex('#fbdc98'));
      // 双月（大月上有穆阿迪布跳鼠的影子）
      disc(70, 30, 10, hex('#f0dcc0'));
      for (let dy = -10; dy <= 10; dy++) {
        for (let dx = -10; dx <= 10; dx++) {
          if (dx * dx + dy * dy > 100) continue;
          const lit = (dx + 3) / 10;
          if (lit < bayer(70 + dx, 30 + dy) * 0.9 - 0.4) plot(70 + dx, 30 + dy, hex('#b9a487'));
        }
      }
      const mouse = hex('#c9af8e');
      fillEllipse(70, 32, 2.4, 1.3, mouse);
      plot(73, 31, mouse);
      plot(73, 30, mouse);
      plot(74, 31, mouse);
      plot(67, 33, mouse);
      plot(66, 32, mouse);
      plot(65, 31, mouse);
      plot(65, 30, mouse);
      disc(101, 18, 4.5, hex('#dcc6a4'));
      for (let i = 0; i < 40; i++) {
        const sx = Math.floor(hash(i, 51) * W);
        const sy = Math.floor(hash(i, 52) * 40);
        if (Math.hypot(sx - 70, sy - 30) > 13) plot(sx, sy, hex('#f5d9c0'));
      }
      // 远景沙丘
      for (let x = 0; x < W; x++) {
        const t = Math.round(122 + Math.sin(x * 0.018 + 0.5) * 6 + Math.sin(x * 0.051 + 1.2) * 3);
        for (let y = t; y < H; y++) plot(x, y, y === t ? hex('#c06440') : hex('#8a3e2c'));
      }
      for (let x = 0; x < W; x++) {
        const t = midDuneI[x];
        const lit = midDune(x + 1) - midDune(x) > 0;
        for (let y = t; y < H; y++) plot(x, y, y === t ? hex('#e3894c') : lit ? hex('#bb6234') : hex('#8f4426'));
      }
      // 主沙丘：风成波纹
      const tones: [number, number][] = [
        [0, hex('#d7843f')],
        [12, hex('#c06f36')],
        [35, hex('#a35a2d')],
        [80, hex('#7e4325')],
      ];
      for (let x = 0; x < W; x++) {
        const top = gyi[x];
        for (let y = top; y < H; y++) {
          const d = y - top;
          let c = depthTone(tones, d, x, y);
          const r = Math.sin(x * 0.42 + d * 1.25 + noise(x * 0.05, y * 0.08) * 3);
          if (d < 45 && r > 0.85) c = hex('#eaa25c');
          else if (r < -0.9) c = hex('#9b512b');
          plot(x, y, c);
        }
        plot(x, top, hex('#f7c27c'));
      }
      // 峰顶障壁山岩柱
      const rock = hex('#4a2418');
      const rockLit = hex('#8a4a2c');
      poly([282, 63, 288, 42, 292, 46, 297, 30, 302, 40, 308, 33, 314, 48, 320, 44, 320, 63], rock);
      stroke(288, 43, 285, 60, 1, rockLit);
      stroke(297, 31, 293, 58, 1, rockLit);
      stroke(308, 34, 305, 58, 1, rockLit);
      for (let x = 282; x < W; x++) plot(x, gyi[x], hex('#f7c27c'));
    };

    const buildStatic = () => {
      toLayer = false;
      clipFn = null;
      if (realm === 'void') buildVoid();
      else if (realm === 'paper') buildPaper();
      else if (realm === 'crt') buildCrt();
      else buildAmber();
      staticBuf.set(buf);
    };

    // ======================================================================
    // 5. 动态元素状态
    // ======================================================================
    interface Particle {
      x: number; y: number; vx: number; vy: number;
      life: number; max: number; c: number; g: number; kind: number; seed: number;
    }
    const parts: Particle[] = [];
    const emit = (x: number, y: number, vx: number, vy: number, max: number, c: number, g = 0, kind = 0) => {
      if (parts.length > 260) parts.shift();
      parts.push({ x, y, vx, vy, life: 0, max, c, g, kind, seed: Math.floor(Math.random() * 511) });
    };
    interface Floater { x: number; y: number; s: string; t: number }
    const floats: Floater[] = [];

    // 黑客帝国代码雨
    const GLYPHS: number[] = [];
    for (let i = 0; i < 48; i++) {
      let m = 0;
      for (let b = 0; b < 15; b++) if (hash(i, b + 90) > 0.48) m |= 1 << b;
      GLYPHS.push(m || 0b010111010);
    }
    const rain = Array.from({ length: 64 }, (_, i) => ({
      x: 1 + i * 5,
      y: Math.random() * H * 1.5 - H * 0.5,
      sp: 22 + Math.random() * 40,
      len: 4 + Math.floor(Math.random() * 9),
      seed: Math.floor(Math.random() * 1000),
    }));

    const worm = { active: false, t: 0, x0: 120, dir: 1 };
    let nextWorm = 12;
    let glitch = 0;
    let nextGlitch = 5;
    let summitFx = -1;

    // ======================================================================
    // 6. 8 小时真实时间轮回（与全站推石存档同步）
    // ======================================================================
    interface CycleSave { anchorEpoch: number; boostAccum: number; boostMeters: number }
    let save: CycleSave = { anchorEpoch: Math.floor(Date.now() / CYCLE_MS), boostAccum: 0, boostMeters: 0 };
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (typeof parsed.anchorEpoch === 'number' && typeof parsed.boostAccum === 'number') {
          save = { anchorEpoch: parsed.anchorEpoch, boostAccum: parsed.boostAccum, boostMeters: Number(parsed.boostMeters || 0) };
        }
      } else localStorage.setItem(STORAGE_KEY, JSON.stringify(save));
    } catch {}
    const persistSave = () => {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(save));
      } catch {}
    };
    const reloadSave = () => {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const p = JSON.parse(raw);
          save.boostAccum = Number(p.boostAccum ?? save.boostAccum);
          save.boostMeters = Number(p.boostMeters ?? save.boostMeters);
        }
      } catch {}
    };
    const getTotal = (ms: number) => Math.max(0, ms / CYCLE_MS - save.anchorEpoch + save.boostAccum);

    let phase: Phase = 'CLIMB';
    let phaseT = 0;
    const initTotal = getTotal(Date.now());
    let activeCycle = Math.floor(initTotal);
    let frac = initTotal - activeCycle;
    let sprint = false;
    let gait = 0;
    let kick = 0;
    let rollX = PATH_X1;
    let rollV = 0;
    let heroX = pushHeroX(frac);
    let prevSin = 0;

    const enterSummit = () => {
      phase = 'SUMMIT';
      phaseT = 0;
      frac = 1;
      summitFx = 0;
      if (realm === 'amber') {
        worm.active = true;
        worm.t = 0;
        worm.x0 = 70;
        worm.dir = 1;
      }
      if (realm === 'crt') glitch = 0.3;
    };

    // ======================================================================
    // 7. 交互
    // ======================================================================
    const applyBoost = (amount: number, at?: { x: number; y: number }) => {
      if (phase !== 'CLIMB') return;
      reloadSave();
      const gained = amount * PEAK_ALT;
      kick = 0.45;
      const bc = boulderCenter(contactX(frac));
      const hx = bc.x - R;
      const pal = ROCK[realm];
      for (let i = 0; i < 16; i++) {
        const a = Math.random() * Math.PI * 2;
        const v = 10 + Math.random() * 30;
        if (realm === 'crt') emit(hx, bc.y, Math.cos(a) * v, Math.sin(a) * v - 10, 0.9, hex('#3dff7a'), 20, 2);
        else if (realm === 'paper') emit(hx, bc.y, Math.cos(a) * v, Math.sin(a) * v - 12, 1.2, i % 3 ? hex('#2b2622') : hex('#e9a3a0'), 40, i % 3 ? 0 : 1);
        else if (realm === 'amber') emit(hx, bc.y + 4, Math.cos(a) * v, -Math.abs(Math.sin(a) * v), 0.9, i % 2 ? hex('#f2bb78') : hex('#ffd59a'), 70, 0);
        else emit(hx, bc.y, Math.cos(a) * v, Math.sin(a) * v, 0.8, i % 2 ? pal[0] : hex('#8fd3ff'), 0, 4);
      }
      if (at) {
        for (let i = 0; i < 6; i++) emit(at.x, at.y, (Math.random() - 0.5) * 24, (Math.random() - 0.5) * 24, 0.5, pal[0], 0, 4);
      }
      floats.push({ x: bc.x - 6, y: bc.y - R - 6, s: `+${gained.toFixed(0)}m`, t: 0 });
      if (floats.length > 4) floats.shift();
      if (realm === 'crt' && Math.random() < 0.5) glitch = Math.max(glitch, 0.12);
    };

    let pendingAt: { x: number; y: number } | undefined;
    const requestPush = (source: string, at?: { x: number; y: number }) => {
      pendingAt = at;
      window.dispatchEvent(new CustomEvent('sisyphus:boulder-boost', { detail: { minM: 14, maxM: 38, source } }));
    };

    window.addEventListener('sisyphus:boulder-boost', (ev: Event) => {
      const d = (ev as CustomEvent<{ amount?: number; minM?: number; maxM?: number; rolledAmount?: number }>).detail;
      let amt = d?.rolledAmount;
      if (typeof amt !== 'number') {
        if (typeof d?.minM === 'number' && typeof d?.maxM === 'number') amt = (d.minM + Math.random() * (d.maxM - d.minM)) / PEAK_ALT;
        else amt = clamp(d?.amount ?? 0.018, 0.001, 0.12) * (0.58 + Math.random() * 0.87);
        if (d) d.rolledAmount = amt;
      }
      applyBoost(amt, pendingAt);
      pendingAt = undefined;
    });
    window.addEventListener('sisyphus:trigger-summit', () => {
      if (phase === 'CLIMB') sprint = true;
    });

    pushBtn?.addEventListener('click', () => requestPush('主动助推'));
    summitBtn?.addEventListener('click', () => {
      if (phase === 'CLIMB') sprint = true;
    });
    viewportEl?.addEventListener('click', (e: MouseEvent) => {
      const rct = canvas.getBoundingClientRect();
      const at = { x: ((e.clientX - rct.left) / rct.width) * W, y: ((e.clientY - rct.top) / rct.height) * H };
      requestPush('画面助推', at);
    });
    viewportEl?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.code === 'Space' || e.key === ' ') {
        e.preventDefault();
        requestPush('空格助推');
      }
    });

    let visible = true;
    if ('IntersectionObserver' in window && viewportEl) {
      new IntersectionObserver((ents) => {
        visible = ents.some((en) => en.isIntersecting);
      }).observe(viewportEl);
    }

    // ======================================================================
    // 8. 角色：IK 骨骼小人 + 主题装束
    // ======================================================================
    const ik = (ax: number, ay: number, bx: number, by: number, l1: number, l2: number, sign: number) => {
      let dx = bx - ax;
      let dy = by - ay;
      let d = Math.hypot(dx, dy) || 0.001;
      const maxD = l1 + l2 - 0.05;
      if (d > maxD) {
        dx *= maxD / d;
        dy *= maxD / d;
        d = maxD;
      }
      const cosA = clamp((l1 * l1 + d * d - l2 * l2) / (2 * l1 * d), -1, 1);
      const ang = Math.atan2(dy, dx) + Math.acos(cosA) * sign;
      return { jx: ax + Math.cos(ang) * l1, jy: ay + Math.sin(ang) * l1, ex: ax + dx, ey: ay + dy };
    };

    const drawHero = (
      mode: Mode,
      hx: number,
      f: number,
      gp: number,
      hand: { x: number; y: number } | null,
      heave: number,
      sec: number,
    ) => {
      const st = HERO[realm];
      const moving = mode === 'push' || mode === 'walk';
      const bob = moving ? Math.abs(Math.sin(gp)) * 0.7 : 0;
      let hipX: number;
      let hipY: number;
      let shX: number;
      let shY: number;
      if (mode === 'push' && hand) {
        hipX = hand.x - 10.8 - heave * 0.4;
        const g = gy(hipX + 0.5);
        hipY = clamp(hand.y + 3.4, g - 9.4, g - 7.2) + bob * 0.4;
        shX = hipX + 5.6 + heave * 0.5;
        shY = hipY - 4.6 - heave * 0.2;
      } else {
        const g = gy(hx);
        hipX = hx;
        hipY = g - 9.6 + bob * 0.5;
        shX = hipX + (mode === 'walk' ? f * 0.7 : 0);
        shY = hipY - 6.4;
      }
      const headX = shX + (mode === 'push' ? 2.4 : f * 0.5);
      const headY = shY - (mode === 'push' ? 2.6 : 3.3);

      // 腿
      const stride = mode === 'push' ? 3.4 : mode === 'walk' ? 3.0 : 0;
      const base = mode === 'push' ? hipX + 0.4 : hipX;
      let fFx = base + Math.cos(gp) * stride * f;
      let fBx = base + Math.cos(gp + Math.PI) * stride * f;
      const liftF = stride ? Math.max(0, -Math.sin(gp)) * 2 : 0;
      const liftB = stride ? Math.max(0, Math.sin(gp)) * 2 : 0;
      if (!stride) {
        fFx = hipX + 1.5 * f;
        fBx = hipX - 1.3 * f;
      }
      const legF = ik(hipX, hipY, fFx, gy(fFx) - 1 - liftF, 5, 5.2, -f);
      const legB = ik(hipX, hipY, fBx, gy(fBx) - 1 - liftB, 5, 5.2, -f);

      // 手
      let aF: { x: number; y: number };
      let aB: { x: number; y: number };
      if (mode === 'push' && hand) {
        aF = { x: hand.x, y: hand.y - 1 };
        aB = { x: hand.x - 0.6, y: hand.y + 1.2 };
      } else if (mode === 'cheer') {
        const w = Math.sin(sec * 10) * 0.8;
        aF = { x: shX + 2.6, y: shY - 6.6 + w };
        aB = { x: shX - 2.6, y: shY - 6.6 - w };
      } else if (mode === 'watch') {
        aF = { x: headX + f * 1.8, y: headY - 0.6 };
        aB = { x: shX - f * 0.6, y: shY + 7 };
      } else if (mode === 'walk') {
        const s = Math.cos(gp + Math.PI) * 2.4 * f;
        aF = { x: shX + s, y: shY + 6.8 };
        aB = { x: shX - s, y: shY + 6.8 };
      } else {
        aF = { x: shX + 0.6 * f, y: shY + 7 };
        aB = { x: shX - 0.6 * f, y: shY + 7 };
      }
      const armF = ik(shX, shY + 0.5, aF.x, aF.y, 3.9, 3.9, f);
      const armB = ik(shX - 0.4 * f, shY + 0.8, aB.x, aB.y, 3.9, 3.9, f);

      // —— 身后装束 ——
      if (realm === 'void') {
        const px = shX - f * 2.6 + (hipX - shX) * 0.25;
        rect(px - 1.5, shY + 0.5, 3, 5, st.acc2);
      } else if (realm === 'crt' || realm === 'amber') {
        const amberC = realm === 'amber';
        const w1 = Math.sin(sec * (amberC ? 9 : 7) + 1) * 1.2 + (moving ? 1.3 : 0.3);
        const tail = amberC ? 5 : 3.2;
        poly(
          [
            shX + f * 1.2, shY,
            hipX + f * 1.8, hipY + 0.5,
            hipX + f * 1.2, hipY + (amberC ? 7.5 : 8.5),
            hipX - f * (tail + w1), hipY + 8 + Math.sin(sec * 9) * 0.8,
            shX - f * (amberC ? 2.4 : 1.6), shY + 0.6,
          ],
          amberC ? st.acc2 : st.main,
        );
      }

      stroke(shX - 0.4 * f, shY + 0.8, armB.jx, armB.jy, 2, st.back);
      stroke(armB.jx, armB.jy, armB.ex, armB.ey, 2, st.back);
      stroke(hipX, hipY, legB.jx, legB.jy, 2, st.back);
      stroke(legB.jx, legB.jy, legB.ex, legB.ey, 2, st.back);
      plot(Math.round(legB.ex + f), Math.round(legB.ey), st.back);

      if (realm === 'paper') {
        poly([hipX - 2, hipY - 1, hipX + 2, hipY - 1, legF.jx + 1.5, legF.jy + 1.5, legB.jx - 1.5, legB.jy + 1.5], st.main);
      }

      stroke(hipX, hipY, shX, shY, 3, st.main);
      if (realm === 'paper') rect(hipX - 1.5, hipY - 1.5, 3, 1, st.acc);

      // 头 + 头饰
      if (realm === 'void') {
        disc(headX, headY, 3, st.main);
        rect(headX + (f > 0 ? 0.5 : -2.5), headY - 1.5, 2, 2, st.acc);
        plot(Math.round(headX + f * 1.4), Math.round(headY - 2), hex('#ffffff'));
      } else if (realm === 'paper') {
        disc(headX, headY, 2.3, st.main);
        poly([headX - 5.2, headY - 0.8, headX + 5.2, headY - 0.8, headX + 0.6, headY - 4.8], st.acc2);
        stroke(headX - 5, headY - 0.8, headX + 5, headY - 0.8, 1, hex('#8a6a34'));
      } else if (realm === 'crt') {
        disc(headX, headY, 2.3, st.main);
        rect(headX + (f > 0 ? 0.2 : -2.2), headY - 0.8, 2, 1, st.acc);
      } else {
        disc(headX - f * 0.4, headY, 2.9, st.acc2);
        disc(headX + f * 0.7, headY + 0.2, 1.4, st.main);
        plot(Math.round(headX + f * 1.3), Math.round(headY - 0.3), st.acc);
      }

      stroke(hipX, hipY, legF.jx, legF.jy, 2, st.main);
      stroke(legF.jx, legF.jy, legF.ex, legF.ey, 2, st.main);
      plot(Math.round(legF.ex + f), Math.round(legF.ey), st.main);
      stroke(shX, shY + 0.5, armF.jx, armF.jy, 2, st.main);
      stroke(armF.jx, armF.jy, armF.ex, armF.ey, 2, st.main);

      return { footF: { x: legF.ex, y: legF.ey }, footB: { x: legB.ex, y: legB.ey } };
    };

    // ======================================================================
    // 9. 巨石：逐像素球面光照 + 随滚动旋转的纹理
    // ======================================================================
    const CRATERS: [number, number, number][] = [
      [0.35, -0.3, 0.22],
      [-0.4, 0.25, 0.18],
      [0.1, 0.5, 0.14],
      [-0.2, -0.55, 0.12],
    ];
    const drawBoulder = (cx: number, cy: number, angle: number, sec: number) => {
      const pal = ROCK[realm];
      const [Lx, Ly, Lz] = LIGHT[realm];
      const ca = Math.cos(angle);
      const sa = Math.sin(angle);
      const x0 = Math.round(cx);
      const y0 = Math.round(cy);
      const rr = R + 0.5;
      for (let dy = -R; dy <= R; dy++) {
        for (let dx = -R; dx <= R; dx++) {
          const nx = dx / rr;
          const ny = dy / rr;
          const r2 = nx * nx + ny * ny;
          if (r2 > 1) continue;
          const nz = Math.sqrt(1 - r2);
          const u = nx * ca + ny * sa;
          const v = -nx * sa + ny * ca;
          const px = x0 + dx;
          const py = y0 + dy;
          let lum = nx * Lx + ny * Ly + nz * Lz;
          if (realm === 'crt') {
            const lat = Math.abs(v * 4 - Math.round(v * 4)) < 0.16;
            const lon = Math.abs(Math.atan2(u, nz) / (Math.PI / 5) - Math.round(Math.atan2(u, nz) / (Math.PI / 5))) < 0.15;
            let c = lum > 0.5 ? pal[3] : pal[4];
            if (lat || lon) c = lum > 0.55 ? pal[1] : pal[2];
            if (r2 > 0.82) c = pal[1];
            if (lum > 0.93 && (lat || lon)) c = pal[0];
            plot(px, py, c);
            continue;
          }
          if (realm === 'void') {
            lum += (noise(u * 3 + 10, v * 3) - 0.5) * 0.25;
            for (const [cu, cv, cr] of CRATERS) {
              const d = Math.hypot(u - cu, v - cv);
              if (d < cr) lum -= 0.32 * (1 - d / cr) * (((u - cu) * Lx + (v - cv) * Ly) < 0 ? 1 : 0.3);
              else if (d < cr + 0.08 && ((u - cu) * Lx + (v - cv) * Ly) > 0) lum += 0.15;
            }
          } else if (realm === 'paper') {
            if (Math.sin(v * 9 + noise(u * 2 + 4, v * 2) * 3) > 0.62) lum -= 0.2;
            lum += (noise(u * 5, v * 5) - 0.5) * 0.12;
          } else {
            const band = Math.sin(v * 10 + u * 1.5 + noise(u * 3, v * 3) * 1.5);
            if (band > 0.35) lum += 0.12;
            else if (band < -0.6) lum -= 0.12;
            if (hash(Math.round(u * 6), Math.round(v * 6)) > 0.96 && Math.sin(sec * 5 + u * 9) > 0.55) {
              plot(px, py, hex('#7fd8ff'));
              continue;
            }
          }
          const t = lum + (bayer(px, py) - 0.5) * 0.22;
          const c = t > 0.8 ? pal[0] : t > 0.52 ? pal[1] : t > 0.28 ? pal[2] : t > 0.08 ? pal[3] : pal[4];
          plot(px, py, c);
        }
      }
    };

    const castShadow = (x: number, len: number) => {
      const sh = SHADOW[realm];
      if (!sh) return;
      for (let i = 0; i < len; i++) {
        const sx = Math.round(x + i * sh.dir);
        if (sx < 0 || sx >= W) continue;
        const a = 0.8 * (1 - i / len);
        pdither(sx, gyi[sx], sh.c, a);
        pdither(sx, gyi[sx] + 1, sh.c, a * 0.75);
      }
    };

    const compositeLayer = (outline: number) => {
      if (bx1 < bx0) return;
      const xa = Math.max(1, bx0 - 1);
      const xb = Math.min(W - 2, bx1 + 1);
      const ya = Math.max(1, by0 - 1);
      const yb = Math.min(H - 2, by1 + 1);
      for (let y = ya; y <= yb; y++) {
        for (let x = xa; x <= xb; x++) {
          const i = y * W + x;
          const m = mask[i];
          if (m && !(mask[i - 1] > m || mask[i + 1] > m || mask[i - W] > m || mask[i + W] > m)) {
            buf[i] = layer[i];
          } else if (mask[i - 1] > m || mask[i + 1] > m || mask[i - W] > m || mask[i + W] > m) {
            buf[i] = outline;
          }
        }
      }
      for (let y = Math.max(0, by0 - 1); y <= Math.min(H - 1, by1 + 1); y++) {
        mask.fill(0, y * W + Math.max(0, bx0 - 1), y * W + Math.min(W, bx1 + 2));
      }
      bx0 = W;
      by0 = H;
      bx1 = 0;
      by1 = 0;
    };

    // ======================================================================
    // 10. 各主题动态背景
    // ======================================================================
    const CAT = ['.......x.x', 'x......xxx', '.x.xxxxxxx', '..xxxxxxx.'];
    const CAT_LEGS = ['..x.x..x.x', '.x..x.x..x'];

    const drawBgVoid = (sec: number) => {
      const boost = summitFx >= 0 && summitFx < 3.5 ? 0.35 : 0;
      for (const s of stars) {
        const tw = s.b + Math.sin(sec * (1.2 + s.b * 2) + s.ph) * 0.3 + boost;
        if (tw > 0.85) {
          plot(s.x, s.y, hex('#ffffff'));
          if (s.b > 0.93) {
            plot(s.x - 1, s.y, hex('#8fa6d9'));
            plot(s.x + 1, s.y, hex('#8fa6d9'));
            plot(s.x, s.y - 1, hex('#8fa6d9'));
            plot(s.x, s.y + 1, hex('#8fa6d9'));
          }
        } else if (tw > 0.45) plot(s.x, s.y, hex('#9aaee0'));
        else if (tw > 0.2) plot(s.x, s.y, hex('#3a4876'));
      }
      // 太阳从木星边缘探出
      const fl = 4 + Math.sin(sec * 2.2) * 1.5;
      const sx = 43;
      const sy = 28;
      disc(sx, sy, 1.2, hex('#ffffff'));
      for (let i = 2; i < fl + 3; i++) {
        const a = 1 - i / (fl + 3);
        pdither(sx + i, sy, hex('#fff2c8'), a);
        pdither(sx - i, sy, hex('#fff2c8'), a);
        pdither(sx, sy - i, hex('#fff2c8'), a);
        pdither(sx, sy + i, hex('#fff2c8'), a);
      }
      // 发现号缓缓掠过
      const shipX = W + 30 - ((sec * 4) % (W + 90));
      const shipY = 66 + Math.sin(sec * 0.4) * 1.5;
      disc(shipX, shipY, 2, hex('#e6eaf2'));
      stroke(shipX + 2, shipY, shipX + 19, shipY, 1, hex('#aeb6c8'));
      rect(shipX + 19, shipY - 1.5, 3, 3, hex('#8c94a8'));
      for (let k = 6; k < 18; k += 3) plot(Math.round(shipX + k), Math.round(shipY - 1), hex('#6f7790'));
      plot(Math.round(shipX - 1), Math.round(shipY - 1), hex('#ff5a5a'));
      // 登顶：石碑谐波
      if (summitFx >= 0 && summitFx < 4) {
        const top = gyi[294] - 9;
        for (let k = 0; k < 3; k++) {
          const r = ((summitFx * 26 + k * 14) % 42) + 3;
          ring(293, top, r, r * 0.92, hex('#8fd3ff'), 0.9 * (1 - r / 45) * (1 - summitFx / 4));
        }
      }
    };

    const drawBgPaper = (sec: number) => {
      const ink = hex('#2b2622');
      const cream = hex('#f6efe0');
      const clouds: [number, number, number, number][] = [
        [30, 46, 3, 0],
        [80, 62, 2, 150],
        [100, 34, 4, 260],
      ];
      for (const [y, len, sp, off] of clouds) {
        const x = ((off + sec * sp) % (W + len + 40)) - len - 20;
        rect(x, y - 3, len, 7, ink);
        disc(x, y, 3.5, ink);
        disc(x + len, y, 3.5, ink);
        rect(x, y - 2, len, 5, cream);
        disc(x, y, 2.5, cream);
        disc(x + len, y, 2.5, cream);
        stroke(x + 4, y + 1, x + len - 8, y + 1, 1, hex('#b9a98a'));
      }
      // 雁阵
      const bx = ((sec * 9) % (W + 80)) - 40;
      for (let i = 0; i < 5; i++) {
        const x = Math.round(bx + i * 6 - Math.abs(i - 2) * 1);
        const y = Math.round(40 + Math.abs(i - 2) * 3 + Math.sin(sec + i) * 0.6);
        const fl = Math.sin(sec * 8 + i) > 0 ? 1 : 0;
        plot(x, y, ink);
        plot(x - 1, y - fl, ink);
        plot(x + 1, y - fl, ink);
        plot(x - 2, y - fl * 2 + (fl ? 0 : 1), ink);
        plot(x + 2, y - fl * 2 + (fl ? 0 : 1), ink);
      }
    };

    const drawBgCrt = (sec: number) => {
      for (const col of rain) {
        for (let k = 0; k < col.len; k++) {
          const yy = Math.round(col.y) - k * 6;
          if (yy < -5) break;
          if (yy > H) continue;
          const flick = k === 0 ? Math.floor(sec * 18) : Math.floor(sec * 1.5 + k * 0.3);
          const g = GLYPHS[(col.seed * 7 + k * 13 + flick) % GLYPHS.length];
          const c = k === 0 ? hex('#d6ffe2') : k <= 2 ? hex('#4dff88') : k < col.len * 0.6 ? hex('#16a548') : hex('#0c5a27');
          const a = k === 0 ? 1 : 1 - (k / col.len) * 0.7;
          for (let b = 0; b < 15; b++) if ((g >> b) & 1) pdither(col.x + (b % 3), yy + Math.floor(b / 3), c, a);
        }
      }
    };

    const drawBgAmber = (sec: number) => {
      // 扑翼机
      const tx = ((sec * 14) % (W + 80)) - 40;
      const ty = 52 + Math.sin(sec * 0.8) * 4;
      const dark = hex('#2a140c');
      stroke(tx - 4, ty, tx + 4, ty, 1, dark);
      stroke(tx - 4, ty, tx - 8, ty - 1, 1, dark);
      plot(Math.round(tx + 4), Math.round(ty), hex('#ffd59a'));
      const wy = Math.sin(sec * 38) > 0 ? -2 : 1.5;
      stroke(tx, ty, tx - 4, ty + wy, 1, dark);
      stroke(tx, ty, tx + 4, ty + wy, 1, dark);
      stroke(tx + 1, ty, tx - 3, ty - wy * 0.6, 1, hex('#5a2c1a'));
      stroke(tx + 1, ty, tx + 5, ty - wy * 0.6, 1, hex('#5a2c1a'));

      // 沙虫夏胡鲁
      if (worm.active) {
        const dur = 5.5;
        const env = Math.sin(Math.PI * clamp(worm.t / dur, 0, 1));
        const headX = worm.x0 + worm.dir * (worm.t / dur) * 110;
        const prevClip = clipFn;
        clipFn = (x, y) => y < gyi[x] && y < midDuneI[x] + 1;
        const K = 18;
        for (let k = K - 1; k >= 0; k--) {
          const x = headX - worm.dir * k * 3.2;
          const h = Math.sin(Math.PI * (k / (K - 1)) * 0.9 + 0.15) * 16 * env;
          const y = midDune(x) + 4 - h;
          disc(x, y, 3.4, k % 2 ? hex('#7b4128') : hex('#6a3622'));
          pset(x, y - 3, hex('#c98552'));
          if (k === 0 && env > 0.4) {
            disc(x + worm.dir * 1.5, y, 2.4, hex('#2a0f08'));
            for (let a = 0; a < 6; a++) {
              const an = (a / 6) * Math.PI * 2;
              pset(x + worm.dir * 1.5 + Math.cos(an) * 2.6, y + Math.sin(an) * 2.6, hex('#f5e6c8'));
            }
          }
        }
        clipFn = prevClip;
        if (Math.random() < 0.6 * env) {
          const ex = headX + (Math.random() - 0.5) * 6;
          emit(ex, midDune(ex) + 1, (Math.random() - 0.5) * 20, -10 - Math.random() * 18, 0.9, hex('#e3894c'), 40, 0);
        }
      }
    };

    const shimmer = (sec: number) => {
      for (let y = 100; y < 130; y++) {
        const s = Math.round(Math.sin(y * 0.9 + sec * 6) * 0.9);
        if (!s) continue;
        const row = y * W;
        tmpRow.set(buf.subarray(row, row + W));
        for (let x = 0; x < W; x++) {
          if (y >= gyi[x] - 1) continue;
          buf[row + x] = tmpRow[clamp(x - s, 0, W - 1)];
        }
      }
    };

    const glitchPass = () => {
      for (let b = 0; b < 3; b++) {
        const y0 = Math.floor(Math.random() * H);
        const h = 1 + Math.floor(Math.random() * 5);
        const off = Math.round((Math.random() - 0.5) * 14);
        for (let y = y0; y < Math.min(H, y0 + h); y++) {
          const row = y * W;
          tmpRow.set(buf.subarray(row, row + W));
          for (let x = 0; x < W; x++) buf[row + x] = tmpRow[clamp(x - off, 0, W - 1)];
        }
      }
    };

    const scanlines = () => {
      for (let y = 1; y < H; y += 2) {
        const row = y * W;
        for (let x = 0; x < W; x++) {
          const c = buf[row + x];
          buf[row + x] = (c - ((c >>> 2) & 0x003f3f3f)) >>> 0;
        }
      }
    };

    // ======================================================================
    // 11. 更新
    // ======================================================================
    const update = (dt: number, sec: number) => {
      const total = getTotal(Date.now());
      phaseT += dt;
      if (kick > 0) kick = Math.max(0, kick - dt);
      if (summitFx >= 0) {
        summitFx += dt;
        if (summitFx > 6) summitFx = -1;
      }
      if (glitch > 0) glitch = Math.max(0, glitch - dt);

      if (phase === 'CLIMB') {
        const prev = frac;
        if (sprint) {
          const step = Math.min(1.0005 - frac, dt * 0.35);
          save.boostAccum += Math.max(0, step);
          frac += step;
          if (frac >= 1) {
            sprint = false;
            persistSave();
            enterSummit();
          }
        } else if (Math.floor(total) > activeCycle) {
          frac += Math.min(1.001 - frac, dt * 0.5);
          if (frac >= 1) enterSummit();
        } else {
          frac += (total - activeCycle - frac) * Math.min(1, dt * 3);
        }
        const vel = dt > 1e-5 ? Math.max(0, (frac - prev) / dt) : 0;
        gait += dt * Math.PI * 2 * (0.8 + Math.min(3, vel * 90));
        const s = Math.sin(gait);
        if (prevSin < 0 && s >= 0 && !reduceMotion) {
          const fx = pushHeroX(frac) - 2;
          for (let i = 0; i < 2; i++) emit(fx, gy(fx) - 1, -4 - Math.random() * 8, -4 - Math.random() * 6, 0.6, ROCK[realm][2], realm === 'void' ? 6 : 30, 0);
        }
        prevSin = s;
      } else if (phase === 'SUMMIT') {
        const startX = pushHeroX(1);
        if (phaseT > 1.3 && phaseT < 2.7) {
          heroX = startX + ((phaseT - 1.3) / 1.4) * (SUMMIT_STAND_X - startX);
          gait += dt * Math.PI * 2 * 2.2;
        } else heroX = phaseT <= 1.3 ? startX : SUMMIT_STAND_X;
        if (phaseT >= 3.8) {
          phase = 'ROLL';
          phaseT = 0;
          rollX = PATH_X1;
          rollV = 4;
        }
      } else if (phase === 'ROLL') {
        rollV = Math.min(120, rollV + dt * 60);
        rollX -= rollV * dt;
        if (Math.random() < 0.7) {
          const c = ROCK[realm][2];
          emit(rollX + 4, gy(rollX) - 1, 6 + Math.random() * 14, -6 - Math.random() * 14, 0.7, c, realm === 'void' ? 8 : 50, 0);
        }
        if (rollX <= PATH_X0) {
          rollX = PATH_X0;
          for (let i = 0; i < 18; i++) emit(PATH_X0, gy(PATH_X0) - 1, (Math.random() - 0.3) * 40, -Math.random() * 26, 0.9, ROCK[realm][1], realm === 'void' ? 8 : 60, 0);
          phase = 'DESCENT';
          phaseT = 0;
          heroX = SUMMIT_STAND_X;
        }
      } else if (phase === 'DESCENT') {
        const target = pushHeroX(0);
        if (heroX > target) {
          heroX = Math.max(target, heroX - dt * 20);
          gait += dt * Math.PI * 2 * 3.1;
          phaseT = 0;
        } else if (phaseT > 1.4) {
          const t2 = getTotal(Date.now());
          activeCycle = Math.floor(t2);
          frac = Math.min(0.03, t2 - activeCycle);
          phase = 'CLIMB';
          phaseT = 0;
        }
      }

      // 主题环境
      if (realm === 'amber') {
        if (!reduceMotion) {
          for (let i = 0; i < 2; i++) {
            if (Math.random() < 0.45) emit(W + 4, 40 + Math.random() * 140, -90 - Math.random() * 60, 4 + Math.random() * 6, 3.5, Math.random() < 0.5 ? hex('#f3c07e') : hex('#e8a160'), 0, 3);
          }
        }
        if (worm.active) {
          worm.t += dt;
          if (worm.t > 5.5) worm.active = false;
        } else {
          nextWorm -= dt;
          if (nextWorm <= 0) {
            worm.active = true;
            worm.t = 0;
            worm.dir = Math.random() < 0.5 ? 1 : -1;
            worm.x0 = worm.dir > 0 ? 40 + Math.random() * 60 : 160 + Math.random() * 60;
            nextWorm = 18 + Math.random() * 14;
          }
        }
      } else if (realm === 'paper') {
        if (!reduceMotion && Math.random() < dt * 2.2) emit(Math.random() * W * 1.2, -2, -6 - Math.random() * 8, 8 + Math.random() * 6, 14, Math.random() < 0.6 ? hex('#e9a3a0') : hex('#f5d6cf'), 0, 1);
      } else if (realm === 'crt') {
        for (const col of rain) {
          col.y += col.sp * dt;
          if (col.y - col.len * 6 > H) {
            col.y = -Math.random() * 60;
            col.sp = 22 + Math.random() * 40;
            col.len = 4 + Math.floor(Math.random() * 9);
          }
        }
        nextGlitch -= dt;
        if (nextGlitch <= 0) {
          glitch = 0.18;
          nextGlitch = 4 + Math.random() * 6;
        }
        if (summitFx > 2.2 && summitFx < 2.3) glitch = 0.25;
      } else if (!reduceMotion && Math.random() < dt * 0.18) {
        emit(200 + Math.random() * 120, 4 + Math.random() * 20, -120, 45, 0.5, hex('#ffffff'), 0, 3);
      }

      for (let i = parts.length - 1; i >= 0; i--) {
        const p = parts[i];
        p.life += dt;
        if (p.life >= p.max || p.x < -20 || p.x > W + 20 || p.y > H + 10) {
          parts.splice(i, 1);
          continue;
        }
        p.vy += p.g * dt;
        p.x += p.vx * dt + (p.kind === 1 ? Math.sin(p.life * 3 + p.seed) * 0.3 : 0);
        p.y += p.vy * dt;
      }
      for (let i = floats.length - 1; i >= 0; i--) {
        floats[i].t += dt;
        floats[i].y -= dt * 10;
        if (floats[i].t > 1.4) floats.splice(i, 1);
      }
      void sec;
    };

    // ======================================================================
    // 12. 渲染
    // ======================================================================
    const render = (sec: number) => {
      buf.set(staticBuf);

      clipFn = skyClip;
      if (realm === 'void') drawBgVoid(sec);
      else if (realm === 'paper') drawBgPaper(sec);
      else if (realm === 'crt') drawBgCrt(sec);
      else drawBgAmber(sec);
      clipFn = null;
      if (realm === 'amber') shimmer(sec);

      if (realm === 'crt') {
        const px = Math.floor(((sec * 48) % (W + 40)) - 20);
        for (let i = 0; i < 12; i++) {
          const x = px - i;
          if (x >= 0 && x < W) plot(x, gyi[x], i === 0 ? hex('#ffffff') : i < 4 ? hex('#c8ffd9') : hex('#7dffa8'));
        }
      }

      // —— 计算角色与巨石位置 ——
      let bcx: number;
      let lift = 0;
      let mode: Mode = 'push';
      let facing = 1;
      let hx = heroX;
      const heave = kick > 0 ? Math.sin(((0.45 - kick) / 0.45) * Math.PI) * 2.5 : Math.sin(gait * 2) * 0.35;
      if (phase === 'CLIMB') {
        bcx = contactX(frac) + Math.max(0, heave) * 0.5;
      } else if (phase === 'SUMMIT') {
        bcx = PATH_X1 + (phaseT > 3 ? Math.sin(phaseT * 30) * 0.6 * (phaseT - 3) : 0);
        if (phaseT <= 1.3) mode = 'cheer';
        else if (phaseT < 2.7) mode = 'walk';
        else {
          mode = 'stand';
          facing = -1;
        }
        if (phaseT >= 2.7) facing = -1;
      } else if (phase === 'ROLL') {
        bcx = rollX;
        lift = Math.abs(Math.sin(rollX * 0.21)) * Math.min(4, rollV * 0.04);
        mode = 'watch';
        facing = -1;
      } else {
        bcx = PATH_X0;
        const target = pushHeroX(0);
        if (heroX > target + 0.01) {
          mode = 'walk';
          facing = -1;
        } else {
          mode = 'stand';
          facing = 1;
        }
        hx = heroX;
      }
      const bc = boulderCenter(bcx, lift);
      const angle = ((bcx - PATH_X0) / R) * 1.05;
      const hand = { x: bc.x - R + 0.5, y: bc.y + 1 };

      castShadow(bcx - (SHADOW[realm]?.dir ?? 1) * 3, 16);
      castShadow((mode === 'push' ? hand.x - 10 : hx) - (SHADOW[realm]?.dir ?? 1) * 1, 10);

      toLayer = true;
      layerId = 1;
      drawBoulder(bc.x, bc.y, angle, sec);
      layerId = 2;
      drawHero(mode, hx, facing, gait, mode === 'push' ? hand : null, heave, sec);
      if (realm === 'crt' && summitFx >= 0 && summitFx < 4.4) {
        layerId = 3;
        const loop = summitFx % 2.2;
        const cx = -12 + (loop / 2.2) * 150;
        const cy = gy(cx) - 5;
        const legs = CAT_LEGS[Math.floor(sec * 8) % 2];
        const rows = [...CAT, legs];
        for (let r = 0; r < rows.length; r++)
          for (let c = 0; c < rows[r].length; c++) if (rows[r][c] === 'x') plot(Math.round(cx) + c, Math.round(cy) + r, hex('#010402'));
      }
      toLayer = false;
      compositeLayer(HERO[realm].outline);

      // —— 粒子 ——
      for (const p of parts) {
        const a = 1 - p.life / p.max;
        if (p.kind === 0) pdither(p.x, p.y, p.c, a * 1.4);
        else if (p.kind === 1) {
          pset(p.x, p.y, p.c);
          if (Math.sin(p.life * 6 + p.seed) > 0) pset(p.x + 1, p.y, p.c);
        } else if (p.kind === 2) {
          for (let b = 0; b < 9; b++) if ((p.seed >> b) & 1) pdither(p.x + (b % 3), p.y + Math.floor(b / 3), p.c, a * 1.3);
        } else if (p.kind === 3) {
          const l = Math.hypot(p.vx, p.vy) * 0.04;
          const nx = p.vx / (Math.hypot(p.vx, p.vy) || 1);
          const ny = p.vy / (Math.hypot(p.vx, p.vy) || 1);
          for (let i = 0; i < l; i++) pdither(p.x - nx * i, p.y - ny * i, p.c, a * (1 - i / l));
        } else {
          pset(p.x, p.y, p.c);
          if (p.life < 0.15) {
            pset(p.x - 1, p.y, p.c);
            pset(p.x + 1, p.y, p.c);
            pset(p.x, p.y - 1, p.c);
            pset(p.x, p.y + 1, p.c);
          }
        }
      }

      // —— 登顶：浮世绘大印 ——
      if (realm === 'paper' && summitFx >= 0) {
        const s = summitFx < 0.22 ? Math.round(22 + (0.22 - summitFx) * 70) : 22;
        if (summitFx < 5 || Math.random() > (summitFx - 5)) drawSeal(160, 26, s, hex('#b8382a'), hex('#efe5cf'));
      }

      for (const fl of floats) {
        if (fl.t > 1.1 && Math.floor(fl.t * 20) % 2) continue;
        const pal = ROCK[realm];
        drawText(fl.s, fl.x, fl.y, realm === 'paper' ? hex('#b8382a') : realm === 'crt' ? hex('#c8ffd9') : pal[0], realm === 'paper' ? hex('#efe5cf') : hex('#000000'));
      }

      if (realm === 'crt') {
        if (glitch > 0) glitchPass();
        scanlines();
      }

      ctx.putImageData(image, 0, 0);
    };

    // ======================================================================
    // 13. DOM 文本
    // ======================================================================
    const fmtEta = (ms: number) => {
      const s = Math.max(0, Math.floor(ms / 1000));
      const h = Math.floor(s / 3600);
      const m = Math.floor((s % 3600) / 60);
      return `${String(h).padStart(2, '0')}h ${String(m).padStart(2, '0')}m ${String(s % 60).padStart(2, '0')}s`;
    };
    let lastTele = '';
    let lastQuote = '';
    let lastSr = 0;
    const updateDom = (now: number) => {
      const latest = getTotal(Date.now());
      const idx = Math.floor(latest);
      let p: number;
      if (phase === 'CLIMB') p = sprint ? frac : clamp(latest - idx, 0, 1);
      else if (phase === 'SUMMIT') p = 1;
      else if (phase === 'ROLL') p = clamp((rollX - PATH_X0) / (PATH_X1 - PATH_X0), 0, 1);
      else p = 0;
      const alt = (p * PEAK_ALT).toFixed(1);
      const filled = Math.round(p * 10);
      const bar = '▪'.repeat(filled) + '▫'.repeat(10 - filled);
      const boost = save.boostMeters >= 0.5 ? ` · BOOST +${Math.round(save.boostMeters)}m` : '';
      const tele = `ALT ${alt}m [${bar}] ETA ${fmtEta((1 - p) * CYCLE_MS)} · #${baseSummits + idx}${boost}`;
      if (tele !== lastTele) {
        telemetryEl.textContent = tele;
        lastTele = tele;
      }
      const q =
        phase === 'SUMMIT'
          ? '"登顶的片刻停驻，风正掠过山脊。"'
          : phase === 'ROLL'
            ? '"引力终将夺回巨石，但夺不走攀登本身。"'
            : phase === 'DESCENT'
              ? '"Il faut imaginer Sisyphe heureux." —— 走下山去的清醒时刻'
              : CLIMB_QUOTES[realm];
      if (quoteEl && q !== lastQuote) {
        quoteEl.textContent = q;
        lastQuote = q;
      }
      if (srEl && now - lastSr > 2000) {
        lastSr = now;
        srEl.textContent =
          phase === 'CLIMB' ? `西西弗斯正推石上山，海拔 ${alt} 米` : phase === 'SUMMIT' ? '西西弗斯登顶' : phase === 'ROLL' ? '巨石滚落' : '西西弗斯走下山去';
      }
    };

    const syncRealm = () => {
      const r = getRealm();
      if (r === realm && titleEl?.textContent === TITLES[r]) return;
      realm = r;
      parts.length = 0;
      buildStatic();
      if (titleEl) titleEl.textContent = TITLES[realm];
      lastQuote = '';
    };
    window.addEventListener('sisyphus:realmchange', syncRealm);

    // ======================================================================
    // 14. 主循环
    // ======================================================================
    buildStatic();
    if (titleEl) titleEl.textContent = TITLES[realm];
    let last = performance.now();
    let lastDraw = 0;
    const frameGap = reduceMotion ? 80 : 33;
    const loop = (now: number) => {
      requestAnimationFrame(loop);
      const dt = clamp((now - last) / 1000, 0.001, 0.1);
      last = now;
      if (!visible || document.hidden) return;
      if (getRealm() !== realm) syncRealm();
      update(dt, now / 1000);
      if (now - lastDraw >= frameGap) {
        lastDraw = now;
        render(now / 1000);
        updateDom(now);
      }
    };
    render(performance.now() / 1000);
    updateDom(performance.now());
    requestAnimationFrame(loop);
  };

  boot();
</script>
