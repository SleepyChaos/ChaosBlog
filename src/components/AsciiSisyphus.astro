---
import { CAMUS_QUOTE } from '../consts';

interface Props {
  initialSummits?: number;
}

const { initialSummits = 1 } = Astro.props;
---

<div class="bento-card col-7 sisyphus-stage-card">
  <div class="bento-head">
    <span class="bento-head-title">
      <span class="term-ascii-icon">/▲</span>
      <span id="sisyphus-stage-title">01 // TMA-1 · 第谷环形山</span>
    </span>
    <div style="display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap;">
      <button
        type="button"
        class="term-btn is-primary"
        id="sisyphus-push-btn"
        title="助推巨石（点击下方画布任意处、拖拽或弹射悬浮舱均可助推）"
      >
        [+PUSH 助推]
      </button>
      <button
        type="button"
        class="term-btn"
        id="sisyphus-summit-btn"
        title="快进体验完整：冲顶驻足 → 巨石抛物崩落 → 走下山坡无缝轮回"
      >
        [&gt;&gt; 冲顶轮回]
      </button>
    </div>
  </div>

  <pre
    class="ascii-slope-pre"
    id="sisyphus-ascii-stage"
    title="点击画布任意位置召唤天象助推西西弗斯！"
    aria-label="216x120 亚像素点阵与 ASCII 混合渲染的四大科幻主题西西弗斯推石剧场"></pre>

  <div class="bento-foot">
    <span id="sisyphus-telemetry" data-summits={initialSummits}>
      ALT 210.0m / 884.8m · ETA 06h 05m · #1
    </span>
    <span id="sisyphus-phase-quote">"{CAMUS_QUOTE}"</span>
  </div>
</div>

<script>
  const stageEl = document.getElementById('sisyphus-ascii-stage');
  const stageTitleEl = document.getElementById('sisyphus-stage-title');
  const telemetryEl = document.getElementById('sisyphus-telemetry');
  const quoteEl = document.getElementById('sisyphus-phase-quote');
  const pushBtn = document.getElementById('sisyphus-push-btn');
  const summitBtn = document.getElementById('sisyphus-summit-btn');

  if (stageEl && telemetryEl) {
    // 98x30 字符网格 + Drawille 2x4 亚像素盲文光栅化层 = 196x120 (23,520 亚像素高分辨率，严格贴合卡片不溢出！)
    const COLS = 98;
    const ROWS = 30;
    const SUB_W = COLS * 2; // 196 水平亚像素
    const SUB_H = ROWS * 4; // 120 垂直亚像素
    const CYCLE_MS = 8 * 60 * 60 * 1000;
    const PEAK_ALT = 884.8;
    const STORAGE_KEY = 'sisyphus_8h_cycle_v2';
    const baseSummits = Number(telemetryEl.dataset.summits || '1');

    const hdSubpixelMode = true;

    // 严格对照四部科幻原著的经典地点，采用 `·` 分隔，不使用括号
    const STAGE_TITLES: Record<string, string> = {
      void: '01 // TMA-1 · 第谷环形山',
      paper: '01 // TERMINUS · 端点星穹顶',
      crt: '01 // ZION · 尼布甲尼撒号',
      amber: '01 // ARRAKIS · 塔布尔穴地',
    };

    const WORLD_QUOTES: Record<string, string> = {
      void: '"My God, it\'s full of stars..." —— 大卫·鲍曼 · 发现号 (TMA-1 / 1:4:9)',
      paper: '"跨越三万年银河暗夜的，是端点星日复一日的编纂与推石。" —— 哈里·谢顿',
      crt: '"Do not try to bend the boulder. Only realize the truth: there is only the climb."',
      amber: '"恐惧是思维的杀手。当沙暴掠过障壁山脉，唯余我与巨石长存。" —— 贝尼·杰瑟里特祷文',
    };

    const BUBBLE_LINES: Record<string, string[]> = {
      void: ['(TMA-1 1:4:9)', '(HAL watching)', '(Clavius ridge)', '(full of stars)', '(EVA nominal)'],
      paper: ['(dS/dt > 0)', '(for Terminus)', '(Seldon Vault)', '(Prime Radiant)', '(Encyclopedia)'],
      crt: ['(no spoon...)', '(Zion uplink)', '(Nebuchadnezzar)', '(Construct ok)', '(still happy)'],
      amber: ['(Sietch Tabr)', '(Shield Wall)', '(walk without)', '(Shai-Hulud!)', '(Kull Wahad!)'],
    };

    interface CycleSave {
      anchorEpoch: number;
      boostAccum: number;
      boostMeters: number;
    }

    const nowInit = Date.now();
    const initEpoch = Math.floor(nowInit / CYCLE_MS);
    let save: CycleSave = {
      anchorEpoch: initEpoch,
      boostAccum: 0,
      boostMeters: 0,
    };

    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (
          typeof parsed.anchorEpoch === 'number' &&
          typeof parsed.boostAccum === 'number'
        ) {
          save = {
            anchorEpoch: parsed.anchorEpoch,
            boostAccum: parsed.boostAccum,
            boostMeters: Number(parsed.boostMeters || 0),
          };
        }
      } else {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(save));
      }
    } catch {}

    const persistSave = () => {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(save));
      } catch {}
    };

    const getTotalRawCycles = (nowMs: number) => {
      const elapsedEpochs = nowMs / CYCLE_MS - save.anchorEpoch;
      return Math.max(0, elapsedEpochs + save.boostAccum);
    };

    type Phase = 'CLIMB' | 'SUMMIT_BREATH' | 'AVALANCHE' | 'DESCENT_WALK';
    let phase: Phase = 'CLIMB';
    let phaseElapsed = 0;

    const initTotal = getTotalRawCycles(nowInit);
    let activeCycleIndex = Math.floor(initTotal);
    let displayFrac = initTotal - activeCycleIndex;
    let boostVelocity = 0;
    let sprintToSummit = false;
    let boostBannerTimer = 0;
    let lastBoostGainMeters = 0;
    let lastBoostSource = '主动助推';

    let boulderProg = displayFrac;
    let sisyphusProg = Math.max(0, displayFrac - 0.068);
    let avalancheVel = 0;
    let continuousRoll = 0;
    let continuousStep = 0;

    // 亚像素级高精度粒子系统 (在 168x72 坐标系中平滑运动！)
    interface SubParticle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      gravity: number;
      life: number;
      maxLife: number;
      cls: number;
      asciiFallback: string;
    }
    const subParticles: SubParticle[] = [];

    const matrixDrops = Array.from({ length: 20 }, (_, i) => ({
      col: 4 + i * 4.5 + (i % 2),
      y: (i * 3.7) % 24,
      speed: 3.4 + (i % 4) * 1.2,
      len: 4 + (i % 4),
    }));

    let skyStrikeTimer = 0;
    let skyStrikeCol = 48;

    // 半山构图山脊地形曲线（无右侧陡崖，山顶高原自然延展至画幅最右边缘）：c ∈ [0, 97] -> y ∈ [5.5, 26.5]
    const terrainY = (c: number): number => {
      if (c <= 9) return 26.5;
      if (c >= 87) return 5.5;
      const u = (c - 9) / 78;
      const base = 26.5 - u * 21.0;
      const crag =
        Math.sin(u * Math.PI * 3.0) * 0.46 * Math.sin(u * Math.PI) +
        Math.sin(u * Math.PI * 7.0) * 0.17 * Math.sin(u * Math.PI);
      return base + crag;
    };

    const progToCol = (p: number): number => {
      const clamped = Math.max(0, Math.min(1, p));
      return 12.5 + clamped * 76.0; // 12.5 -> 88.5
    };

    const spawnSubParticles = (
      colX: number,
      rowY: number,
      count: number,
      dirX: number,
      cls: number,
      gravity = 28.0,
    ) => {
      const glyphs = ['*', '.', ':', "'", '+'];
      for (let i = 0; i < count; i++) {
        if (subParticles.length > 90) subParticles.shift();
        subParticles.push({
          x: colX * 2 + (Math.random() - 0.5) * 3,
          y: rowY * 4 + (Math.random() - 0.5) * 3,
          vx: dirX * (6 + Math.random() * 16) + (Math.random() - 0.5) * 6,
          vy: -(7 + Math.random() * 16),
          gravity,
          life: 0,
          maxLife: 0.55 + Math.random() * 0.7,
          cls,
          asciiFallback: glyphs[i % glyphs.length],
        });
      }
    };

    const applyBoost = (
      amount: number,
      strikeCol?: number,
      source = '主动助推',
      alreadyPersisted = false,
    ) => {
      if (phase !== 'CLIMB') return;
      const clamped = Math.max(0.001, Math.min(0.12, amount));
      const gainedM = clamped * PEAK_ALT;
      if (alreadyPersisted) {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (raw) {
            const parsed = JSON.parse(raw);
            save.boostAccum = Number(parsed.boostAccum || save.boostAccum);
            save.boostMeters = Number(parsed.boostMeters || save.boostMeters);
          }
        } catch {}
      } else {
        save.boostAccum += clamped;
        save.boostMeters += gainedM;
        persistSave();
      }
      lastBoostGainMeters = gainedM;
      lastBoostSource = source;
      boostBannerTimer = 2.0;
      boostVelocity = Math.min(0.45, boostVelocity + clamped * 2.8);

      const bx = progToCol(boulderProg);
      const by = terrainY(bx);
      skyStrikeCol = strikeCol ?? Math.round(bx);
      skyStrikeTimer = strikeCol !== undefined ? 0.58 : 0.35;
      spawnSubParticles(bx - 2, by - 1, 12, -1, 9);
    };

    pushBtn?.addEventListener('click', () => {
      window.dispatchEvent(
        new CustomEvent('sisyphus:boulder-boost', {
          detail: { minM: 14, maxM: 38, source: '主动助推' },
        }),
      );
    });

    summitBtn?.addEventListener('click', () => {
      if (phase === 'CLIMB') {
        sprintToSummit = true;
      }
    });

    stageEl.addEventListener('click', (e) => {
      const rect = stageEl.getBoundingClientRect();
      const ratioX = Math.max(0.05, Math.min(0.95, (e.clientX - rect.left) / Math.max(1, rect.width)));
      const clickedCol = Math.round(ratioX * (COLS - 1));
      window.dispatchEvent(
        new CustomEvent('sisyphus:boulder-boost', {
          detail: { minM: 12, maxM: 34, source: '天象共鸣', strikeCol: clickedCol },
        }),
      );
    });

    window.addEventListener('sisyphus:boulder-boost', (ev: Event) => {
      const detail = (
        ev as CustomEvent<{
          amount?: number;
          minM?: number;
          maxM?: number;
          rolledAmount?: number;
          source?: string;
          strikeCol?: number;
        }>
      ).detail;
      let rawAmt = detail?.rolledAmount;
      if (typeof rawAmt !== 'number') {
        if (typeof detail?.minM === 'number' && typeof detail?.maxM === 'number') {
          rawAmt = (detail.minM + Math.random() * (detail.maxM - detail.minM)) / PEAK_ALT;
        } else {
          const baseAmt = Math.max(0.001, Math.min(0.12, detail?.amount ?? 0.018));
          rawAmt = baseAmt * (0.58 + Math.random() * 0.87);
        }
        if (detail) detail.rolledAmount = rawAmt;
      }
      applyBoost(
        rawAmt,
        detail?.strikeCol,
        detail?.source || '动能共鸣',
        true,
      );
    });

    window.addEventListener('sisyphus:trigger-summit', () => {
      if (phase === 'CLIMB') {
        sprintToSummit = true;
      }
    });

    const syncStageTitle = () => {
      const r = document.documentElement.dataset.realm || 'void';
      if (stageTitleEl) {
        stageTitleEl.textContent = STAGE_TITLES[r] || STAGE_TITLES.void;
      }
    };
    syncStageTitle();
    window.addEventListener('sisyphus:realmchange', syncStageTitle);

    // 6x4 超清立体多面巨石（在 216x120 亚像素模式下拥有双层装甲刻面与动态盲文旋转核心！）
    const getBoulderSprite = (
      realm: string,
      frame: number,
      hd: boolean,
    ): [string, string, string, string] => {
      const f = ((frame % 6) + 6) % 6;
      if (realm === 'crt') {
        const topRow = ['▓⣿░▒', '░▓⣿▒', '⣿░▓░', '▒⣿▒▓', '▓░⣿░', '⣿▒░▓'];
        const botRow = ['░▒⣿▓', '▒⣿▓░', '░▓░⣿', '▓▒⣿▒', '░⣿░▓', '▓░▒⣿'];
        return ['┌─▀▀─┐', `│${topRow[f]}│`, `│${botRow[f]}│`, '└─▄▄─┘'];
      }
      if (realm === 'void') {
        const topRow = hd
          ? ['▒⣿*░', '░⠿▒+', '▒*⣿░', '░⣿▒#', '▒+⠿░', '░#▒⣿']
          : ['▒*+░', '░+#▒', '▒#*░', '░*+▒', '▒+#░', '░#*▒'];
        const botRow = hd
          ? ['░+⠿▒', '▒░⣿*', '░⣿*▒', '#▒⣿░', '░⠿+▒', '⣿▒#░']
          : ['░+#▒', '▒*+░', '░*#▒', '▒#*░', '░#+▒', '▒*#░'];
        return ['╔═▀▀═╗', `║${topRow[f]}║`, `║${botRow[f]}║`, '╚═▄▄═╝'];
      }
      if (realm === 'paper') {
        const topRow = hd
          ? ['░⠿=▒', '▒=⠿░', '░+⠿▒', '▒⠿#░', '░#⠿▒', '▒:⠿░']
          : ['░#=▒', '▒=+░', '░+#▒', '▒#:░', '░:+▒', '▒+#░'];
        const botRow = hd
          ? ['▒:⠿░', '░⠿=▒', '▒⠿+░', '░#⠿▒', '▒⠿#░', '░=⠿▒']
          : ['▒:#░', '░=#▒', '▒+░#', '░:#▒', '▒+#░', '░#=▒'];
        return ['╔═▀▀═╗', `║${topRow[f]}║`, `║${botRow[f]}║`, '╚═▄▄═╝'];
      }
      const topRow = hd
        ? ['▒⣿~░', '░~⠿▒', '▒⠿*░', '░:⣿▒', '▒*⠿░', '░⠿~▒']
        : ['▒*~░', '░~o▒', '▒o:░', '░:*▒', '▒~*░', '░*~▒'];
      const botRow = hd
        ? ['░~⣿▒', '▒⠿~░', '░*⠿▒', '▒⣿:░', '░⠿*▒', '▒~⠿░']
        : ['░~*▒', '▒o~░', '░:o▒', '▒*:░', '░*~▒', '▒~*░'];
      return ['/─▀▀─\\', `│${topRow[f]}│`, `│${botRow[f]}│`, '\\─▄▄─/'];
    };

    const CLIMB_LEGS = ['/ \\', '| /', '> \\', '\\ |'];
    const WALK_DOWN_LEGS = ['/ \\', '| \\', '/ |', '\\ /'];

    const escapeHtml = (s: string) =>
      s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

    const CLS_NAMES = [
      '', // 0
      'as-sky', // 1
      'as-aurora', // 2
      'as-aurora2', // 3
      'as-far', // 4
      'as-ridge', // 5
      'as-earth', // 6
      'as-hero', // 7
      'as-rock', // 8
      'as-fire', // 9
      'as-hud', // 10
    ];

    // Drawille 2x4 Unicode 盲文位掩码映射表:
    // (dx=0, dy=0..3) -> 0x01, 0x02, 0x04, 0x40
    // (dx=1, dy=0..3) -> 0x08, 0x10, 0x20, 0x80
    const BRAILLE_BITS = [
      [0x01, 0x02, 0x04, 0x40],
      [0x08, 0x10, 0x20, 0x80],
    ];

    const formatEta = (ms: number) => {
      const totalSec = Math.max(0, Math.floor(ms / 1000));
      const h = Math.floor(totalSec / 3600);
      const m = Math.floor((totalSec % 3600) / 60);
      const s = totalSec % 60;
      return `${String(h).padStart(2, '0')}h ${String(m).padStart(2, '0')}m ${String(s).padStart(2, '0')}s`;
    };

    let lastTime = performance.now();
    let lastRenderTime = 0;
    let nextPebbleTick = 0;
    let nextMeteorTick = 1200;

    const tick = (nowPerf: number) => {
      const dt = Math.min(0.08, Math.max(0.001, (nowPerf - lastTime) / 1000));
      lastTime = nowPerf;

      const nowWall = Date.now();
      const totalRaw = getTotalRawCycles(nowWall);
      const realm = document.documentElement.dataset.realm || 'void';

      for (let i = subParticles.length - 1; i >= 0; i--) {
        const p = subParticles[i];
        p.life += dt;
        if (p.life >= p.maxLife) {
          subParticles.splice(i, 1);
          continue;
        }
        p.x += p.vx * dt;
        p.y += p.vy * dt;
        p.vy += p.gravity * dt;
      }

      for (const drop of matrixDrops) {
        drop.y += drop.speed * dt;
        if (drop.y > ROWS + drop.len) {
          drop.y = -1;
        }
      }

      if (nowPerf > nextMeteorTick) {
        nextMeteorTick = nowPerf + 2100 + Math.random() * 2200;
        if (realm === 'void') {
          subParticles.push({
            x: 110 + Math.random() * 32,
            y: 4 + Math.random() * 8,
            vx: -38 - Math.random() * 14,
            vy: 11,
            gravity: 0,
            life: 0,
            maxLife: 0.95,
            cls: 1,
            asciiFallback: '*',
          });
        } else if (realm === 'amber') {
          for (let k = 0; k < 5; k++) {
            subParticles.push({
              x: 136 + Math.random() * 18,
              y: 8 + Math.random() * 20,
              vx: -26 - Math.random() * 12,
              vy: 2.2,
              gravity: 0,
              life: 0,
              maxLife: 1.4,
              cls: k === 0 ? 2 : 1,
              asciiFallback: '~',
            });
          }
        }
      }

      if (boostBannerTimer > 0) boostBannerTimer = Math.max(0, boostBannerTimer - dt);
      if (skyStrikeTimer > 0) skyStrikeTimer = Math.max(0, skyStrikeTimer - dt);

      if (phase === 'CLIMB') {
        const speedMult = sprintToSummit ? 6.5 : 1 + boostVelocity * 11;
        continuousStep += dt * 2.6 * speedMult;
        continuousRoll += dt * 2.1 * speedMult;

        if (nowPerf > nextPebbleTick) {
          nextPebbleTick = nowPerf + (boostVelocity > 0.02 || sprintToSummit ? 130 : 560);
          const sx = progToCol(sisyphusProg);
          spawnSubParticles(sx - 1.4, terrainY(sx) - 0.4, 2, -0.9, boostVelocity > 0.02 ? 9 : 5);
        }

        if (sprintToSummit) {
          const step = Math.min(1.001 - displayFrac, dt * 0.42);
          save.boostAccum += Math.max(0, step);
          displayFrac += step;
          if (displayFrac >= 1.0) {
            sprintToSummit = false;
            persistSave();
            phase = 'SUMMIT_BREATH';
            phaseElapsed = 0;
            boulderProg = 1.0;
            sisyphusProg = 0.935;
          }
        } else {
          const targetCycle = Math.floor(totalRaw);
          if (targetCycle > activeCycleIndex) {
            displayFrac += Math.min(1.002 - displayFrac, dt * 0.55);
            if (displayFrac >= 1.0) {
              phase = 'SUMMIT_BREATH';
              phaseElapsed = 0;
              boulderProg = 1.0;
              sisyphusProg = 0.935;
            }
          } else {
            const targetFrac = totalRaw - activeCycleIndex;
            const diff = targetFrac - displayFrac;
            if (Math.abs(diff) > 0.00001) {
              displayFrac += diff * Math.min(1, dt * 7.5);
            }
            if (boostVelocity > 0.001) {
              boostVelocity *= Math.pow(0.18, dt);
            }
          }
        }

        const heaveBob = Math.sin(continuousStep * Math.PI) * 0.0025;
        boulderProg = Math.min(1, Math.max(0.02, displayFrac + heaveBob));
        sisyphusProg = Math.max(0, boulderProg - 0.068);
      } else if (phase === 'SUMMIT_BREATH') {
        phaseElapsed += dt;
        boulderProg = 1.0;
        sisyphusProg = 0.935;
        if (phaseElapsed > 2.2 && Math.random() < 0.45) {
          const bx = progToCol(boulderProg);
          spawnSubParticles(bx - 1.8, terrainY(bx) - 0.2, 2, -0.7, 9);
        }
        if (phaseElapsed >= 3.3) {
          phase = 'AVALANCHE';
          phaseElapsed = 0;
          avalancheVel = 0.06;
        }
      } else if (phase === 'AVALANCHE') {
        phaseElapsed += dt;
        avalancheVel = Math.min(0.48, avalancheVel + dt * 0.25);
        boulderProg = Math.max(0.02, boulderProg - avalancheVel * dt);
        continuousRoll -= avalancheVel * dt * 36;

        const bx = progToCol(boulderProg);
        if (boulderProg > 0.025 && Math.random() < 0.75) {
          spawnSubParticles(bx + 1.8, terrainY(bx) - 0.6, 3, 0.9, 9);
        }

        if (phaseElapsed > 1.3) {
          sisyphusProg = Math.max(0.75, sisyphusProg - dt * 0.085);
          continuousStep += dt * 4.8;
        }

        if (boulderProg <= 0.022) {
          boulderProg = 0.02;
          spawnSubParticles(progToCol(0.02) + 1.5, terrainY(10) - 0.6, 16, 0.4, 9);
          phase = 'DESCENT_WALK';
          phaseElapsed = 0;
        }
      } else if (phase === 'DESCENT_WALK') {
        phaseElapsed += dt;
        boulderProg = 0.02;
        const targetS = 0.0;
        if (sisyphusProg > targetS + 0.004) {
          const walkSpeed = 0.18;
          sisyphusProg = Math.max(targetS, sisyphusProg - walkSpeed * dt);
          continuousStep += walkSpeed * dt * 44;
        } else {
          sisyphusProg = targetS;
          if (phaseElapsed > 4.5) {
            const latestTotal = getTotalRawCycles(Date.now());
            activeCycleIndex = Math.floor(latestTotal);
            displayFrac = Math.min(0.05, latestTotal - activeCycleIndex);
            boulderProg = displayFrac;
            sisyphusProg = Math.max(0, displayFrac - 0.068);
            phase = 'CLIMB';
            phaseElapsed = 0;
          }
        }
      }

      if (nowPerf - lastRenderTime >= 42) {
        lastRenderTime = nowPerf;
        renderFrame(nowPerf, realm);
      }

      requestAnimationFrame(tick);
    };

    const renderFrame = (nowPerf: number, realm: string) => {
      const chars: string[][] = Array.from({ length: ROWS }, () => Array(COLS).fill(' '));
      const cls: number[][] = Array.from({ length: ROWS }, () => Array(COLS).fill(0));

      // Drawille 168x72 亚像素点阵缓冲区（每个字符格存储 8-bit 盲文掩码与主导颜色通道）
      const brailleMask: number[][] = Array.from({ length: ROWS }, () => Array(COLS).fill(0));
      const brailleCls: number[][] = Array.from({ length: ROWS }, () => Array(COLS).fill(0));

      const setSubPixel = (px: number, py: number, colorCls: number) => {
        const xi = Math.round(px);
        const yi = Math.round(py);
        if (xi < 0 || xi >= SUB_W || yi < 0 || yi >= SUB_H) return;
        const col = xi >> 1;
        const row = yi >> 2;
        if (yi >= terrainY(col) * 4 - 1) return; // 不覆盖主山脊以下前景
        brailleMask[row][col] |= BRAILLE_BITS[xi & 1][yi & 3];
        if (colorCls > brailleCls[row][col]) {
          brailleCls[row][col] = colorCls;
        }
      };

      const drawSubLine = (x0: number, y0: number, x1: number, y1: number, colorCls: number) => {
        const steps = Math.max(1, Math.ceil(Math.hypot(x1 - x0, y1 - y0)));
        for (let i = 0; i <= steps; i++) {
          const u = i / steps;
          setSubPixel(x0 + (x1 - x0) * u, y0 + (y1 - y0) * u, colorCls);
        }
      };

      const drawSubCircle = (
        cx: number,
        cy: number,
        r: number,
        colorCls: number,
        fill = false,
        crescentCutX = 0,
      ) => {
        const r2 = r * r;
        for (let dy = -Math.ceil(r); dy <= Math.ceil(r); dy++) {
          for (let dx = -Math.ceil(r); dx <= Math.ceil(r); dx++) {
            const d2 = dx * dx + dy * dy;
            if (fill ? d2 <= r2 : Math.abs(Math.sqrt(d2) - r) < 0.72) {
              if (crescentCutX !== 0) {
                const cd2 = (dx - crescentCutX) * (dx - crescentCutX) + dy * dy;
                if (cd2 < r2 * 0.78) continue;
              }
              setSubPixel(cx + dx, cy + dy, colorCls);
            }
          }
        }
      };

      const drawSubEllipseRing = (
        cx: number,
        cy: number,
        rx: number,
        ry: number,
        tiltRad: number,
        colorCls: number,
      ) => {
        const steps = Math.ceil(rx * 5.2);
        const cosT = Math.cos(tiltRad);
        const sinT = Math.sin(tiltRad);
        for (let i = 0; i < steps; i++) {
          const a = (i / steps) * Math.PI * 2;
          const ex = Math.cos(a) * rx;
          const ey = Math.sin(a) * ry;
          const px = cx + ex * cosT - ey * sinT;
          const py = cy + ex * sinT + ey * cosT;
          setSubPixel(px, py, colorCls);
        }
      };

      const put = (r: number, c: number, ch: string, colorCls = 0) => {
        const ri = Math.round(r);
        const ci = Math.round(c);
        if (ri >= 0 && ri < ROWS && ci >= 0 && ci < COLS && ch.length === 1) {
          chars[ri][ci] = ch;
          cls[ri][ci] = colorCls;
        }
      };

      const putStr = (r: number, c: number, text: string, colorCls = 0, keepSpace = false) => {
        const ri = Math.round(r);
        const ciStart = Math.round(c);
        for (let i = 0; i < text.length; i++) {
          const ci = ciStart + i;
          if (ri >= 0 && ri < ROWS && ci >= 0 && ci < COLS) {
            if (text[i] !== ' ' || keepSpace) {
              chars[ri][ci] = text[i];
              cls[ri][ci] = colorCls;
            }
          }
        }
      };

      const sec = nowPerf * 0.001;

      // ================= 1. Drawille 196x120 亚像素天体与双层远山科幻奇观层 =================
      if (hdSubpixelMode) {
        // 远景双层立体山脉的 196x120 亚像素精密等高轮廓线与山脊阴影线
        for (let px = 22; px < 134; px++) {
          const p1 = 30 + Math.abs(px - 50) * 0.52 + Math.sin(px * 0.32) * 1.4;
          const p2 = 34 + Math.abs(px - 84) * 0.48 + Math.cos(px * 0.25) * 1.3;
          const p3 = 40 + Math.abs(px - 112) * 0.55 + Math.sin(px * 0.29) * 1.1;
          const py = Math.min(p1, p2, p3);
          setSubPixel(px, py, 4);
          if (px % 2 === 0) setSubPixel(px, py + 2, 4);
          // 山体内部斜向构造线
          if (px % 5 === 0) {
            drawSubLine(px, py + 3, px - 4, py + 11, 4);
          }
        }

        // 高空细微星尘点阵
        for (let sIdx = 0; sIdx < 16; sIdx++) {
          const sx = (sIdx * 37 + 19) % (SUB_W - 16) + 8;
          const sy = (sIdx * 23 + 7) % 34 + 4;
          if (Math.sin(sec * 1.8 + sIdx * 1.7) > -0.25) {
            setSubPixel(sx, sy, sIdx % 3 === 0 ? 2 : 4);
          }
        }

        if (realm === 'void') {
          // 《2001：太空漫游》：196x120 亚像素精密木星圆盘 + 多层风暴云带 + 双倾斜卫星轨道 + TMA-1 球面谐波
          const jx = 34;
          const jy = 16;
          drawSubCircle(jx, jy, 11.0, 1, false);
          for (let bandY = -8; bandY <= 8; bandY += 3) {
            const halfW = Math.sqrt(Math.max(0, 118 - bandY * bandY));
            drawSubLine(jx - halfW + 1, jy + bandY, jx + halfW - 1, jy + bandY, 1);
          }
          // 环木星双层椭圆卫星轨道
          drawSubEllipseRing(jx, jy, 23, 5.4, -0.18, 2);
          drawSubEllipseRing(jx, jy, 28, 6.8, -0.18, 4);

          // TMA-1 黑石碑发射的同心亚像素球面谐波弧
          for (let wIdx = 0; wIdx < 4; wIdx++) {
            const rad = ((sec * 10 + wIdx * 7) % 28) + 3;
            for (let a = -1.35; a <= 0.15; a += 0.09) {
              setSubPixel(11 + Math.cos(a) * rad, 84 + Math.sin(a) * rad, 2);
            }
          }
        } else if (realm === 'paper') {
          // 《银河帝国》：川陀带环恒星 + 谢顿“第一辐光”三维双螺旋心理史学流形曲面！
          drawSubCircle(34, 16, 7.2, 1, true);
          drawSubEllipseRing(34, 16, 19, 4.6, -0.26, 3);
          drawSubEllipseRing(34, 16, 24, 6.0, -0.26, 4);

          // 第一辐光 (Prime Radiant) 196x120 亚像素相位流形与积分网格
          for (let px = 56; px < 156; px++) {
            const u = (px - 56) * 0.085;
            const yA = 18 + Math.sin(u + sec * 2.0) * 7.0;
            const yB = 18 + Math.cos(u * 0.85 - sec * 1.6) * 6.3;
            setSubPixel(px, yA, 3);
            setSubPixel(px, yB, 1);
            if (px % 7 === 0) {
              drawSubLine(px, yA, px, yB, 4);
            }
          }
        } else if (realm === 'crt') {
          // 《黑客帝国》：锡安主机双层电磁脉冲场线 + 劈向构造层的亚像素分叉闪电树
          for (let px = 44; px < 152; px += 2) {
            const py = 18 + Math.sin(px * 0.12 - sec * 5) * 4.2;
            const py2 = 22 + Math.cos(px * 0.09 + sec * 3.8) * 3.2;
            setSubPixel(px, py, 2);
            if (px % 4 === 0) setSubPixel(px, py2, 4);
          }
          if (sec % 2.4 < 0.48) {
            let lx = 94 + Math.sin(sec * 17) * 16;
            let ly = 2;
            for (let seg = 0; seg < 9; seg++) {
              const nx = lx + (Math.sin(seg * 3.7 + sec * 31) * 8);
              const ny = ly + 6;
              drawSubLine(lx, ly, nx, ny, 9);
              if (seg === 3 || seg === 6) {
                drawSubLine(lx, ly, lx - 14, ly + 11, 3);
              }
              lx = nx;
              ly = ny;
            }
          }
        } else {
          // 《沙丘》：厄拉科斯精密亚像素新月双星 + 巨型沙虫夏胡鲁蜿蜒亚像素环状躯干 + 沙槌地震波
          drawSubCircle(26, 14, 8.6, 1, true, 3.9); // 穆阿迪布弯月
          drawSubCircle(50, 19, 4.4, 2, true, 2.1); // 弗雷曼蓝光伴月

          // 巨型沙虫夏胡鲁 (Shai-Hulud) 196x120 亚像素厚重拱起躯干与体节环纹
          const wormPhase = sec * 3.6;
          for (let wx = 28; wx < 104; wx++) {
            const arch = Math.sin((wx - 28) * 0.125 - wormPhase) * 8.8;
            const groundPy = terrainY(wx * 0.5) * 4;
            const wy = groundPy - 4 - arch;
            if (wy < groundPy - 2) {
              for (let thick = 0; thick < 5; thick++) {
                const isRing = wx % 4 === 0 && thick > 0;
                setSubPixel(wx, wy + thick, thick === 0 ? 1 : isRing ? 9 : 4);
              }
            }
          }

          // 塔布尔穴地沙槌同心地震波
          const thumpR = ((sec * 13) % 24) + 2;
          drawSubEllipseRing(12, 96, thumpR * 1.5, thumpR * 0.48, 0, 2);
        }

        // 将所有亚像素火花/流星/香料粒子光栅化至 196x120 盲文缓冲区
        for (const sp of subParticles) {
          setSubPixel(sp.x, sp.y, sp.cls);
          setSubPixel(sp.x - sp.vx * 0.018, sp.y - sp.vy * 0.018, sp.cls);
        }

        // 点击画布触发的 196x120 亚像素高能天象集束流
        if (skyStrikeTimer > 0) {
          const bTargetPx = progToCol(boulderProg) * 2;
          const bTargetPy = (terrainY(progToCol(boulderProg)) - 2) * 4;
          drawSubLine(skyStrikeCol * 2, 2, bTargetPx, bTargetPy, 9);
          drawSubLine(skyStrikeCol * 2 + 2, 2, bTargetPx - 1, bTargetPy, 2);
          drawSubCircle(bTargetPx, bTargetPy, (0.6 - skyStrikeTimer) * 20, 9, false);
        }

        // 将 196x120 盲文缓冲区合成为 98x30 的 Unicode 盲文字符 (U+2800..U+28FF，严格 1ch 宽度)
        for (let r = 0; r < ROWS; r++) {
          for (let c = 0; c < COLS; c++) {
            const mask = brailleMask[r][c];
            if (mask !== 0) {
              chars[r][c] = String.fromCharCode(0x2800 | mask);
              cls[r][c] = brailleCls[r][c] || 2;
            }
          }
        }
      }

      // ================= 2. 四大科幻原著标志性前景器物与舰船层 =================
      if (realm === 'void') {
        if (!hdSubpixelMode) {
          putStr(1, 12, '.─~═══~─.', 1);
          putStr(2, 12, '│▒▒(o)░░│', 1);
          putStr(3, 12, "'─~═══~─'", 1);
        }
        put(4, 17, 'o', 9); // 木星大红斑核心
        const m1x = Math.round(17 + Math.cos(sec * 0.9) * 11);
        const m2x = Math.round(17 + Math.sin(sec * 0.55) * 13);
        put(4, m1x, '*', 2);
        put(3, m2x, '+', 3);

        // 发现号深空飞船 (XD-1 Discovery One) 加长精密舰体
        const shipX = 28 + (Math.floor(sec * 3.5) % 42);
        if (shipX + 12 < 82) {
          putStr(5, shipX, ':::', sec % 0.4 < 0.2 ? 2 : 3);
          putStr(5, shipX + 3, 'O═══╤══>', 5);
        }

        const halPulse = Math.floor(sec * 2) % 2 === 0 ? '(o)' : '(O)';
        putStr(0, 83, '[HAL:9000 ', 10);
        putStr(0, 93, halPulse, 9);
        put(0, 96, ']', 10);

        // 第谷环形山 TMA-1 1:4:9 黑色方尖碑
        for (let r = 20; r <= 25; r++) {
          putStr(r, 4, '███', 5);
        }
      } else if (realm === 'paper') {
        if (!hdSubpixelMode) {
          putStr(1, 13, '  .─═─.  ', 1);
          putStr(2, 13, '══╡ O ╞══', 1);
          putStr(3, 13, "  '─═─'  ", 1);
        } else {
          put(4, 17, 'O', 1);
        }
        putStr(0, 72, '[PRIME_RADIANT // SELDON]', 1);

        const fleetX = 28 + (Math.floor(sec * 4.5) % 44);
        if (fleetX + 8 < 80) {
          putStr(6, fleetX, '...-==>', 1);
          putStr(7, fleetX - 5, '..-=>', 4);
        }

        // 端点星谢顿穹顶 (Seldon Vault)
        putStr(22, 2, ' ╔══╦══╗ ', 4);
        putStr(23, 2, '╔╣  ║  ╠╗', 4);
        putStr(24, 2, '║║  ║  ║║', 4);
        putStr(25, 2, '╩╩══╩══╩╩', 4);
      } else if (realm === 'crt') {
        const rainChars = ['0', '1', ':', '|', '+', '#', '7', '9'];
        for (const drop of matrixDrops) {
          const colI = Math.round(drop.col);
          const maxY = terrainY(colI) - 1;
          for (let k = 0; k < drop.len; k++) {
            const ry = Math.round(drop.y - k);
            if (ry >= 0 && ry < maxY) {
              const g = rainChars[(Math.floor(sec * 9) + colI + k) % rainChars.length];
              put(ry, colI, g, k === 0 ? 3 : 2);
            }
          }
        }

        const towers = [
          [11, 16, 4],
          [18, 13, 5],
          [26, 14, 4],
          [34, 15, 5],
          [43, 16, 4],
        ] as const;
        towers.forEach(([tc, topR, tw], idx) => {
          const botR = Math.round(terrainY(tc)) - 1;
          for (let r = topR; r <= botR; r++) {
            for (let xOff = 0; xOff < tw; xOff++) {
              const isEdge = xOff === 0 || xOff === tw - 1 || r === topR;
              if (isEdge) {
                put(r, tc + xOff, r === topR ? '▀' : '│', 4);
              } else if ((r + xOff + Math.floor(sec * 2 + idx)) % 3 === 0) {
                put(r, tc + xOff, '▪', idx % 2 === 0 ? 9 : 1);
              }
            }
          }
        });

        // 尼布甲尼撒号气垫船 (Nebuchadnezzar)
        const hoverX = Math.round(44 + Math.sin(sec * 1.3) * 10);
        const hoverY = Math.round(5.0 + Math.cos(sec * 2.2) * 0.9);
        putStr(hoverY, hoverX, '<═╦═╬═╦═>', 3);
        putStr(0, 71, '[ZION_MAINFRAME // 0x5F37]', 2);
      } else {
        if (!hdSubpixelMode) {
          putStr(1, 11, '(o)', 1);
          put(2, 19, 'o', 2);
        }
        // 阿崔迪扑翼机 (Ornithopter) 高频振翅掠过障壁山脉
        const thopterX = 26 + (Math.floor(sec * 5.5) % 48);
        const wingFrame = Math.floor(sec * 11) % 3;
        const wings = wingFrame === 0 ? '\\\\═╦═//' : wingFrame === 1 ? '──═╦═──' : '//═╦═\\\\';
        if (thopterX + 8 < 82) {
          putStr(3 + (wingFrame === 2 ? 1 : 0), thopterX, wings, 1);
        }

        // 弗雷曼沙槌 (Thumper)
        const thumpBeat = sec % 2.2;
        put(22, 5, thumpBeat < 0.25 ? '▄' : '╤', 9);
        put(23, 5, '║', 1);
        put(24, 5, '║', 1);
        put(25, 5, '╩', 1);
        putStr(0, 73, '[ARRAKIS // SHIELD_WALL]', 1);
      }

      if (!hdSubpixelMode) {
        for (const sp of subParticles) {
          put(sp.y * 0.25, sp.x * 0.5, sp.asciiFallback, sp.cls);
        }
      }

      // ================= 3. 主山脊线与 Chafa 明暗法线地质岩层 =================
      const treadShift = Math.floor(continuousRoll * 2.2);
      for (let c = 0; c < COLS; c++) {
        const yExact = terrainY(c);
        const sr = Math.round(yExact);
        const nextY = terrainY(Math.min(COLS - 1, c + 1));
        const diff = nextY - yExact;

        let ridgeChar = '─';
        if (c >= 87) ridgeChar = '═';
        else if (diff < -0.1) ridgeChar = '/';
        else ridgeChar = '_';

        if (sr >= 0 && sr < ROWS) {
          put(sr, c, ridgeChar, 5);
        }

        for (let r = sr + 1; r < ROWS; r++) {
          const depth = r - sr;
          let fill = '░';
          let colorId = 6;

          if (realm === 'crt') {
            const pulseWave = Math.abs(((c - Math.floor(sec * 16)) % 28 + 28) % 28) < 2;
            fill =
              depth === 1
                ? (c + r + treadShift) % 2 === 0
                  ? '1'
                  : '0'
                : depth === 2
                  ? '┼'
                  : (c + r) % 3 === 0
                    ? '▒'
                    : '░';
            if (pulseWave && depth <= 3) colorId = 3;
          } else if (realm === 'paper') {
            fill =
              depth === 1
                ? '/'
                : depth === 2
                  ? (c + treadShift) % 3 === 0
                    ? ':'
                    : ','
                  : (r + c) % 4 === 0
                    ? '+'
                    : '.';
          } else if (realm === 'amber') {
            const sandDrift = (c + r + Math.floor(sec * 3)) % 5;
            fill = depth === 1 ? '~' : sandDrift === 0 ? '-' : depth <= 3 ? '▒' : '░';
            if (sandDrift === 0 && depth === 2) colorId = 1;
          } else {
            const harmonic = (c * 2 + r + Math.floor(sec * 4)) % 17 === 0;
            fill = depth === 1 ? '▓' : depth <= 3 ? '▒' : (r + c) % 2 === 0 ? '░' : ':';
            if (harmonic) colorId = 2;
          }
          put(r, c, fill, colorId);
        }
      }

      // 峰顶信标红旗与山巅界碑（全部严格收拢在 98 列可视画幅内部，右侧山顶直接延展至画框边缘）
      const peakR = Math.round(terrainY(90));
      const flagWave = Math.floor(sec * 5) % 2 === 0 ? '[~>' : '[=>';
      put(peakR - 2, 91, '│', 5);
      put(peakR - 1, 91, '┴', 5);
      putStr(peakR - 2, 92, flagWave, 9);
      put(peakR - 1, 96, '▲', 4);

      // ================= 4. 绘制 6x4 超清立体滚动多面体巨石 =================
      const bCol = progToCol(boulderProg);
      let bGroundY = terrainY(bCol);

      if (phase === 'AVALANCHE') {
        const bounce = Math.abs(Math.sin(boulderProg * Math.PI * 7.0)) * 1.75;
        bGroundY -= bounce;
      } else if (phase === 'SUMMIT_BREATH' && phaseElapsed > 2.2) {
        bGroundY -= (Math.random() - 0.5) * 0.25;
      }

      const rockSprite = getBoulderSprite(realm, Math.floor(continuousRoll), hdSubpixelMode);
      const rockTopRow = Math.round(bGroundY) - 4;
      const rockLeftCol = Math.round(bCol) - 2;
      putStr(rockTopRow, rockLeftCol, rockSprite[0], 8);
      putStr(rockTopRow + 1, rockLeftCol, rockSprite[1], 8);
      putStr(rockTopRow + 2, rockLeftCol, rockSprite[2], 8);
      putStr(rockTopRow + 3, rockLeftCol, rockSprite[3], 8);

      // ================= 5. 绘制关节化西西弗斯小人 + 原著独白气泡 =================
      const sCol = progToCol(sisyphusProg);
      const sLeft =
        phase === 'CLIMB'
          ? Math.max(1, rockLeftCol - 3)
          : Math.round(sCol) - 1;
      const sGroundRow = Math.round(terrainY(sLeft + 1));

      if (phase === 'CLIMB') {
        const legIdx = Math.floor(continuousStep) % CLIMB_LEGS.length;
        const armPush = Math.floor(continuousStep * 0.5) % 2 === 0 ? '/|═' : '/|─';
        const headPose = boostVelocity > 0.02 || sprintToSummit ? ' o/' : ' o_';

        putStr(sGroundRow - 3, sLeft, headPose, 7);
        putStr(sGroundRow - 2, sLeft, armPush, 7);
        putStr(sGroundRow - 1, sLeft, CLIMB_LEGS[legIdx], 7);

        if (boostVelocity > 0.025 || sprintToSummit) {
          put(sGroundRow - 2, sLeft - 1, '*', 9);
          put(sGroundRow - 1, sLeft - 2, ':', 9);
        }

        const bubbleCycle = sec % 7.5;
        if (bubbleCycle < 2.8 && boostBannerTimer <= 0) {
          const lines = BUBBLE_LINES[realm] || BUBBLE_LINES.void;
          const msg = lines[Math.floor(sec / 7.5) % lines.length];
          const bubbleCol = Math.max(1, Math.min(COLS - msg.length - 1, sLeft - 4));
          putStr(Math.max(1, Math.min(rockTopRow - 1, sGroundRow - 5)), bubbleCol, msg, 7);
        }
      } else if (phase === 'SUMMIT_BREATH') {
        if (phaseElapsed < 1.2) {
          putStr(sGroundRow - 3, sLeft, '\\o/', 7);
          putStr(sGroundRow - 2, sLeft, ' | ', 7);
          putStr(Math.max(0, sGroundRow - 5), Math.max(1, sLeft - 4), '(884.8m!)', 1);
        } else {
          putStr(sGroundRow - 3, sLeft, ' o ', 7);
          putStr(sGroundRow - 2, sLeft, '/|\\', 7);
        }
        putStr(sGroundRow - 1, sLeft, '/ \\', 7);
      } else if (phase === 'AVALANCHE') {
        if (phaseElapsed <= 1.3) {
          putStr(sGroundRow - 3, sLeft, 'o  ', 7);
          putStr(sGroundRow - 2, sLeft, '|\\ ', 7);
          putStr(sGroundRow - 1, sLeft, '/ \\', 7);
        } else {
          const legIdx = Math.floor(continuousStep) % WALK_DOWN_LEGS.length;
          putStr(sGroundRow - 3, sLeft, ' o ', 7);
          putStr(sGroundRow - 2, sLeft, '/|\\', 7);
          putStr(sGroundRow - 1, sLeft, WALK_DOWN_LEGS[legIdx], 7);
        }
      } else if (phase === 'DESCENT_WALK') {
        if (sisyphusProg > 0.008) {
          const legIdx = Math.floor(continuousStep) % WALK_DOWN_LEGS.length;
          const armSwing = Math.floor(continuousStep) % 2 === 0 ? '/|\\' : ' | ';
          putStr(sGroundRow - 3, sLeft, ' o ', 7);
          putStr(sGroundRow - 2, sLeft, armSwing, 7);
          putStr(sGroundRow - 1, sLeft, WALK_DOWN_LEGS[legIdx], 7);
          putStr(Math.max(1, sGroundRow - 5), Math.max(1, sLeft - 3), '(happy.)', 7);
        } else {
          putStr(sGroundRow - 3, sLeft, ' o_', 7);
          putStr(sGroundRow - 2, sLeft, '/|═', 7);
          putStr(sGroundRow - 1, sLeft, '/ \\', 7);
        }
      }

      // ================= 6. 左上角内嵌 TUI 遥测角标（与全站全局海拔数据源 100% 统一） =================
      const latestTotalNow = getTotalRawCycles(Date.now());
      const unifiedCycleIdx = Math.floor(latestTotalNow);
      const unifiedFrac =
        phase === 'CLIMB' && !sprintToSummit
          ? Math.max(0, Math.min(1, latestTotalNow - unifiedCycleIdx))
          : Math.max(0, Math.min(1, boulderProg));
      const shownCycle = baseSummits + unifiedCycleIdx;
      const altNow = (unifiedFrac * PEAK_ALT).toFixed(1);
      const phaseTag =
        phase === 'CLIMB'
          ? sprintToSummit
            ? 'SPRINT'
            : 'ASCENT'
          : phase === 'SUMMIT_BREATH'
            ? 'SUMMIT'
            : phase === 'AVALANCHE'
              ? 'TUMBLE'
              : 'RETURN';

      putStr(0, 1, `[${phaseTag}] ${altNow}m`, 10);
      if (boostBannerTimer > 0) {
        putStr(0, 18, `>> +${lastBoostGainMeters.toFixed(1)}m [${lastBoostSource}] <<`, 9);
      }

      // ================= 7. 合并连续同色字符输出高对比多彩 HTML =================
      const htmlLines: string[] = [];
      for (let r = 0; r < ROWS; r++) {
        let lineHtml = '';
        let runCls = cls[r][0];
        let runText = chars[r][0];

        for (let c = 1; c < COLS; c++) {
          if (cls[r][c] === runCls) {
            runText += chars[r][c];
          } else {
            const escaped = escapeHtml(runText);
            lineHtml += runCls
              ? `<span class="${CLS_NAMES[runCls]}">${escaped}</span>`
              : escaped;
            runCls = cls[r][c];
            runText = chars[r][c];
          }
        }
        const escaped = escapeHtml(runText);
        lineHtml += runCls
          ? `<span class="${CLS_NAMES[runCls]}">${escaped}</span>`
          : escaped;
        htmlLines.push(lineHtml);
      }

      stageEl.innerHTML = htmlLines.join('\n');

      const filled = Math.max(0, Math.min(10, Math.round(unifiedFrac * 10)));
      const bar = '▪'.repeat(filled) + '▫'.repeat(10 - filled);
      const remainMs = Math.max(0, (1 - unifiedFrac) * CYCLE_MS);
      const boostNote =
        save.boostMeters >= 0.5 ? ` · BOOST +${Math.round(save.boostMeters)}m` : '';

      telemetryEl.textContent = `ALT ${altNow}m [${bar}] ETA ${formatEta(remainMs)} · #${shownCycle}${boostNote}`;

      if (quoteEl) {
        if (phase === 'SUMMIT_BREATH') {
          quoteEl.textContent = '"登顶的片刻停驻，星风正掠过山脊。"';
        } else if (phase === 'AVALANCHE') {
          quoteEl.textContent = '"引力终将夺回巨石，但夺不走攀登本身。"';
        } else if (phase === 'DESCENT_WALK') {
          quoteEl.textContent = '"真正打动我的，是他走下山去的那段清醒时刻。"';
        } else {
          quoteEl.textContent = WORLD_QUOTES[realm] || WORLD_QUOTES.void;
        }
      }
    };

    requestAnimationFrame(tick);
  }
</script>
