    };

    // ======================================================================
    // 5. 动态粒子、分段推石特效 (Tier 1~3)、1% 坐骑冲顶彩蛋 (Tier 4) 与背景随机小事件
    // ======================================================================
    interface Particle {
      x: number; y: number; vx: number; vy: number;
      life: number; max: number; c: number; g: number; kind: number; seed: number;
    }
    const parts: Particle[] = [];
    const emit = (x: number, y: number, vx: number, vy: number, max: number, c: number, g = 0, kind = 0) => {
      if (parts.length > 280) parts.shift();
      parts.push({ x, y, vx, vy, life: 0, max, c, g, kind, seed: Math.floor(Math.random() * 511) });
    };
    interface Floater { x: number; y: number; s: string; t: number; tier: number }
    const floats: Floater[] = [];

    // 黑客帝国代码雨
    const GLYPHS: number[] = [];
    for (let i = 0; i < 48; i++) {
      let m = 0;
      for (let b = 0; b < 15; b++) if (hash(i, b + 90) > 0.48) m |= 1 << b;
      GLYPHS.push(m || 0b010111010);
    }
    const rain = Array.from({ length: 64 }, (_, i) => ({
      x: 1 + i * 5,
      y: Math.random() * H * 1.5 - H * 0.5,
      sp: 22 + Math.random() * 40,
