    // 分段助推小动画状态 (Tier 1: 稳步发力, Tier 2: 强力突进, Tier 3: 史诗暴击, Tier 4: 1% 坐骑神迹直达峰顶!)
    let activeTier = 0; // 1 | 2 | 3 | 4
    let tierTimer = 0;
    let tierDuration = 1.0;
    let epicCharge = false; // true 时播放盛大坐骑/载具冲顶演出（骑沙虫 / 星门推进舱 / 帝国反重力舰 / 救世主御空）
    let pushPityCount = 0;

    // 背景随机小事件系统 (每个主题 3 种独特背景事件，每隔 5~9 秒随机触发)
    interface BgEvent {
      type: number; // 0, 1, 2
      t: number;
      dur: number;
      x0: number;
      y0: number;
      dir: number;
    }
    let bgEvent: BgEvent | null = { type: 0, t: 0.5, dur: 6.0, x0: 85, y0: 40, dir: 1 };
    let nextBgEventTimer = 5.5;

    const worm = { active: false, t: 0, x0: 120, dir: 1 };
    let nextWorm = 10;
    let glitch = 0;
    let nextGlitch = 5;
    let summitFx = -1;

    // ======================================================================
    // 6. 8 小时真实时间轮回（与全站推石存档同步）
    // ======================================================================
    interface CycleSave { anchorEpoch: number; boostAccum: number; boostMeters: number }
    let save: CycleSave = { anchorEpoch: Math.floor(Date.now() / CYCLE_MS), boostAccum: 0, boostMeters: 0 };
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (typeof parsed.anchorEpoch === 'number' && typeof parsed.boostAccum === 'number') {
          save = { anchorEpoch: parsed.anchorEpoch, boostAccum: parsed.boostAccum, boostMeters: Number(parsed.boostMeters || 0) };
        }
      } else localStorage.setItem(STORAGE_KEY, JSON.stringify(save));
    } catch {}
    const persistSave = () => {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(save));
      } catch {}
    };
    const reloadSave = () => {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const p = JSON.parse(raw);
          save.boostAccum = Number(p.boostAccum ?? save.boostAccum);
          save.boostMeters = Number(p.boostMeters ?? save.boostMeters);
        }
      } catch {}
    };
    const getTotal = (ms: number) => Math.max(0, ms / CYCLE_MS - save.anchorEpoch + save.boostAccum);

    let phase: Phase = 'CLIMB';
    let phaseT = 0;
    const initTotal = getTotal(Date.now());
    let activeCycle = Math.floor(initTotal);
    let frac = initTotal - activeCycle;
    let sprint = false;
    let gait = 0;
    let kick = 0;
    let rollX = PATH_X1;
    let rollV = 0;
    let heroX = pushHeroX(frac);
    let prevSin = 0;

