          // 球形 EVA 出舱作业舱 (EVA Pod) 在西西弗斯身后托举推进
          const podX = bc.x - 21;
          const podY = bc.y + 1;
          disc(podX, podY, 5.5, hex('#e6eaf2'));
          disc(podX + 2, podY - 1, 2.2, hex('#38bdf8')); // 观察窗
          // 机械臂握持西西弗斯与巨石
          stroke(podX + 5, podY + 1, bc.x - R, bc.y + 2, 1, hex('#9aaee0'));
          // 尾部巨型核热等离子喷焰
          poly([podX - 5, podY - 3, podX - 5, podY + 3, podX - 22 - Math.sin(sec * 40) * 4, podY], hex('#38bdf8'));
          poly([podX - 5, podY - 1.5, podX - 5, podY + 1.5, podX - 14, podY], hex('#ffffff'));
          return { customHeroDrawn: false };
        }

        if (realm === 'paper') {
          // 《银河帝国：基地》：川陀帝国反重力黄金舰艇 (Imperial Grav-Barge) 托举冲顶！
          const bargeX = bc.x - 7;
          const bargeY = gy(bargeX) - 2;
          // 黄金反重力光桥与舰体
          poly([bargeX - 18, bargeY, bargeX + 16, bargeY - 5, bargeX + 13, bargeY + 2, bargeX - 15, bargeY + 4], hex('#2e3846'));
          stroke(bargeX - 17, bargeY, bargeX + 15, bargeY - 5, 1, hex('#f0c875'));
          // 舰底双反重力光环
          ring(bargeX - 8, bargeY + 4, 6, 1.8, hex('#5ec8ff'), 0.95);
          ring(bargeX + 6, bargeY + 1, 6, 1.8, hex('#5ec8ff'), 0.95);
          // 环绕巨石的第一辐光全息牵引金环
          ring(bc.x, bc.y, R + 3, R + 3, hex('#f0c875'), 0.95);
          ring(bc.x, bc.y, R + 5, 3, hex('#c8402a'), 0.9);
          const mountX = bc.x - 12;
          drawHero('ride', mountX, 1, gait, { x: bc.x - R, y: bc.y }, heave, sec, bargeY - 1);
          return { customHeroDrawn: true };
        }

        if (realm === 'crt') {
          // 《黑客帝国》：救世主尼奥觉醒御空飞行 + 4 重绿光残影 + 念力电磁闪电驭石！
          const flyX = bc.x - 14;
          const flyY = gy(flyX) - 6;
          // 4 道子弹时间绿光残影
          for (let clone = 3; clone >= 1; clone--) {
            const cx = flyX - clone * 6;
            const cy = gy(cx) - 5;
            rect(cx - 2, cy - 9, 4, 6, clone === 1 ? hex('#16a548') : hex('#0b3a1a'));
          }
          // 念力闪电弧连接尼奥手掌与线框巨石
          for (let b = -1; b <= 1; b++) {
            stroke(flyX + 6, flyY - 9, bc.x, bc.y + b * 3, 1, b === 0 ? hex('#ffffff') : hex('#3dff7a'));
          }
          ring(bc.x, bc.y, R + 2 + Math.sin(sec * 30), R + 2, hex('#c8ffd9'), 0.9);
          drawHero('ride', flyX, 1, gait, { x: bc.x - R - 1, y: bc.y - 2 }, heave, sec, flyY);
          return { customHeroDrawn: true };
        }
      }

      // —— B. Tier 2 (强力突进) & Tier 3 (史诗暴击) 分段专属动画 ——
      if (tierTimer > 0 && phase === 'CLIMB') {
        const p = tierTimer / tierDuration; // 1 -> 0
        if (activeTier >= 2) {
          // Tier 2 & 3 共有：巨石高能外环 + 地面推进滑痕
          const auraC =
            realm === 'crt'
              ? hex('#3dff7a')
              : realm === 'paper'
                ? hex('#f0c875')
                : realm === 'amber'
                  ? hex('#5ec8ff')
                  : hex('#8fd3ff');
          ring(bc.x, bc.y, R + 1.5 + Math.sin(sec * 25), R + 1.5, auraC, p * 0.9);
          for (let s = 2; s < 18; s++) {
            const sx = Math.round(bcx - s);
            if (sx > 0 && sx < W) pdither(sx, gyi[sx] - 1, auraC, p * (1 - s / 18));
          }
        }

        if (activeTier === 3) {
          // Tier 3 (35m~68m) 四大主题专属暴击过场小动画！
          if (realm === 'void') {
            // 太空漫游：轨道 1:4:9 谐波光束从天而降轰击巨石
            for (let dx = -2; dx <= 2; dx++) {
              pdither(bc.x + dx, 0, hex('#8fd3ff'), p);
              stroke(bc.x + dx, 2, bc.x + dx, bc.y - R, 1, Math.abs(dx) <= 1 ? hex('#ffffff') : hex('#38bdf8'));
            }
            ring(bc.x, bc.y, (1 - p) * 24 + 4, (1 - p) * 8 + 2, hex('#ffffff'), p);
          } else if (realm === 'paper') {
            // 银河帝国：帝国巡洋舰俯冲牵引光束 + 谢顿全息金印悬顶
            const shipX = bc.x - 25 + (1 - p) * 55;
            const shipY = Math.max(16, bc.y - 38);
            poly([shipX - 9, shipY, shipX + 8, shipY - 2, shipX + 11, shipY + 2, shipX - 6, shipY + 2], hex('#2e3846'));
            stroke(shipX - 6, shipY, shipX + 7, shipY, 1, hex('#f0c875'));
            // 金色牵引光锥
            stroke(shipX, shipY + 2, bc.x - 4, bc.y - R, 1, hex('#f0c875'));
            stroke(shipX, shipY + 2, bc.x + 4, bc.y - R, 1, hex('#f0c875'));
            stroke(shipX, shipY + 2, bc.x, bc.y - R, 1, hex('#c8402a'));
          } else if (realm === 'crt') {
            // 黑客帝国：全屏扩散的双环青色 EMP 电磁脉冲波
            const empR = (1 - p) * 75 + 6;
            ring(bc.x, bc.y, empR, empR * 0.6, hex('#7fd8ff'), p);
            ring(bc.x, bc.y, empR * 0.7, empR * 0.42, hex('#c8ffd9'), p);
          } else {
            // 沙丘：阿崔迪扑翼机低空俯冲 + 巨石脚下香料喷泉爆发
            const ox = bc.x - 30 + (1 - p) * 65;
            const oy = Math.max(18, bc.y - 32);
            stroke(ox - 5, oy, ox + 5, oy, 1, hex('#2a140c'));
            stroke(ox, oy, ox - 6, oy - 3, 1, hex('#fbdc98'));
            stroke(ox, oy, ox + 6, oy - 3, 1, hex('#fbdc98'));
            // 巨石下方香料喷泉柱
            for (let dy = 0; dy < 16; dy++) {
              pdither(bc.x + (Math.random() - 0.5) * 8, bc.y + R - dy, dy % 2 ? hex('#ffd59a') : hex('#c8402a'), p);
            }
          }
        }
      }

      return { customHeroDrawn: false };
    };

    const shimmer = (sec: number) => {
      for (let y = 100; y < 130; y++) {
        const s = Math.round(Math.sin(y * 0.9 + sec * 6) * 0.9);
        if (!s) continue;
        const row = y * W;
        tmpRow.set(buf.subarray(row, row + W));
        for (let x = 0; x < W; x++) {
          if (y >= gyi[x] - 1) continue;
          buf[row + x] = tmpRow[clamp(x - s, 0, W - 1)];
        }
      }
    };

    const glitchPass = () => {
      for (let b = 0; b < 3; b++) {
        const y0 = Math.floor(Math.random() * H);
        const h = 1 + Math.floor(Math.random() * 5);
        const off = Math.round((Math.random() - 0.5) * 14);
        for (let y = y0; y < Math.min(H, y0 + h); y++) {
          const row = y * W;
          tmpRow.set(buf.subarray(row, row + W));
          for (let x = 0; x < W; x++) buf[row + x] = tmpRow[clamp(x - off, 0, W - 1)];
        }
      }
    };

    const scanlines = () => {
      for (let y = 1; y < H; y += 2) {
        const row = y * W;
        for (let x = 0; x < W; x++) {
          const c = buf[row + x];
          buf[row + x] = (c - ((c >>> 2) & 0x003f3f3f)) >>> 0;
        }
      }
    };

    // ======================================================================
    // 11. 更新
    // ======================================================================
    const update = (dt: number, sec: number) => {
      const total = getTotal(Date.now());
      phaseT += dt;
      if (kick > 0) kick = Math.max(0, kick - dt);
      if (tierTimer > 0) {
        tierTimer = Math.max(0, tierTimer - dt);
        if (tierTimer <= 0 && !epicCharge) activeTier = 0;
      }
      if (summitFx >= 0) {
        summitFx += dt;
        if (summitFx > 6) summitFx = -1;
      }
      if (glitch > 0) glitch = Math.max(0, glitch - dt);

      // 更新随机背景小事件计时器
      if (bgEvent) {
        bgEvent.t += dt;
        if (bgEvent.t >= bgEvent.dur) {
          bgEvent = null;
          nextBgEventTimer = 4.5 + Math.random() * 5.5;
        }
      } else {
        nextBgEventTimer -= dt;
        if (nextBgEventTimer <= 0) {
          bgEvent = {
            type: Math.floor(Math.random() * 3),
            t: 0,
            dur: 5.5 + Math.random() * 2.5,
            x0: 60 + Math.random() * 160,
            y0: 25 + Math.random() * 45,
            dir: Math.random() < 0.5 ? 1 : -1,
          };
        }
      }

      if (phase === 'CLIMB') {
        const prev = frac;
        if (sprint) {
          const speed = epicCharge ? 0.32 : 0.35;
          const step = Math.min(1.0005 - frac, dt * speed);
          save.boostAccum += Math.max(0, step);
          frac += step;
          if (epicCharge && Math.random() < 0.75) {
            const bc = boulderCenter(contactX(frac));
            const trailC =
              realm === 'amber'
                ? hex('#eaa25c')
                : realm === 'crt'
                  ? hex('#3dff7a')
                  : realm === 'paper'
                    ? hex('#f0c875')
                    : hex('#8fd3ff');
            emit(bc.x - 10, bc.y + 3, -25 - Math.random() * 30, -8 - Math.random() * 16, 0.8, trailC, 25, 4);
          }
          if (frac >= 1) {
            sprint = false;
            persistSave();
            enterSummit();
          }
        } else if (Math.floor(total) > activeCycle) {
          frac += Math.min(1.001 - frac, dt * 0.5);
          if (frac >= 1) enterSummit();
        } else {
          frac += (total - activeCycle - frac) * Math.min(1, dt * 3);
        }
        const vel = dt > 1e-5 ? Math.max(0, (frac - prev) / dt) : 0;
        const tierSpeedBonus = activeTier === 3 ? 2.2 : activeTier === 2 ? 1.5 : 0;
        gait += dt * Math.PI * 2 * (0.8 + tierSpeedBonus + Math.min(3, vel * 90));
        const s = Math.sin(gait);
        if (prevSin < 0 && s >= 0 && !reduceMotion) {
          const fx = pushHeroX(frac) - 2;
          for (let i = 0; i < 2; i++) emit(fx, gy(fx) - 1, -4 - Math.random() * 8, -4 - Math.random() * 6, 0.6, ROCK[realm][2], realm === 'void' ? 6 : 30, 0);
        }
        prevSin = s;
      } else if (phase === 'SUMMIT') {
        const startX = pushHeroX(1);
        if (phaseT > 1.3 && phaseT < 2.7) {
          heroX = startX + ((phaseT - 1.3) / 1.4) * (SUMMIT_STAND_X - startX);
          gait += dt * Math.PI * 2 * 2.2;
        } else heroX = phaseT <= 1.3 ? startX : SUMMIT_STAND_X;
        if (phaseT >= 3.8) {
          phase = 'ROLL';
          phaseT = 0;
          rollX = PATH_X1;
          rollV = 4;
        }
      } else if (phase === 'ROLL') {
        rollV = Math.min(120, rollV + dt * 60);
        rollX -= rollV * dt;
        if (Math.random() < 0.7) {
          const c = ROCK[realm][2];
          emit(rollX + 4, gy(rollX) - 1, 6 + Math.random() * 14, -6 - Math.random() * 14, 0.7, c, realm === 'void' ? 8 : 50, 0);
        }
        if (rollX <= PATH_X0) {
          rollX = PATH_X0;
          for (let i = 0; i < 18; i++) emit(PATH_X0, gy(PATH_X0) - 1, (Math.random() - 0.3) * 40, -Math.random() * 26, 0.9, ROCK[realm][1], realm === 'void' ? 8 : 60, 0);
          phase = 'DESCENT';
          phaseT = 0;
          heroX = SUMMIT_STAND_X;
        }
      } else if (phase === 'DESCENT') {
        const target = pushHeroX(0);
        if (heroX > target) {
          heroX = Math.max(target, heroX - dt * 20);
          gait += dt * Math.PI * 2 * 3.1;
          phaseT = 0;
        } else if (phaseT > 1.4) {
          const t2 = getTotal(Date.now());
          activeCycle = Math.floor(t2);
          frac = Math.min(0.03, t2 - activeCycle);
          phase = 'CLIMB';
          phaseT = 0;
        }
      }

      // 主题常态环境粒子
      if (realm === 'amber') {
        if (!reduceMotion) {
          for (let i = 0; i < 2; i++) {
            if (Math.random() < 0.45) emit(W + 4, 40 + Math.random() * 140, -90 - Math.random() * 60, 4 + Math.random() * 6, 3.5, Math.random() < 0.5 ? hex('#f3c07e') : hex('#e8a160'), 0, 3);
          }
        }
        if (worm.active) {
          worm.t += dt;
          if (worm.t > 5.5) worm.active = false;
        } else {
          nextWorm -= dt;
          if (nextWorm <= 0) {
            worm.active = true;
            worm.t = 0;
            worm.dir = Math.random() < 0.5 ? 1 : -1;
            worm.x0 = worm.dir > 0 ? 40 + Math.random() * 60 : 160 + Math.random() * 60;
            nextWorm = 14 + Math.random() * 12;
          }
        }
      } else if (realm === 'paper') {
        // 川陀高空悬浮金尘与微光信标粒子
        if (!reduceMotion && Math.random() < dt * 1.8) {
          emit(Math.random() * W, 30 + Math.random() * 80, 8 + Math.random() * 10, -2 + Math.random() * 4, 4.5, Math.random() < 0.6 ? hex('#f0c875') : hex('#88c9e8'), 0, 1);
        }
      } else if (realm === 'crt') {
        for (const col of rain) {
          col.y += col.sp * dt;
          if (col.y - col.len * 6 > H) {
            col.y = -Math.random() * 60;
            col.sp = 22 + Math.random() * 40;
            col.len = 4 + Math.floor(Math.random() * 9);
          }
        }
        nextGlitch -= dt;
        if (nextGlitch <= 0) {
          glitch = 0.18;
          nextGlitch = 4 + Math.random() * 6;
        }
        if (summitFx > 2.2 && summitFx < 2.3) glitch = 0.25;
      } else if (!reduceMotion && Math.random() < dt * 0.25) {
        emit(200 + Math.random() * 120, 4 + Math.random() * 20, -120, 45, 0.5, hex('#ffffff'), 0, 3);
      }

      for (let i = parts.length - 1; i >= 0; i--) {
        const p = parts[i];
        p.life += dt;
        if (p.life >= p.max || p.x < -20 || p.x > W + 20 || p.y > H + 10) {
          parts.splice(i, 1);
          continue;
        }
        p.vy += p.g * dt;
        p.x += p.vx * dt + (p.kind === 1 ? Math.sin(p.life * 3 + p.seed) * 0.3 : 0);
        p.y += p.vy * dt;
      }
      for (let i = floats.length - 1; i >= 0; i--) {
        floats[i].t += dt;
        floats[i].y -= dt * 10;
        if (floats[i].t > 1.55) floats.splice(i, 1);
      }
      void sec;
    };

    // ======================================================================
    // 12. 渲染
    // ======================================================================
    const render = (sec: number) => {
      buf.set(staticBuf);

      clipFn = skyClip;
      if (realm === 'void') drawBgVoid(sec);
      else if (realm === 'paper') drawBgPaper(sec);
      else if (realm === 'crt') drawBgCrt(sec);
      else drawBgAmber(sec);
      clipFn = null;
      if (realm === 'amber') shimmer(sec);

      if (realm === 'crt') {
        const px = Math.floor(((sec * 48) % (W + 40)) - 20);
        for (let i = 0; i < 12; i++) {
          const x = px - i;
          if (x >= 0 && x < W) plot(x, gyi[x], i === 0 ? hex('#ffffff') : i < 4 ? hex('#c8ffd9') : hex('#7dffa8'));
        }
      }

      // —— 计算角色与巨石位置 ——
      let bcx: number;
      let lift = 0;
      let mode: Mode = 'push';
      let facing = 1;
      let hx = heroX;
      const heaveAmp = activeTier === 3 ? 3.8 : activeTier === 2 ? 2.8 : 2.2;
      const heave = kick > 0 ? Math.sin(((0.75 - Math.min(0.75, kick)) / 0.75) * Math.PI) * heaveAmp : Math.sin(gait * 2) * 0.35;
      if (phase === 'CLIMB') {
        bcx = contactX(frac) + Math.max(0, heave) * 0.5;
        if (epicCharge) {
          lift = realm === 'crt' ? 4.5 : realm === 'paper' ? 3.5 : realm === 'amber' ? 4.0 : 2.5;
        } else if (activeTier === 3) {
          lift = Math.sin((tierTimer / tierDuration) * Math.PI) * 2.4;
        }
      } else if (phase === 'SUMMIT') {
        bcx = PATH_X1 + (phaseT > 3 ? Math.sin(phaseT * 30) * 0.6 * (phaseT - 3) : 0);
        if (phaseT <= 1.3) mode = 'cheer';
        else if (phaseT < 2.7) mode = 'walk';
        else {
          mode = 'stand';
          facing = -1;
        }
        if (phaseT >= 2.7) facing = -1;
      } else if (phase === 'ROLL') {
        bcx = rollX;
        lift = Math.abs(Math.sin(rollX * 0.21)) * Math.min(4, rollV * 0.04);
        mode = 'watch';
        facing = -1;
      } else {
        bcx = PATH_X0;
        const target = pushHeroX(0);
        if (heroX > target + 0.01) {
          mode = 'walk';
          facing = -1;
        } else {
          mode = 'stand';
          facing = 1;
        }
        hx = heroX;
      }
      const bc = boulderCenter(bcx, lift);
      const angle = ((bcx - PATH_X0) / R) * 1.05;
      const hand = { x: bc.x - R + 0.5, y: bc.y + 1 };

      castShadow(bcx - (SHADOW[realm]?.dir ?? 1) * 3, 16);
      castShadow((mode === 'push' ? hand.x - 10 : hx) - (SHADOW[realm]?.dir ?? 1) * 1, 10);

      toLayer = true;
      layerId = 1;
      drawBoulder(bc.x, bc.y, angle, sec);
      layerId = 2;
      const { customHeroDrawn } = drawTierEffectsAndEpicMount(bc, bcx, hand, heave, sec);
      if (!customHeroDrawn) {
        // Tier 2 / Tier 3 突进残影
        if (activeTier >= 2 && tierTimer > 0 && mode === 'push') {
          rect(hand.x - 14, hand.y - 4, 3, 8, HERO[realm].back);
        }
        drawHero(mode, hx, facing, gait, mode === 'push' ? hand : null, heave, sec);
      }
      if (realm === 'crt' && summitFx >= 0 && summitFx < 4.4) {
        layerId = 3;
        const loop = summitFx % 2.2;
        const cx = -12 + (loop / 2.2) * 150;
        const cy = gy(cx) - 5;
        const legs = CAT_LEGS[Math.floor(sec * 8) % 2];
        const rows = [...CAT, legs];
        for (let r = 0; r < rows.length; r++)
          for (let c = 0; c < rows[r].length; c++) if (rows[r][c] === 'x') plot(Math.round(cx) + c, Math.round(cy) + r, hex('#010402'));
      }
      toLayer = false;
      compositeLayer(HERO[realm].outline);

      // —— 粒子 ——
      for (const p of parts) {
        const a = 1 - p.life / p.max;
        if (p.kind === 0) pdither(p.x, p.y, p.c, a * 1.4);
        else if (p.kind === 1) {
          pset(p.x, p.y, p.c);
          if (Math.sin(p.life * 6 + p.seed) > 0) pset(p.x + 1, p.y, p.c);
        } else if (p.kind === 2) {
          for (let b = 0; b < 9; b++) if ((p.seed >> b) & 1) pdither(p.x + (b % 3), p.y + Math.floor(b / 3), p.c, a * 1.3);
        } else if (p.kind === 3) {
          const l = Math.hypot(p.vx, p.vy) * 0.04;
          const nx = p.vx / (Math.hypot(p.vx, p.vy) || 1);
          const ny = p.vy / (Math.hypot(p.vx, p.vy) || 1);
          for (let i = 0; i < l; i++) pdither(p.x - nx * i, p.y - ny * i, p.c, a * (1 - i / l));
        } else {
          pset(p.x, p.y, p.c);
          if (p.life < 0.15) {
            pset(p.x - 1, p.y, p.c);
            pset(p.x + 1, p.y, p.c);
            pset(p.x, p.y - 1, p.c);
            pset(p.x, p.y + 1, p.c);
          }
        }
      }

      // —— 登顶：川陀谢顿穹顶全息星环爆发 ——
      if (realm === 'paper' && summitFx >= 0 && summitFx < 4.5) {
        const top = gyi[298] - 22;
        for (let k = 0; k < 3; k++) {
          const r = ((summitFx * 28 + k * 14) % 44) + 4;
          ring(299, top, r, r * 0.45, k % 2 ? hex('#f0c875') : hex('#5ec8ff'), 0.9 * (1 - r / 48));
        }
      }

      for (const fl of floats) {
        if (fl.t > 1.2 && Math.floor(fl.t * 20) % 2) continue;
        const pal = ROCK[realm];
        const fg =
          fl.tier === 4
            ? hex('#ffd54f')
            : fl.tier === 3
              ? hex('#ff6b4a')
              : fl.tier === 2
                ? hex('#5ec8ff')
                : realm === 'paper'
                  ? hex('#f0c875')
                  : realm === 'crt'
                    ? hex('#c8ffd9')
                    : pal[0];
        drawText(fl.s, fl.x, fl.y, fg, hex('#0a0c14'));
      }

      if (realm === 'crt') {
        if (glitch > 0) glitchPass();
        scanlines();
      }

      ctx.putImageData(image, 0, 0);
    };

    // ======================================================================
    // 13. DOM 文本
    // ======================================================================
    const fmtEta = (ms: number) => {
      const s = Math.max(0, Math.floor(ms / 1000));
      const h = Math.floor(s / 3600);
      const m = Math.floor((s % 3600) / 60);
      return `${String(h).padStart(2, '0')}h ${String(m).padStart(2, '0')}m ${String(s % 60).padStart(2, '0')}s`;
    };
    let lastTele = '';
    let lastQuote = '';
    let lastSr = 0;
    const updateDom = (now: number) => {
      const latest = getTotal(Date.now());
      const idx = Math.floor(latest);
      let p: number;
      if (phase === 'CLIMB') p = sprint ? frac : clamp(latest - idx, 0, 1);
      else if (phase === 'SUMMIT') p = 1;
      else if (phase === 'ROLL') p = clamp((rollX - PATH_X0) / (PATH_X1 - PATH_X0), 0, 1);
      else p = 0;
      const alt = (p * PEAK_ALT).toFixed(1);
      const filled = Math.round(p * 10);
      const bar = '▪'.repeat(filled) + '▫'.repeat(10 - filled);
      const boost = save.boostMeters >= 0.5 ? ` · BOOST +${Math.round(save.boostMeters)}m` : '';
      const tele = `ALT ${alt}m [${bar}] ETA ${fmtEta((1 - p) * CYCLE_MS)} · #${baseSummits + idx}${boost}`;
      if (tele !== lastTele) {
        telemetryEl.textContent = tele;
        lastTele = tele;
      }
      if (tierTimer <= 0 && !epicCharge) {
        const q =
          phase === 'SUMMIT'
            ? '"登顶的片刻停驻，风正掠过山脊。"'
            : phase === 'ROLL'
              ? '"引力终将夺回巨石，但夺不走攀登本身。"'
              : phase === 'DESCENT'
                ? '"Il faut imaginer Sisyphe heureux." —— 走下山去的清醒时刻'
                : CLIMB_QUOTES[realm];
        if (quoteEl && q !== lastQuote) {
          quoteEl.textContent = q;
          lastQuote = q;
        }
      }
      if (srEl && now - lastSr > 2000) {
        lastSr = now;
        srEl.textContent =
          phase === 'CLIMB' ? `西西弗斯正推石上山，海拔 ${alt} 米` : phase === 'SUMMIT' ? '西西弗斯登顶' : phase === 'ROLL' ? '巨石滚落' : '西西弗斯走下山去';
      }
    };

    const syncRealm = () => {
      const r = getRealm();
      if (r === realm && titleEl?.textContent === TITLES[r]) return;
      realm = r;
      parts.length = 0;
      bgEvent = { type: 0, t: 0.2, dur: 6.0, x0: 95, y0: 38, dir: 1 };
      buildStatic();
      if (titleEl) titleEl.textContent = TITLES[realm];
      lastQuote = '';
    };
    window.addEventListener('sisyphus:realmchange', syncRealm);

    // ======================================================================
    // 14. 主循环
    // ======================================================================
    buildStatic();
    if (titleEl) titleEl.textContent = TITLES[realm];
    let last = performance.now();
    let lastDraw = 0;
    const frameGap = reduceMotion ? 80 : 33;
    const loop = (now: number) => {
      requestAnimationFrame(loop);
      const dt = clamp((now - last) / 1000, 0.001, 0.1);
      last = now;
      if (!visible || document.hidden) return;
      if (getRealm() !== realm) syncRealm();
      update(dt, now / 1000);
      if (now - lastDraw >= frameGap) {
        lastDraw = now;
        render(now / 1000);
        updateDom(now);
      }
    };
    render(performance.now() / 1000);
    updateDom(performance.now());
    requestAnimationFrame(loop);
  };

  boot();
</script>
