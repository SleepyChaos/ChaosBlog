              : baseMsg;
        const bubbleCol = Math.max(2, Math.min(COLS - msg.length - 2, Math.round(sCenterCol) - 6));
        putStr(Math.max(2, Math.round(sGroundY) - 10), bubbleCol, msg, 7);
      }

      for (const ft of floatingTags) {
        putStr(Math.round(ft.row), ft.col, ft.text, ft.cls, false, 0);
      }

      // 悬停目标锁定准星框
      if (hoveredHotspot) {
        const hc0 = Math.max(0, hoveredHotspot.col - 1);
        const hc1 = Math.min(COLS - 1, hoveredHotspot.col + hoveredHotspot.w);
        const hr0 = Math.max(1, hoveredHotspot.row - 1);
        const hr1 = Math.min(ROWS - 1, hoveredHotspot.row + hoveredHotspot.h);
        put(hr0, hc0, '╔', 9);
        put(hr0, hc1, '╗', 9);
        put(hr1, hc0, '╚', 9);
        put(hr1, hc1, '╝', 9);
      }

      // 左上角 TUI 实时遥测角标
      const latestTotalNow = getTotalRawCycles(Date.now());
      const unifiedCycleIdx = Math.floor(latestTotalNow);
      const unifiedFrac =
        phase === 'CLIMB' && !sprintToSummit
          ? Math.max(0, Math.min(1, latestTotalNow - unifiedCycleIdx))
          : Math.max(0, Math.min(1, boulderProg));
      const shownCycle = baseSummits + unifiedCycleIdx;
      const altNow = (unifiedFrac * PEAK_ALT).toFixed(1);
      const phaseTag =
        themeSkillTimer > 0
          ? 'OVERDRIVE'
          : phase === 'CLIMB'
            ? sprintToSummit
              ? 'SPRINT'
              : 'ASCENT'
            : phase === 'SUMMIT_BREATH'
              ? 'SUMMIT'
              : phase === 'AVALANCHE'
                ? 'TUMBLE'
                : 'RETURN';

      putStr(0, 1, `[${phaseTag}] ${altNow}m / 884.8m · 224x72 ATLAS`, 10);
      if (comboCount > 1) {
        putStr(0, 42, `[COMBO x${comboCount}]`, 9);
      }
      if (boostBannerTimer > 0) {
        putStr(
          0,
          comboCount > 1 ? 56 : 42,
          `>> +${lastBoostGainMeters.toFixed(1)}m [${lastBoostSource}] <<`,
          9,
        );
      } else if (hoveredHotspot) {
        putStr(0, comboCount > 1 ? 56 : 42, `[TARGET: ${hoveredHotspot.label}]`, 2);
      }

      // ================= LAYER 9: xterm.js Offscreen Glyph Atlas GPU 位块传输渲染 =================
      if (ctx) {
        const totalPhysW = COLS * TILE_W;
        const totalPhysH = ROWS * TILE_H;
        ctx.fillStyle = palette.bg;
        ctx.fillRect(0, 0, totalPhysW, totalPhysH);

        // Pass 1: 水平游程合并绘制每格背景色 (Run-Length Encoded BG Pass)
        for (let r = 0; r < ROWS; r++) {
          const rowOff = r * COLS;
          const yPx = r * TILE_H;
          let c = 0;
          while (c < COLS) {
            const bgId = cellBg[rowOff + c];
            if (bgId === 0) {
              c++;
              continue;
            }
            let endC = c + 1;
            while (endC < COLS && cellBg[rowOff + endC] === bgId) {
              endC++;
            }
            ctx.fillStyle = palette.colors[bgId] || palette.bg;
            ctx.fillRect(c * TILE_W, yPx, (endC - c) * TILE_W, TILE_H);
            c = endC;
          }
        }

        // Pass 2: 从 xterm.js 透明纹理图集 (atlasCanvas) 极速位块贴图所有前景字符
        for (let r = 0; r < ROWS; r++) {
          const rowOff = r * COLS;
          const yPx = r * TILE_H;
          for (let c = 0; c < COLS; c++) {
            const ch = cellChar[r][c];
            if (ch === ' ') continue;
            const fgId = cellFg[rowOff + c] || 6;
            const slot = getOrBakeGlyphSlot(ch, fgId);
            const sx = (slot % ATLAS_COLS) * TILE_W;
            const sy = Math.floor(slot / ATLAS_COLS) * TILE_H;
            ctx.drawImage(atlasCanvas, sx, sy, TILE_W, TILE_H, c * TILE_W, yPx, TILE_W, TILE_H);
          }
        }
      }

      // ================= LAYER 10: 同步更新节拍共鸣槽 UI 与节流无障碍镜面 =================
      if (cadenceMeterEl) {
        const trackLen = 11;
        const cursorIdx = Math.max(0, Math.min(trackLen - 1, Math.floor(cadenceClock * trackLen)));
        const baseGlyphs = ['░', '░', '▒', '▒', '▓', '█', '▓', '▒', '▒', '░', '░'];
        baseGlyphs[cursorIdx] = isSweetSpot ? '◈' : '▲';
        cadenceMeterEl.textContent = baseGlyphs.join('');
        cadenceMeterEl.classList.toggle('is-sweet', isSweetSpot);
      }
      if (comboBadgeEl) {
        if (comboCount > 1) {
          comboBadgeEl.textContent = `COMBO x${comboCount}`;
          comboBadgeEl.classList.add('is-hot');
        } else if (isSweetSpot) {
          comboBadgeEl.textContent = '★HIT NOW!';
          comboBadgeEl.classList.add('is-hot');
        } else {
          comboBadgeEl.textContent = 'SYNC';
          comboBadgeEl.classList.remove('is-hot');
        }
      }

      // 每 360ms 节流同步一次隐藏的无障碍 `<pre>` 镜面，确保零主线程 DOM 开销
      if (nowPerf - lastSrSyncTime > 360) {
        lastSrSyncTime = nowPerf;
        const srLines: string[] = [];
        for (let r = 0; r < ROWS; r += 2) {
          let line = '';
          for (let c = 0; c < COLS; c += 2) {
            line += cellChar[r][c];
          }
          srLines.push(line);
        }
        stageEl.textContent = srLines.join('\n');
      }

      const filled = Math.max(0, Math.min(10, Math.round(unifiedFrac * 10)));
      const bar = '▪'.repeat(filled) + '▫'.repeat(10 - filled);
      const remainMs = Math.max(0, (1 - unifiedFrac) * CYCLE_MS);
      const boostNote =
        save.boostMeters >= 0.5 ? ` · BOOST +${Math.round(save.boostMeters)}m` : '';

      telemetryEl.textContent = `ALT ${altNow}m [${bar}] ETA ${formatEta(remainMs)} · #${shownCycle}${boostNote}`;

      if (quoteEl && themeSkillTimer <= 0) {
        if (phase === 'SUMMIT_BREATH') {
          quoteEl.textContent = '"登顶的片刻停驻，星风正掠过山脊。"';
        } else if (phase === 'AVALANCHE') {
          quoteEl.textContent = '"引力终将夺回巨石，但夺不走攀登本身。"';
        } else if (phase === 'DESCENT_WALK') {
          quoteEl.textContent = '"真正打动我的，是他走下山去的那段清醒时刻。"';
        } else {
          quoteEl.textContent = WORLD_QUOTES[realm] || WORLD_QUOTES.void;
        }
      }
    };

    requestAnimationFrame(tick);
  }
</script>
