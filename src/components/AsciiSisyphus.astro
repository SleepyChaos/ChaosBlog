          const rainbow = ['#38bdf8', '#f2b44f', '#ff4d79', '#a78bfa', '#ffffff'].map(hex);
          for (let i = -3; i <= 3; i++) {
            const c = rainbow[Math.abs(i) % rainbow.length];
            stroke(bc.x - 55, bc.y + i * 5 + 14, bc.x + 28, bc.y + i * 2 - 10, 1, c);
