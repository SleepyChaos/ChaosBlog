      paper: '"★ 1% 神迹触发：川陀帝国旗舰降临！第一辐光反重力金桥护送直抵谢顿穹顶！"',
      crt: '"★ 1% 神迹触发：THE ONE AWAKENS！尼奥御空飞行，念力裹挟代码巨石直冲万物之源！"',
      amber: '"★ 1% 神迹触发：SHAI-HULUD！西西弗斯抛出造物主沙钩，骑乘巨型沙虫夏胡鲁破沙冲顶！"',
    };

    const TIER3_QUOTES: Record<Realm, string> = {
      void: '"[暴击助推] TMA-1 轨道谐波束锁定巨石，局部月面重力归零！"',
      paper: '"[暴击助推] 川陀帝国巡洋舰低空掠过，心理史学牵引光束全功率输出！"',
      crt: '"[暴击助推] 尼布甲尼撒号释放 EMP 冲击波，子弹时间残影全开！"',
      amber: '"[暴击助推] 阿崔迪扑翼机俯冲投弹，香料矿脉大喷发将巨石掀上沙脊！"',
    };

    const applyBoost = (amount: number, at?: { x: number; y: number }, forcedTier?: number) => {
      if (phase !== 'CLIMB') return;
      reloadSave();
      const gained = amount * PEAK_ALT;

      // 根据弹出的进度米数自动匹配 4 档分段动画：
      // Tier 1 (<18.5m): 稳步发力 | Tier 2 (18.5~35m): 强力突进 | Tier 3 (>35m): 史诗暴击 | Tier 4: 1% 坐骑神迹冲顶
      const tier =
        forcedTier ??
        (gained >= 180 ? 4 : gained >= 35 ? 3 : gained >= 18.5 ? 2 : 1);

      activeTier = tier;
      tierDuration = tier === 4 ? 3.5 : tier === 3 ? 1.75 : tier === 2 ? 1.15 : 0.65;
      tierTimer = tierDuration;
      kick = tier >= 2 ? 0.75 : 0.45;

      const bc = boulderCenter(contactX(frac));
      const hx = bc.x - R;
      const pal = ROCK[realm];

      if (tier === 4) {
        // 1% 终极登顶彩蛋：启动主题专属坐骑/载具冲顶演出！
        sprint = true;
        epicCharge = true;
        if (quoteEl) quoteEl.textContent = EPIC_QUOTES[realm];
        floats.push({ x: clamp(bc.x - 24, 8, W - 72), y: bc.y - R - 14, s: `*1%MAX+${Math.round(PEAK_ALT)}m!`, t: 0, tier: 4 });
        for (let i = 0; i < 42; i++) {
          const a = Math.random() * Math.PI * 2;
          const v = 18 + Math.random() * 55;
          emit(bc.x, bc.y, Math.cos(a) * v, Math.sin(a) * v - 15, 1.4, i % 2 ? hex('#ffd56b') : pal[0], 18, 4);
        }
      } else if (tier === 3) {
        // Tier 3 (35m~68m): 暴击神迹过场小动画
        if (quoteEl) quoteEl.textContent = TIER3_QUOTES[realm];
        floats.push({ x: bc.x - 14, y: bc.y - R - 10, s: `CRIT+${gained.toFixed(0)}m!!`, t: 0, tier: 3 });
        for (let i = 0; i < 30; i++) {
          const a = Math.random() * Math.PI * 2;
          const v = 16 + Math.random() * 44;
          const c =
            realm === 'crt'
              ? hex('#c8ffd9')
              : realm === 'paper'
                ? i % 2
                  ? hex('#f0c875')
                  : hex('#c8402a')
                : realm === 'amber'
                  ? i % 2
                    ? hex('#ff9d42')
                    : hex('#7fd8ff')
                  : hex('#8fd3ff');
          emit(bc.x, bc.y, Math.cos(a) * v, Math.sin(a) * v - 14, 1.2, c, 24, i % 3 === 0 ? 3 : 4);
        }
        if (realm === 'crt') glitch = Math.max(glitch, 0.25);
      } else if (tier === 2) {
        // Tier 2 (18.5m~35m): 强力突进小动画
        floats.push({ x: bc.x - 8, y: bc.y - R - 8, s: `+${gained.toFixed(0)}m!`, t: 0, tier: 2 });
        for (let i = 0; i < 22; i++) {
          const a = Math.random() * Math.PI * 2;
          const v = 12 + Math.random() * 34;
          if (realm === 'crt') emit(hx, bc.y, Math.cos(a) * v, Math.sin(a) * v - 10, 0.95, hex('#3dff7a'), 20, 2);
          else if (realm === 'paper') emit(hx, bc.y, Math.cos(a) * v, Math.sin(a) * v - 12, 1.1, i % 2 ? hex('#f0c875') : hex('#c8402a'), 30, 4);
          else if (realm === 'amber') emit(hx, bc.y + 4, Math.cos(a) * v, -Math.abs(Math.sin(a) * v), 0.95, i % 2 ? hex('#f2bb78') : hex('#5ec8ff'), 60, 0);
          else emit(hx, bc.y, Math.cos(a) * v, Math.sin(a) * v, 0.9, i % 2 ? pal[0] : hex('#8fd3ff'), 0, 4);
        }
      } else {
        // Tier 1 (8m~18.5m): 稳步蓄力推石
        floats.push({ x: bc.x - 6, y: bc.y - R - 6, s: `+${gained.toFixed(0)}m`, t: 0, tier: 1 });
        for (let i = 0; i < 12; i++) {
          const a = Math.random() * Math.PI * 2;
          const v = 8 + Math.random() * 20;
          emit(hx - 2, bc.y + 3, Math.cos(a) * v - 6, -Math.abs(Math.sin(a) * v), 0.65, pal[1], 45, 0);
        }
      }

      if (at) {
        for (let i = 0; i < 7; i++) emit(at.x, at.y, (Math.random() - 0.5) * 26, (Math.random() - 0.5) * 26, 0.5, pal[0], 0, 4);
      }
      if (floats.length > 5) floats.shift();
    };

    let pendingAt: { x: number; y: number } | undefined;
    let pendingTier: number | undefined;

    const requestPush = (source: string, at?: { x: number; y: number }) => {
      if (phase !== 'CLIMB') return;
      pendingAt = at;
      pushPityCount++;

      // 1% 直接登顶彩蛋判定（附带保底机制：连续点击满 45 次必触发一次 1% 神迹彩蛋！）
      const roll = Math.random();
      if (roll < 0.01 || pushPityCount >= 45) {
        pushPityCount = 0;
        pendingTier = 4;
        const remainFrac = Math.max(0.05, 1.0 - frac);
        window.dispatchEvent(
          new CustomEvent('sisyphus:boulder-boost', {
            detail: {
              rolledAmount: remainFrac * 0.25, // 先记入一部分立即冲量，剩余由 epicCharge 狂飙完成
              source: '★1%神迹登顶',
            },
          }),
        );
        return;
      }

      // 分段随机权重：
      // 45% Tier 1 (稳步发力: +8m ~ +18m)
      // 35% Tier 2 (强力突进: +19m ~ +34m)
      // 19% Tier 3 (暴击神迹: +36m ~ +66m)
      let minM = 8;
      let maxM = 18;
      if (roll < 0.20) {
        pendingTier = 3;
        minM = 36;
        maxM = 66;
      } else if (roll < 0.55) {
        pendingTier = 2;
        minM = 19;
        maxM = 34;
      } else {
        pendingTier = 1;
        minM = 8;
        maxM = 18;
      }
      const randM = minM + Math.random() * (maxM - minM);
      window.dispatchEvent(
        new CustomEvent('sisyphus:boulder-boost', {
          detail: {
            minM,
            maxM,
            rolledAmount: randM / PEAK_ALT,
            source,
          },
        }),
      );
    };

    window.addEventListener('sisyphus:boulder-boost', (ev: Event) => {
      const d = (ev as CustomEvent<{ amount?: number; minM?: number; maxM?: number; rolledAmount?: number }>).detail;
      let amt = d?.rolledAmount;
      if (typeof amt !== 'number') {
        if (typeof d?.minM === 'number' && typeof d?.maxM === 'number') amt = (d.minM + Math.random() * (d.maxM - d.minM)) / PEAK_ALT;
        else amt = clamp(d?.amount ?? 0.018, 0.001, 0.12) * (0.58 + Math.random() * 0.87);
        if (d) d.rolledAmount = amt;
      }
      applyBoost(amt, pendingAt, pendingTier);
      pendingAt = undefined;
      pendingTier = undefined;
    });

    const triggerEpicSummitCharge = () => {
      if (phase === 'CLIMB') {
        sprint = true;
        epicCharge = true;
        activeTier = 4;
        tierDuration = 3.5;
        tierTimer = 3.5;
        if (quoteEl) quoteEl.textContent = EPIC_QUOTES[realm];
      }
    };

    window.addEventListener('sisyphus:trigger-summit', triggerEpicSummitCharge);
    pushBtn?.addEventListener('click', () => requestPush('主动助推'));
    summitBtn?.addEventListener('click', triggerEpicSummitCharge);

    viewportEl?.addEventListener('click', (e: MouseEvent) => {
      const rct = canvas.getBoundingClientRect();
      const at = { x: ((e.clientX - rct.left) / rct.width) * W, y: ((e.clientY - rct.top) / rct.height) * H };
      // 点击高空背景区域时除了助推，若当前没有背景小事件还会立即唤醒一个背景小事件！
      if (at.y < gy(at.x) - 18 && !bgEvent) {
        bgEvent = {
          type: Math.floor(Math.random() * 3),
          t: 0,
          dur: 6.2,
          x0: clamp(at.x, 45, 250),
          y0: clamp(at.y, 18, 85),
          dir: Math.random() < 0.5 ? 1 : -1,
        };
      }
      requestPush('画面助推', at);
    });
    viewportEl?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.code === 'Space' || e.key === ' ') {
        e.preventDefault();
        requestPush('空格助推');
      }
    });

    let visible = true;
    if ('IntersectionObserver' in window && viewportEl) {
      new IntersectionObserver((ents) => {
        visible = ents.some((en) => en.isIntersecting);
      }).observe(viewportEl);
    }

    // ======================================================================
    // 8. 角色：IK 骨骼小人 + 主题装束 + 骑乘姿态
    // ======================================================================
    const ik = (ax: number, ay: number, bx: number, by: number, l1: number, l2: number, sign: number) => {
      let dx = bx - ax;
      let dy = by - ay;
      let d = Math.hypot(dx, dy) || 0.001;
      const maxD = l1 + l2 - 0.05;
      if (d > maxD) {
        dx *= maxD / d;
        dy *= maxD / d;
        d = maxD;
      }
      const cosA = clamp((l1 * l1 + d * d - l2 * l2) / (2 * l1 * d), -1, 1);
      const ang = Math.atan2(dy, dx) + Math.acos(cosA) * sign;
      return { jx: ax + Math.cos(ang) * l1, jy: ay + Math.sin(ang) * l1, ex: ax + dx, ey: ay + dy };
    };

    const drawHero = (
      mode: Mode,
      hx: number,
      f: number,
      gp: number,
      hand: { x: number; y: number } | null,
      heave: number,
      sec: number,
      rideMountY?: number,
    ) => {
      const st = HERO[realm];
      const moving = mode === 'push' || mode === 'walk' || mode === 'ride';
      const bob = moving ? Math.abs(Math.sin(gp)) * 0.7 : 0;
      let hipX: number;
      let hipY: number;
      let shX: number;
      let shY: number;

      if (mode === 'ride' && rideMountY !== undefined) {
        hipX = hx;
        hipY = rideMountY - 8.5 + Math.sin(sec * 16) * 0.6;
        shX = hipX + (realm === 'crt' ? 4.8 : 2.2);
        shY = hipY - (realm === 'crt' ? 3.2 : 5.8);
      } else if (mode === 'push' && hand) {
        const tierLean = activeTier === 2 ? 1.4 : activeTier === 3 ? 2.0 : 0;
        hipX = hand.x - 10.8 - heave * 0.4;
        const g = gy(hipX + 0.5);
        hipY = clamp(hand.y + 3.4, g - 9.4, g - 7.2) + bob * 0.4;
        shX = hipX + 5.6 + heave * 0.5 + tierLean * 0.4;
        shY = hipY - 4.6 - heave * 0.2 + (activeTier === 1 && kick > 0 ? 0.8 : 0);
      } else {
        const g = gy(hx);
        hipX = hx;
        hipY = g - 9.6 + bob * 0.5;
        shX = hipX + (mode === 'walk' ? f * 0.7 : 0);
        shY = hipY - 6.4;
      }
      const headX = shX + (mode === 'push' || mode === 'ride' ? 2.4 : f * 0.5);
      const headY = shY - (mode === 'push' || mode === 'ride' ? 2.6 : 3.3);

      // 腿
      const stride = mode === 'push' ? (activeTier >= 2 ? 4.4 : 3.4) : mode === 'walk' ? 3.0 : 0;
      const base = mode === 'push' ? hipX + 0.4 : hipX;
      let fFx = base + Math.cos(gp) * stride * f;
      let fBx = base + Math.cos(gp + Math.PI) * stride * f;
      const liftF = stride ? Math.max(0, -Math.sin(gp)) * 2 : 0;
      const liftB = stride ? Math.max(0, Math.sin(gp)) * 2 : 0;
      let footBaseY_F = gy(fFx) - 1 - liftF;
      let footBaseY_B = gy(fBx) - 1 - liftB;

      if (mode === 'ride' && rideMountY !== undefined) {
        if (realm === 'crt') {
          // 尼奥超人御空飞行双腿后掠
          fFx = hipX - 6.5;
          fBx = hipX - 7.5;
          footBaseY_F = hipY + 2.5;
          footBaseY_B = hipY + 3.5;
        } else {
          fFx = hipX + 2.6;
          fBx = hipX - 2.2;
          footBaseY_F = rideMountY - 1;
          footBaseY_B = rideMountY - 1;
        }
      } else if (!stride) {
        fFx = hipX + 1.5 * f;
        fBx = hipX - 1.3 * f;
        footBaseY_F = gy(fFx) - 1;
        footBaseY_B = gy(fBx) - 1;
      }
      const legF = ik(hipX, hipY, fFx, footBaseY_F, 5, 5.2, -f);
      const legB = ik(hipX, hipY, fBx, footBaseY_B, 5, 5.2, -f);

      // 手
      let aF: { x: number; y: number };
      let aB: { x: number; y: number };
      if (mode === 'ride' && hand) {
        aF = { x: hand.x, y: hand.y };
        aB = { x: hand.x - 1.5, y: hand.y + 1.5 };
      } else if (mode === 'push' && hand) {
        aF = { x: hand.x, y: hand.y - 1 };
        aB = { x: hand.x - 0.6, y: hand.y + 1.2 };
      } else if (mode === 'cheer') {
        const w = Math.sin(sec * 10) * 0.8;
        aF = { x: shX + 2.6, y: shY - 6.6 + w };
        aB = { x: shX - 2.6, y: shY - 6.6 - w };
      } else if (mode === 'watch') {
        aF = { x: headX + f * 1.8, y: headY - 0.6 };
        aB = { x: shX - f * 0.6, y: shY + 7 };
      } else if (mode === 'walk') {
        const s = Math.cos(gp + Math.PI) * 2.4 * f;
        aF = { x: shX + s, y: shY + 6.8 };
        aB = { x: shX - s, y: shY + 6.8 };
      } else {
        aF = { x: shX + 0.6 * f, y: shY + 7 };
        aB = { x: shX - 0.6 * f, y: shY + 7 };
      }
      const armF = ik(shX, shY + 0.5, aF.x, aF.y, 3.9, 3.9, f);
      const armB = ik(shX - 0.4 * f, shY + 0.8, aB.x, aB.y, 3.9, 3.9, f);

      // —— 身后装束 ——
      if (realm === 'void') {
        const px = shX - f * 2.6 + (hipX - shX) * 0.25;
        rect(px - 1.5, shY + 0.5, 3, 5, st.acc2);
        // Tier 2/3/4 宇航服背包等离子喷射尾焰
        if (activeTier >= 2 && mode === 'push') {
          const jetLen = activeTier === 3 ? 9 : 5;
          poly([px - 1, shY + 2, px - 1, shY + 5, px - 1 - jetLen, shY + 3.5 + Math.sin(sec * 35)], hex('#5ec8ff'));
          poly([px - 1, shY + 3, px - 1, shY + 4, px - 1 - jetLen * 0.6, shY + 3.5], hex('#ffffff'));
        }
      } else {
        // 披风 / 帝国学者大氅 / 尼奥黑风衣 / 弗雷曼沙漠披风
        const boostBlow = activeTier >= 2 || mode === 'ride' ? 3.2 : 0;
        const w1 = Math.sin(sec * 9 + 1) * 1.2 + (moving ? 1.5 : 0.3) + boostBlow;
        const tail = (realm === 'amber' ? 5 : 3.8) + boostBlow;
        const cloakColor = realm === 'paper' ? st.acc : realm === 'amber' ? st.acc2 : st.main;
        poly(
          [
            shX + f * 1.2, shY,
            hipX + f * 1.8, hipY + 0.5,
            hipX + f * 1.2, hipY + 7.5,
            hipX - f * (tail + w1), hipY + 7.8 + Math.sin(sec * 11) * 0.9,
            shX - f * 2.2, shY + 0.6,
          ],
          cloakColor,
        );
      }

      stroke(shX - 0.4 * f, shY + 0.8, armB.jx, armB.jy, 2, st.back);
      stroke(armB.jx, armB.jy, armB.ex, armB.ey, 2, st.back);
      stroke(hipX, hipY, legB.jx, legB.jy, 2, st.back);
      stroke(legB.jx, legB.jy, legB.ex, legB.ey, 2, st.back);
      plot(Math.round(legB.ex + f), Math.round(legB.ey), st.back);

      stroke(hipX, hipY, shX, shY, 3, st.main);
      if (realm === 'paper') rect(hipX - 1.5, hipY - 1.5, 3, 1, st.acc2);

      // 头 + 头饰
      if (realm === 'void') {
        disc(headX, headY, 3, st.main);
        rect(headX + (f > 0 ? 0.5 : -2.5), headY - 1.5, 2, 2, st.acc);
        plot(Math.round(headX + f * 1.4), Math.round(headY - 2), hex('#ffffff'));
      } else if (realm === 'paper') {
        // 川陀心理史学大师：金冠头环与第一辐光徽记
        disc(headX, headY, 2.4, hex('#e8d2b5'));
        rect(headX - 2, headY - 2.2, 4.5, 1.4, st.main);
        stroke(headX - 2, headY - 1, headX + 2.2, headY - 1, 1, st.acc2);
        plot(Math.round(headX + f * 1.2), Math.round(headY - 1.5), hex('#5ec8ff'));
      } else if (realm === 'crt') {
        disc(headX, headY, 2.3, st.main);
        rect(headX + (f > 0 ? 0.2 : -2.2), headY - 0.8, 2, 1, st.acc);
      } else {
        disc(headX - f * 0.4, headY, 2.9, st.acc2);
        disc(headX + f * 0.7, headY + 0.2, 1.4, st.main);
        plot(Math.round(headX + f * 1.3), Math.round(headY - 0.3), st.acc);
      }

      stroke(hipX, hipY, legF.jx, legF.jy, 2, st.main);
      stroke(legF.jx, legF.jy, legF.ex, legF.ey, 2, st.main);
      plot(Math.round(legF.ex + f), Math.round(legF.ey), st.main);
      stroke(shX, shY + 0.5, armF.jx, armF.jy, 2, st.main);
      stroke(armF.jx, armF.jy, armF.ex, armF.ey, 2, st.main);

      return { footF: { x: legF.ex, y: legF.ey }, footB: { x: legB.ex, y: legB.ey }, shX, shY, hipX, hipY };
    };

    // ======================================================================
    // 9. 巨石：逐像素球面光照 + 四大主题雕刻纹理
    // ======================================================================
    const CRATERS: [number, number, number][] = [
      [0.35, -0.3, 0.22],
      [-0.4, 0.25, 0.18],
      [0.1, 0.5, 0.14],
      [-0.2, -0.55, 0.12],
    ];
    const drawBoulder = (cx: number, cy: number, angle: number, sec: number) => {
      const pal = ROCK[realm];
      const [Lx, Ly, Lz] = LIGHT[realm];
      const ca = Math.cos(angle);
      const sa = Math.sin(angle);
      const x0 = Math.round(cx);
      const y0 = Math.round(cy);
      const rr = R + 0.5;
      const isWireframe = realm === 'crt' && (activeTier >= 2 || epicCharge);

      for (let dy = -R; dy <= R; dy++) {
        for (let dx = -R; dx <= R; dx++) {
          const nx = dx / rr;
          const ny = dy / rr;
          const r2 = nx * nx + ny * ny;
          if (r2 > 1) continue;
          const nz = Math.sqrt(1 - r2);
          const u = nx * ca + ny * sa;
          const v = -nx * sa + ny * ca;
          const px = x0 + dx;
          const py = y0 + dy;
          let lum = nx * Lx + ny * Ly + nz * Lz;

          if (realm === 'crt') {
            const lat = Math.abs(v * 4 - Math.round(v * 4)) < 0.16;
            const lon = Math.abs(Math.atan2(u, nz) / (Math.PI / 5) - Math.round(Math.atan2(u, nz) / (Math.PI / 5))) < 0.15;
            if (isWireframe && !lat && !lon && r2 < 0.82) continue;
            let c = lum > 0.5 ? pal[3] : pal[4];
            if (lat || lon) c = lum > 0.55 ? pal[1] : pal[2];
            if (r2 > 0.82) c = pal[1];
            if (lum > 0.93 && (lat || lon)) c = pal[0];
            plot(px, py, c);
            continue;
          }
          if (realm === 'void') {
            lum += (noise(u * 3 + 10, v * 3) - 0.5) * 0.25;
            for (const [cu, cv, cr] of CRATERS) {
              const d = Math.hypot(u - cu, v - cv);
              if (d < cr) lum -= 0.32 * (1 - d / cr) * (((u - cu) * Lx + (v - cv) * Ly) < 0 ? 1 : 0.3);
              else if (d < cr + 0.08 && ((u - cu) * Lx + (v - cv) * Ly) > 0) lum += 0.15;
            }
          } else if (realm === 'paper') {
            // 第一辐光浑天球：旋转正交金环与发光赤红方程脉络
            const onRing = Math.abs(u) < 0.14 || Math.abs(v) < 0.14 || Math.abs(u * u + v * v - 0.52) < 0.1;
            if (onRing) {
              plot(px, py, lum > 0.35 ? hex('#fff2b2') : hex('#c8402a'));
              continue;
            }
            lum += (noise(u * 5, v * 5) - 0.5) * 0.15;
          } else {
            const band = Math.sin(v * 10 + u * 1.5 + noise(u * 3, v * 3) * 1.5);
            if (band > 0.35) lum += 0.12;
            else if (band < -0.6) lum -= 0.12;
            if (hash(Math.round(u * 6), Math.round(v * 6)) > 0.96 && Math.sin(sec * 5 + u * 9) > 0.55) {
              plot(px, py, hex('#7fd8ff'));
              continue;
            }
          }
          const t = lum + (bayer(px, py) - 0.5) * 0.22;
          const c = t > 0.8 ? pal[0] : t > 0.52 ? pal[1] : t > 0.28 ? pal[2] : t > 0.08 ? pal[3] : pal[4];
          plot(px, py, c);
        }
      }
    };

    const castShadow = (x: number, len: number) => {
      const sh = SHADOW[realm];
      if (!sh) return;
      for (let i = 0; i < len; i++) {
        const sx = Math.round(x + i * sh.dir);
        if (sx < 0 || sx >= W) continue;
        const a = 0.8 * (1 - i / len);
        pdither(sx, gyi[sx], sh.c, a);
        pdither(sx, gyi[sx] + 1, sh.c, a * 0.75);
      }
    };

    const compositeLayer = (outline: number) => {
      if (bx1 < bx0) return;
      const xa = Math.max(1, bx0 - 1);
      const xb = Math.min(W - 2, bx1 + 1);
      const ya = Math.max(1, by0 - 1);
      const yb = Math.min(H - 2, by1 + 1);
      for (let y = ya; y <= yb; y++) {
        for (let x = xa; x <= xb; x++) {
          const i = y * W + x;
          const m = mask[i];
          if (m && !(mask[i - 1] > m || mask[i + 1] > m || mask[i - W] > m || mask[i + W] > m)) {
            buf[i] = layer[i];
          } else if (mask[i - 1] > m || mask[i + 1] > m || mask[i - W] > m || mask[i + W] > m) {
            buf[i] = outline;
          }
        }
      }
      for (let y = Math.max(0, by0 - 1); y <= Math.min(H - 1, by1 + 1); y++) {
        mask.fill(0, y * W + Math.max(0, bx0 - 1), y * W + Math.min(W, bx1 + 2));
      }
      bx0 = W;
      by0 = H;
      bx1 = 0;
      by1 = 0;
